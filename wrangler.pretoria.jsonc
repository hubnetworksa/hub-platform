{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pretoriahub",
  "compatibility_date": "2026-08-31",
  "pages_build_output_dir": "dist",

  // Read by functions/_lib/site.ts at request time to pick this site's config
  // out of sites/*.json — set separately for Preview vs Production in the
  // Cloudflare Pages dashboard too (Settings → Environment variables);
  // whatever's there overrides this file for an actual deployed build.
  "vars": {
    "SITE": "pretoria"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pretoriahub-db",
      "database_id": "0681593f-b710-402d-aae4-684be8302010",
      "migrations_dir": "db/migrations/pretoria"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "pretoriahub-media"
    }
  ],

  // Ethan-branch-only: PayFast SANDBOX credentials for the dev preview
  // (Production has its own, set as encrypted Pages secrets — never
  // touched by this file). These are PayFast's own publicly documented
  // sandbox test pair (developers.payfast.co.za), safe to commit — they
  // only work against sandbox.payfast.co.za and move no real money. Preview
  // deploys use this env.preview block automatically; Production ignores it.
  // IMPORTANT: env.preview.vars REPLACES the top-level vars for preview
  // deploys rather than merging with it, so SITE has to be repeated here too
  // — leaving it out breaks every page on preview (confirmed the hard way).
  "env": {
    "preview": {
      "vars": {
        "SITE": "pretoria",
        "PAYFAST_MERCHANT_ID": "10004002",
        "PAYFAST_MERCHANT_KEY": "q1cd2rdny4a53",
        "PAYFAST_PASSPHRASE": "payfast",
        "PAYFAST_HOST": "sandbox.payfast.co.za"
      }
    }
  }

  // Consolidation note (see plan): Pretoria previously sent email via Gmail
  // SMTP (worker-mailer + compatibility_flags: ["nodejs_compat"] + a
  // GMAIL_APP_PASSWORD Pages secret). That's been dropped in favour of the
  // same mailto:<contactEmail> client-side approach Polokwane already used —
  // no SMTP credentials to provision per site. See
  // src/pages/{report-listing,request-removal,list-your-business}.astro.
  // The GMAIL_APP_PASSWORD secret on the pretoriahub Pages project can be
  // deleted once this is deployed.
}
