---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import site from '../site';
import { siteName, cityLabel, footerTagline, adsEnabled } from '../lib/site-overrides';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** When set, used verbatim as the <title> / OG / Twitter title instead of
   *  the default "`${title} | ${site.siteName}`" — for pages given an exact
   *  search-optimised meta title. */
  titleOverride?: string;
  /** For utility pages (report-listing/request-removal) that get a distinct
   *  ?slug=&name= query string linked from every business page — without
   *  this, Google discovers one crawlable URL per business for what's
   *  really the same non-content form, which wastes crawl budget on
   *  thousands of near-duplicate URLs. */
  noindex?: boolean;
  /** Renders `site.impactSiteVerification` as a meta tag when set — only
   *  ever passed `true` from the homepage, per Impact.com's own
   *  instructions that this tag is homepage-only, not site-wide. */
  impactVerification?: boolean;
}

const { title, description, canonical, titleOverride, noindex, impactVerification } = Astro.props;
const fullTitle = titleOverride ?? `${title} | ${site.siteName}`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = canonical ?? (siteUrl + Astro.url.pathname);

const ICONS = {
  home: '<path d="M4 11.5 12 4l8 7.5"/><path d="M6 10v10h12V10"/>',
  pin: '<path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5"/>',
  grid: '<rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6"/><path d="M12 7.5v.01"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  building: '<path d="M4 21h16M6 21V7l6-4 6 4v14M9 21v-6h6v6"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m14.5 9.5-2 5-5 2 2-5 5-2Z"/>',
  shield: '<path d="M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-4Z"/><path d="m9.5 12 1.8 1.8L15 10"/>',
  tag: '<path d="M20.6 12.6 12.6 4.6a2 2 0 0 0-1.4-.6H5a1 1 0 0 0-1 1v6.2a2 2 0 0 0 .6 1.4l8 8a2 2 0 0 0 2.8 0l5.2-5.2a2 2 0 0 0 0-2.8Z"/><circle cx="8.5" cy="8.5" r="1.2"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  check: '<path d="m5 12 5 5L19 7"/>',
};
const { theme } = site;

// Built as a raw string (not Astro's `define:vars`, whose inline style ends
// up on whichever element wraps the <style> tag — not reliably <html> from
// inside <head>) and injected via set:html below, so the :root rule really
// is document-root-scoped regardless of where in <head> it sits. Values all
// come from our own sites/<slug>.json, never user input.
const themeCss = `:root {
  --bg: ${theme.bg};
  --bg-subtle: ${theme.bgSubtle};
  --bg-card: ${theme.bgCard};
  --border: ${theme.border};
  --text: ${theme.text};
  --text-muted: ${theme.textMuted};
  --accent: ${theme.accent};
  --accent-rgb: ${theme.accentRgb};
  --accent-hover: ${theme.accentHover};
  --accent-contrast: ${theme.accentContrast};
  --navy: ${theme.navy};
  --navy-rgb: ${theme.navyRgb};
  --gradient: linear-gradient(135deg, ${theme.gradientFrom} 0%, ${theme.accent} 100%);
  --danger: ${theme.danger};
  --warning: ${theme.warning};
  --brand-row-bg: ${theme.brandRowBg};
  --brand-row-fg: ${theme.brandRowFg};
  --brand-row-accent: ${theme.brandRowAccent};
  --brand-row-muted: ${theme.brandRowMuted};

  /* Aliases matching the mockup's own variable names verbatim (--contrast,
     --muted, --grad-from) — kept as aliases of the vars above rather than
     translating every occurrence by hand across every page's markup, so
     the mockup's literal inline styles can be copied in directly without
     transcription drift. */
  --contrast: ${theme.accentContrast};
  --muted: ${theme.textMuted};
  --grad-from: ${theme.gradientFrom};
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {site.googleSiteVerification && (
      <meta name="google-site-verification" content={site.googleSiteVerification} />
    )}
    {site.bingSiteVerification && (
      <meta name="msvalidate.01" content={site.bingSiteVerification} />
    )}
    {impactVerification && site.impactSiteVerification && (
      <meta name="impact-site-verification" content={site.impactSiteVerification} />
    )}

    <!-- Google Analytics (GA4) — each site has its own separate property,
         rendered only once this site actually has a Measurement ID.
         Guarded on the real production hostname at runtime: any preview
         deployment (e.g. the hosted dev preview on the `dev` branch)
         serves this exact same build, so without this check a real
         browser visit while testing there would land as a genuine
         pageview in production Analytics — this isn't a build-time
         distinction since every environment deploys the identical dist/
         output. -->
    {site.googleAnalyticsId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}></script>
      <script define:vars={{ gaId: site.googleAnalyticsId, prodHost: site.domain }}>
        if (location.hostname === prodHost) {
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        }
      </script>
    )}

    <!-- AdSense loader. Auto ads (if enabled) are controlled from the AdSense
         dashboard per-site; no <ins class="adsbygoogle"> units are placed in
         markup here. Only rendered once this site has a publisher ID. -->
    {site.adsensePublisherId && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsensePublisherId}`} crossorigin="anonymous"></script>
    )}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:image" content={siteUrl + '/logo-icon.png'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&display=swap" rel="stylesheet" />

    <!-- Square, multiple-of-48px icons — Google Search requires a square
         favicon to show one at all instead of a generic globe; logo-icon.png
         itself is a tall (537x620) non-square crop of the pin mark, which is
         why it wasn't picked up. -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={theme.navy} />

    <style set:html={themeCss}></style>
  </head>
  <body data-city-label={cityLabel} data-ads={adsEnabled ? '1' : '0'}>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div style="position:sticky;top:0;z-index:80;background:var(--navy);color:#fff">
      <div style="max-width:1200px;margin:0 auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:34px;font-size:11.5px;font-weight:600;letter-spacing:.02em">
        <span style="display:flex;align-items:center;gap:8px;color:rgba(255,255,255,.72)">
          <Icon path={ICONS.shield} size={13} />
          Every listing reviewed before it goes live
        </span>
        <span style="display:flex;align-items:center;gap:18px;color:rgba(255,255,255,.72)">
          <span id="wx-chip" hidden data-city={site.slug}>
            <svg id="wx-chip-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></svg>
            <span id="wx-chip-label"></span>
          </span>
          <a href="/advertise/" style="color:rgba(255,255,255,.78)">Advertise</a>
          <a href="/my-businesses/" style="color:rgba(255,255,255,.78)">Business log in</a>
        </span>
      </div>
    </div>

    <header style="position:sticky;top:34px;z-index:70;background:#fff;border-bottom:2px solid var(--navy)">
      <div style="max-width:1200px;margin:0 auto;padding:14px 20px;display:flex;align-items:center;gap:18px;flex-wrap:wrap">
        <a href="/" style="display:flex;align-items:center;gap:10px;flex-shrink:0">
          <img src="/logo-icon.png" alt={site.siteName} style="height:38px;width:auto;display:block" />
          <span style="display:flex;flex-direction:column;line-height:1.05">
            <span style="font-weight:800;font-size:19px;letter-spacing:-.02em;color:var(--navy)">{cityLabel}<span style="color:var(--accent)">Hub</span></span>
            <span style="font-size:9px;font-weight:800;letter-spacing:.18em;color:var(--muted);margin-top:3px">BUSINESS DIRECTORY</span>
          </span>
        </a>
        <nav id="desk-nav" style="display:none;gap:2px;margin-left:8px" aria-label="Main">
          <a href="/suburb/" class="nav-desk-link">Directory</a>
          <a href="/category/" class="nav-desk-link">Categories</a>
          <a href="/events/" class="nav-desk-link">Events</a>
          <a href="/shopping-center/" class="nav-desk-link">Shopping centres</a>
          <a href="/guides/" class="nav-desk-link">Guides</a>
          {site.features.tourism && <a href="/tourism/" class="nav-desk-link">Tourism</a>}
          <a href="/about/" class="nav-desk-link">About</a>
        </nav>
        <div style="display:flex;align-items:center;gap:10px;margin-left:auto">
          <a href="/pricing/" id="pricing-link" style="display:none;padding:10px 14px;font-size:13px;font-weight:800;color:var(--navy);border:2px solid var(--border);border-radius:10px">Pricing</a>
          <a href="/admin/" id="admin-nav-link" hidden style="display:none;padding:10px 14px;font-size:13px;font-weight:800;color:var(--navy);border:2px solid var(--border);border-radius:10px">Admin</a>
          <button type="button" id="nav-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle menu" style="display:none;align-items:center;justify-content:center;width:42px;height:42px;border:2px solid var(--border);border-radius:10px;background:#fff;cursor:pointer;color:var(--navy);flex-shrink:0">
            <Icon path={ICONS.menu} size={20} strokeWidth={2.2} />
          </button>
          <a href="/list-your-business/" id="header-add-business" style="display:inline-flex;align-items:center;gap:7px;padding:11px 16px;font-size:13.5px;font-weight:800;background:var(--accent);color:var(--contrast);border-radius:10px;box-shadow:0 6px 18px rgba(var(--accent-rgb),.28);white-space:nowrap;flex-shrink:0">
            <Icon path={ICONS.plus} size={15} strokeWidth={2.4} />
            <span>Add your business</span>
          </a>
        </div>
      </div>
      <div id="mobile-menu" hidden style="border-top:2px solid var(--border);background:#fff;padding:10px 20px 16px;display:flex;flex-direction:column;gap:2px">
        <a href="/suburb/" class="nav-mob-link">Directory</a>
        <a href="/category/" class="nav-mob-link">Categories</a>
        <a href="/events/" class="nav-mob-link">Events</a>
        <a href="/shopping-center/" class="nav-mob-link">Shopping centres</a>
        <a href="/pricing/" class="nav-mob-link">Plans &amp; pricing</a>
        <a href="/about/" class="nav-mob-link">About</a>
        <a href="/guides/" class="nav-mob-link">Guides</a>
        <a href="/my-businesses/" style="padding:13px 6px;font-size:15.5px;font-weight:800;color:var(--muted)">Business log in</a>
      </div>
    </header>

    <div id="main-content">
      <slot />
    </div>

    <footer style="background:var(--navy);color:rgba(255,255,255,.7);margin-top:0">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(28px,4vw,44px) 20px">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:24px">
          <div>
            <div style="font-weight:800;font-size:18px;letter-spacing:-.02em;color:#fff">{cityLabel}<span style="color:var(--grad-from)">Hub</span></div>
            <p style="margin:8px 0 0;font-size:13.5px;line-height:1.55;max-width:32ch">{footerTagline}</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px;font-size:13.5px;font-weight:600">
            <span style="font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.45)">Browse</span>
            <a href="/suburb/" style="color:rgba(255,255,255,.75)">Suburbs</a>
            <a href="/category/" style="color:rgba(255,255,255,.75)">Categories</a>
            <a href="/events/" style="color:rgba(255,255,255,.75)">Events</a>
            <a href="/shopping-center/" style="color:rgba(255,255,255,.75)">Shopping centres</a>
            <a href="/guides/" style="color:rgba(255,255,255,.75)">Guides</a>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px;font-size:13.5px;font-weight:600">
            <span style="font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.45)">For owners</span>
            <a href="/list-your-business/" style="color:rgba(255,255,255,.75)">Add your business</a>
            <a href="/pricing/" style="color:rgba(255,255,255,.75)">Plans &amp; pricing</a>
            <a href="/my-businesses/" style="color:rgba(255,255,255,.75)">My businesses</a>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px;font-size:13.5px;font-weight:600">
            <span style="font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.45)">Company</span>
            <a href="/about/" style="color:rgba(255,255,255,.75)">About</a>
            <a href="/partners/" style="color:rgba(255,255,255,.75)">Partners</a>
            <a href="/contact/" style="color:rgba(255,255,255,.75)">Contact</a>
            <a href="/privacy/" style="color:rgba(255,255,255,.75)">Privacy &amp; POPIA</a>
            <a href="/terms/" style="color:rgba(255,255,255,.75)">Terms</a>
          </div>
        </div>
        <div style="height:1px;background:rgba(255,255,255,.16);margin:24px 0 16px"></div>
        <div style="font-size:12.5px;font-weight:600;color:rgba(255,255,255,.55)">© {new Date().getFullYear()} {siteName} — {footerTagline}</div>
      </div>
    </footer>

    <script>
      const WX_COORDS: Record<string, [number, number]> = { capetown: [-33.9249, 18.4241], pretoria: [-25.7479, 28.2293], polokwane: [-23.9045, 29.4689] };
      const WX_ICONS: Record<string, string> = {
        sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/>',
        cloud: '<path d="M7 18h10a3.6 3.6 0 0 0 .3-7.2A5.4 5.4 0 0 0 6.9 11 3.5 3.5 0 0 0 7 18Z"/>',
        rain: '<path d="M7 15h10a3.4 3.4 0 0 0 .3-6.8A5.2 5.2 0 0 0 6.9 8.3 3.4 3.4 0 0 0 7 15Z"/><path d="M9 18.5 8 21M13 18.5 12 21M17 18.5 16 21"/>',
      };
      const wxChip = document.getElementById('wx-chip');
      const wxCoords = wxChip ? WX_COORDS[wxChip.dataset.city ?? ''] : undefined;
      if (wxChip && wxCoords) {
        fetch(`/api/weather?lat=${wxCoords[0]}&lon=${wxCoords[1]}`)
          .then((r) => (r.ok ? r.json() : Promise.reject()))
          .then((w) => {
            if (!w.ok) return;
            document.getElementById('wx-chip-icon')!.innerHTML = WX_ICONS[w.now.icon] ?? WX_ICONS.cloud;
            document.getElementById('wx-chip-label')!.textContent = `${w.now.temp}°C · ${w.now.cond}`;
            wxChip.hidden = false;
          })
          .catch(() => {});
      }

      // Deters casual copying only — not a real barrier (dev tools/view-source
      // bypass this trivially) — real protection is the copyright notice in
      // Terms plus hotlink protection on the actual image files.
      document.addEventListener('contextmenu', (e) => {
        if ((e.target as HTMLElement).tagName === 'IMG') e.preventDefault();
      });
      document.addEventListener('dragstart', (e) => {
        if ((e.target as HTMLElement).tagName === 'IMG') e.preventDefault();
      });
    </script>

    <script>
      // Reveals the Admin Dashboard nav link only for the one admin
      // account — everyone else never sees it, since the site is static
      // and can't know login state at build time.
      fetch('/api/me')
        .then((r) => (r.ok ? r.json() : null))
        .then((data) => {
          if (data?.isAdmin) document.getElementById('admin-nav-link')!.hidden = false;
        })
        .catch(() => {});
    </script>

    <script>
      // Hamburger toggle for the mobile dropdown menu (<950px — see the
      // @media rule in global.css that shows #nav-toggle at that width).
      const toggle = document.getElementById('nav-toggle');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => {
        const open = !menu?.hidden;
        if (menu) menu.hidden = open;
        toggle.setAttribute('aria-expanded', String(!open));
      });
      // If the mobile menu was left open and the viewport grows past the
      // breakpoint (desktop nav becomes visible via CSS), close it so it
      // isn't left open-but-hidden underneath.
      window.addEventListener('resize', () => {
        if (window.innerWidth > 950 && menu) {
          menu.hidden = true;
          toggle?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>
