---
// Two variants matching the mockup: 'card' (grid card — Centre/Results
// screens) and 'row' (A-Z list row — Suburb screen).
import { suburbFor, categoriesFor, shoppingCenterFor, FEATURED_TIER, type Business } from '../lib/data';

interface Props {
  business: Business;
  showSuburb?: boolean;
  /** Replaces the computed meta line entirely (pass '' to hide it) — the
   *  shopping-centre page shows category (and address on the pinned card)
   *  only, not "at <this same centre>" on every tenant. */
  metaOverride?: string;
  variant?: 'card' | 'row';
  // When set, clicking this card remembers "you came from this list" (see
  // ListReturn.astro), so the business page can offer a "Back to <name>"
  // link to whichever suburb/shopping-centre listing page the card lives
  // on. Omit on pages where that doesn't apply (e.g. category pages).
  listContext?: { kind: 'suburb' | 'shopping-center'; slug: string; name: string };
}

const { business, showSuburb = true, variant = 'card', listContext, metaOverride } = Astro.props;
const suburb = suburbFor(business);
const cats = categoriesFor(business);
const primary = cats[0];
const center = shoppingCenterFor(business);
const isFeatured = business.subscription_tier >= FEATURED_TIER;
const meta = metaOverride ?? [showSuburb && suburb ? suburb.name : null, center ? `at ${center.name}` : business.address].filter(Boolean).join(' · ');
---

{variant === 'row' ? (
  <a
    href={`/business/${business.slug}/`}
    class="business-row"
    data-list-kind={listContext?.kind}
    data-list-slug={listContext?.slug}
    data-list-name={listContext?.name}
    style="display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px 18px;border-bottom:1px solid var(--border);color:var(--navy);text-decoration:none"
  >
    <span style="display:flex;flex-direction:column;gap:3px;min-width:0">
      <span style="font-size:15.5px;font-weight:800;letter-spacing:-.01em">{business.name}</span>
      {meta && <span style="font-size:12.5px;font-weight:600;color:var(--muted)">{meta}</span>}
    </span>
    {primary && <span style="font-size:11.5px;font-weight:800;color:var(--accent-hover);white-space:nowrap;flex-shrink:0">{primary.name}</span>}
  </a>
) : (
  <article class="business-card" style={`border:2px solid ${isFeatured ? 'var(--accent)' : 'var(--border)'};border-radius:14px;padding:16px;background:#fff;display:flex;flex-direction:column;gap:6px`}>
    {isFeatured && <span style="align-self:flex-start;padding:4px 9px;border-radius:999px;background:var(--accent);color:var(--contrast);font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase">Featured</span>}
    <h3 style="margin:0;font-size:16.5px;letter-spacing:-.015em;color:var(--navy)">{business.name}</h3>
    {(primary || meta) && <p style="margin:0;font-size:13px;font-weight:600;color:var(--muted)">{[primary?.name, meta].filter(Boolean).join(' · ')}</p>}
    <a
      href={`/business/${business.slug}/`}
      class="business-card-link"
      data-list-kind={listContext?.kind}
      data-list-slug={listContext?.slug}
      data-list-name={listContext?.name}
      style="align-self:flex-start;margin-top:2px;font-size:13px;font-weight:800;color:var(--accent);text-decoration:none"
    >
      View profile →
    </a>
  </article>
)}

<script>
  // Astro dedupes this to a single copy per page no matter how many
  // BusinessCards render, so one delegated listener covers every card.
  // Only cards given a listContext prop carry data-list-kind at all.
  document.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest('a[data-list-kind]') as HTMLElement | null;
    if (!card) return;
    const kind = card.dataset.listKind;
    const slug = card.dataset.listSlug;
    const name = card.dataset.listName;
    if (!kind || !slug || !name) return;
    try {
      sessionStorage.setItem('phub:lastList', JSON.stringify({ kind, slug, name, t: Date.now() }));
    } catch {
      /* sessionStorage unavailable — the back link just won't show */
    }
  });
</script>

<style>
  .business-row:hover {
    background: var(--bg-subtle);
  }
  .business-card:hover {
    border-color: var(--navy);
  }
</style>
