---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
  /** 'pill' (default) — the original rounded-chip style. 'plain' — the
   *  mockup's slash-separated breadcrumb, used on the hero/navy-background
   *  screens (suburb, business, shopping-centre, search). Both emit the
   *  same BreadcrumbList JSON-LD either way. */
  variant?: 'pill' | 'plain';
  /** 'plain' only: true when sitting on a navy/dark background (hero
   *  sections) — swaps to the mockup's translucent-white link colors. */
  onDark?: boolean;
}
const { items, variant = 'pill', onDark = false } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    // Omitted for the last (current-page) item, which is standard —
    // there's nothing further to link to since it's the page itself.
    ...(item.href ? { item: siteUrl + item.href } : {}),
  })),
};

const plainLinkColor = onDark ? 'rgba(255,255,255,.7)' : 'var(--muted)';
const plainCurrentColor = onDark ? '#fff' : 'var(--navy)';
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

{variant === 'plain' ? (
  <div style={`display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;color:${plainLinkColor};flex-wrap:wrap`}>
    {items.map((item, i) => (
      <>
        {item.href ? <a href={item.href} style={`color:${plainLinkColor}`}>{item.label}</a> : <span style={`color:${plainCurrentColor}`}>{item.label}</span>}
        {i < items.length - 1 && <span>/</span>}
      </>
    ))}
  </div>
) : (
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    {items.map((item, i) => (
      <>
        {item.href ? <a href={item.href}>{item.label}</a> : <span class="current">{item.label}</span>}
        {i < items.length - 1 && <span class="sep" aria-hidden="true">›</span>}
      </>
    ))}
  </nav>
)}

<style>
  .breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .breadcrumbs a {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    transition: border-color 0.15s, color 0.15s;
  }
  .breadcrumbs a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .breadcrumbs .current {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.3rem 0.2rem;
    overflow-wrap: break-word;
    min-width: 0;
  }
  .breadcrumbs .sep {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
</style>
