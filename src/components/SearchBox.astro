---
// Matches the mockup's hero search card exactly: a white rounded card with
// a keyword row on top and a suburb-select + Search button row below.
// Submitting navigates to /search/ (the mockup's "Results" screen) with
// ?q=&suburb= — that page does the actual client-side fuzzy search against
// /search-index.json (same index/matching logic this component used to run
// inline in a dropdown; centralized there now instead of duplicated).
import { suburbs, businessesInSuburb } from '../lib/data';

const sortedSuburbs = [...suburbs].sort((a, b) => businessesInSuburb(b.id).length - businessesInSuburb(a.id).length);
---

<form id="hero-search" action="/search/" style="background:#fff;border-radius:16px;padding:10px;box-shadow:0 22px 50px rgba(0,0,0,.34);max-width:760px;display:grid;grid-template-columns:1fr;gap:8px">
  <div style="display:flex;align-items:center;gap:10px;padding:0 12px;border-radius:10px;background:var(--bg-subtle)">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1.9" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m20 20-4.5-4.5"></path></svg>
    <input
      type="search"
      name="q"
      placeholder={`Plumber, dentist, panel beater…`}
      aria-label="Search businesses"
      autocomplete="off"
      style="flex:1;min-width:0;border:0;background:transparent;padding:15px 0;font-size:15.5px;color:var(--text);outline:none"
    />
  </div>
  <div style="display:grid;grid-template-columns:1fr auto;gap:8px">
    <div style="display:flex;align-items:center;gap:10px;padding:0 12px;border-radius:10px;background:var(--bg-subtle)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1.9" stroke-linecap="round"><path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
      <select name="suburb" style="flex:1;min-width:0;border:0;background:transparent;padding:14px 0;font-size:14.5px;font-weight:600;color:var(--text);outline:none">
        <option value="">All suburbs</option>
        {sortedSuburbs.slice(0, 40).map((s) => <option value={s.slug}>{s.name}</option>)}
      </select>
    </div>
    <button type="submit" class="hero-search-submit" style="padding:14px 26px;border:0;border-radius:10px;background:var(--accent);color:var(--contrast);font-size:14.5px;font-weight:800;cursor:pointer">Search</button>
  </div>
</form>

<style>
  .hero-search-submit:hover {
    background: var(--accent-hover);
  }
</style>

<script>
  // Bare-bones progressive enhancement: the form works with no JS at all
  // (plain GET to /search/?q=&suburb=), this just skips the extra
  // round-trip when JS is available.
  const form = document.getElementById('hero-search') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    const q = (form.elements.namedItem('q') as HTMLInputElement).value.trim();
    const suburb = (form.elements.namedItem('suburb') as HTMLSelectElement).value;
    if (!q && !suburb) {
      e.preventDefault();
      return;
    }
    e.preventDefault();
    const params = new URLSearchParams();
    if (q) params.set('q', q);
    if (suburb) params.set('suburb', suburb);
    window.location.href = `/search/?${params.toString()}`;
  });
</script>
