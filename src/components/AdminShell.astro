---
// Matches the mockup's Admin console chrome exactly: fixed navy sidebar +
// topbar. The mockup's console is a single-page app with client-side tab
// state; this site's admin section is (and stays) separate real pages —
// each a bookmarkable/shareable URL, which a fake single-page tab switcher
// would have made worse, not better. The sidebar items also cover more
// ground than the mockup's 6 tabs, since the real data model splits
// "Approvals" into three distinct workflows (submissions/claims/reports)
// that the mockup's demo data collapses into one.
import Icon from './Icon.astro';
import site from '../site';

interface Props {
  active: 'dashboard' | 'listings' | 'submissions' | 'claims' | 'reports' | 'users' | 'activity' | 'events' | 'plans' | 'ads';
  title: string;
  subtitle: string;
}
const { active, title, subtitle } = Astro.props;

const NAV: { key: Props['active']; href: string; label: string }[] = [
  { key: 'dashboard', href: '/admin/', label: 'Dashboard' },
  { key: 'listings', href: '/admin/businesses/', label: 'Listings' },
  { key: 'submissions', href: '/admin/submissions/', label: 'Submissions' },
  { key: 'claims', href: '/admin/claims/', label: 'Claims' },
  { key: 'reports', href: '/admin/reports/', label: 'Reports' },
  { key: 'users', href: '/admin/users/', label: 'Users' },
  { key: 'activity', href: '/admin/activity/', label: 'Activity' },
  { key: 'events', href: '/admin/events/', label: 'Events' },
  { key: 'plans', href: '/admin/plans-pricing/', label: 'Plans & pricing' },
  { key: 'ads', href: '/admin/ads-sponsors/', label: 'Ads & sponsors' },
];
---

<div id="admin-shell" style="min-height:100vh;display:grid;background:var(--bg-subtle)">
  <div id="admin-sidebar-backdrop" hidden style="position:fixed;inset:0;background:rgba(16,26,51,.5);z-index:39"></div>
  <aside id="admin-sidebar" style="background:var(--navy);display:flex;flex-direction:column;gap:2px;padding:18px 14px">
    <div style="display:flex;align-items:center;gap:10px;padding:4px 8px 18px">
      <img src="/logo-icon.png" alt="" style="height:30px;width:auto" />
      <span style="display:flex;flex-direction:column;line-height:1.1;min-width:0">
        <span style="font-size:15px;font-weight:800;color:#fff;letter-spacing:-.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{site.cityLabel}Hub</span>
        <span style="font-size:9px;font-weight:800;letter-spacing:.16em;color:var(--grad-from);margin-top:3px">ADMIN</span>
      </span>
      <button id="admin-sidebar-close" type="button" aria-label="Close menu" style="margin-left:auto;align-items:center;justify-content:center;width:32px;height:32px;border:0;border-radius:8px;background:rgba(255,255,255,.1);color:#fff;cursor:pointer">
        <Icon path='<path d="M18 6 6 18M6 6l12 12"/>' size={16} />
      </button>
    </div>
    {NAV.map((n) => (
      <a
        href={n.href}
        style={`display:flex;align-items:center;justify-content:space-between;padding:11px 12px;border-radius:9px;font-size:13.5px;font-weight:700;text-decoration:none;${n.key === active ? 'background:rgba(255,255,255,.14);color:#fff' : 'color:rgba(255,255,255,.7)'}`}
      >
        <span>{n.label}</span>
        <span data-nav-badge={n.key} hidden style="padding:2px 8px;border-radius:999px;background:var(--accent);color:var(--contrast);font-size:11px;font-weight:800"></span>
      </a>
    ))}
    <div style="margin-top:auto;padding-top:18px;display:flex;flex-direction:column;gap:8px">
      <div style="padding:12px;border-radius:10px;background:rgba(255,255,255,.08);font-size:12px;font-weight:700;color:rgba(255,255,255,.72);line-height:1.45">
        Signed in as<br /><span id="admin-shell-email" style="color:#fff">…</span>
      </div>
      <button id="admin-shell-logout" type="button" style="padding:11px 13px;border:1.5px solid rgba(255,255,255,.28);border-radius:10px;background:transparent;color:#fff;font-size:13px;font-weight:800;cursor:pointer;text-align:left">Sign out</button>
    </div>
  </aside>

  <div style="min-width:0;display:flex;flex-direction:column">
    <div style="background:#fff;border-bottom:2px solid var(--border);padding:16px 22px;display:flex;align-items:center;gap:14px;flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:14px;flex:1 1 200px;min-width:200px">
        <button id="admin-sidebar-open" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="admin-sidebar" style="align-items:center;justify-content:center;width:40px;height:40px;border:2px solid var(--border);border-radius:10px;background:#fff;color:var(--navy);cursor:pointer;flex-shrink:0">
          <Icon path='<path d="M4 7h16M4 12h16M4 17h16"/>' size={19} />
        </button>
        <div>
          <h1 style="margin:0;font-size:21px;letter-spacing:-.025em;color:var(--navy)">{title}</h1>
          <p style="margin:3px 0 0;font-size:13px;font-weight:600;color:var(--muted)">{subtitle}</p>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:9px;margin-left:auto;flex-wrap:wrap">
        <span style="display:inline-flex;align-items:center;gap:6px;padding:7px 11px;border-radius:999px;background:var(--bg-subtle);font-size:12px;font-weight:800;color:var(--accent-hover)">Managing {site.cityLabel}</span>
        <a href="/" style="padding:11px 14px;border:2px solid var(--border);border-radius:10px;background:#fff;color:var(--navy);font-size:13px;font-weight:800;text-decoration:none">View site</a>
      </div>
    </div>

    <div style="padding:22px;display:flex;flex-direction:column;gap:18px">
      <slot />
    </div>
  </div>
</div>

<style>
  #admin-sidebar a:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  /* Grid columns live here, not as an inline style on #admin-shell —
     an inline style attribute always beats a <style> block rule
     (media query or not, whatever its specificity), so the
     min-width:860px override below could never actually take effect
     while this was inline. That's what let the sidebar collapse to
     min-height:100vh at desktop width while the grid stayed
     single-column, pushing the dashboard content below the sidebar's
     full viewport height instead of beside it. */
  #admin-shell {
    grid-template-columns: 1fr;
  }
  /* Below 860px the sidebar becomes an off-canvas panel opened by the
     topbar's hamburger button, instead of stacking inline above the
     content (which used to push the dashboard tables far down the page
     on mobile). */
  #admin-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: 260px;
    max-width: 82vw;
    z-index: 40;
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.22s ease;
  }
  #admin-sidebar.open {
    transform: translateX(0);
  }
  #admin-sidebar-open {
    display: inline-flex;
  }
  #admin-sidebar-close {
    display: inline-flex;
  }
  @media (min-width: 860px) {
    #admin-shell {
      grid-template-columns: 236px 1fr;
    }
    #admin-sidebar,
    #admin-sidebar.open {
      position: static;
      transform: none;
      min-height: 100vh;
      max-width: none;
    }
    #admin-sidebar-backdrop {
      display: none;
    }
    #admin-sidebar-open,
    #admin-sidebar-close {
      display: none;
    }
  }
</style>

<script>
  // Every admin page already fetches /api/me itself to gate access — this
  // just also fills in the shell's "signed in as" footer + wires sign-out,
  // so it doesn't have to be duplicated in every page's own script.
  fetch('/api/me')
    .then((r) => (r.ok ? r.json() : null))
    .then((data) => {
      const el = document.getElementById('admin-shell-email');
      if (el && data?.email) el.textContent = data.email;
    })
    .catch(() => {});

  document.getElementById('admin-shell-logout')?.addEventListener('click', async () => {
    await fetch('/api/logout', { method: 'POST' });
    window.location.href = '/';
  });

  // Nav badges — pending-count pills next to Submissions/Claims/Reports,
  // matching the mockup's sidebar badges. Every admin page already loads
  // this shell, so one fetch here covers all of them rather than each
  // page computing its own counts redundantly.
  fetch('/api/admin/overview')
    .then((r) => (r.ok ? r.json() : null))
    .then((data) => {
      if (!data?.ok) return;
      const counts: Record<string, number> = {
        submissions: data.stats.pendingSubmissions,
        claims: data.stats.pendingClaims,
        reports: data.stats.openReports,
      };
      for (const [key, count] of Object.entries(counts)) {
        if (!count) continue;
        const badge = document.querySelector(`[data-nav-badge="${key}"]`) as HTMLElement | null;
        if (badge) {
          badge.textContent = String(count);
          badge.hidden = false;
        }
      }
    })
    .catch(() => {});

  // Hamburger toggle for the off-canvas sidebar (<860px — see the
  // @media rule above that hides it and pins the sidebar static past that).
  const sidebar = document.getElementById('admin-sidebar');
  const backdrop = document.getElementById('admin-sidebar-backdrop');
  const openBtn = document.getElementById('admin-sidebar-open');
  const closeBtn = document.getElementById('admin-sidebar-close');

  function openSidebar() {
    sidebar?.classList.add('open');
    if (backdrop) backdrop.hidden = false;
    openBtn?.setAttribute('aria-expanded', 'true');
  }
  function closeSidebar() {
    sidebar?.classList.remove('open');
    if (backdrop) backdrop.hidden = true;
    openBtn?.setAttribute('aria-expanded', 'false');
  }

  openBtn?.addEventListener('click', openSidebar);
  closeBtn?.addEventListener('click', closeSidebar);
  backdrop?.addEventListener('click', closeSidebar);
  // If the viewport grows past the breakpoint (sidebar becomes a static
  // column via CSS), drop the open state so it isn't left open-but-static
  // underneath, then stuck mid-transition if the window shrinks back.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 860) closeSidebar();
  });
</script>
