---
// "Show password" tick box for auth forms. Place it inside a <form> after
// the password field(s): ticking shows every password input in that form as
// plain text, unticking hides them again. Before the form submits the fields
// are switched back to type="password" so password managers still treat
// them as passwords. `plural` changes the label to "Show passwords".
interface Props {
  plural?: boolean;
}
const { plural = false } = Astro.props;
---

<label class="show-pw">
  <input type="checkbox" data-show-password />
  {plural ? 'Show passwords' : 'Show password'}
</label>

<script>
  document.querySelectorAll<HTMLInputElement>('input[data-show-password]').forEach((box) => {
    const form = box.closest('form');
    if (!form) return;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[type="password"]'));
    const apply = () => fields.forEach((f) => { f.type = box.checked ? 'text' : 'password'; });
    box.checked = false;
    box.addEventListener('change', apply);
    // Capture phase so this runs before the page's own submit handler.
    form.addEventListener('submit', () => { box.checked = false; apply(); }, true);
  });
</script>

<style>
  .show-pw {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: flex-start;
    margin-top: -0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    user-select: none;
  }
  .show-pw input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .show-pw input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
