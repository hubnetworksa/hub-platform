---
// Matches the mockup's "Featured"/"Verified" pill styling exactly.
// Basic (tier 0) renders nothing — there's no badge for the free plan
// anywhere in the design. The mockup actually uses two different visual
// treatments for a Featured badge depending on context — a solid pill on
// results/profile pages, a softer tinted pill on the homepage's featured
// row — plus a longer label ("Featured listing") on the business profile
// page specifically. `variant`/`label` let callers match either without
// forking the component.
interface Props {
  tier: number;
  variant?: 'solid' | 'light';
  label?: string;
}
const { tier, variant = 'solid', label } = Astro.props;
const featuredBg = variant === 'light' ? 'rgba(var(--accent-rgb),.12)' : 'var(--accent)';
const featuredColor = variant === 'light' ? 'var(--accent-hover)' : 'var(--contrast)';
---

{tier >= 2 && (
  <span style={`display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:999px;background:${featuredBg};color:${featuredColor};font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase`}>{label ?? 'Featured'}</span>
)}
{tier === 1 && (
  <span style="display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:999px;background:rgba(var(--accent-rgb),.12);color:var(--accent-hover);font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase">Verified</span>
)}
