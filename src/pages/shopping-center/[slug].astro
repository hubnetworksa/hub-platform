---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import PageBanner from '../../components/PageBanner.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StatTile from '../../components/StatTile.astro';
import SponsorSlot from '../../components/SponsorSlot.astro';
import { shoppingCenters, suburbs, businessesInShoppingCenter, categoriesFor, FEATURED_TIER } from '../../lib/data';
import { collectionPageJsonLd } from '../../lib/seo';
import { synonymsFor } from '../../lib/categorySynonyms';
import site from '../../site';

export function getStaticPaths() {
  return shoppingCenters
    .filter((c) => businessesInShoppingCenter(c.id).length > 0)
    .map((center) => ({ params: { slug: center.slug }, props: { center } }));
}

const { center } = Astro.props;
const businesses = businessesInShoppingCenter(center.id);
const suburb = center.suburb_id != null ? suburbs.find((s) => s.id === center.suburb_id) : undefined;

const centerUrl = `https://${site.domain}/shopping-center/${center.slug}/`;

// Union of every tenant's category synonyms (e.g. a mall with a pharmacy
// and a hair salon picks up "chemist"/"hairdresser" too) — same reasoning
// as business/[slug].astro's own keywords field: costs nothing, widens
// what this page can match beyond its own literal name/description.
const keywords = [...new Set(businesses.flatMap((b) => categoriesFor(b).flatMap((c) => synonymsFor(c.slug))))];

const centerJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ShoppingCenter',
  name: center.name,
  url: centerUrl,
  ...(center.description ? { description: center.description } : {}),
  ...(center.address
    ? { address: { '@type': 'PostalAddress', streetAddress: center.address, addressLocality: suburb?.name ?? site.cityLabel, addressRegion: site.province, addressCountry: 'ZA' } }
    : {}),
  ...(center.lat && center.lng ? { geo: { '@type': 'GeoCoordinates', latitude: center.lat, longitude: center.lng } } : {}),
  ...(keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
};

const tenantsJsonLd = collectionPageJsonLd({
  name: `Businesses at ${center.name}`,
  url: centerUrl,
  items: businesses.map((b) => ({ name: b.name, url: `https://${site.domain}/business/${b.slug}/` })),
});

const featuredStores = businesses.filter((b) => b.subscription_tier >= FEATURED_TIER);
// Sort Featured stores first so the pinned/highlighted cards lead the grid.
const sortedBusinesses = [...businesses].sort((a, b) => b.subscription_tier - a.subscription_tier);
---

<BaseLayout
  title={center.name}
  description={center.description ?? `${businesses.length} businesses at ${center.name}, ${site.cityLabel}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(centerJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(tenantsJsonLd)} />

  <PageBanner title={center.name} description={`${businesses.length} businesses listed here.`}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Shopping Centres', href: '/shopping-center/' },
        ...(suburb ? [{ label: suburb.name, href: `/suburb/${suburb.slug}/` }] : []),
        { label: center.name },
      ]}
    />
  </PageBanner>

  <section class="stats-band">
    <div class="container stat-strip stat-strip-on-navy">
      <StatTile value={String(businesses.length)} label="Stores listed" />
      <StatTile value={center.type === 'mall' ? 'Mall' : 'Fuel station'} label="Centre type" />
      <StatTile value={suburb?.name ?? '—'} label="Suburb" />
      <StatTile value={String(featuredStores.length)} label="Featured stores" />
    </div>
  </section>

  <section class="container" style="padding-top: 2rem; padding-bottom: 3rem;">
    {center.description && <p class="center-desc">{center.description}</p>}
    {center.address && <p style="color: var(--text-muted); margin-top: 0;">{center.address}</p>}
    <div class="business-grid">
      {sortedBusinesses.map((business) => (
        <BusinessCard
          business={business}
          listContext={{ kind: 'shopping-center', slug: center.slug, name: center.name }}
        />
      ))}
    </div>

    <div class="centre-management">
      <div>
        <h2>Sponsor this centre</h2>
        <p class="text-muted">Put your business in front of everyone browsing {center.name} — one sponsor at a time.</p>
      </div>
      <SponsorSlot productType="centre_sponsor" target={center.slug} label="centre sponsor" />
    </div>
  </section>
</BaseLayout>

<style>
  .center-desc {
    max-width: 68ch;
    margin: 0 0 0.4rem;
    line-height: 1.65;
    color: var(--text);
  }
  .business-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .centre-management {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .centre-management h2 {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
  }
  .centre-management p {
    margin: 0;
    max-width: 46ch;
  }
  .centre-management :global(.sponsor-slot) {
    min-width: 260px;
  }
</style>
