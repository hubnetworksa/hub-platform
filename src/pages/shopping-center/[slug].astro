---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import StatTile from '../../components/StatTile.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { shoppingCenters, suburbs, businessesInShoppingCenter, categoriesFor, FEATURED_TIER, sponsorFor, priceRand } from '../../lib/data';
import { collectionPageJsonLd } from '../../lib/seo';
import { synonymsFor } from '../../lib/categorySynonyms';
import site from '../../site';

export function getStaticPaths() {
  return shoppingCenters
    .filter((c) => businessesInShoppingCenter(c.id).length > 0)
    .map((center) => ({ params: { slug: center.slug }, props: { center } }));
}

const { center } = Astro.props;
const businesses = businessesInShoppingCenter(center.id);
const suburb = center.suburb_id != null ? suburbs.find((s) => s.id === center.suburb_id) : undefined;

const centerUrl = `https://${site.domain}/shopping-center/${center.slug}/`;

const keywords = [...new Set(businesses.flatMap((b) => categoriesFor(b).flatMap((c) => synonymsFor(c.slug))))];

const centerJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ShoppingCenter',
  name: center.name,
  url: centerUrl,
  ...(center.description ? { description: center.description } : {}),
  ...(center.address
    ? { address: { '@type': 'PostalAddress', streetAddress: center.address, addressLocality: suburb?.name ?? site.cityLabel, addressRegion: site.province, addressCountry: 'ZA' } }
    : {}),
  ...(center.lat && center.lng ? { geo: { '@type': 'GeoCoordinates', latitude: center.lat, longitude: center.lng } } : {}),
  ...(keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
};

const tenantsJsonLd = collectionPageJsonLd({
  name: `Businesses at ${center.name}`,
  url: centerUrl,
  items: businesses.map((b) => ({ name: b.name, url: `https://${site.domain}/business/${b.slug}/` })),
});

const featuredStores = businesses.filter((b) => b.subscription_tier >= FEATURED_TIER);
const pinned = featuredStores[0];
const rest = businesses.filter((b) => b !== pinned);
const heroSrc = site.sectionBannerImage;
const centreSponsor = sponsorFor('centre_sponsor', center.slug);
---

<BaseLayout
  title={center.name}
  description={center.description ?? `${businesses.length} businesses at ${center.name}, ${site.cityLabel}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(centerJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(tenantsJsonLd)} />

  <main>
    <section style="position:relative;background:var(--navy);overflow:hidden;min-height:clamp(200px,26vw,320px)">
      <img src={heroSrc} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 55%" />
      <div style="position:absolute;inset:0;background:linear-gradient(100deg,rgba(var(--navy-rgb),.93) 0%,rgba(var(--navy-rgb),.72) 52%,rgba(var(--navy-rgb),.2) 100%)"></div>
      <div style="position:relative;max-width:1200px;margin:0 auto;padding:26px 20px 32px">
        <Breadcrumbs
          variant="plain"
          onDark
          items={[{ label: 'Home', href: '/' }, { label: 'Shopping centres', href: '/shopping-center/' }, { label: center.name }]}
        />
        <h1 style="margin:14px 0 10px;color:#fff;font-size:clamp(28px,4.6vw,46px);letter-spacing:-.03em;line-height:1.04;max-width:22ch">{center.name}</h1>
        <p style="margin:0;color:rgba(255,255,255,.86);font-size:15.5px;max-width:56ch;line-height:1.55">{center.address ?? center.description}</p>
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:22px 20px 60px">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:2px;background:var(--border);border:1px solid var(--border);border-radius:12px;overflow:hidden">
        <div style="background:#fff;padding:16px"><StatTile variant="light" value={String(businesses.length)} label="Stores listed" /></div>
        <div style="background:#fff;padding:16px"><StatTile variant="light" value={center.type === 'mall' ? 'Mall' : 'Fuel station'} label="Centre type" /></div>
        <div style="background:#fff;padding:16px"><StatTile variant="light" value={suburb?.name ?? '—'} label="Suburb" /></div>
        <div style="background:#fff;padding:16px"><StatTile variant="light" value={String(featuredStores.length)} label="Featured stores" color="var(--accent)" /></div>
      </div>

      {center.description && <p style="max-width:68ch;margin:24px 0 0;line-height:1.65;color:var(--text)">{center.description}</p>}

      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-bottom:2px solid var(--navy);padding-bottom:12px;margin-top:30px;flex-wrap:wrap">
        <h2 style="margin:0;font-size:clamp(20px,2.8vw,26px);letter-spacing:-.02em;color:var(--navy)">Stores in this centre</h2>
        <span style="font-size:12.5px;font-weight:700;color:var(--muted)">Featured stores shown first</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px;margin-top:18px">
        {pinned && <BusinessCard business={pinned} listContext={{ kind: 'shopping-center', slug: center.slug, name: center.name }} />}
        {rest.map((business) => (
          <BusinessCard business={business} listContext={{ kind: 'shopping-center', slug: center.slug, name: center.name }} />
        ))}
      </div>

      <div style="margin-top:28px;border:2px solid var(--navy);border-radius:16px;overflow:hidden;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
        <div style="background:var(--navy);padding:24px">
          <h3 style="margin:0 0 8px;color:#fff;font-size:22px;letter-spacing:-.02em">Centre management</h3>
          <p style="margin:0;color:rgba(255,255,255,.8);font-size:14.5px;line-height:1.55">Sponsor your whole centre page — your branding at the top, every store listed underneath.</p>
        </div>
        <div style="background:#fff;padding:24px;display:flex;flex-direction:column;gap:12px;justify-content:center">
          {centreSponsor ? (
            <>
              <span style="font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--accent)">Currently sponsored by</span>
              <a href={`/business/${centreSponsor.business_slug}/`} style="font-size:20px;font-weight:800;color:var(--navy);text-decoration:none">{centreSponsor.business_name}</a>
            </>
          ) : (
            <>
              <span style="font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--accent)">Centre sponsorship from</span>
              <span style="font-size:26px;font-weight:800;color:var(--navy);letter-spacing:-.02em">{priceRand('price_sponsor_centre_cents')} <span style="font-size:14px;font-weight:700;color:var(--muted)">/ month</span></span>
              <a href="/pricing/" style="align-self:flex-start;padding:11px 18px;border-radius:9px;background:var(--accent);color:var(--contrast);font-size:13.5px;font-weight:800;text-decoration:none">Enquire</a>
            </>
          )}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
