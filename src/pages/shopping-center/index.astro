---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { shoppingCenters, suburbs, businessesInShoppingCenter, type ShoppingCenter } from '../../lib/data';
import { collectionPageJsonLd } from '../../lib/seo';
import site from '../../site';

// Grouped by suburb rather than sorted alphabetically/by count: people
// search this page the way they search anything else on the site —
// "malls in <suburb>", "shopping centres in <suburb>" — by area first, not
// by mall name. Grouping this way also gives each suburb its own heading
// text for that kind of location-based search.
const suburbById = new Map(suburbs.map((s) => [s.id, s]));

const bySuburb = new Map<string, { name: string; slug: string; centers: { center: ShoppingCenter; count: number }[] }>();
for (const center of shoppingCenters) {
  const count = businessesInShoppingCenter(center.id).length;
  if (count === 0) continue;
  const suburb = center.suburb_id != null ? suburbById.get(center.suburb_id) : undefined;
  const key = suburb?.slug ?? 'other';
  if (!bySuburb.has(key)) bySuburb.set(key, { name: suburb?.name ?? 'Other areas', slug: key, centers: [] });
  bySuburb.get(key)!.centers.push({ center, count });
}

const suburbGroups = [...bySuburb.values()]
  .map((group) => ({ ...group, centers: group.centers.sort((a, b) => a.center.name.localeCompare(b.center.name)) }))
  .sort((a, b) => a.name.localeCompare(b.name));

const totalCenters = suburbGroups.reduce((sum, g) => sum + g.centers.length, 0);

const jsonLd = collectionPageJsonLd({
  name: 'Shopping Centres & Malls',
  description: `${totalCenters} shopping centres and malls across ${site.cityLabel}, by suburb.`,
  url: `https://${site.domain}/shopping-center/`,
  items: suburbGroups.flatMap((group) =>
    group.centers.map(({ center }) => ({ name: center.name, url: `https://${site.domain}/shopping-center/${center.slug}/` }))
  ),
});
---

<BaseLayout
  title="Shopping Centres & Malls"
  description={`Browse ${site.cityLabel} shopping centres and malls by suburb — find every mall in a specific area, or a business by the specific centre it's located at.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main>
    <section style="position:relative;background:var(--navy);overflow:hidden">
      <img src={site.sectionBannerImage} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%" />
      <div style="position:absolute;inset:0;background:linear-gradient(105deg,rgba(var(--navy-rgb),.94) 0%,rgba(var(--navy-rgb),.82) 42%,rgba(var(--navy-rgb),.34) 78%,rgba(var(--navy-rgb),.12) 100%)"></div>
      <div style="position:relative;max-width:1200px;margin:0 auto;padding:clamp(30px,5vw,54px) 20px clamp(26px,4vw,38px)">
        <h1 style="margin:0 0 10px;color:#fff;font-size:clamp(28px,4.6vw,44px);letter-spacing:-.03em;line-height:1.05">Shopping Centres &amp; Malls</h1>
        <p style="margin:0;color:rgba(255,255,255,.86);font-size:15.5px;max-width:58ch;line-height:1.55">{totalCenters} shopping centres and malls across {site.cityLabel}, by suburb.</p>
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:clamp(28px,4vw,44px) 20px 60px">
      {suburbGroups.length === 0 ? (
        <p style="color:var(--muted);">None linked yet.</p>
      ) : (
        suburbGroups.map((group, i) => (
          <div style={i > 0 ? 'margin-top:30px;' : ''}>
            <h2 style="margin:0 0 14px;font-size:18px;letter-spacing:-.02em;color:var(--navy);border-bottom:2px solid var(--navy);padding-bottom:10px;">{group.name}</h2>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;">
              {group.centers.map(({ center, count }) => (
                <a href={`/shopping-center/${center.slug}/`} style="display:flex;flex-direction:column;gap:4px;padding:14px 16px;border:2px solid var(--border);border-radius:12px;background:#fff;text-decoration:none">
                  <strong style="font-size:14.5px;color:var(--navy);font-weight:800;">{center.name}</strong>
                  <span style="color:var(--muted);font-size:12.5px;font-weight:700;">{count} businesses</span>
                </a>
              ))}
            </div>
          </div>
        ))
      )}
    </section>
  </main>
</BaseLayout>
