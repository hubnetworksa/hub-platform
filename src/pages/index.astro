---
import { adsEnabled } from '../lib/site-overrides';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import Icon from '../components/Icon.astro';
import StatTile from '../components/StatTile.astro';
import PlanBadge from '../components/PlanBadge.astro';
import BusinessLogo from '../components/BusinessLogo.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { sponsorFor, withoutSponsors, eventsSorted, eventDateParts, logoFor, cardBlurbFor, whatsappFor } from '../lib/data';
import { suburbs, categories, businesses, businessesInSuburb, businessesInCategory, suburbFor, categoriesFor, FEATURED_TIER, newsSorted, newsDateShort, latestFuel, fuelPeriodLabel } from '../lib/data';
import { CATEGORY_GROUPS } from '../lib/categoryGroups';
import site from '../site';
import { formatPhoneZA, phoneHref } from '../lib/phone';
import AdUnit from '../components/AdUnit.astro';

const groupCount = (group: (typeof CATEGORY_GROUPS)[number]) =>
  categories
    .filter((c) => group.categorySlugs.includes(c.slug))
    .reduce((sum, c) => sum + businessesInCategory(c.id).length, 0);

const topSuburbs = [...suburbs].sort((a, b) => businessesInSuburb(b.id).length - businessesInSuburb(a.id).length).slice(0, 12);

// Popular quick-search chips — the mockup hardcodes a handful of trade
// names; here it's the top categories by listing count, which is the real
// equivalent (always populated, never a category with zero listings).
const popularCategories = [...categories].sort((a, b) => businessesInCategory(b.id).length - businessesInCategory(a.id).length).slice(0, 4);

// Only ever shown once a business is actually Featured — until then this
// section just doesn't render, rather than showing an empty state. See
// business/[slug].astro and the Premium Listings v2 plan for how a
// business gets here.
// Every Featured business is rendered (capped for page weight) and the
// browser shows a random three per visit, so it really is a rotation and
// no Featured customer is permanently stuck below the fold.
// Sponsor card wins: the homepage-banner sponsor already has its own strip
// under the hero, so it is left out of the Featured rotation here.
const bannerSponsor = sponsorFor('homepage_banner');
const bannerBusiness = bannerSponsor ? businesses.find((b) => b.id === bannerSponsor.business_id) : undefined;
const featuredBusinesses = withoutSponsors(businesses.filter((b) => b.subscription_tier >= FEATURED_TIER), bannerSponsor).slice(0, 24);

// Paying to feature an event promises a spot on the homepage as well as the
// top of /events/ — this is that spot. Featured upcoming events only; the
// banner doesn't render at all when there are none.
// Capped at 8 — every featured event rotates through the banner (not just a
// slice), but a dot-indicator row stays sane even if dozens ever get
// featured at once.
const featuredEvents = eventsSorted().filter((e) => e.featured).slice(0, 8);

// WebSite + Organization structured data — Google's documented way to hint
// the bold "sitename" shown in search results (otherwise it falls back to
// the bare domain). No guarantee it switches over, or how fast — this is a
// signal Google re-crawls and applies on its own schedule, not an instant switch.
// City centre point for the "<city> today" weather card (fetched live from
// /api/weather — see functions/api/weather.ts). A site with no entry here
// simply doesn't render the card.
const CITY_COORDS: Record<string, [number, number]> = {
  capetown: [-33.9249, 18.4241],
  pretoria: [-25.7479, 28.2293],
  polokwane: [-23.9045, 29.4689],
};
const cityCoords = CITY_COORDS[site.slug];
const homeNews = newsSorted().slice(0, 4);
const fuel = latestFuel(site.slug);
const rand = (cents: number) => `R${(cents / 100).toFixed(2)}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.siteName,
    url: `https://${site.domain}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.siteName,
    url: `https://${site.domain}/`,
    logo: `https://${site.domain}/logo-icon.png`,
  },
];
// No Google ads anywhere a paid listing or sponsor is shown (BaseLayout's
// noAds pauses AdSense ad requests): this page shows one if this is true.
const showsPaid = featuredBusinesses.length > 0 || !!bannerSponsor || featuredEvents.length > 0;
---

<BaseLayout noAds={showsPaid}
  title={`${site.cityLabel} Business Directory`}
  description={`Find businesses across ${site.cityLabel} and surrounding areas — browse by suburb or category to discover what's nearby.`}
  impactVerification
>
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}

  <main>
    <section style="position:relative;background:var(--navy);overflow:hidden">
      <img src={site.bannerImage} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%" />
      <div style="position:absolute;inset:0;background:linear-gradient(105deg,rgba(var(--navy-rgb),.94) 0%,rgba(var(--navy-rgb),.82) 42%,rgba(var(--navy-rgb),.34) 78%,rgba(var(--navy-rgb),.12) 100%)"></div>
      <div style="position:relative;max-width:1200px;margin:0 auto;padding:clamp(40px,7vw,86px) 20px clamp(28px,4vw,44px)">
        <span style="display:inline-flex;align-items:center;gap:7px;padding:6px 12px;border:1.5px solid rgba(255,255,255,.34);border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#fff">{site.cityLabel} &amp; surrounds</span>
        <h1 style="margin:18px 0 14px;color:#fff;font-size:clamp(34px,6.4vw,62px);line-height:1.02;letter-spacing:-.03em;max-width:17ch;text-wrap:balance">{site.cityLabel}'s Local Business Directory</h1>
        <p style="margin:0 0 26px;color:rgba(255,255,255,.88);font-size:clamp(15px,1.7vw,18.5px);max-width:72ch;line-height:1.5">Discover. Connect. Grow. — local businesses <span style="white-space:nowrap">on {site.siteName}</span></p>

        <SearchBox />

        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:16px">
          <span style="font-size:12px;font-weight:700;color:rgba(255,255,255,.62);align-self:center;letter-spacing:.06em;text-transform:uppercase">Popular</span>
          {popularCategories.map((c) => (
            <a href={`/category/${c.slug}/`} style="padding:7px 13px;border-radius:999px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.26);color:#fff;font-size:13px;font-weight:700;text-decoration:none">{c.name}</a>
          ))}
        </div>
      </div>
    </section>

    {bannerSponsor && (
      <section style="background:var(--bg-subtle);border-bottom:2px solid var(--border)">
        <a href={`/business/${bannerSponsor.business_slug}/`} class="home-banner-sponsor" style="max-width:1200px;margin:0 auto;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;color:var(--navy);text-decoration:none">
          <span style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span style="padding:3px 9px;border-radius:999px;background:var(--navy);color:#fff;font-size:9.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase">Homepage sponsor</span>
            {bannerBusiness && <BusinessLogo business={bannerBusiness} size="sm" />}
            <span style="font-size:16px;font-weight:800;letter-spacing:-.015em">{bannerSponsor.business_name}</span>
          </span>
          <span style="font-size:13px;font-weight:800;color:var(--accent-hover)">View listing →</span>
        </a>
      </section>
    )}

    <section style="background:var(--navy);border-top:1px solid rgba(255,255,255,.12)">
      <div style="max-width:1200px;margin:0 auto;padding:0 20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
        <div style="padding:22px 18px 22px 0;border-right:1px solid rgba(255,255,255,.14)">
          <StatTile value={businesses.length.toLocaleString()} label="Live listings" />
        </div>
        <div style="padding:22px 18px;border-right:1px solid rgba(255,255,255,.14)">
          <StatTile value={suburbs.length.toLocaleString()} label="Suburbs covered" />
        </div>
        <div style="padding:22px 0 22px 18px">
          <StatTile value={categories.length.toLocaleString()} label="Categories" />
        </div>
      </div>
    </section>

    {featuredBusinesses.length > 0 && (
      <section style="max-width:1200px;margin:0 auto;padding:clamp(34px,5vw,60px) 20px 0">
        <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-bottom:2px solid var(--navy);padding-bottom:12px;flex-wrap:wrap">
          <div>
            <span style="font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)">Featured this month</span>
            <h2 style="margin:8px 0 0;font-size:clamp(22px,3vw,30px);letter-spacing:-.025em;color:var(--navy)">Premium Local Businesses</h2>
          </div>
          <a href="/pricing/" style="font-size:13.5px;font-weight:800;color:var(--accent);white-space:nowrap;text-decoration:none">Get this spot →</a>
        </div>
        <div id="home-featured-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:20px">
          {featuredBusinesses.map((b, i) => {
            const suburb = suburbFor(b);
            // With a logo, the logo is a left column and the name, meta,
            // description and buttons all sit beside it.
            const hasLogo = !!logoFor(b);
            const IdWrap = hasLogo ? 'div' : Fragment;
            const IdBody = hasLogo ? 'div' : Fragment;
            return (
              <article class="home-featured-card" data-rotate hidden={i >= 3} style="border:2px solid var(--border);border-radius:14px;background:#fff;overflow:hidden;display:flex;flex-direction:column">
                <div style="height:6px;background:var(--accent)"></div>
                <div style="padding:18px 18px 20px;display:flex;flex-direction:column;gap:10px;flex:1">
                  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                    <PlanBadge tier={b.subscription_tier} variant="light" />
                    <span style="display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:800;color:var(--accent-hover)">
                      <Icon path="<circle cx='12' cy='12' r='9'/><path d='m8.5 12.5 2.5 2.5 5-5'/>" size={13} />
                      Verified
                    </span>
                  </div>
                  <IdWrap {...(hasLogo ? { class: 'biz-split biz-split--stack-phone', style: 'flex:1' } : {})}>
                  <BusinessLogo business={b} size="card" />
                  <IdBody {...(hasLogo ? { class: 'biz-split-body', style: 'gap:10px' } : {})}>
                  <h3 style="margin:0;font-size:19px;line-height:1.2;letter-spacing:-.02em;color:var(--navy)">{b.name}</h3>
                  {(categoriesFor(b)[0] || suburb) && (
                    <p style="margin:0;font-size:13.5px;color:var(--muted);font-weight:600">{[categoriesFor(b)[0]?.name, suburb?.name].filter(Boolean).join(' · ')}</p>
                  )}
                  {cardBlurbFor(b) && <p class="desc-clamp" style="margin:0;font-size:14px;line-height:1.55;color:var(--text)" set:html={cardBlurbFor(b)} />}
                  <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:auto;padding-top:6px">
                    <a href={`/business/${b.slug}/`} style="flex:1;padding:10px 12px;border-radius:9px;background:var(--navy);color:#fff;font-size:13px;font-weight:800;text-decoration:none;text-align:center;white-space:nowrap">View profile</a>
                    {b.phone && <a href={phoneHref(b.phone)} data-track="phone_click" data-track-slug={b.slug} style={`${whatsappFor(b) ? 'flex:1 1 auto;text-align:center;' : ''}padding:10px 12px;border-radius:9px;border:2px solid var(--border);color:var(--navy);font-size:13px;font-weight:800;text-decoration:none;white-space:nowrap`}>{formatPhoneZA(b.phone)}</a>}
                    <WhatsAppButton business={b} grow />
                  </div>
                  </IdBody>
                  </IdWrap>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <section style="max-width:1200px;margin:0 auto;padding:clamp(34px,5vw,60px) 20px 0">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-bottom:2px solid var(--navy);padding-bottom:12px;flex-wrap:wrap">
        <div>
          <span style="font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)">Browse</span>
          <h2 style="margin:8px 0 0;font-size:clamp(22px,3vw,30px);letter-spacing:-.025em;color:var(--navy)">What are you looking for?</h2>
        </div>
        <a href="/category/" style="font-size:13.5px;font-weight:800;color:var(--accent);white-space:nowrap;text-decoration:none">All {categories.length} categories →</a>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-top:20px">
        {CATEGORY_GROUPS.map((group) => (
          <a href={`/section/${group.slug}/`} class="home-category-tile" style="display:flex;flex-direction:column;gap:6px;padding:18px;border:2px solid var(--border);border-radius:14px;background:#fff;min-height:118px;text-decoration:none">
            <span style="color:var(--accent)"><Icon path={group.iconPath} size={26} /></span>
            <span style="margin-top:auto;font-size:15.5px;font-weight:800;letter-spacing:-.01em;color:var(--navy);line-height:1.2">{group.name}</span>
            <span style="font-size:12.5px;font-weight:700;color:var(--muted)">{groupCount(group)} businesses</span>
          </a>
        ))}
      </div>
    </section>

    {adsEnabled && !showsPaid && (
      <AdUnit placement="homeInContent" style="max-width:1200px;margin:0 auto;padding:clamp(28px,4vw,44px) 20px 0" />
    )}

    {featuredEvents.length > 0 && (
      <section style="max-width:1200px;margin:0 auto;padding:clamp(34px,5vw,56px) 20px 0">
        <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-bottom:2px solid var(--navy);padding-bottom:12px;flex-wrap:wrap">
          <h2 style="margin:0;font-size:clamp(22px,3vw,30px);letter-spacing:-.025em;color:var(--navy)">Featured events</h2>
          <a href="/events/" style="font-size:13.5px;font-weight:800;color:var(--accent);white-space:nowrap;text-decoration:none">All events →</a>
        </div>
        <div id="home-events-carousel" style="position:relative;margin-top:18px;border:2px solid var(--border);border-radius:14px;background:#fff;overflow:hidden">
          <div id="home-events-track" style="display:flex;transition:transform .5s ease">
            {featuredEvents.map((e, i) => {
              const { month, day, weekday } = eventDateParts(e);
              return (
                <a href={`/events/${e.slug}/`} class="home-event-slide" aria-hidden={i === 0 ? 'false' : 'true'} tabindex={i === 0 ? 0 : -1} style="flex:0 0 100%;position:relative;display:flex;flex-direction:column;justify-content:flex-end;min-height:clamp(260px,32vw,320px);padding:clamp(18px,3.6vw,30px);text-decoration:none;min-width:0;overflow:hidden">
                  <span style={`position:absolute;inset:0;display:block;${e.image_url ? 'background:var(--navy)' : 'background:linear-gradient(135deg,var(--navy) 0%,rgba(var(--navy-rgb),.88) 55%,rgba(var(--accent-rgb),.5) 100%)'}`}>
                    {e.image_url && <img src={e.image_url} alt="" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block" />}
                  </span>
                  <span style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(var(--navy-rgb),.1) 0%,rgba(var(--navy-rgb),.18) 32%,rgba(var(--navy-rgb),.8) 70%,rgba(var(--navy-rgb),.95) 100%);pointer-events:none"></span>
                  <span style="position:absolute;top:16px;left:16px;display:flex;flex-direction:column;align-items:center;padding:8px 14px;border-radius:10px;background:var(--accent);color:var(--contrast);box-shadow:0 4px 14px rgba(0,0,0,.28)">
                    <span style="font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;opacity:.85">{month}</span>
                    <span style="font-size:24px;font-weight:800;line-height:1">{day}</span>
                    <span style="font-size:10.5px;font-weight:700;opacity:.85">{weekday}</span>
                  </span>
                  <span style="position:relative;min-width:0;font-size:clamp(19px,2.6vw,27px);font-weight:800;color:#fff;letter-spacing:-.02em;line-height:1.15;text-shadow:0 2px 10px rgba(0,0,0,.55);text-wrap:pretty">{e.title}</span>
                  {(e.venue || e.suburb) && <span style="position:relative;min-width:0;font-size:14.5px;font-weight:700;color:rgba(255,255,255,.92);text-shadow:0 1px 5px rgba(0,0,0,.55);margin-top:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{[e.venue, e.suburb].filter(Boolean).join(' · ')}</span>}
                  <span style="position:relative;font-size:15.5px;font-weight:800;color:#fff;text-shadow:0 1px 5px rgba(0,0,0,.55);margin-top:4px">{e.price}</span>
                </a>
              );
            })}
          </div>
          {featuredEvents.length > 1 && (
            <>
              <button type="button" id="home-events-prev" aria-label="Previous featured event" style="position:absolute;top:50%;left:10px;transform:translateY(-50%);width:36px;height:36px;border-radius:999px;border:2px solid var(--border);background:#fff;color:var(--navy);font-size:18px;font-weight:800;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0">‹</button>
              <button type="button" id="home-events-next" aria-label="Next featured event" style="position:absolute;top:50%;right:10px;transform:translateY(-50%);width:36px;height:36px;border-radius:999px;border:2px solid var(--border);background:#fff;color:var(--navy);font-size:18px;font-weight:800;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0">›</button>
              <div style="display:flex;justify-content:center;gap:7px;padding:0 0 14px">
                {featuredEvents.map((_, i) => (
                  <button type="button" class="home-events-dot" data-dot-index={i} aria-label={`Go to featured event ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} style="width:8px;height:8px;border-radius:999px;border:none;padding:0;background:var(--border);cursor:pointer"></button>
                ))}
              </div>
            </>
          )}
        </div>
      </section>
    )}

    {(cityCoords || homeNews.length > 0 || fuel) && (
      <section id="today" hidden={homeNews.length === 0 && !fuel} data-lat={cityCoords?.[0]} data-lon={cityCoords?.[1]} style="max-width:1200px;margin:0 auto;padding:clamp(30px,4.5vw,50px) 20px 0">
        <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-bottom:2px solid var(--navy);padding-bottom:12px;flex-wrap:wrap">
          <h2 style="margin:0;font-size:clamp(22px,3vw,30px);letter-spacing:-.025em;color:var(--navy)">{site.cityLabel} today</h2>
          {homeNews.length > 0 && <a href="/news/" style="font-size:13.5px;font-weight:800;color:var(--accent);white-space:nowrap;text-decoration:none">All local news →</a>}
        </div>
        <div class="today-row" style="display:grid;grid-template-columns:1fr;gap:14px;margin-top:18px;align-items:stretch">
          <div id="today-left" hidden={!fuel} style="display:flex;flex-direction:column;gap:12px;min-width:0">
          {cityCoords && (
            <div id="wx-card" hidden style="min-width:0">
              <div style="border:2px solid var(--border);border-radius:14px;overflow:hidden;background:#fff">
                <div style="padding:14px 16px;display:flex;align-items:center;gap:11px">
                  <span style="flex-shrink:0;color:var(--accent);display:flex">
                    <svg id="wx-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></svg>
                  </span>
                  <span style="min-width:0;display:flex;flex-direction:column;gap:2px">
                    <span id="wx-now" style="font-size:20px;font-weight:800;color:var(--navy);letter-spacing:-.025em;line-height:1.1"></span>
                    <span id="wx-range" style="font-size:11.5px;font-weight:700;color:var(--muted)"></span>
                  </span>
                </div>
                <div id="wx-days" style="display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--border);border-top:1px solid var(--border)"></div>
              </div>
              <p style="margin:8px 0 0;font-size:11px;font-weight:600;color:var(--muted)">Forecast: <a href="https://www.met.no/en" target="_blank" rel="noopener noreferrer" style="color:var(--muted)">MET Norway</a></p>
            </div>
          )}
          {fuel && (
            <div style="border:2px solid var(--border);border-radius:14px;background:#fff;overflow:hidden">
              <div style="padding:11px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px">
                <span style="flex-shrink:0;color:var(--accent);display:flex">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V5a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2v16"></path><path d="M3 21h13"></path><path d="M14 9h3a2 2 0 0 1 2 2v6a1.5 1.5 0 0 0 3 0v-7l-2.5-2.5"></path></svg>
                </span>
                <span style="font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Fuel price</span>
                <span style="margin-left:auto;font-size:10.5px;font-weight:700;color:var(--muted)">{fuelPeriodLabel(fuel.period)} · {fuel.region}</span>
              </div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border)">
                {fuel.rows.map((r) => (
                  <div style="background:#fff;padding:12px 16px;display:flex;flex-direction:column;gap:2px">
                    <span style="font-size:10.5px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)">{r.grade}</span>
                    <span style="font-size:17px;font-weight:800;color:var(--navy);letter-spacing:-.02em">{rand(r.price_cents)}</span>
                    <span style={`font-size:11.5px;font-weight:800;color:${r.change_cents > 0 ? 'var(--danger)' : 'var(--accent-hover)'}`}>{r.change_cents === 0 ? 'No change' : `${r.change_cents > 0 ? '↑' : '↓'} ${Math.abs(r.change_cents)}c`}</span>
                  </div>
                ))}
              </div>
              <p style="margin:0;padding:8px 16px;border-top:1px solid var(--border);font-size:10.5px;font-weight:600;color:var(--muted)">Regulated pump price from the official monthly announcement.</p>
            </div>
          )}
          </div>
          {homeNews.length > 0 && (
            <div style="border:2px solid var(--border);border-radius:14px;background:#fff;overflow:hidden;min-width:0;display:flex;flex-direction:column">
