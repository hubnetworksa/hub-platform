<script>
  // "<city> today" — hidden until the live forecast arrives, so a failed or
  // slow fetch leaves nothing (never placeholder numbers).
  const today = document.getElementById('today');
  if (today) {
    const ICONS: Record<string, string> = {
      sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/>',
      cloud: '<path d="M7 18h10a3.6 3.6 0 0 0 .3-7.2A5.4 5.4 0 0 0 6.9 11 3.5 3.5 0 0 0 7 18Z"/>',
      rain: '<path d="M7 15h10a3.4 3.4 0 0 0 .3-6.8A5.2 5.2 0 0 0 6.9 8.3 3.4 3.4 0 0 0 7 15Z"/><path d="M9 18.5 8 21M13 18.5 12 21M17 18.5 16 21"/>',
    };
    interface Wx {
      ok: boolean;
      now: { temp: number; cond: string; icon: string };
      today: { high: number; low: number };
      days: { day: string; high: number; low: number; icon: string }[];
    }
    fetch(`/api/weather?lat=${today.dataset.lat}&lon=${today.dataset.lon}`)
      .then((r) => (r.ok ? (r.json() as Promise<Wx>) : Promise.reject()))
      .then((w) => {
        if (!w.ok || !w.days?.length) return;
        document.getElementById('wx-icon')!.innerHTML = ICONS[w.now.icon] ?? ICONS.cloud;
        document.getElementById('wx-now')!.textContent = `${w.now.temp}°C · ${w.now.cond}`;
        document.getElementById('wx-range')!.textContent = `${w.today.high}° / ${w.today.low}° today`;
        document.getElementById('wx-days')!.innerHTML = w.days
          .map(
            (d) => `<div style="background:var(--bg-subtle);padding:9px 2px;display:flex;flex-direction:column;align-items:center;gap:4px">
              <span style="font-size:9.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)">${d.day}</span>
              <span style="color:var(--accent);display:flex"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">${ICONS[d.icon] ?? ICONS.cloud}</svg></span>
              <span style="font-size:12px;font-weight:800;color:var(--navy)">${d.high}°</span>
            </div>`,
          )
          .join('');
        document.getElementById('wx-card')!.hidden = false;
        document.getElementById('today-left')!.hidden = false;
        today.hidden = false;
      })
      .catch(() => {});
  }
</script>

<script>
  // Pick three Featured cards at random for this visit.
  const rotating = [...document.querySelectorAll<HTMLElement>('#home-featured-grid [data-rotate]')];
  if (rotating.length > 3) {
    const picks = new Set<number>();
    while (picks.size < 3) picks.add(Math.floor(Math.random() * rotating.length));
    rotating.forEach((el, i) => (el.hidden = !picks.has(i)));
  }

  // Phone clicks from a Featured card count towards the owner's "Phone
  // clicks" tile (see functions/api/track-view.ts), same as on the profile page.
  document.getElementById('home-featured-grid')?.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
    if (!el?.dataset.trackSlug) return;
    try {
      navigator.sendBeacon('/api/track-view', new Blob([JSON.stringify({ businessSlug: el.dataset.trackSlug, event: el.dataset.track })], { type: 'application/json' }));
    } catch {
      // A missed click count is never worth surfacing an error over.
    }
  });
</script>

<script>
  // Featured events banner — rotates automatically through every slide,
  // pausing on hover/keyboard focus and respecting prefers-reduced-motion.
  // With 0 or 1 featured events the prev/next/dot controls simply aren't in
  // the markup (see the Astro guard around them), and this script is a
  // harmless no-op in that case.
  const eventsCarousel = document.getElementById('home-events-carousel');
  const eventsTrack = document.getElementById('home-events-track');
  if (eventsCarousel && eventsTrack) {
    const slides = [...eventsTrack.querySelectorAll<HTMLAnchorElement>('.home-event-slide')];
    const dots = [...eventsCarousel.querySelectorAll<HTMLButtonElement>('.home-events-dot')];
    const prevBtn = document.getElementById('home-events-prev');
    const nextBtn = document.getElementById('home-events-next');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      eventsTrack.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((s, i) => {
        const active = i === index;
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
        s.tabIndex = active ? 0 : -1;
      });
      dots.forEach((d, i) => d.setAttribute('aria-current', i === index ? 'true' : 'false'));
    };

    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };
    const start = () => {
      if (reduceMotion || slides.length < 2) return;
      stop();
      timer = setInterval(() => show(index + 1), 5000); // 5s for now — easy to revisit
    };

    if (slides.length > 1) {
      prevBtn?.addEventListener('click', () => {
        show(index - 1);
        start();
      });
      nextBtn?.addEventListener('click', () => {
        show(index + 1);
        start();
      });
      dots.forEach((d) => {
        d.addEventListener('click', () => {
          show(Number(d.dataset.dotIndex));
          start();
        });
      });
      eventsCarousel.addEventListener('mouseenter', stop);
      eventsCarousel.addEventListener('mouseleave', start);
      eventsCarousel.addEventListener('focusin', stop);
      eventsCarousel.addEventListener('focusout', start);
      start();
    }
  }
</script>

