---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlowProgress from '../../components/FlowProgress.astro';
import { categories, suburbs, shoppingCenters } from '../../lib/data';
import { getFlowPlans } from '../../lib/list-flow-plans';
import site from '../../site';

const plans = getFlowPlans();
const categoryNames = Object.fromEntries(categories.map((c) => [c.slug, c.name]));
const suburbNames = Object.fromEntries(suburbs.map((s) => [s.slug, s.name]));
const centreNames = Object.fromEntries(shoppingCenters.map((c) => [c.slug, c.name]));
---

<BaseLayout
  title="List your business — review"
  description={`Step 3 of 3: check your ${site.siteName} listing, then send it to review.`}
  noindex
>
  <main
    id="flow-root"
    data-plans={JSON.stringify(plans)}
    data-categories={JSON.stringify(categoryNames)}
    data-suburbs={JSON.stringify(suburbNames)}
    data-centres={JSON.stringify(centreNames)}
    data-site-name={site.siteName}
    data-city-label={site.cityLabel}
    data-contact-email={site.contactEmail}
    style="max-width:1200px;margin:0 auto;padding:clamp(22px,3.5vw,42px) 20px 60px"
  >
    <div class="flow-grid" style="display:grid;gap:26px">
      <div style="min-width:0">
        <div id="review-view">
          <span style="font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)">Step 3 of 3</span>
          <h1 style="margin:12px 0 10px;font-size:clamp(26px,4.2vw,42px);letter-spacing:-.03em;line-height:1.05;color:var(--navy);max-width:20ch">Check it, then send it to review</h1>
          <p style="margin:0 0 22px;font-size:16px;line-height:1.6;color:var(--text);max-width:50ch">This is exactly how your listing will appear.</p>
          <FlowProgress step={3} />

          <div style="border:2px solid var(--navy);border-radius:16px;overflow:hidden;background:#fff">
            <div style="padding:10px 16px;background:var(--bg-subtle);font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Preview</div>
            <div style="padding:20px">
              <h2 id="pv-name" style="margin:0 0 8px;font-size:23px;letter-spacing:-.025em;color:var(--navy);overflow-wrap:anywhere"></h2>
              <p id="pv-meta" style="margin:0 0 12px;font-size:13.5px;font-weight:700;color:var(--muted)"></p>
              <p id="pv-desc" style="margin:0 0 16px;font-size:15px;line-height:1.6;color:var(--text);overflow-wrap:anywhere"></p>
              <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:2px;background:var(--border);border:1px solid var(--border);border-radius:11px;overflow:hidden">
                <div style="background:#fff;padding:12px 14px"><div style="font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Phone</div><div id="pv-phone" style="font-size:14px;font-weight:700;margin-top:4px;overflow-wrap:anywhere"></div></div>
                <div style="background:#fff;padding:12px 14px"><div style="font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Address</div><div id="pv-address" style="font-size:14px;font-weight:700;margin-top:4px;overflow-wrap:anywhere"></div></div>
                <div style="background:#fff;padding:12px 14px"><div style="font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Hours</div><div id="pv-hours" style="font-size:14px;font-weight:700;margin-top:4px"></div></div>
              </div>
            </div>
          </div>

          <div style="border:2px solid var(--border);border-radius:14px;padding:18px;margin-top:20px;background:var(--bg-subtle)">
            <h2 style="margin:0 0 10px;font-size:15px;letter-spacing:-.01em;color:var(--navy)">Your plan</h2>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
              <div>
                <div id="plan-title" style="font-size:18px;font-weight:800;color:var(--navy);letter-spacing:-.02em"></div>
                <div id="plan-note" style="font-size:13px;font-weight:700;color:var(--muted);margin-top:3px"></div>
              </div>
              <a href="/pricing/" style="font-size:13.5px;font-weight:800;color:var(--accent);cursor:pointer">Change plan</a>
            </div>
          </div>

          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px">
            <button type="button" id="go-btn" class="btn-primary" style="padding:15px 24px;border:0;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:15px;font-weight:800;cursor:pointer">Continue to payment</button>
            <button type="button" id="back-btn" style="padding:15px 24px;border:2px solid var(--border);border-radius:11px;background:#fff;color:var(--navy);font-size:15px;font-weight:800;cursor:pointer">Back</button>
          </div>
          <p id="form-status" role="status" style="font-size:13.5px;font-weight:600;line-height:1.5;color:var(--muted);margin:14px 0 0"></p>
        </div>

        <div id="done-view" hidden>
          <span style="font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)">Step 3 of 3</span>
          <h1 style="margin:12px 0 10px;font-size:clamp(26px,4.2vw,42px);letter-spacing:-.03em;line-height:1.05;color:var(--navy);max-width:20ch">Sent to review</h1>
          <p style="margin:0 0 22px;font-size:16px;line-height:1.6;color:var(--text);max-width:50ch">We check every submission by hand — usually live within 48 hours.</p>
          <FlowProgress step={3} />
          <div style="border:2px solid var(--navy);border-radius:16px;overflow:hidden;background:#fff">
            <div style="padding:10px 16px;background:var(--bg-subtle);font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Submitted</div>
            <div style="padding:20px">
              <h2 id="done-name" style="margin:0 0 8px;font-size:23px;letter-spacing:-.025em;color:var(--navy);overflow-wrap:anywhere"></h2>
              <p id="done-meta" style="margin:0;font-size:13.5px;font-weight:700;color:var(--muted)"></p>
            </div>
          </div>
          <p id="done-note" style="margin:18px 0 0;font-size:14px;font-weight:600;line-height:1.55;color:var(--text)"></p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px">
            <a href="/my-businesses/" class="btn-primary" style="padding:15px 24px;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:15px;font-weight:800;text-decoration:none">Go to My Businesses</a>
            <a href="/" style="padding:15px 24px;border:2px solid var(--border);border-radius:11px;background:#fff;color:var(--navy);font-size:15px;font-weight:800;text-decoration:none">Back to home</a>
          </div>
        </div>
      </div>
      <aside style="display:flex;flex-direction:column;gap:14px">
        <div style="border:2px solid var(--border);border-radius:14px;padding:20px;background:#fff">
          <h2 style="margin:0 0 10px;font-size:15px;letter-spacing:-.01em;color:var(--navy)">What happens next</h2>
          <ol style="margin:0;padding-left:18px;display:flex;flex-direction:column;gap:8px;font-size:13.5px;line-height:1.5;color:var(--text)">
            <li>We check details against public records.</li>
            <li>You get an email when it's live — usually 48 hours.</li>
            <li>Paid plans apply once the listing publishes. If we can't publish it, you're refunded.</li>
          </ol>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  [hidden] {
    display: none !important;
  }
  .flow-grid {
    grid-template-columns: 1fr;
  }
  @media (min-width: 950px) {
    .flow-grid {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }
  .btn-primary:hover {
    background: var(--accent-hover) !important;
  }
  .btn-primary:disabled {
    opacity: 0.6;
    cursor: default !important;
  }
</style>

<script>
  import {
    loadDraft,
    clearDraft,
    saveResult,
    draftHasBasics,
    buildAddress,
    formatHours,
    buildMailto,
    openMail,
    readPlans,
    readMap,
  } from '../../lib/list-flow-client';

  const root = document.getElementById('flow-root') as HTMLElement;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const plans = readPlans(root);
  const categoryNames = readMap(root, 'data-categories');
  const suburbNames = readMap(root, 'data-suburbs');
  const centreNames = readMap(root, 'data-centres');
  const siteName = root.dataset.siteName || '';
  const cityLabel = root.dataset.cityLabel || '';
  const contactEmail = root.dataset.contactEmail || '';

  const draft = loadDraft();
  // Nothing to review (direct visit / already submitted) — start at step 1.
  if (!draftHasBasics(draft)) window.location.replace('/list-your-business/');

  const plan = plans.find((p) => p.tier === draft.tier) ?? plans[0];
  const paid = plan.tier > 0;
  const categoryName = categoryNames[draft.category] || draft.category;
  const suburbName = suburbNames[draft.suburb] || draft.suburb;
  const centreName = draft.centre ? centreNames[draft.centre] || '' : '';
  const address = buildAddress(draft);
  const hours = formatHours(draft.hours);

  // Same fallback the server stores when no description was given, so the
  // preview really is what gets submitted.
  const description =
    draft.description || `${draft.name} is a business in ${draft.suburb.replace(/-/g, ' ')}, part of the Greater ${cityLabel} area.`;

  $('pv-name').textContent = draft.name;
  $('pv-meta').textContent = `${categoryName} · ${suburbName}`;
  $('pv-desc').textContent = description;
  $('pv-phone').textContent = draft.phone || 'Not provided';
  $('pv-address').textContent = address || 'Not provided';
  $('pv-hours').textContent = hours || 'Not provided';
  $('plan-title').textContent = paid ? `${plan.name} — ${plan.amount}/month` : `${plan.name} — Free`;
  $('plan-note').textContent = plan.summary;
  $('go-btn').textContent = paid ? 'Continue to payment' : 'Send to review';

  $('back-btn').addEventListener('click', () => {
    window.location.href = '/list-your-business/contact/';
  });

  const goBtn = $('go-btn') as HTMLButtonElement;
  const status = $('form-status');

  goBtn.addEventListener('click', async () => {
    goBtn.disabled = true;
    status.textContent = 'Submitting…';
    try {
      const res = await fetch('/api/submit-business', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: draft.name,
          category: draft.category,
          suburb: draft.suburb,
          description: draft.description,
          phone: draft.phone,
          email: draft.email,
          website: draft.website,
          address,
          chosenTier: draft.tier,
          company_url: draft.company_url,
          loadedAt: draft.loadedAt,
        }),
      });
      const result = (await res.json()) as { ok?: boolean; error?: string; reviewUrl?: string; redirectUrl?: string };
      if (!result.ok) {
        status.textContent = result.error || 'Something went wrong — please try again.';
        goBtn.disabled = false;
        return;
      }

      // The listing is saved server-side (pending human review) either way.
      // Notifying the admin is a mailto: the visitor's own mail client sends
      // (there is no server-side SMTP); it opens without navigating the tab.
      const mailto = buildMailto({
        contactEmail,
        siteName,
        draft,
        categoryName,
        suburbName,
        centreName,
        reviewUrl: result.reviewUrl || '',
      });
      clearDraft();
      openMail(mailto);

      if (paid && result.redirectUrl) {
        // Hand off to the checkout summary; its "Pay with PayFast" button
        // uses the server-signed redirect URL kept in sessionStorage.
        saveResult({ name: draft.name, tier: draft.tier, redirectUrl: result.redirectUrl, mailto });
        status.textContent = 'Saved — taking you to checkout…';
        window.setTimeout(() => {
          window.location.href = '/list-your-business/checkout/';
        }, 700);
        return;
      }

      $('done-name').textContent = draft.name;
      $('done-meta').textContent = `${categoryName} · ${suburbName}`;
      const note = $('done-note');
      note.textContent = '';
      const lead = document.createElement('span');
      lead.textContent = "We've opened your email app with a message to us so we can review it quickly — please hit send. If it didn't open, ";
      const link = document.createElement('a');
      link.href = mailto;
      link.textContent = 'click here';
      note.append(lead, link, '.');
      if (paid) {
        const p = document.createElement('span');
        p.style.display = 'block';
        p.style.marginTop = '10px';
        p.textContent = `Online payment isn't available right now, so nothing has been charged. Your listing will publish on the Basic plan — you can upgrade to ${plan.name} any time from My Businesses.`;
        note.append(p);
      }
      $('review-view').hidden = true;
      $('done-view').hidden = false;
      window.scrollTo({ top: 0 });
    } catch {
      status.textContent = 'Something went wrong — please try again.';
      goBtn.disabled = false;
    }
  });
</script>
