---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFlowPlans } from '../../lib/list-flow-plans';
import site from '../../site';

const plans = getFlowPlans();
// PayFast hosts the payment page itself, so the mockup's "Pay with" tiles are
// shown as what PayFast offers (informational), not as a selectable choice.
const payMethods = [
  { name: 'Card', note: 'Visa, Mastercard' },
  { name: 'Instant EFT', note: 'All major SA banks' },
  { name: 'SnapScan', note: 'Scan to pay' },
  { name: 'Zapper', note: 'Scan to pay' },
];
---

<BaseLayout
  title="Checkout"
  description={`Pay for your ${site.siteName} plan securely with PayFast.`}
  noindex
>
  <main
    id="flow-root"
    data-plans={JSON.stringify(plans)}
    data-contact-email={site.contactEmail}
    style="max-width:1200px;margin:0 auto;padding:clamp(22px,3.5vw,42px) 20px 60px"
  >
    <div id="co-pay" hidden class="flow-grid" style="display:grid;gap:26px">
      <div style="min-width:0">
        <h1 style="margin:0 0 10px;font-size:clamp(26px,4.2vw,42px);letter-spacing:-.03em;line-height:1.05;color:var(--navy);max-width:18ch">Checkout</h1>
        <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:var(--text);max-width:50ch">Secured by PayFast. Month to month — cancel any time from your dashboard.</p>

        <h2 style="margin:0 0 12px;font-size:13px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Pay with</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:2px;background:var(--border);border:2px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:10px">
          {payMethods.map((m) => (
            <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-start;text-align:left;padding:15px;background:#fff;color:var(--navy)">
              <span style="font-size:13.5px;font-weight:800">{m.name}</span>
              <span style="font-size:12px;font-weight:600;line-height:1.4">{m.note}</span>
            </div>
          ))}
        </div>
        <p style="margin:0 0 24px;font-size:12px;font-weight:600;color:var(--muted);line-height:1.5">You'll choose your method on PayFast's secure page.</p>

        <form id="pay-form" style="display:flex;flex-direction:column;gap:15px">
          <label style="display:flex;align-items:flex-start;gap:10px;font-size:13.5px;font-weight:600;color:var(--text);line-height:1.5">
            <input type="checkbox" id="terms" required style="accent-color:var(--accent);width:17px;height:17px;margin-top:2px;flex-shrink:0" />
            <span>I accept the <a href="/terms/">terms</a> and understand this renews monthly until cancelled.</span>
          </label>
          <button type="submit" id="pay-btn" class="btn-primary" style="align-self:flex-start;padding:15px 26px;border:0;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:15px;font-weight:800;cursor:pointer">Pay with PayFast</button>
          <p style="margin:0;font-size:12px;font-weight:600;color:var(--muted);line-height:1.5">You'll be redirected to PayFast to complete payment. {site.siteName} never stores your card details.</p>
          <p id="mail-fallback" hidden style="margin:0;font-size:12px;font-weight:600;color:var(--muted);line-height:1.5">Your listing is saved and waiting for review. If your email app didn't open a message to us, <a id="mail-link" href="#">send it now</a> so we can review it sooner.</p>
        </form>
      </div>
      <aside style="display:flex;flex-direction:column;gap:14px">
        <div style="border:2px solid var(--navy);border-radius:16px;overflow:hidden">
          <div style="background:var(--navy);padding:14px 18px;font-size:14.5px;font-weight:800;color:#fff">Order summary</div>
          <div style="background:#fff;padding:16px;display:flex;flex-direction:column;gap:11px">
            <div style="display:flex;justify-content:space-between;gap:10px;font-size:14px;font-weight:700">
              <span id="sum-plan"></span><span id="sum-price"></span>
            </div>
            <div style="display:flex;justify-content:space-between;gap:10px;font-size:14px;font-weight:700;color:var(--muted)">
              <span>Listing setup</span><span>R0</span>
            </div>
            <div style="border-top:2px solid var(--border);padding-top:11px;display:flex;justify-content:space-between;gap:10px;font-size:18px;font-weight:800;color:var(--navy)">
              <span>Due today</span><span id="sum-total"></span>
            </div>
            <p style="margin:0;font-size:12px;font-weight:600;color:var(--muted);line-height:1.5">Your plan applies once your listing is approved. If we can't publish it, we refund your payment.</p>
          </div>
        </div>
        <div style="border:2px solid var(--border);border-radius:14px;padding:18px;background:var(--bg-subtle)">
          <div style="display:flex;align-items:center;gap:9px;font-size:13.5px;font-weight:800;color:var(--navy)">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round"><path d="M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-4Z"></path><path d="m9.5 12 1.8 1.8L15 10"></path></svg>
            PayFast secured
          </div>
          <p style="margin:8px 0 0;font-size:13px;line-height:1.55;color:var(--text)">Card, Instant EFT, SnapScan and Zapper. Need an invoice instead? <a href="/contact/">Ask for EFT billing</a>.</p>
        </div>
      </aside>
    </div>

    <div id="co-state" hidden style="max-width:640px">
      <h1 id="state-title" style="margin:0 0 10px;font-size:clamp(26px,4.2vw,42px);letter-spacing:-.03em;line-height:1.05;color:var(--navy);max-width:18ch"></h1>
      <p id="state-body" style="margin:0 0 24px;font-size:16px;line-height:1.6;color:var(--text);max-width:50ch"></p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="/my-businesses/" class="btn-primary" style="padding:15px 24px;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:15px;font-weight:800;text-decoration:none">Go to My Businesses</a>
        <a href="/" style="padding:15px 24px;border:2px solid var(--border);border-radius:11px;background:#fff;color:var(--navy);font-size:15px;font-weight:800;text-decoration:none">Back to home</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  [hidden] {
    display: none !important;
  }
  .flow-grid {
    grid-template-columns: 1fr;
  }
  @media (min-width: 950px) {
    .flow-grid {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }
  .btn-primary:hover {
    background: var(--accent-hover) !important;
  }
  .btn-primary:disabled {
    opacity: 0.6;
    cursor: default !important;
  }
</style>

<script>
  import { loadResult, clearResult, readPlans } from '../../lib/list-flow-client';

  const root = document.getElementById('flow-root') as HTMLElement;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const plans = readPlans(root);
  const q = new URLSearchParams(window.location.search);

  function showState(title: string, body: string) {
    $('state-title').textContent = title;
    $('state-body').textContent = body;
    $('co-pay').hidden = true;
    $('co-state').hidden = false;
  }

  if (q.get('payment_cancelled')) {
    clearResult();
    showState(
      'Payment cancelled',
      'Nothing was charged. Your listing has still been sent for review and will publish on the Basic plan — you can upgrade any time from My Businesses.'
    );
  } else if (q.get('paid')) {
    clearResult();
    showState(
      'Thank you',
      "PayFast is confirming your payment. Your listing is with our team for review — we'll email you when it's live, usually within 48 hours, and your plan applies once it's approved."
    );
  } else {
    const result = loadResult();
    const plan = result ? plans.find((p) => p.tier === result.tier) : undefined;
    // Only ever hand the browser to PayFast's own https host.
    if (!result || !plan || !/^https:\/\//i.test(result.redirectUrl)) {
      window.location.replace('/list-your-business/');
    } else {
      $('sum-plan').textContent = `${plan.name} plan — monthly`;
      $('sum-price').textContent = plan.amount;
      $('sum-total').textContent = plan.amount;
      $('pay-btn').textContent = `Pay ${plan.amount} with PayFast`;
      if (result.mailto) {
        ($('mail-link') as HTMLAnchorElement).href = result.mailto;
        $('mail-fallback').hidden = false;
      }
      $('co-pay').hidden = false;

      const form = $('pay-form') as HTMLFormElement;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        ($('pay-btn') as HTMLButtonElement).disabled = true;
        window.location.href = result.redirectUrl;
      });
    }
  }
</script>
