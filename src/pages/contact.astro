---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../site';

const TOPICS = [
  'A listing that needs fixing',
  'Advertising and sponsorship',
  'Billing or an invoice',
  'Report incorrect or spam content',
  'Something else',
];

// The mockup's "Direct lines" card lists separate addresses per topic; the real
// site has a single inbox (site.contactEmail), so each line is that address with
// the topic pre-filled as the subject.
const LINES = [
  { label: 'Listings', subject: 'Listings' },
  { label: 'Advertising', subject: 'Advertising' },
  { label: 'POPIA requests', subject: 'POPIA request' },
];

const labelStyle = 'display:flex;flex-direction:column;gap:6px;font-size:12.5px;font-weight:800;color:var(--navy)';
const fieldStyle = 'padding:13px;border:2px solid var(--border);border-radius:11px;font-size:14.5px;outline:none;background:#fff;color:var(--text)';
---

<BaseLayout
  title="Contact"
  titleOverride={`Contact ${site.siteName} | ${site.cityLabel}'s Local Business Directory`}
  description={`Get in touch with ${site.siteName} — questions, listing corrections, advertising or POPIA requests, reach us at ${site.contactEmail}.`}
>
  <main>
    <section style="background:var(--navy);color:#fff">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(28px,4.5vw,54px) 20px">
        <span style="font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--grad-from)">Contact</span>
        <h1 style="margin:12px 0 12px;color:#fff;font-size:clamp(28px,5vw,46px);letter-spacing:-.03em;line-height:1.05;max-width:20ch">Talk to a person, not a form robot</h1>
        <p style="margin:0;color:rgba(255,255,255,.84);font-size:16px;line-height:1.55;max-width:52ch">Send us a message and a real person will read it.</p>
      </div>
    </section>
    <section style="max-width:1200px;margin:0 auto;padding:clamp(24px,3.5vw,40px) 20px 60px">
      <div id="contact-shell" style="display:grid;gap:22px">
        <form id="contact-form" style="display:flex;flex-direction:column;gap:15px">
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:15px">
            <label style={labelStyle}>Your name
              <input type="text" name="name" class="contact-field" maxlength="120" style={fieldStyle} /></label>
            <label style={labelStyle}>Email
              <input type="email" name="email" class="contact-field" maxlength="120" style={fieldStyle} /></label>
          </div>
          <label style={labelStyle}>What's this about?
            <select name="topic" class="contact-field" style={fieldStyle}>
              {TOPICS.map((t) => <option>{t}</option>)}
            </select></label>
          <label style={labelStyle}>Message
            <textarea name="message" rows="6" required maxlength="4000" class="contact-field" style={`${fieldStyle};resize:vertical`}></textarea></label>
          <button type="submit" class="contact-send" style="align-self:flex-start;padding:14px 22px;border:0;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:14.5px;font-weight:800;cursor:pointer">Send message</button>
          <p id="contact-status" role="status" style="font-size:13.5px;font-weight:600;color:var(--muted);margin:0"></p>
        </form>
        <aside style="display:flex;flex-direction:column;gap:14px">
          <div style="border:2px solid var(--navy);border-radius:14px;overflow:hidden">
            <div style="background:var(--navy);padding:14px 18px;font-size:14.5px;font-weight:800;color:#fff">Direct lines</div>
            <div style="background:#fff;padding:16px;display:flex;flex-direction:column;gap:13px">
              {LINES.map((l) => (
                <div>
                  <div style="font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">{l.label}</div>
                  <div style="font-size:14.5px;font-weight:700;margin-top:4px;overflow-wrap:anywhere"><a href={`mailto:${site.contactEmail}?subject=${encodeURIComponent(l.subject)}`} style="color:inherit">{site.contactEmail}</a></div>
                </div>
              ))}
            </div>
          </div>
          <div style="border:2px solid var(--border);border-radius:14px;padding:18px;background:var(--bg-subtle)">
            <h3 style="margin:0 0 8px;font-size:15px;letter-spacing:-.01em;color:var(--navy)">Faster than emailing</h3>
            <p style="margin:0 0 12px;font-size:13.5px;line-height:1.55;color:var(--text)">Wrong phone number or address on a listing? Use the Claim button on the listing itself — it routes straight to review.</p>
            <a href="/my-businesses/claim/" style="display:block;padding:11px 14px;border-radius:9px;border:2px solid var(--navy);color:var(--navy);font-size:13.5px;font-weight:800;background:#fff;text-align:center;cursor:pointer;text-decoration:none">Claim a listing</a>
          </div>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  #contact-shell {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 950px) {
    #contact-shell {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }
  .contact-field:focus {
    border-color: var(--accent) !important;
  }
  .contact-send:hover {
    background: var(--accent-hover) !important;
  }
</style>

<script define:vars={{ contactEmail: site.contactEmail, siteName: site.siteName }}>
  // NOTE: define:vars forces this script to stay inline and unprocessed by
  // Astro/Vite (no TypeScript stripping) — it must be plain browser JS.
  // No server round-trip: this opens the visitor's own email app with a
  // pre-filled message to our contact address; their mail client does the
  // actual sending and Cloudflare Email Routing forwards it into our inbox.
  const form = document.getElementById('contact-form');
  const status = document.getElementById('contact-status');

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    const lines = [
      `Name: ${data.name || ''}`,
      `Email: ${data.email || ''}`,
      `Topic: ${data.topic || ''}`,
      '',
      'Message:',
      data.message || '',
    ];
    const subject = `${siteName} contact: ${data.topic || 'Message'}`;
    const mailto = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    status.innerHTML = `Opening your email app to send this — if it didn't open, <a href="${mailto}">click here</a>.`;
    window.location.href = mailto;
  });
</script>
