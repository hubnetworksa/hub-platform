---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import site from '../site';

const ICONS = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>',
};
---

<BaseLayout
  title="Contact"
  titleOverride={`Contact ${site.siteName} | ${site.cityLabel}'s Local Business Directory`}
  description={`Get in touch with ${site.siteName} — questions, listing corrections, or anything else, reach us at ${site.contactEmail}.`}
>
  <section class="container" style="padding-top: 3rem; padding-bottom: 3rem; max-width: 640px;">
    <h1>Contact {site.siteName}</h1>
    <p class="lede">
      Got a question, a correction for a listing, or something else on your mind? We'd like to hear
      from you.
    </p>

    <a href={`mailto:${site.contactEmail}`} class="contact-card">
      <span class="contact-icon"><Icon path={ICONS.mail} size={22} /></span>
      <span class="contact-text">
        <strong>Email us</strong>
        <span>{site.contactEmail}</span>
      </span>
    </a>

    <h2>Before you email</h2>
    <ul class="tips">
      <li>To report an issue with a specific listing, use the <strong>"Report this listing"</strong> link on that business's own page — it gets routed straight to us with the listing already attached.</li>
      <li>To add your business, visit <a href="/list-your-business/">List your business</a> — it's free.</li>
      <li>Already claimed your business? Manage it from <a href="/my-businesses/">My Businesses</a>.</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .lede {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text);
  }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 16px);
    background: var(--bg-card);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .contact-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 14px rgba(16, 26, 51, 0.08);
  }
  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(var(--accent-rgb), 0.1);
    color: var(--accent);
    flex-shrink: 0;
  }
  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .contact-text strong {
    color: var(--navy);
    font-size: 1.05rem;
  }
  .contact-text span {
    color: var(--accent);
    font-size: 0.95rem;
  }
  h2 {
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
    color: var(--navy);
  }
  .tips {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-left: 1.1rem;
    margin: 0;
  }
  .tips li {
    line-height: 1.6;
  }
</style>
