---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, suburbs, businessesInCategory, businessesInSuburb, sponsorFor, isPaidListing, businesses, sponsorships } from '../lib/data';
import { groupForSuburb } from '../site-content';
import { synonymsFor } from '../lib/categorySynonyms';
import site from '../site';

// Real, build-time data for the "Nothing matched" screen's suggestions —
// categories (with their trade-jargon synonyms) and suburbs (with their area
// group, for "nearby suburbs"), each with how many listings they hold. The
// client matches the visitor's query against these (typo-tolerant) so every
// suggestion links somewhere that genuinely has businesses.
const searchMeta = {
  cats: categories
    .map((c) => ({ n: c.name, s: c.slug, c: businessesInCategory(c.id).length, k: synonymsFor(c.slug).join(' ') }))
    .filter((c) => c.c > 0),
  subs: suburbs
    .map((s) => ({ n: s.name, s: s.slug, c: businessesInSuburb(s.id).length, g: groupForSuburb(s.slug)?.slug ?? '' }))
    .filter((s) => s.c > 0),
  // Category name -> its slug and current sponsor (if sold), so the
  // "Sponsored category spot" beside results shows who bought it.
  sp: Object.fromEntries(
    categories.map((c) => {
      const sp = sponsorFor('category_sponsor', c.slug);
      return [c.name, { cs: c.slug, ...(sp ? { n: sp.business_name, s: sp.business_slug } : {}) }];
    })
  ),
  // The in-feed AdSense unit after the fifth result: a real unit only when
  // this site names a slot ID for it (sites/<city>.json → adsenseSlots).
  ad: { c: site.adsensePublisherId, s: site.adsenseSlots?.searchInFeed ?? null },
};
const searchMetaJson = JSON.stringify(searchMeta).replace(/</g, '\\u003c');

// The search box's suburb picker: every suburb with listings, A-Z.
const subOptions = [...searchMeta.subs].sort((a, b) => a.n.localeCompare(b.n));

const stepStyle = 'flex-shrink:0;width:28px;height:28px;border-radius:8px;background:var(--bg-subtle);color:var(--accent);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px';
// No Google ads anywhere a paid listing or sponsor is shown (see
// BaseLayout's noAds): this page shows one if this is true.
const showsPaid = businesses.some(isPaidListing) || sponsorships.some((s) => s.product_type === 'category_sponsor');
---

<BaseLayout preloadSearchIndex noAds={showsPaid} title="Search results" description={`Search ${site.siteName}'s directory.`} noindex={true}>
  <main style="max-width:1200px;margin:0 auto;padding:22px 20px 60px">
    <div id="crumbs" style="display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;color:var(--muted);flex-wrap:wrap">
      <a href="/" style="color:var(--muted)">Home</a><span>/</span><span style="color:var(--navy)">Search</span>
    </div>
    <form id="search-form" class="sp-form">
      <div class="sp-field sp-field--q">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m20 20-4.5-4.5"></path></svg>
        <input id="search-input" type="search" name="q" aria-label="Search businesses" placeholder="Business name, category or service" autocomplete="off" class="sp-input" />
      </div>
      <div class="sp-field sp-field--sub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="1.9" stroke-linecap="round"><path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
        <select id="search-suburb" name="suburb" aria-label="Suburb" class="sp-select">
          <option value="">All suburbs</option>
          {subOptions.map((s) => <option value={s.s}>{s.n}</option>)}
        </select>
      </div>
      <button type="submit" class="sp-submit">Search</button>
    </form>

    <div id="results-view">
      <h1 id="results-heading" style="margin:22px 0 4px;font-size:clamp(24px,3.4vw,32px);letter-spacing:-.025em;color:var(--navy)">Search</h1>
      <p style="margin:0 0 14px;font-size:14px;color:var(--muted);font-weight:600">Featured listings appear first and are marked as such.</p>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:18px">
        <button id="open-now-btn" type="button" class="filter-pill" aria-pressed="false" style="display:inline-flex;align-items:center;gap:8px;padding:9px 14px;border-radius:999px;cursor:pointer;font-size:13px;font-weight:800">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg>
          <span id="open-now-label">Open now</span>
        </button>
        <button id="verified-btn" type="button" class="filter-pill" aria-pressed="false" style="padding:9px 14px;border-radius:999px;cursor:pointer;font-size:13px;font-weight:800">Verified only</button>
        <span id="open-note" style="font-size:12.5px;font-weight:700;color:var(--muted)">Filter to businesses trading right now.</span>
      </div>

      <div style="display:grid;grid-template-columns:1fr;gap:22px" id="results-shell">
        <div style="display:flex;flex-direction:column;gap:12px" id="results-list"></div>

        <aside style="display:flex;flex-direction:column;gap:14px">
          <div id="sponsor-slot" style="border:2px solid var(--navy);border-radius:14px;overflow:hidden"></div>
          <div style="border:2px solid var(--border);border-radius:14px;padding:16px;background:var(--bg-subtle)">
            <div style="font-size:13px;font-weight:800;color:var(--navy);margin-bottom:8px">Refine</div>
            <div style="display:flex;flex-direction:column;gap:8px">
              <label style="display:flex;align-items:center;gap:9px;font-size:13.5px;font-weight:600;color:var(--text)"><input id="filter-verified" type="checkbox" style="accent-color:var(--accent);width:16px;height:16px" />Verified only</label>
              <label style="display:flex;align-items:center;gap:9px;font-size:13.5px;font-weight:600;color:var(--text)"><input id="filter-hours" type="checkbox" style="accent-color:var(--accent);width:16px;height:16px" />Has trading hours</label>
              <label style="display:flex;align-items:center;gap:9px;font-size:13.5px;font-weight:600;color:var(--text)"><input id="filter-open" type="checkbox" style="accent-color:var(--accent);width:16px;height:16px" />Open now</label>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <div id="empty-view" hidden>
      <div style="border:2px solid var(--border);border-radius:16px;padding:clamp(24px,4vw,44px);margin-top:22px;background:#fff;max-width:760px">
        <h1 id="empty-title" style="margin:0 0 10px;font-size:clamp(23px,3.4vw,32px);letter-spacing:-.03em;color:var(--navy)">Nothing matched</h1>
        <p style="margin:0 0 22px;font-size:16px;line-height:1.6;color:var(--text);max-width:52ch">That doesn't mean the business doesn't exist — it might not be listed yet.</p>
        <div style="display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;gap:12px;align-items:flex-start">
            <span style={stepStyle}>1</span>
            <div><div style="font-size:15px;font-weight:800;color:var(--navy)">Try a broader term</div><div style="font-size:14px;color:var(--muted);font-weight:600;margin-top:2px">Drop the suburb, or search the category on its own.</div></div>
          </div>
          <div style="display:flex;gap:12px;align-items:flex-start">
            <span style={stepStyle}>2</span>
            <div><div id="empty-step2-title" style="font-size:15px;font-weight:800;color:var(--navy)">Browse nearby suburbs</div><div id="empty-step2-body" style="font-size:14px;color:var(--muted);font-weight:600;margin-top:2px">Every suburb we cover is listed in the directory.</div></div>
          </div>
          <div style="display:flex;gap:12px;align-items:flex-start">
            <span style={stepStyle}>3</span>
            <div><div style="font-size:15px;font-weight:800;color:var(--navy)">Know the business? Add it</div><div style="font-size:14px;color:var(--muted);font-weight:600;margin-top:2px">Listing is free and live within 48 hours.</div></div>
          </div>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px">
          <a href="/list-your-business/" style="padding:13px 20px;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:14px;font-weight:800;text-decoration:none">Add a business</a>
          <a href="/suburb/" style="padding:13px 20px;border-radius:11px;border:2px solid var(--border);background:#fff;color:var(--navy);font-size:14px;font-weight:800;text-decoration:none">Browse suburbs</a>
        </div>
      </div>
      <h2 id="empty-suggest-title" style="margin:30px 0 12px;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">You might have meant</h2>
      <div id="empty-suggestions" style="display:flex;flex-wrap:wrap;gap:8px"></div>
    </div>
  </main>

  <script type="application/json" id="search-meta" set:html={searchMetaJson} />
</BaseLayout>

<style>
  @media (min-width: 950px) {
    #results-shell {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }
  /* Search bar: query field, suburb picker and button on one row on
     desktop; stacked full-width rows on phones. */
  .sp-form {
    margin-top: 14px;
    display: flex;
    gap: 8px;
    max-width: 820px;
  }
  .sp-field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border: 2px solid var(--navy);
    border-radius: 12px;
    background: #fff;
    min-width: 0;
  }
  .sp-field--q {
    flex: 1 1 auto;
  }
  .sp-field--sub {
    flex: 0 0 210px;
    border-color: var(--border);
  }
  .sp-input,
  .sp-select {
    flex: 1;
    min-width: 0;
    width: 100%;
    border: 0;
    background: transparent;
    height: 44px;
    padding: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    outline: none;
    font-family: inherit;
  }
  .sp-select {
    padding-right: 4px;
    text-overflow: ellipsis;
    cursor: pointer;
  }
  .sp-submit {
    flex: 0 0 auto;
    padding: 0 22px;
    min-height: 48px;
    border: 0;
    border-radius: 12px;
    background: var(--accent);
    color: var(--contrast);
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 800;
    cursor: pointer;
  }
  .sp-submit:hover {
    background: var(--accent-hover);
  }
  @media (max-width: 640px) {
    .sp-form {
      flex-direction: column;
    }
    .sp-field--q,
    .sp-field--sub {
      flex: none;
    }
    .sp-input,
    .sp-select,
    .sp-submit {
      font-size: 16px;
    }
    .sp-submit {
      width: 100%;
    }
  }
  /* Inline display:flex on the crumb row beats the [hidden] attribute. */
  #crumbs[hidden] {
    display: none !important;
  }
  /* The mockup's two toggle pills: white/bordered when off, accent-filled when on. */
  .filter-pill {
    font-family: inherit;
    border: 2px solid var(--border);
    background: #fff;
    color: var(--navy);
  }
  .filter-pill[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--contrast);
  }
</style>

<style is:global>
  /* Result rows are injected via innerHTML from the script below, so they
     never get Astro's scoped-style data attribute — a scoped <style>
     block wouldn't reach them, hence is:global. */
  .search-result-row:hover {
    border-color: var(--navy);
  }
  .suggest-chip:hover {
    border-color: var(--navy) !important;
  }
</style>

<script>
  import { norm, STOP, type PackRow } from '../lib/fuzzy-search';
  import { createSearchClient, type SearchResult } from '../lib/search-client';
  import { openStatus } from '../lib/openNow';
  import { phoneHref } from '../lib/phone';
  import { gaEvent } from '../lib/ga';
  import { WHATSAPP_ICON, WHATSAPP_GREEN } from '../lib/whatsapp';

  // define:vars would force this script to skip TS compilation (it's
  // treated as inline HTML), which this whole file relies on — so the
  // city label comes in via a data attribute on <body> instead (set in
  // BaseLayout.astro) rather than an Astro define:vars binding here.
  const cityLabel = document.body.dataset.cityLabel ?? '';

  interface Row extends PackRow { c: string; sb: string; sbs: string; h: boolean; hr: string; p?: string; w?: string; a?: string; d?: string; sd?: string; l?: string; wa?: string }
  interface Meta {
    cats: { n: string; s: string; c: number; k: string }[];
    subs: { n: string; s: string; c: number; g: string }[];
    sp?: Record<string, { cs: string; n?: string; s?: string }>;
    ad?: { c: string | null; s: string | null };
  }

  const searchMeta: Meta = JSON.parse(document.getElementById('search-meta')?.textContent || '{"cats":[],"subs":[]}');
  const initialQ = new URLSearchParams(location.search).get('q') ?? '';

  const input = document.getElementById('search-input') as HTMLInputElement;
  const form = document.getElementById('search-form') as HTMLFormElement;
  const crumbs = document.getElementById('crumbs')!;
  const resultsView = document.getElementById('results-view')!;
  const emptyView = document.getElementById('empty-view')!;
  const heading = document.getElementById('results-heading')!;
  const list = document.getElementById('results-list')!;
  const sponsorSlot = document.getElementById('sponsor-slot')!;
  const filterVerified = document.getElementById('filter-verified') as HTMLInputElement;
  const filterHours = document.getElementById('filter-hours') as HTMLInputElement;
  const filterOpen = document.getElementById('filter-open') as HTMLInputElement;
  const openBtn = document.getElementById('open-now-btn') as HTMLButtonElement;
  const openLabel = document.getElementById('open-now-label')!;
  const verifiedBtn = document.getElementById('verified-btn') as HTMLButtonElement;
  const openNote = document.getElementById('open-note')!;

  input.value = initialQ;
  const suburbSelect = document.getElementById('search-suburb') as HTMLSelectElement;
  const initialSuburb = new URLSearchParams(location.search).get('suburb') ?? '';
  suburbSelect.value = initialSuburb;
  // A suburb from an old link that isn't in the list: keep it, as an option.
  if (initialSuburb && suburbSelect.value !== initialSuburb) {
    suburbSelect.add(new Option(searchMeta.subs.find((x) => x.s === initialSuburb)?.n ?? initialSuburb, initialSuburb, true, true));
  }

  // ---- Fuzzy search ---------------------------------------------------------
  // The engine lives in src/lib/fuzzy-search.ts (Fuse.js, shared by every
  // search on the site). The index is pre-normalised and its Fuse indexes
  // are pre-built at build time (/search-index.<hash>.json), so the browser
  // only parses them — no indexing work.

  // Queries run in a Web Worker (see src/lib/search-client.ts).
  const client = createSearchClient<Row>(document.body.dataset.searchIndex!);

  // Relevance bucket of each row in the latest results (for the pinned pick).
  let lastBucket = new Map<Row, number>();

  async function search(_data: Row[], rawWords: string[], suburbSlug: string): Promise<Row[]> {
    const res: SearchResult = await client.search(rawWords.join(' '), suburbSlug);
    const rows = allRows!;
    const out = Array.from(res.i, (k) => rows[k]);
    if (rawWords.length) lastBucket = new Map(out.map((r, k) => [r, res.bucket[k]]));
    else lastBucket = new Map();
    return out;
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  function planBadge(tier: number): string {
    if (tier >= 2) return `<span style="display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:999px;background:var(--accent);color:var(--contrast);font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase">Featured</span>`;
    if (tier === 1) return `<span style="display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:999px;background:rgba(var(--accent-rgb),.12);color:var(--accent-hover);font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase">Verified</span>`;
    return '';
  }

  // "Open now" / "Closed" badge — only when the listing's hours text parses
  // cleanly (see src/lib/openNow.ts); otherwise nothing, never a guess.
  function openBadge(r: Row): string {
    const st = openStatus(r.hr);
    if (!st) return '';
    const style = st.open
      ? 'padding:3px 9px;border-radius:999px;background:rgba(var(--accent-rgb),.13);color:var(--accent-hover);font-size:11px;font-weight:800'
      : 'padding:3px 9px;border-radius:999px;background:var(--bg-subtle);color:var(--muted);font-size:11px;font-weight:800';
    return `<span style="${style}">${st.open ? 'Open now' : 'Closed'}</span>`;
  }

  // Same tile as src/components/BusinessLogo.astro (.biz-logo in global.css).
  // r.l is only ever a site-relative path from the build (see logoFor).
  function logoTile(r: Row, size: 'pin' | 'row'): string {
    if (!r.l || !r.l.startsWith('/')) return '';
    const px = size === 'pin' ? 76 : 60;
    return `<span class="biz-logo biz-logo--${size}"><img src="${escapeHtml(r.l)}" alt="${escapeHtml(r.n)} logo" width="${px}" height="${px}" loading="lazy" decoding="async"></span>`;
  }

  function renderRow(r: Row, pinned: boolean): string {
    const badge = openBadge(r);
    const badgeRow = badge ? `<div style="display:flex;align-items:center;gap:8px;margin-top:7px;flex-wrap:wrap">${badge}</div>` : '';
    if (pinned) {
      const meta = [r.c, r.sb, r.a].filter(Boolean).join(' · ');
      const pinnedLogo = logoTile(r, 'pin');
      const actions = [
        r.p ? `<a href="${escapeHtml(phoneHref(r.p))}" data-track="phone_click" data-track-slug="${escapeHtml(r.s)}" style="padding:10px 14px;border-radius:9px;background:var(--navy);color:#fff;font-size:13px;font-weight:800;text-decoration:none">${escapeHtml(r.p)}</a>` : '',
        r.wa ? `<a href="${escapeHtml(r.wa)}" target="_blank" rel="noopener" data-track="whatsapp_click" data-track-slug="${escapeHtml(r.s)}" aria-label="Chat to ${escapeHtml(r.n)} on WhatsApp" style="display:inline-flex;align-items:center;gap:6px;padding:10px 14px;border-radius:9px;background:${WHATSAPP_GREEN};color:#fff;font-size:13px;font-weight:800;text-decoration:none"><svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true" style="flex-shrink:0">${WHATSAPP_ICON}</svg>WhatsApp</a>` : '',
        r.w ? `<a href="${escapeHtml(r.w)}" target="_blank" rel="noopener noreferrer" style="padding:10px 14px;border-radius:9px;border:2px solid var(--border);color:var(--navy);font-size:13px;font-weight:800;text-decoration:none">Website</a>` : '',
        `<a href="/business/${r.s}/#enquiry-form" style="padding:10px 14px;border-radius:9px;border:2px solid var(--border);color:var(--navy);font-size:13px;font-weight:800;text-decoration:none">Send enquiry</a>`,
      ].join('');
      return `
        <article style="border:2px solid var(--accent);border-radius:14px;background:#fff;padding:18px">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
            ${planBadge(r.t)}
            <span style="font-size:11px;font-weight:700;color:var(--muted)">Sponsored placement</span>
          </div>
          ${pinnedLogo ? `<div class="biz-split biz-split--stack-phone" style="margin-top:14px">${pinnedLogo}<div class="biz-split-body" style="gap:0">` : ''}
          <h2 style="margin:${pinnedLogo ? '0 0 4px' : '12px 0 6px'};font-size:21px;letter-spacing:-.02em;color:var(--navy)"><a href="/business/${r.s}/" style="color:var(--navy)">${escapeHtml(r.n)}</a></h2>
          <p style="margin:0 0 ${badge ? '8px' : '0'};font-size:13.5px;font-weight:700;color:var(--muted)">${escapeHtml(meta)}</p>
          ${badge ? `<div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap">${badge}</div>` : ''}
          ${r.sd || r.d ? `<p class="desc-clamp" style="margin:${badge ? '0' : '10px'} 0 0;font-size:14.5px;line-height:1.55;color:var(--text)">${escapeHtml(r.sd || r.d)}</p>` : ''}
          <div${pinnedLogo ? ' class="biz-split-actions"' : ''} style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px">${actions}</div>
          ${pinnedLogo ? '</div></div>' : ''}
        </article>`;
    }
    const meta = [r.c, r.sb].filter(Boolean).join(' · ');
    const rowLogo = logoTile(r, 'row');
    return `
      <article class="search-result-row" style="border:2px solid var(--border);border-radius:14px;background:#fff;padding:16px 18px">
        ${rowLogo ? `<div class="biz-split">${rowLogo}<div class="biz-split-body" style="gap:0">` : ''}
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap">
          <h2 style="margin:0;font-size:18px;letter-spacing:-.015em;color:var(--navy)"><a href="/business/${r.s}/" style="color:var(--navy)">${escapeHtml(r.n)}</a></h2>
          ${r.c ? `<span style="display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:999px;background:var(--bg-subtle);color:var(--accent-hover);font-size:11px;font-weight:800;${rowLogo ? 'max-width:100%' : 'white-space:nowrap'}">${escapeHtml(r.c)}</span>` : ''}
        </div>
        <p style="margin:8px 0 0;font-size:13.5px;font-weight:600;color:var(--muted)">${escapeHtml(meta)}${planBadge(r.t) ? ' &nbsp;' + planBadge(r.t) : ''}</p>
        ${r.sd ? `<p class="desc-clamp" style="margin:7px 0 0;font-size:14px;line-height:1.5;color:var(--text)">${escapeHtml(r.sd)}</p>` : ''}
        ${badgeRow}
        ${rowLogo ? '</div></div>' : ''}
      </article>`;
  }

  function renderSponsorSlot(category: string) {
    const info = category ? searchMeta.sp?.[category] : undefined;
    if (info?.n && info.s) {
      sponsorSlot.innerHTML = `
      <div style="background:var(--navy);padding:14px 16px">
        <div style="font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--grad-from)">Sponsored · ${escapeHtml(category)}</div>
        <a href="/business/${encodeURIComponent(info.s)}/" style="display:block;font-size:17px;font-weight:800;color:#fff;margin-top:6px;letter-spacing:-.02em;text-decoration:none">${escapeHtml(info.n)}</a>
      </div>
      <div style="padding:16px;background:#fff">
        <a href="/business/${encodeURIComponent(info.s)}/" style="display:block;padding:11px 14px;border-radius:9px;background:var(--accent);color:var(--contrast);font-size:13.5px;font-weight:800;text-decoration:none">View listing</a>
      </div>`;
      return;
    }
    const buyHref = `/my-businesses/sponsor/?type=category_sponsor${info?.cs ? `&target=${encodeURIComponent(info.cs)}` : ''}`;
    sponsorSlot.innerHTML = `
      <div style="background:var(--navy);padding:14px 16px">
        <div style="font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--grad-from)">Sponsored category spot</div>
        <div style="font-size:17px;font-weight:800;color:#fff;margin-top:6px;letter-spacing:-.02em">One advertiser per category</div>
      </div>
      <div style="padding:16px;background:#fff">
        <p style="margin:0 0 12px;font-size:14px;line-height:1.55;color:var(--text)">${category ? `Own the top of every &ldquo;${escapeHtml(category)}&rdquo; page in ${escapeHtml(cityLabel)} — including this one.` : 'Own the top of a category page across the whole site.'}</p>
        <a href="${buyHref}" style="display:block;padding:11px 14px;border-radius:9px;background:var(--accent);color:var(--contrast);font-size:13.5px;font-weight:800;text-decoration:none">Sponsor this category</a>
      </div>`;
  }

  // ---- "Nothing matched" suggestions ------------------------------------
  // All computed from the real category/suburb lists embedded at build time
  // and the live search index — nothing is canned.

  function lev(a: string, b: string): number {
    if (Math.abs(a.length - b.length) > 2) return 3;
    const prev = Array.from({ length: b.length + 1 }, (_, i) => i);
    for (let i = 1; i <= a.length; i++) {
      let diag = prev[0];
      prev[0] = i;
      for (let j = 1; j <= b.length; j++) {
        const tmp = prev[j];
        prev[j] = Math.min(prev[j] + 1, prev[j - 1] + 1, diag + (a[i - 1] === b[j - 1] ? 0 : 1));
        diag = tmp;
      }
    }
    return prev[b.length];
  }

  /** How well a typed word matches a target word: 1 exact … 0 no. Handles
   *  plurals/inflections, prefixes ("plumb"), and one or two typos. */
  function wordScore(qw: string, tw: string): number {
    if (qw === tw) return 1;
    if (qw.length >= 4 && tw.startsWith(qw)) return 0.85;
    if (tw.length >= 4 && qw.startsWith(tw) && qw.length - tw.length <= 2) return 0.8;
    const max = qw.length >= 8 ? 2 : qw.length >= 4 ? 1 : 0;
    if (max && lev(qw, tw) <= max) return 0.7;
    return 0;
  }

  function suggestionChip(href: string, label: string): string {
    return `<a href="${href}" class="suggest-chip" style="padding:9px 14px;border:2px solid var(--border);border-radius:999px;font-size:13.5px;font-weight:700;color:var(--navy);background:#fff;text-decoration:none">${escapeHtml(label)}</a>`;
  }

  async function showEmpty(q: string, suburbSlug: string, data: Row[]) {
    crumbs.hidden = true;
    resultsView.hidden = true;
    emptyView.hidden = false;

    const paramSuburb = suburbSlug ? searchMeta.subs.find((s) => s.s === suburbSlug) : undefined;
    document.getElementById('empty-title')!.textContent = `Nothing matched “${q || paramSuburb?.n || suburbSlug}”`;

    const qWords = norm(q).split(' ').filter((w) => w.length >= 2 && !STOP.has(w));

    // Each typed word, plus each pair of adjacent words run together.
    const units = [
      ...qWords.map((w) => ({ text: w, words: [w] })),
      ...qWords.slice(1).map((w, i) => ({ text: qWords[i] + w, words: [qWords[i], w] })),
    ];

    // Suburbs the query names (typo-tolerant); the longest token must match.
    const consumed = new Set<string>();
    const suburbHits = searchMeta.subs
      .map((s) => {
        const tokens = norm(s.n).split(' ').filter(Boolean);
        const longest = [...tokens].sort((a, b) => b.length - a.length)[0];
        let matched = 0;
        let longestMatched = false;
        const used: string[] = [];
        for (const t of tokens) {
          const best = Math.max(0, ...qWords.map((w) => wordScore(w, t)));
          if (best >= 0.7) {
            matched++;
            if (t === longest) longestMatched = true;
            used.push(...qWords.filter((w) => wordScore(w, t) >= 0.7));
          }
        }
        let score = longestMatched ? matched / tokens.length : 0;
        // "greenpoint" for "Green Point": the whole name run together, from a
        // typed word or two adjacent typed words.
        if (tokens.length > 1) {
          const joined = tokens.join('');
          for (const u of units) {
            if (u.text.length >= 5 && wordScore(u.text, joined) >= 0.7) {
              score = 1;
              used.push(...u.words);
            }
          }
        }
        return { s, score, used };
      })
      .filter((x) => x.score >= 0.5)
      .sort((a, b) => b.score - a.score || b.s.c - a.s.c)
      .slice(0, 2);
    suburbHits.forEach((h) => h.used.forEach((w) => consumed.add(w)));
    const matchedSuburb = paramSuburb ?? suburbHits[0]?.s;

    // Step 2 — nearby suburbs (same area group), or a plain pointer.
    const step2Title = document.getElementById('empty-step2-title')!;
    const step2Body = document.getElementById('empty-step2-body')!;
    const nearby = matchedSuburb?.g
      ? searchMeta.subs.filter((s) => s.g === matchedSuburb.g && s.s !== matchedSuburb.s).sort((a, b) => b.c - a.c).slice(0, 3).map((s) => s.n)
      : [];
    if (matchedSuburb && nearby.length) {
      step2Title.textContent = 'Browse nearby suburbs';
      const joined = nearby.length > 1 ? `${nearby.slice(0, -1).join(', ')} and ${nearby[nearby.length - 1]}` : nearby[0];
      step2Body.textContent = `${matchedSuburb.n} is close to ${joined}.`;
    } else {
      step2Title.textContent = 'Browse by suburb';
      step2Body.textContent = 'Every suburb we cover is listed in the directory.';
    }

    // Categories whose name or trade-jargon synonyms resemble what was typed.
    const catHits = searchMeta.cats
      .map((c) => {
        const nameWords = norm(c.n).split(' ').filter((w) => w.length > 1 && !STOP.has(w));
        const synWords = norm(c.k).split(' ').filter((w) => w.length > 2 && !STOP.has(w));
        let score = 0;
        for (const w of qWords) {
          if (consumed.has(w) || w.length < 3) continue;
          const inName = Math.max(0, ...nameWords.map((t) => wordScore(w, t)));
          const inSyn = Math.max(0, ...synWords.map((t) => wordScore(w, t))) * 0.8;
          score += Math.max(inName, inSyn);
        }
        return { c, score };
      })
      .filter((x) => x.score >= 0.7)
      .sort((a, b) => b.score - a.score || b.c.c - a.c.c)
      .slice(0, 3);

    const chips: string[] = [];
    const seen = new Set<string>();
    const add = (href: string, label: string) => {
      if (seen.has(href) || chips.length >= 6) return;
      seen.add(href);
      chips.push(suggestionChip(href, label));
    };
    catHits.forEach((h) => add(`/category/${h.c.s}/`, `${h.c.n} — ${cityLabel} wide`));
    suburbHits.forEach((h) => add(`/suburb/${h.s.s}/`, `All businesses in ${h.s.n}`));
    if (paramSuburb) add(`/suburb/${paramSuburb.s}/`, `All businesses in ${paramSuburb.n}`);
    // Single words from the query that DO match something on their own.
    for (const w of qWords) {
      if (consumed.has(w) || w.length < 3) continue;
      const n = (await search(data, [w], '')).length;
      if (n > 0) add(`/search/?q=${encodeURIComponent(w)}`, `“${w}” — ${n} ${n === 1 ? 'business' : 'businesses'}`);
    }

    const titleEl = document.getElementById('empty-suggest-title')!;
    const listEl = document.getElementById('empty-suggestions')!;
    if (chips.length > 0) {
      titleEl.textContent = 'You might have meant';
      listEl.innerHTML = chips.join('');
    } else {
      // Nothing resembles the query — show what we're biggest in instead,
      // labelled honestly (not as a "did you mean").
      titleEl.textContent = 'Popular categories';
      listEl.innerHTML = [...searchMeta.cats]
        .sort((a, b) => b.c - a.c)
        .slice(0, 5)
        .map((c) => suggestionChip(`/category/${c.s}/`, c.n))
        .join('');
    }
  }

  function showResultsView() {
    crumbs.hidden = false;
    resultsView.hidden = false;
    emptyView.hidden = true;
  }

  let allRows: Row[] | null = null;
  let indexPromise: Promise<Row[]> | null = null;
  // The fetch starts from the <link rel="preload"> in <head> (and the worker
  // reads the same URL), so this usually just picks up a finished download.
  function loadIndex(): Promise<Row[]> {
    if (!indexPromise) {
      indexPromise = client.load.then(({ pack, rows }) => {
        const subSlug = pack.s.map((x) => x.s);
        for (const r of rows) {
          r.c = pack.c[r.ci]?.n ?? '';
          r.sb = pack.s[r.si]?.n ?? '';
          r.sbs = subSlug[r.si] ?? '';
          r.hr = (r.hr as string | undefined) ?? '';
          r.h = r.hr !== '';
        }
        return (allRows = rows);
      });
    }
    return indexPromise;
  }

  const OPEN_NOTE_DEFAULT = 'Filter to businesses trading right now.';

  // The pills and the sidebar checkboxes are two views of the same filters.
  function syncPills() {
    openBtn.setAttribute('aria-pressed', String(filterOpen.checked));
    verifiedBtn.setAttribute('aria-pressed', String(filterVerified.checked));
    openLabel.textContent = filterOpen.checked ? 'Open now · on' : 'Open now';
  }

  let runSeq = 0;
  const PAGE = 50;
  let limit = PAGE;
  let lastKey = '';
  let lastHtml = '';

  async function runSearch(track = true) {
    syncPills();
    const q = input.value.trim();
    const suburbSlug = new URLSearchParams(location.search).get('suburb') ?? '';
    const words = q.split(/\s+/).filter(Boolean);
    const mySeq = ++runSeq; const data = await loadIndex();
    const base = await search(data, words, suburbSlug);
    if (mySeq !== runSeq) return; // a newer keystroke superseded this one
    if (track && q) gaEvent('search', { search_term: q.toLowerCase().slice(0, 80), result_count: base.length });
    const key = [q, suburbSlug, filterOpen.checked, filterVerified.checked, filterHours.checked].join('|');
    if (key !== lastKey) limit = PAGE;
    lastKey = key;

    // Zero hits before any Refine filter: the full "Nothing matched" screen.
    if (base.length === 0 && (q || suburbSlug)) {
      await showEmpty(q, suburbSlug, data);
      return;
    }
    showResultsView();

    let results = base;
    if (filterVerified.checked) results = results.filter((r) => r.t >= 1);
    if (filterHours.checked) results = results.filter((r) => r.h);
    const beforeOpen = results.length;
    if (filterOpen.checked) results = results.filter((r) => openStatus(r.hr)?.open === true);
    openNote.textContent = filterOpen.checked
      ? `Showing ${results.length} of ${beforeOpen} — the rest are closed, or haven't listed trading hours.`
      : OPEN_NOTE_DEFAULT;

    heading.textContent = q ? `${results.length} results for “${q}”` : `${results.length} businesses${suburbSlug ? '' : ' listed'}`;

    if (results.length === 0) {
      list.innerHTML = `<p style="color:var(--muted);font-size:14px;">No listings match these filters — try switching one off.</p>`;
      renderSponsorSlot('');
      return;
    }
    // Sponsor card wins: the sponsored-category box beside the results is
    // rendered for the top result's category, so that sponsor is never also
    // the pinned Featured result (it stays in the ordinary rows once).
    const topCategory = results.find((r) => r.c)?.c ?? '';
    const sponsorSlug = topCategory ? searchMeta.sp?.[topCategory]?.s : undefined;
    // Only pin a Featured listing that genuinely matched (not a typo-only
    // match) whenever direct matches exist.
    const strong = results.some((r) => (lastBucket.get(r) ?? 0) >= 2);
    const featured = results.find((r) => r.t >= 2 && r.s !== sponsorSlug && (!strong || (lastBucket.get(r) ?? 0) >= 2));
    const restAll = results.filter((r) => r !== featured);
    const rest = restAll.slice(0, limit);
    // A real AdSense in-feed unit after the fifth result — only when this
    // site has a publisher ID and names a slot for it; otherwise nothing at
    // all (never a placeholder box). Like AdUnit.astro it stays collapsed
    // (BaseLayout's .ad-unit rules) until Google marks it filled.
    const ad = searchMeta.ad;
    const attr = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    const adSlot = ad?.c && ad?.s
      ? `<div class="ad-unit" style="min-width:0;--ad-gap:12px">
        <span class="ad-label">Advertisement</span>
        <ins class="adsbygoogle" style="display:block" data-ad-client="${attr(ad.c)}" data-ad-slot="${attr(ad.s)}" data-ad-format="fluid" data-full-width-responsive="true"></ins>
      </div>`
      : '';
    const rows = rest.map((r) => renderRow(r, false));
    const showAd = adSlot !== '' && rows.length > 5 && document.body.dataset.ads !== '0';
    if (showAd) rows.splice(5, 0, adSlot);
    const more = restAll.length > rest.length ? `<button type="button" id="show-more" style="align-self:center;padding:12px 22px;border-radius:10px;border:2px solid var(--border);background:#fff;color:var(--navy);font-size:14px;font-weight:800;cursor:pointer;font-family:inherit">Show more (${restAll.length - rest.length} more)</button>` : '';
    const html = (featured ? renderRow(featured, true) : '') + rows.join('') + more;
    // Only touch the DOM when the rendered result actually changed.
    const changed = html !== lastHtml;
    if (changed) list.innerHTML = html;
    lastHtml = html;
    // Never re-push the ad unit on a keystroke re-render.
    if (showAd && track) {
      const w = window as unknown as { adsbygoogle?: unknown[] };
      (w.adsbygoogle = w.adsbygoogle || []).push({});
    }

    renderSponsorSlot(topCategory);

    // Real numbers behind the owner dashboard's "Search appearances" tile
    // (see functions/api/track-view.ts) — one beacon per real search,
    // naming every business actually shown on this page of results, not
    // one request per row. Only sent for a search that means something
    // (a typed term or a suburb), so idly loading /search/ with nothing
    // typed doesn't count as every listed business "appearing".
    if (track && (q || suburbSlug)) {
      const shown = [...(featured ? [featured] : []), ...rest].map((r) => r.s);
      const query = q.toLowerCase().replace(/\s+/g, ' ').slice(0, 80);
      try {
        navigator.sendBeacon('/api/track-view', new Blob([JSON.stringify({ event: 'search_appearance', businessSlugs: shown, ...(query ? { query } : {}) })], { type: 'application/json' }));
      } catch {
        // A missed appearance count is never worth surfacing an error over.
      }
    }
  }

  // Phone clicks straight from a result card count too — otherwise the
  // owner's "Phone clicks" tile only sees calls started from the profile page.
  list.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#show-more')) {
      limit += PAGE;
      runSearch(false);
      return;
    }
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
    if (!el?.dataset.trackSlug) return;
    try {
      navigator.sendBeacon('/api/track-view', new Blob([JSON.stringify({ businessSlug: el.dataset.trackSlug, event: el.dataset.track })], { type: 'application/json' }));
      gaEvent(el.dataset.track!, { business_slug: el.dataset.trackSlug, surface: 'search' });
    } catch {
      // A missed click count is never worth surfacing an error over.
    }
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const params = new URLSearchParams(location.search);
    if (input.value.trim()) params.set('q', input.value.trim());
    else params.delete('q');
    if (suburbSelect.value) params.set('suburb', suburbSelect.value);
    else params.delete('suburb');
    history.replaceState(null, '', `?${params.toString()}`);
    runSearch();
  });
  // Search as you type, debounced; never beacons per keystroke.
  let typingTimer: number | undefined;
  input.addEventListener('input', () => {
    clearTimeout(typingTimer);
    typingTimer = window.setTimeout(() => {
      const params = new URLSearchParams(location.search);
      if (input.value.trim()) params.set('q', input.value.trim());
      else params.delete('q');
      history.replaceState(null, '', `?${params.toString()}`);
      runSearch(false);
    }, 50);
  });
  // Picking a suburb searches straight away, like pressing Search.
  suburbSelect.addEventListener('change', () => form.requestSubmit());
  filterVerified.addEventListener('change', () => runSearch());
  filterHours.addEventListener('change', () => runSearch());
  filterOpen.addEventListener('change', () => runSearch());
  openBtn.addEventListener('click', () => {
    filterOpen.checked = !filterOpen.checked;
    runSearch();
  });
  verifiedBtn.addEventListener('click', () => {
    filterVerified.checked = !filterVerified.checked;
    runSearch();
  });

  runSearch();
</script>
