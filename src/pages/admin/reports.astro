---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminShell from '../../components/AdminShell.astro';
---

<BaseLayout title="Reports & Removal Requests" description="Review reported listing issues and removal requests." noindex={true}>
  <div id="loading" style="padding:3rem;color:var(--muted);text-align:center;">Loading…</div>

  <div id="content" hidden>
    <AdminShell active="reports" title="Reports" subtitle="Reported listing issues and removal requests.">
      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div id="reports-list"></div>
        <div id="reports-empty" hidden style="padding:40px 18px;text-align:center;">
          <div style="font-size:16px;font-weight:800;color:var(--navy)">Nothing waiting</div>
          <div style="font-size:13.5px;font-weight:600;color:var(--muted);margin-top:5px">No open reports.</div>
        </div>
      </div>
    </AdminShell>
  </div>
</BaseLayout>

<script>
  import { esc } from '../../lib/admin-html';

  async function postJson(url: string, body: unknown): Promise<void> {
    await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  }

  function renderReport(r: {
    id: number; kind: string; business_slug: string; business_name: string; reason: string;
    relationship: string | null; requester_email: string | null; created_at: string;
  }): string {
    const label = r.kind === 'removal' ? 'Removal request' : 'Reported issue';
    return `
      <div style="padding:18px;border-bottom:1px solid var(--border);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center;">
        <div style="min-width:0;">
          <span style="font-size:15px;font-weight:800;color:var(--navy);">${label}: <a href="/business/${encodeURIComponent(r.business_slug)}/" target="_blank" rel="noopener" style="color:var(--accent);">${esc(r.business_name)}</a></span>
          <p style="margin:8px 0 0;font-size:13.5px;line-height:1.5;color:var(--text);max-width:64ch;">${esc(r.reason)}</p>
          ${r.relationship ? `<div style="font-size:12.5px;color:var(--muted);margin-top:4px;">Relationship: ${esc(r.relationship)}</div>` : ''}
          ${r.requester_email ? `<div style="font-size:12.5px;color:var(--muted);">From: ${esc(r.requester_email)}</div>` : ''}
          <div style="font-size:12.5px;color:var(--muted);margin-top:4px;">${new Date(r.created_at).toLocaleString()}</div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;">
          <button data-resolve="${r.id}" style="padding:10px 14px;border:0;border-radius:9px;background:var(--accent);color:var(--contrast);font-size:13px;font-weight:800;cursor:pointer;">Mark resolved</button>
        </div>
      </div>`;
  }

  async function init() {
    const me = await fetch('/api/me');
    if (me.status === 401) {
      window.location.href = '/login/?next=/admin/reports/';
      return;
    }
    const meData = await me.json();
    if (!meData.isAdmin) {
      window.location.href = '/my-businesses/';
      return;
    }

    const res = await fetch('/api/admin/overview');
    const data = await res.json();
    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;

    const list = document.getElementById('reports-list')!;
    if (data.reports.length === 0) {
      document.getElementById('reports-empty')!.hidden = false;
    } else {
      list.innerHTML = data.reports.map(renderReport).join('');
    }
  }

  document.getElementById('content')!.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-resolve]') as HTMLButtonElement | null;
    if (!btn) return;
    btn.disabled = true;
    await postJson('/api/admin/resolve-report', { reportId: Number(btn.dataset.resolve) });
    init();
  });

  init();
</script>
