---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Reports & Removal Requests" description="Review reported listing issues and removal requests." noindex={true}>
  <section class="admin-wrap">
    <div id="loading" class="loading">Loading…</div>

    <div id="content" class="admin" hidden>
      <a href="/admin/" class="back-link">← Admin Dashboard</a>
      <h1>Reports &amp; removal requests</h1>
      <ul id="reports-list" class="item-list"></ul>
      <p id="reports-empty" class="empty-state" hidden>No open reports.</p>
    </div>
  </section>
</BaseLayout>

<script>
  async function postJson(url: string, body: unknown): Promise<void> {
    await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  }

  function renderReport(r: {
    id: number; kind: string; business_slug: string; business_name: string; reason: string;
    relationship: string | null; requester_email: string | null; created_at: string;
  }): string {
    const label = r.kind === 'removal' ? 'Removal request' : 'Reported issue';
    return `
      <li class="admin-row">
        <div class="admin-row-main">
          <strong>${label}: <a href="/business/${r.business_slug}/" target="_blank" rel="noopener">${r.business_name}</a></strong>
          <span class="row-detail">${r.reason}</span>
          ${r.relationship ? `<span class="row-detail">Relationship: ${r.relationship}</span>` : ''}
          ${r.requester_email ? `<span class="row-detail">From: ${r.requester_email}</span>` : ''}
          <span class="row-detail">${new Date(r.created_at).toLocaleString()}</span>
        </div>
        <div class="row-actions">
          <button class="btn-sm btn-approve" data-resolve="${r.id}">Mark resolved</button>
        </div>
      </li>`;
  }

  async function init() {
    const me = await fetch('/api/me');
    if (me.status === 401) {
      window.location.href = '/login/?next=/admin/reports/';
      return;
    }
    const meData = await me.json();
    if (!meData.isAdmin) {
      window.location.href = '/my-businesses/';
      return;
    }

    const res = await fetch('/api/admin/overview');
    const data = await res.json();
    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;

    const list = document.getElementById('reports-list')!;
    if (data.reports.length === 0) {
      document.getElementById('reports-empty')!.hidden = false;
    } else {
      list.innerHTML = data.reports.map(renderReport).join('');
    }
  }

  document.getElementById('content')!.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-resolve]') as HTMLButtonElement | null;
    if (!btn) return;
    btn.disabled = true;
    await postJson('/api/admin/resolve-report', { reportId: Number(btn.dataset.resolve) });
    init();
  });

  init();
</script>

<style>
  .admin-wrap {
    display: flex;
    justify-content: center;
    padding: 3rem 1rem;
  }
  .loading {
    color: var(--text-muted);
  }
  .admin {
    width: 100%;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .back-link {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
  }
  .back-link:hover {
    text-decoration: underline;
  }
  h1 {
    margin: 0;
    font-size: 1.4rem;
    color: var(--navy);
  }
  .item-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  :global(.admin-row) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
  }
  :global(.admin-row-main) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.9rem;
    min-width: 0;
  }
  :global(.admin-row-main a) {
    color: var(--accent);
  }
  :global(.row-detail) {
    color: var(--text-muted);
    font-size: 0.82rem;
    overflow-wrap: break-word;
  }
  :global(.row-actions) {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  :global(.btn-sm) {
    border-radius: var(--radius);
    padding: 0.35rem 0.7rem;
    font-weight: 700;
    font-size: 0.78rem;
    cursor: pointer;
    white-space: nowrap;
    border: none;
    background: var(--accent);
    color: #fff;
  }
  .empty-state {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
