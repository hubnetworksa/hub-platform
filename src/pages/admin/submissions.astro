---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminShell from '../../components/AdminShell.astro';
---

<BaseLayout title="Approvals" description="Review new business submissions." noindex={true}>
  <div id="loading" style="padding:3rem;color:var(--muted);text-align:center;">Loading…</div>

  <div id="content" hidden>
    <AdminShell active="submissions" title="Approvals" subtitle="Submissions waiting for review">
      <div style="display:flex;gap:9px;">
        <button id="bulk-approve" disabled style="padding:10px 14px;border:0;border-radius:9px;background:var(--accent);color:var(--contrast);font-size:13px;font-weight:800;cursor:pointer;">Approve selected</button>
        <button id="bulk-reject" disabled style="padding:10px 14px;border:2px solid var(--border);border-radius:9px;background:#fff;color:var(--danger);font-size:13px;font-weight:800;cursor:pointer;">Reject selected</button>
      </div>
      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div id="submissions-list"></div>
        <div id="submissions-empty" hidden style="padding:40px 18px;text-align:center;">
          <div style="font-size:16px;font-weight:800;color:var(--navy)">Nothing waiting</div>
          <div style="font-size:13.5px;font-weight:600;color:var(--muted);margin-top:5px">Every submission has been reviewed.</div>
        </div>
      </div>
    </AdminShell>
  </div>
</BaseLayout>

<script>
  import { esc, TIER_NAMES, requireAdmin, showContent } from '../../lib/admin-html';

  async function postForm(url: string, params: Record<string, string>): Promise<void> {
    await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(params) });
  }

  interface Submission {
    token: string; name: string; category_slug: string; suburb_slug: string;
    category_name: string | null; suburb_name: string | null;
    address: string | null; phone: string | null; email: string | null; website: string | null;
    description: string; status: string; chosen_tier: number;
  }

  function renderSubmission(s: Submission): string {
    const canAct = s.status === 'Pending your approval';
    const meta = [s.category_name ?? s.category_slug, s.suburb_name ?? s.suburb_slug].filter(Boolean).join(' · ');
    const contact = [s.address, s.phone, s.email, s.website].filter(Boolean).join(' · ');
    const plan = TIER_NAMES[s.chosen_tier] ?? 'Basic';
    return `
      <div style="padding:18px;border-bottom:1px solid var(--border);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center;">
        <div style="min-width:0;display:flex;align-items:flex-start;gap:10px;">
          ${canAct ? `<input type="checkbox" class="submission-check" data-token="${esc(s.token)}" style="margin-top:4px;flex-shrink:0;accent-color:var(--accent);" />` : ''}
          <div style="min-width:0;">
            <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;">
              <span style="font-size:16px;font-weight:800;color:var(--navy);letter-spacing:-.015em">${esc(s.name)}</span>
              <span style="padding:3px 9px;border-radius:999px;background:rgba(var(--accent-rgb),.12);color:var(--accent-hover);font-size:11px;font-weight:800">${plan}</span>
              ${!canAct ? `<span style="padding:3px 9px;border-radius:999px;background:var(--bg-subtle);color:var(--muted);font-size:11px;font-weight:800;">${esc(s.status)}</span>` : ''}
            </div>
            <div style="font-size:13px;font-weight:600;color:var(--muted);margin-top:4px;overflow-wrap:break-word;">${esc(meta)}</div>
            ${contact ? `<div style="font-size:12.5px;font-weight:600;color:var(--muted);margin-top:2px;overflow-wrap:break-word;">${esc(contact)}</div>` : ''}
            <p style="margin:8px 0 0;font-size:13.5px;line-height:1.5;color:var(--text);max-width:64ch;overflow-wrap:break-word;">${esc(s.description)}</p>
          </div>
        </div>
        ${canAct
          ? `<div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;">
              <button data-action="approve" data-token="${esc(s.token)}" style="padding:10px 14px;border:0;border-radius:9px;background:var(--accent);color:var(--contrast);font-size:13px;font-weight:800;cursor:pointer;">Approve</button>
              <button data-action="reject" data-token="${esc(s.token)}" style="padding:10px 14px;border:2px solid var(--border);border-radius:9px;background:#fff;color:var(--danger);font-size:13px;font-weight:800;cursor:pointer;">Reject</button>
            </div>`
          : ''
        }
      </div>`;
  }

  function updateBulkButtons() {
    const anyChecked = document.querySelectorAll('.submission-check:checked').length > 0;
    (document.getElementById('bulk-approve') as HTMLButtonElement).disabled = !anyChecked;
    (document.getElementById('bulk-reject') as HTMLButtonElement).disabled = !anyChecked;
  }

  async function init() {
    if (!(await requireAdmin('/admin/submissions/'))) return;

    const res = await fetch('/api/admin/overview');
    const data = await res.json();
    showContent();

    const n = data.stats.awaitingReview;
    document.getElementById('admin-subtitle')!.textContent = `${n} submission${n === 1 ? '' : 's'} waiting for review`;

    const list = document.getElementById('submissions-list')!;
    const empty = document.getElementById('submissions-empty')!;
    if (data.submissions.length === 0) {
      list.innerHTML = '';
      empty.hidden = false;
    } else {
      empty.hidden = true;
      list.innerHTML = data.submissions.map(renderSubmission).join('');
    }
    updateBulkButtons();
  }

  document.getElementById('content')!.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).classList.contains('submission-check')) updateBulkButtons();
  });

  document.getElementById('bulk-approve')!.addEventListener('click', async () => {
    const tokens = [...document.querySelectorAll('.submission-check:checked')].map((el) => (el as HTMLElement).dataset.token!);
    for (const token of tokens) await postForm('/api/confirm-listing', { token, action: 'approve' });
    init();
  });
  document.getElementById('bulk-reject')!.addEventListener('click', async () => {
    const tokens = [...document.querySelectorAll('.submission-check:checked')].map((el) => (el as HTMLElement).dataset.token!);
    for (const token of tokens) await postForm('/api/confirm-listing', { token, action: 'reject' });
    init();
  });

  document.getElementById('content')!.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    btn.disabled = true;
    await postForm('/api/confirm-listing', { token: btn.dataset.token!, action: btn.dataset.action! });
    init();
  });

  init();
</script>
