---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminShell from '../../components/AdminShell.astro';
import { siteName } from '../../lib/site-overrides';
---

<BaseLayout title="Invoices" description="Billing history and outstanding payments." noindex={true}>
  <div id="loading" style="padding:3rem;color:var(--muted);text-align:center;">Loading…</div>

  <div id="content" hidden data-site-name={siteName}>
    <AdminShell active="invoices" title="Invoices" subtitle="Billing history and outstanding payments">
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <div style="background:#fff;border:2px solid var(--border);border-radius:12px;padding:14px 18px;flex:1;min-width:150px">
          <div style="font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Collected</div>
          <div id="inv-paid" style="font-size:26px;font-weight:800;color:var(--navy);letter-spacing:-.03em;margin-top:6px">—</div>
        </div>
        <div style="background:#fff;border:2px solid var(--danger);border-radius:12px;padding:14px 18px;flex:1;min-width:150px">
          <div style="font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--danger)">Outstanding</div>
          <div id="inv-outstanding" style="font-size:26px;font-weight:800;color:var(--navy);letter-spacing:-.03em;margin-top:6px">—</div>
        </div>
        <button id="inv-export" type="button" style="padding:13px 18px;border:2px solid var(--navy);border-radius:11px;background:#fff;color:var(--navy);font-size:13.5px;font-weight:800;cursor:pointer;align-self:center">Export CSV</button>
      </div>

      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div class="admin-cols" style="gap:12px;padding:12px 18px;border-bottom:2px solid var(--navy);font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">
          <span>Invoice</span><span class="admin-hide">Date &amp; method</span><span class="admin-hide">Amount</span><span>Actions</span>
        </div>
        <div id="inv-rows"></div>
        <div id="inv-empty" hidden style="padding:40px 18px;text-align:center">
          <div style="font-size:16px;font-weight:800;color:var(--navy)">No payments yet</div>
          <div style="font-size:13.5px;font-weight:600;color:var(--muted);margin-top:5px">Payments appear here as soon as PayFast confirms a plan or sponsorship purchase.</div>
        </div>
        <p style="margin:0;padding:12px 18px;font-size:12.5px;font-weight:600;color:var(--muted);border-top:1px solid var(--border)">Each row is a confirmed PayFast payment. <strong>Overdue</strong> means a paid plan or slot passed its renewal date without a new payment arriving. Free plans and admin-comped slots never appear here.</p>
      </div>
    </AdminShell>
  </div>
</BaseLayout>

<script>
  import { esc, randFromCents, statusPillStyle, requireAdmin, showContent, fmtDate } from '../../lib/admin-html';

  interface Invoice {
    id: string; reference: string | null; client: string; product: string; amountCents: number; date: string; status: string; method: string;
  }
  let invoices: Invoice[] = [];

  function render() {
    document.getElementById('inv-empty')!.hidden = invoices.length > 0;
    document.getElementById('inv-rows')!.innerHTML = invoices
      .map(
        (v, i) => `<div class="admin-cols admin-row" style="gap:12px;padding:14px 18px;border-bottom:1px solid var(--border);align-items:center">
          <div style="min-width:0">
            <div style="font-size:14.5px;font-weight:800;color:var(--navy);letter-spacing:-.01em">${esc(v.client)}</div>
            <div style="display:flex;align-items:center;gap:8px;margin-top:4px;flex-wrap:wrap">
              <span style="${statusPillStyle(v.status)}">${esc(v.status)}</span>
              <span style="font-size:12px;font-weight:700;color:var(--muted)">${esc(v.id)}</span>
            </div>
          </div>
          <div class="admin-hide" style="min-width:0;font-size:13px;font-weight:700;color:var(--text)">${esc(fmtDate(v.date))}<br /><span style="font-weight:600;color:var(--muted);font-size:12px">${esc(v.product)} · ${esc(v.method)}</span></div>
          <div class="admin-hide" style="font-size:15px;font-weight:800;color:var(--navy)">${randFromCents(v.amountCents)}</div>
          <div style="display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end">
            ${v.status === 'Paid' ? `<button data-receipt="${i}" style="padding:8px 12px;border:2px solid var(--border);border-radius:8px;background:#fff;color:var(--navy);font-size:12px;font-weight:800;cursor:pointer">PDF</button>` : ''}
          </div>
        </div>`
      )
      .join('');
  }

  // "PDF" opens a print-ready receipt — choose "Save as PDF" in the print dialog.
  function openReceipt(v: Invoice) {
    const site = document.getElementById('content')!.dataset.siteName ?? '';
    const w = window.open('', '_blank', 'width=720,height=800');
    if (!w) return;
    w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Receipt ${esc(v.id)}</title>
      <style>body{font-family:-apple-system,Segoe UI,Roboto,sans-serif;max-width:560px;margin:40px auto;padding:0 20px;color:#101a33}
      h1{font-size:22px;margin:0 0 4px}table{width:100%;border-collapse:collapse;margin-top:24px}td{padding:10px 0;border-bottom:1px solid #d7dfea;font-size:14px}td:first-child{color:#5a6785;width:40%}</style></head>
      <body><h1>${esc(site)} — payment receipt</h1><div style="color:#5a6785;font-size:13px">${esc(v.id)}</div>
      <table><tr><td>Business</td><td>${esc(v.client)}</td></tr><tr><td>Product</td><td>${esc(v.product)}</td></tr>
      <tr><td>Amount</td><td><strong>${randFromCents(v.amountCents)}</strong></td></tr><tr><td>Date</td><td>${esc(fmtDate(v.date))}</td></tr>
      <tr><td>Paid via</td><td>${esc(v.method)}</td></tr>${v.reference ? `<tr><td>PayFast reference</td><td>${esc(v.reference)}</td></tr>` : ''}
      <tr><td>Status</td><td>${esc(v.status)}</td></tr></table></body></html>`);
    w.document.close();
    w.focus();
    w.print();
  }

  document.getElementById('inv-rows')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-receipt]') as HTMLButtonElement | null;
    if (btn) openReceipt(invoices[Number(btn.dataset.receipt)]);
  });

  document.getElementById('inv-export')!.addEventListener('click', () => {
    const cell = (s: string) => `"${s.replace(/"/g, '""')}"`;
    const lines = [['Invoice', 'Business', 'Product', 'Date', 'Amount (R)', 'Status', 'PayFast reference'].map(cell).join(',')];
    for (const v of invoices) {
      lines.push([v.id, v.client, v.product, v.date, (v.amountCents / 100).toFixed(2), v.status, v.reference ?? ''].map((x) => cell(String(x))).join(','));
    }
    const url = URL.createObjectURL(new Blob([lines.join('\r\n')], { type: 'text/csv;charset=utf-8' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = `invoices-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });

  async function init() {
    if (!(await requireAdmin('/admin/invoices/'))) return;
    const res = await fetch('/api/admin/payments');
    const data = await res.json();
    showContent();
    invoices = data.invoices ?? [];
    document.getElementById('inv-paid')!.textContent = randFromCents(data.collectedCents ?? 0);
    document.getElementById('inv-outstanding')!.textContent = randFromCents(data.outstandingCents ?? 0);
    render();
  }

  init();
</script>
