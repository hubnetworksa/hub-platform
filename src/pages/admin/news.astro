---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminShell from '../../components/AdminShell.astro';
---

<BaseLayout title="News" description="Review and remove local news articles." noindex={true}>
  <div id="loading" style="padding:3rem;color:var(--muted);text-align:center;">Loading…</div>

  <div id="content" hidden>
    <AdminShell active="news" title="News" subtitle="Articles written by the daily news routine. Remove anything that is wrong.">
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
        <div style="background:#fff;border:2px solid var(--border);border-radius:12px;padding:14px 18px;flex:1;min-width:150px">
          <div style="font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Articles published</div>
          <div id="stat-total" style="font-size:26px;font-weight:800;color:var(--navy);letter-spacing:-.03em;margin-top:6px">—</div>
        </div>
        <a href="/news/" style="padding:13px 18px;border:2px solid var(--navy);border-radius:11px;background:#fff;color:var(--navy);font-size:13.5px;font-weight:800;text-decoration:none">View public page</a>
      </div>

      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div id="news-list"></div>
      </div>
      <p style="margin:0;font-size:12.5px;color:var(--muted)">Removing an article takes it off the site after the next rebuild &amp; deploy (Dashboard → Rebuild &amp; deploy).</p>
    </AdminShell>
  </div>
</BaseLayout>

<script>
  import { esc, requireAdmin, showContent, postJson, fmtDate } from '../../lib/admin-html';

  interface NewsRow {
    id: number;
    slug: string;
    title: string;
    category: string;
    published_date: string;
    source_name: string;
    source_url: string;
    source: string;
    verification_json: string;
  }

  function safeUrl(v: string): string {
    return /^https?:\/\//i.test(v) ? v : '#';
  }

  async function load() {
    const res = await fetch('/api/admin/news');
    const data = await res.json();
    const rows: NewsRow[] = data.news ?? [];
    document.getElementById('stat-total')!.textContent = String(rows.length);
    const list = document.getElementById('news-list')!;
    if (rows.length === 0) {
      list.innerHTML = '<div style="padding:22px 18px;font-size:14px;color:var(--muted)">No news yet. The daily news routine will add stories here.</div>';
      return;
    }
    list.innerHTML = rows
      .map((r) => {
        let n = 0;
        try {
          n = (JSON.parse(r.verification_json) as unknown[]).length;
        } catch {
          n = 0;
        }
        return `<div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <div style="flex:1;min-width:220px">
            <div style="font-size:14.5px;font-weight:800;color:var(--navy);line-height:1.3">${esc(r.title)}</div>
            <div style="font-size:12px;font-weight:700;color:var(--muted);margin-top:3px">${esc(r.category)} · ${esc(fmtDate(r.published_date))} · <a href="${esc(safeUrl(r.source_url))}" target="_blank" rel="noopener noreferrer" style="color:var(--accent-hover)">${esc(r.source_name)}</a> · ${n} source${n === 1 ? '' : 's'} · ${esc(r.source)}</div>
          </div>
          <a href="/news/${esc(r.slug)}/" style="padding:8px 12px;border:2px solid var(--border);border-radius:8px;background:#fff;font-size:12px;font-weight:800;color:var(--navy);text-decoration:none">View</a>
          <button data-delete="${r.id}" style="padding:8px 12px;border:2px solid var(--border);border-radius:8px;background:#fff;color:var(--danger);font-size:12px;font-weight:800;cursor:pointer">Remove</button>
        </div>`;
      })
      .join('');
    list.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        if (!confirm('Remove this article? It disappears from the site after the next rebuild.')) return;
        const out = await postJson('/api/admin/news', { action: 'delete', id: Number(btn.dataset.delete) });
        if (!out.ok) {
          alert(out.error || 'Could not remove the article.');
          return;
        }
        load();
      }),
    );
  }

  (async () => {
    if (!(await requireAdmin('/admin/news/'))) return;
    showContent();
    await load();
  })();
</script>
