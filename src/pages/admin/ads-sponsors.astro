---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminShell from '../../components/AdminShell.astro';
---

<BaseLayout title="Ads & Sponsors" description="Manage exclusive sponsorship slots." noindex={true}>
  <div id="loading" style="padding:3rem;color:var(--muted);text-align:center;">Loading…</div>

  <div id="content" hidden>
    <AdminShell active="ads" title="Ads & sponsors" subtitle="Exclusive spots — one advertiser holds each at a time.">
      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div style="padding:14px 18px;border-bottom:2px solid var(--navy);">
          <h2 style="margin:0;font-size:15px;letter-spacing:-.015em;color:var(--navy)">Sponsored category &amp; suburb spots</h2>
          <p style="margin:4px 0 0;font-size:12.5px;color:var(--muted);font-weight:600">One advertiser per category and per suburb. Sold slots are marked on the public pages automatically. Comping one here doesn't touch PayFast — it's a manual/off-platform sale.</p>
        </div>
        <div id="sold-list"></div>
        <p id="sold-empty" hidden style="padding:26px 18px;text-align:center;font-size:13.5px;font-weight:700;color:var(--muted);margin:0;">No sponsorship slots sold yet.</p>
      </div>

      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;padding:18px">
        <h2 style="margin:0 0 12px;font-size:15px;letter-spacing:-.015em;color:var(--navy)">Comp a slot</h2>
        <form id="comp-form" style="display:flex;flex-direction:column;gap:14px;max-width:380px;">
          <label style="display:flex;flex-direction:column;gap:6px;font-size:12.5px;font-weight:800;color:var(--navy)">
            Business ID
            <input type="number" name="businessId" required style="padding:12px;border:2px solid var(--border);border-radius:10px;font-size:14px;outline:none;background:#fff;color:var(--text)" />
          </label>
          <label style="display:flex;flex-direction:column;gap:6px;font-size:12.5px;font-weight:800;color:var(--navy)">
            Product
            <select name="productType" required style="padding:12px;border:2px solid var(--border);border-radius:10px;font-size:14px;outline:none;background:#fff;color:var(--text)">
              <option value="category_sponsor">Category sponsor</option>
              <option value="suburb_sponsor">Suburb sponsor</option>
              <option value="homepage_banner">Homepage banner</option>
              <option value="centre_sponsor">Centre sponsorship</option>
            </select>
          </label>
          <label style="display:flex;flex-direction:column;gap:6px;font-size:12.5px;font-weight:800;color:var(--navy)">
            Target slug <span style="font-weight:600;color:var(--muted);font-size:11.5px">category/suburb/centre slug — blank for homepage banner</span>
            <input type="text" name="productTarget" style="padding:12px;border:2px solid var(--border);border-radius:10px;font-size:14px;outline:none;background:#fff;color:var(--text)" />
          </label>
          <button type="submit" style="align-self:flex-start;padding:12px 17px;border:0;border-radius:10px;background:var(--accent);color:var(--contrast);font-size:13.5px;font-weight:800;cursor:pointer;">Assign</button>
          <p id="comp-status" role="status" style="margin:0;font-size:0.85rem;color:var(--muted);"></p>
        </form>
      </div>
    </AdminShell>
  </div>
</BaseLayout>

<script>
  const PRODUCT_LABELS: Record<string, string> = {
    category_sponsor: 'Category sponsor',
    suburb_sponsor: 'Suburb sponsor',
    homepage_banner: 'Homepage banner',
    centre_sponsor: 'Centre sponsorship',
  };

  async function postJson(url: string, body: unknown) {
    const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    return res.json();
  }

  async function loadSold() {
    const res = await fetch('/api/admin/sponsorships');
    const data = await res.json();
    const list = document.getElementById('sold-list')!;
    const empty = document.getElementById('sold-empty')!;
    if (!data.sponsorships || data.sponsorships.length === 0) {
      empty.hidden = false;
      list.innerHTML = '';
      return;
    }
    list.innerHTML = data.sponsorships
      .map(
        (s: { id: number; product_type: string; product_target: string | null; business_name: string }) =>
          `<div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
            <div style="min-width:0;flex:1">
              <div style="font-size:14.5px;font-weight:800;color:var(--navy);">${PRODUCT_LABELS[s.product_type] ?? s.product_type}${s.product_target ? ` — ${s.product_target}` : ''}</div>
              <div style="font-size:12.5px;font-weight:600;color:var(--muted);">sold to ${s.business_name}</div>
            </div>
            <button data-clear="${s.id}" style="padding:8px 11px;border:2px solid var(--border);border-radius:8px;background:#fff;font-size:12px;font-weight:800;color:var(--danger);cursor:pointer;">Clear</button>
          </div>`
      )
      .join('');
  }

  document.getElementById('sold-list')!.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-clear]') as HTMLButtonElement | null;
    if (!btn) return;
    if (!confirm('Clear this sponsorship slot? It becomes available for anyone to buy.')) return;
    btn.disabled = true;
    await postJson('/api/admin/sponsorships', { action: 'clear', id: Number(btn.dataset.clear) });
    loadSold();
  });

  const compForm = document.getElementById('comp-form') as HTMLFormElement;
  compForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('comp-status')!;
    status.textContent = 'Saving…';
    const data = Object.fromEntries(new FormData(compForm).entries());
    const result = await postJson('/api/admin/sponsorships', { action: 'set', businessId: Number(data.businessId), productType: data.productType, productTarget: data.productTarget });
    status.textContent = result.ok ? 'Assigned.' : result.error || 'Something went wrong.';
    if (result.ok) {
      compForm.reset();
      loadSold();
    }
  });

  async function init() {
    const me = await fetch('/api/me');
    if (me.status === 401) {
      window.location.href = '/login/?next=/admin/ads-sponsors/';
      return;
    }
    const meData = await me.json();
    if (!meData.isAdmin) {
      window.location.href = '/my-businesses/';
      return;
    }
    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;
    await loadSold();
  }

  init();
</script>
