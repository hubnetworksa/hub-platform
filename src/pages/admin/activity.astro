---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminShell from '../../components/AdminShell.astro';
---

<BaseLayout title="Recent Activity" description="Audit log of admin decisions." noindex={true}>
  <div id="loading" style="padding:3rem;color:var(--muted);text-align:center;">Loading…</div>

  <div id="content" hidden>
    <AdminShell active="activity" title="Activity" subtitle="Audit log of admin decisions.">
      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div id="activity-list"></div>
        <p id="activity-empty" hidden style="padding:26px 18px;text-align:center;font-size:13.5px;font-weight:700;color:var(--muted);margin:0;">Nothing logged yet.</p>
      </div>
    </AdminShell>
  </div>
</BaseLayout>

<script>
  function renderActivity(a: { kind: string; business_name: string | null; detail: string; created_at: string }): string {
    return `
      <div style="padding:14px 18px;border-bottom:1px solid var(--border);">
        <div style="font-size:14.5px;font-weight:800;color:var(--navy);text-transform:capitalize;">${a.kind.replace(/_/g, ' ')}${a.business_name ? `: ${a.business_name}` : ''}</div>
        <div style="font-size:12.5px;font-weight:600;color:var(--muted);margin-top:3px;">${a.detail}</div>
        <div style="font-size:11.5px;color:var(--muted);margin-top:2px;">${new Date(a.created_at).toLocaleString()}</div>
      </div>`;
  }

  async function init() {
    const me = await fetch('/api/me');
    if (me.status === 401) {
      window.location.href = '/login/?next=/admin/activity/';
      return;
    }
    const meData = await me.json();
    if (!meData.isAdmin) {
      window.location.href = '/my-businesses/';
      return;
    }

    const res = await fetch('/api/admin/activity');
    const data = await res.json();
    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;

    const list = document.getElementById('activity-list')!;
    if (data.activity.length === 0) {
      document.getElementById('activity-empty')!.hidden = false;
    } else {
      list.innerHTML = data.activity.map(renderActivity).join('');
    }
  }

  init();
</script>
