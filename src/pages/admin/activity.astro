---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Recent Activity" description="Audit log of admin decisions." noindex={true}>
  <section class="admin-wrap">
    <div id="loading" class="loading">Loading…</div>

    <div id="content" class="admin" hidden>
      <a href="/admin/" class="back-link">← Admin Dashboard</a>
      <h1>Recent activity</h1>
      <ul id="activity-list" class="item-list"></ul>
      <p id="activity-empty" class="empty-state" hidden>Nothing logged yet.</p>
    </div>
  </section>
</BaseLayout>

<script>
  function renderActivity(a: { kind: string; business_name: string | null; detail: string; created_at: string }): string {
    return `
      <li class="admin-row">
        <div class="admin-row-main">
          <strong>${a.kind.replace(/_/g, ' ')}${a.business_name ? `: ${a.business_name}` : ''}</strong>
          <span class="row-detail">${a.detail}</span>
          <span class="row-detail">${new Date(a.created_at).toLocaleString()}</span>
        </div>
      </li>`;
  }

  async function init() {
    const me = await fetch('/api/me');
    if (me.status === 401) {
      window.location.href = '/login/?next=/admin/activity/';
      return;
    }
    const meData = await me.json();
    if (!meData.isAdmin) {
      window.location.href = '/my-businesses/';
      return;
    }

    const res = await fetch('/api/admin/activity');
    const data = await res.json();
    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;

    const list = document.getElementById('activity-list')!;
    if (data.activity.length === 0) {
      document.getElementById('activity-empty')!.hidden = false;
    } else {
      list.innerHTML = data.activity.map(renderActivity).join('');
    }
  }

  init();
</script>

<style>
  .admin-wrap {
    display: flex;
    justify-content: center;
    padding: 3rem 1rem;
  }
  .loading {
    color: var(--text-muted);
  }
  .admin {
    width: 100%;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .back-link {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
  }
  .back-link:hover {
    text-decoration: underline;
  }
  h1 {
    margin: 0;
    font-size: 1.4rem;
    color: var(--navy);
  }
  .item-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  :global(.admin-row) {
    display: flex;
    align-items: flex-start;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
  }
  :global(.admin-row-main) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.9rem;
  }
  :global(.admin-row-main strong) {
    text-transform: capitalize;
  }
  :global(.row-detail) {
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .empty-state {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
