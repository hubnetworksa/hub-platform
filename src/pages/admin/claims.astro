---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminShell from '../../components/AdminShell.astro';
---

<BaseLayout title="Pending Claims" description="Review business ownership claims." noindex={true}>
  <div id="loading" style="padding:3rem;color:var(--muted);text-align:center;">Loading…</div>

  <div id="content" hidden>
    <AdminShell active="claims" title="Claims" subtitle="Business ownership claims awaiting review.">
      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div id="claims-list"></div>
        <div id="claims-empty" hidden style="padding:40px 18px;text-align:center;">
          <div style="font-size:16px;font-weight:800;color:var(--navy)">Nothing waiting</div>
          <div style="font-size:13.5px;font-weight:600;color:var(--muted);margin-top:5px">No claims waiting for review.</div>
        </div>
      </div>
    </AdminShell>
  </div>
</BaseLayout>

<script>
  async function postForm(url: string, params: Record<string, string>): Promise<void> {
    await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(params) });
  }

  function renderClaim(c: { businessName: string; claimantEmail: string; reviewToken: string; contactName: string | null; contactPhone: string | null; contactEmail: string | null; roleNote: string | null }): string {
    return `
      <div style="padding:18px;border-bottom:1px solid var(--border);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center;">
        <div style="min-width:0;">
          <span style="font-size:16px;font-weight:800;color:var(--navy);letter-spacing:-.015em">${c.businessName}</span>
          <div style="font-size:13px;font-weight:600;color:var(--muted);margin-top:4px;">Account: ${c.claimantEmail}</div>
          <p style="margin:8px 0 0;font-size:13.5px;line-height:1.5;color:var(--text);max-width:64ch;">${c.contactName ?? 'Not specified'} · ${c.contactPhone ?? 'Not specified'} · ${c.contactEmail ?? 'Not specified'} · ${c.roleNote ?? 'Not specified'}</p>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;">
          <button data-action="approve" data-token="${c.reviewToken}" style="padding:10px 14px;border:0;border-radius:9px;background:var(--accent);color:var(--contrast);font-size:13px;font-weight:800;cursor:pointer;">Approve</button>
          <button data-action="reject" data-token="${c.reviewToken}" style="padding:10px 14px;border:2px solid var(--border);border-radius:9px;background:#fff;color:var(--danger);font-size:13px;font-weight:800;cursor:pointer;">Reject</button>
        </div>
      </div>`;
  }

  async function init() {
    const me = await fetch('/api/me');
    if (me.status === 401) {
      window.location.href = '/login/?next=/admin/claims/';
      return;
    }
    const meData = await me.json();
    if (!meData.isAdmin) {
      window.location.href = '/my-businesses/';
      return;
    }

    const res = await fetch('/api/admin/overview');
    const data = await res.json();
    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;

    const list = document.getElementById('claims-list')!;
    if (data.claims.length === 0) {
      document.getElementById('claims-empty')!.hidden = false;
    } else {
      list.innerHTML = data.claims.map(renderClaim).join('');
    }
  }

  document.getElementById('content')!.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    btn.disabled = true;
    await postForm('/api/review-claim', { token: btn.dataset.token!, action: btn.dataset.action! });
    init();
  });

  init();
</script>
