---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminShell from '../../components/AdminShell.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout title="Manage Businesses" description="Publish, hide, edit, delete, or reassign any business." noindex={true}>
  <div id="loading" style="padding:3rem;color:var(--muted);text-align:center;">Loading…</div>

  <div id="content" hidden>
    <AdminShell active="listings" title="Listings" subtitle="Add, edit, re-plan or remove any business">
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
        <div style="display:flex;align-items:center;gap:9px;padding:0 13px;background:#fff;border:2px solid var(--border);border-radius:11px;flex:1;min-width:220px">
          <Icon path='<circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.5-4.5"/>' size={17} />
          <input type="text" id="manage-search-input" autocomplete="off" placeholder="Filter by name, category or suburb…" style="flex:1;min-width:0;border:0;padding:12px 0;font-size:14px;outline:none;background:transparent;color:var(--text)" />
        </div>
        <div id="plan-filters" style="display:contents">
          {['All', 'Featured', 'Verified', 'Basic', 'Hidden'].map((f) => (
            <button type="button" data-plan-filter={f} style={`padding:11px 15px;border-radius:11px;cursor:pointer;font-size:13px;font-weight:800;border:2px solid ${f === 'All' ? 'var(--navy)' : 'var(--border)'};background:${f === 'All' ? 'var(--navy)' : '#fff'};color:${f === 'All' ? '#fff' : 'var(--navy)'}`}>{f}</button>
          ))}
        </div>
      </div>

      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div class="admin-cols" style="gap:12px;padding:12px 18px;border-bottom:2px solid var(--navy);font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">
          <span>Business</span><span class="admin-hide">Category</span><span class="admin-hide">Plan</span><span>Actions</span>
        </div>
        <div id="manage-search-results"></div>
        <div id="manage-empty" hidden style="padding:30px 18px;text-align:center;font-size:13.5px;font-weight:700;color:var(--muted)">No listings match that filter.</div>
        <div style="padding:13px 18px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
          <span id="manage-count" style="font-size:12.5px;font-weight:700;color:var(--muted)"></span>
          <span style="display:flex;gap:9px;flex-wrap:wrap">
            <button id="manage-more" type="button" hidden style="padding:10px 14px;border:2px solid var(--border);border-radius:9px;background:#fff;color:var(--navy);font-size:13px;font-weight:800;cursor:pointer">Show more</button>
            <button id="manage-add" type="button" style="padding:10px 14px;border:2px solid var(--navy);border-radius:9px;background:#fff;color:var(--navy);font-size:13px;font-weight:800;cursor:pointer">+ Add listing</button>
          </span>
        </div>
      </div>
    </AdminShell>
  </div>
</BaseLayout>

<script>
  import { esc, planPillStyle, TIER_NAMES, postJson, requireAdmin, showContent } from '../../lib/admin-html';

  interface Row {
    id: number;
    slug: string;
    name: string;
    status: string;
    subscription_tier: number;
    phone: string | null;
    suburb_name: string | null;
    category_name: string | null;
  }

  const PAGE = 25;
  let planFilter = 'All';
  let rows: Row[] = [];
  let matching = 0;
  let total = 0;
  let requestSeq = 0;

  function renderRow(b: Row): string {
    const tier = b.subscription_tier ?? 0;
    const plan = TIER_NAMES[tier] ?? 'Basic';
    const sub = [b.suburb_name, b.phone].filter(Boolean).join(' · ');
    const hidden = b.status !== 'published';
    return `
      <div class="admin-cols admin-row" style="gap:12px;padding:14px 18px;border-bottom:1px solid var(--border);align-items:center">
        <div style="min-width:0">
          <div style="font-size:14.5px;font-weight:800;color:var(--navy);letter-spacing:-.01em">${esc(b.name)}${hidden ? ' <span style="margin-left:6px;padding:2px 8px;border-radius:999px;background:var(--bg-subtle);color:var(--muted);font-size:10.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;vertical-align:1px">Hidden</span>' : ''}</div>
          <div style="font-size:12.5px;font-weight:600;color:var(--muted)">${esc(sub || `status: ${b.status}`)}</div>
        </div>
        <div class="admin-hide" style="min-width:0;font-size:13px;font-weight:700;color:var(--text)">${esc(b.category_name ?? '')}</div>
        <div class="admin-hide"><span style="${planPillStyle(plan)}">${plan}</span></div>
        <div style="display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end">
          <button data-cycle="${b.id}" class="admin-btn-plan" style="padding:8px 11px;border:2px solid var(--border);border-radius:8px;background:#fff;font-size:12px;font-weight:800;color:var(--navy);cursor:pointer">Plan</button>
          <button data-edit="${b.id}" style="padding:8px 11px;border:0;border-radius:8px;background:var(--navy);color:#fff;font-size:12px;font-weight:800;cursor:pointer">Edit</button>
          <button data-delete="${b.id}" class="admin-btn-remove" style="padding:8px 11px;border:2px solid var(--border);border-radius:8px;background:#fff;color:var(--danger);font-size:12px;font-weight:800;cursor:pointer">Remove</button>
        </div>
      </div>`;
  }

  function render() {
    document.getElementById('manage-search-results')!.innerHTML = rows.map(renderRow).join('');
    document.getElementById('manage-empty')!.hidden = rows.length > 0;
    document.getElementById('manage-count')!.textContent = `${rows.length.toLocaleString('en-US')} of ${matching.toLocaleString('en-US')} listing${matching === 1 ? '' : 's'}${matching !== total ? ` (${total.toLocaleString('en-US')} in total)` : ''}`;
    (document.getElementById('manage-more') as HTMLButtonElement).hidden = rows.length >= matching;
  }

  async function load(append = false) {
    const seq = ++requestSeq;
    const q = (document.getElementById('manage-search-input') as HTMLInputElement).value.trim();
    const params = new URLSearchParams({ limit: String(PAGE), offset: String(append ? rows.length : 0) });
    if (q) params.set('q', q);
    if (planFilter === 'Hidden') params.set('status', 'hidden');
    else if (planFilter !== 'All') params.set('plan', planFilter);
    const res = await fetch(`/api/admin/listings?${params}`);
    const data = await res.json();
    if (seq !== requestSeq || !data.ok) return;
    rows = append ? rows.concat(data.results) : data.results;
    matching = data.matching;
    total = data.total;
    render();
  }

  let searchDebounce: number;
  document.getElementById('manage-search-input')!.addEventListener('input', () => {
    clearTimeout(searchDebounce);
    searchDebounce = window.setTimeout(() => load(), 250);
  });

  document.getElementById('plan-filters')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-plan-filter]') as HTMLButtonElement | null;
    if (!btn) return;
    planFilter = btn.dataset.planFilter!;
    document.querySelectorAll<HTMLButtonElement>('button[data-plan-filter]').forEach((b) => {
      const active = b === btn;
      b.style.borderColor = active ? 'var(--navy)' : 'var(--border)';
      b.style.background = active ? 'var(--navy)' : '#fff';
      b.style.color = active ? '#fff' : 'var(--navy)';
    });
    load();
  });

  document.getElementById('manage-more')!.addEventListener('click', () => load(true));
  document.getElementById('manage-add')!.addEventListener('click', () => (window as unknown as { adminListing: { open: () => void } }).adminListing.open());
  document.addEventListener('admin:listing-saved', () => load());

  // Basic -> Verified -> Featured -> Basic (the mockup's "Plan" button).
  const CYCLE: Record<number, number> = { 0: 1, 1: 2, 2: 0 };

  document.getElementById('content')!.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    const editBtn = target.closest('button[data-edit]') as HTMLButtonElement | null;
    if (editBtn) {
      (window as unknown as { adminListing: { open: (id: number) => void } }).adminListing.open(Number(editBtn.dataset.edit));
      return;
    }

    const cycleBtn = target.closest('button[data-cycle]') as HTMLButtonElement | null;
    if (cycleBtn) {
      const id = Number(cycleBtn.dataset.cycle);
      const row = rows.find((r) => r.id === id);
      if (!row) return;
      const next = CYCLE[row.subscription_tier ?? 0] ?? 1;
      cycleBtn.disabled = true;
      const result = await postJson('/api/admin/subscriptions', { businessId: id, tier: next });
      if (result.ok) row.subscription_tier = next;
      render();
      return;
    }

    const deleteBtn = target.closest('button[data-delete]') as HTMLButtonElement | null;
    if (deleteBtn) {
      const id = Number(deleteBtn.dataset.delete);
      const row = rows.find((r) => r.id === id);
      if (!window.confirm(`Permanently delete "${row?.name ?? 'this business'}"? This can't be undone.`)) return;
      deleteBtn.disabled = true;
      await postJson('/api/admin/delete-business', { businessId: id });
      load();
    }
  });

  async function init() {
    if (!(await requireAdmin('/admin/businesses/'))) return;
    showContent();
    await load();
    if (new URLSearchParams(window.location.search).get('new')) {
      history.replaceState(null, '', window.location.pathname);
      (window as unknown as { adminListing: { open: () => void } }).adminListing.open();
    }
  }

  init();
</script>
