---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminShell from '../../components/AdminShell.astro';
---

<BaseLayout title="Manage Businesses" description="Publish, hide, edit, delete, or reassign any business." noindex={true}>
  <div id="loading" style="padding:3rem;color:var(--muted);text-align:center;">Loading…</div>

  <div id="content" hidden>
    <AdminShell active="listings" title="Listings" subtitle="Publish, hide, edit, delete, or reassign any business.">
      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div style="padding:14px 18px;border-bottom:2px solid var(--navy)">
          <h2 style="margin:0;font-size:15px;letter-spacing:-.015em;color:var(--navy)">Hidden businesses</h2>
          <p style="margin:4px 0 0;font-size:12.5px;color:var(--muted);font-weight:600">Not on the public site — used for test listings.</p>
        </div>
        <div id="hidden-list"></div>
        <p id="hidden-empty" hidden style="padding:26px 18px;text-align:center;font-size:13.5px;font-weight:700;color:var(--muted);margin:0;">Nothing hidden right now.</p>
      </div>

      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div style="padding:14px 18px;border-bottom:2px solid var(--navy)">
          <h2 style="margin:0;font-size:15px;letter-spacing:-.015em;color:var(--navy)">Find any business</h2>
          <p style="margin:4px 0 0;font-size:12.5px;color:var(--muted);font-weight:600">Publish, hide, edit, delete, or reassign the owner.</p>
        </div>
        <div style="padding:14px 18px;border-bottom:1px solid var(--border)">
          <div style="display:flex;align-items:center;gap:9px;padding:0 13px;background:var(--bg-subtle);border:2px solid var(--border);border-radius:11px">
            <input type="text" id="manage-search-input" autocomplete="off" placeholder="Filter by name…" style="flex:1;min-width:0;border:0;padding:12px 0;font-size:14px;outline:none;background:transparent;color:var(--text)" />
          </div>
        </div>
        <div id="manage-search-results"></div>
      </div>
    </AdminShell>
  </div>
</BaseLayout>

<script>
  async function postJson(url: string, body: unknown): Promise<void> {
    await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  }

  const TIER_NAMES: Record<number, string> = { 0: 'Basic', 1: 'Verified', 2: 'Featured' };

  function renderToggleRow(b: { id: number; name: string; status: string; subscription_tier?: number }): string {
    const isPublished = b.status === 'published';
    const tier = b.subscription_tier ?? 0;
    const planOptions = [0, 1, 2].map((t) => `<option value="${t}" ${t === tier ? 'selected' : ''}>${TIER_NAMES[t]}</option>`).join('');
    return `
      <div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <div style="min-width:0;flex:1">
          <div style="font-size:14.5px;font-weight:800;color:var(--navy)">${b.name}</div>
          <div style="font-size:12.5px;font-weight:600;color:var(--muted)">status: ${b.status}</div>
        </div>
        <div style="display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end;">
          <select class="plan-select" data-plan-business-id="${b.id}" style="padding:8px 10px;border:2px solid var(--border);border-radius:8px;background:#fff;font-size:12px;font-weight:700;color:var(--navy);">${planOptions}</select>
          <button data-toggle="${isPublished ? 'hide' : 'publish'}" data-business-id="${b.id}" style="padding:8px 11px;border:0;border-radius:8px;background:var(--accent);color:var(--contrast);font-size:12px;font-weight:800;cursor:pointer;">${isPublished ? 'Hide' : 'Publish'}</button>
          <a href="/my-businesses/edit/?id=${b.id}" style="padding:8px 11px;border:2px solid var(--border);border-radius:8px;background:#fff;font-size:12px;font-weight:800;color:var(--navy);text-decoration:none;">Edit</a>
          <button data-reassign="${b.id}" data-business-name="${b.name}" style="padding:8px 11px;border:2px solid var(--border);border-radius:8px;background:#fff;font-size:12px;font-weight:800;color:var(--navy);cursor:pointer;">Reassign</button>
          <button data-delete="${b.id}" data-business-name="${b.name}" style="padding:8px 11px;border:2px solid var(--border);border-radius:8px;background:#fff;font-size:12px;font-weight:800;color:var(--danger);cursor:pointer;">Remove</button>
        </div>
      </div>`;
  }

  async function loadHidden() {
    const res = await fetch('/api/admin/overview');
    const data = await res.json();
    const list = document.getElementById('hidden-list')!;
    const empty = document.getElementById('hidden-empty')!;
    empty.hidden = true;
    if (data.hidden.length === 0) {
      empty.hidden = false;
      list.innerHTML = '';
    } else {
      list.innerHTML = data.hidden.map(renderToggleRow).join('');
    }
  }

  let searchDebounce: number;
  document.getElementById('manage-search-input')!.addEventListener('input', (e) => {
    clearTimeout(searchDebounce);
    const q = (e.target as HTMLInputElement).value.trim();
    const results = document.getElementById('manage-search-results')!;
    if (q.length < 2) {
      results.innerHTML = '';
      return;
    }
    searchDebounce = window.setTimeout(async () => {
      const res = await fetch(`/api/admin/search-businesses?q=${encodeURIComponent(q)}`);
      const data = await res.json();
      results.innerHTML = data.results.map(renderToggleRow).join('') || '<p style="padding:20px 18px;color:var(--muted);margin:0;">No matches.</p>';
    }, 300);
  });

  async function init() {
    const me = await fetch('/api/me');
    if (me.status === 401) {
      window.location.href = '/login/?next=/admin/businesses/';
      return;
    }
    const meData = await me.json();
    if (!meData.isAdmin) {
      window.location.href = '/my-businesses/';
      return;
    }

    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;
    await loadHidden();
  }

  document.getElementById('content')!.addEventListener('change', async (e) => {
    const select = (e.target as HTMLElement).closest('select[data-plan-business-id]') as HTMLSelectElement | null;
    if (!select) return;
    select.disabled = true;
    await postJson('/api/admin/subscriptions', { businessId: Number(select.dataset.planBusinessId), tier: Number(select.value) });
    select.disabled = false;
  });

  document.getElementById('content')!.addEventListener('click', async (e) => {
    const toggleBtn = (e.target as HTMLElement).closest('button[data-toggle]') as HTMLButtonElement | null;
    if (toggleBtn) {
      toggleBtn.disabled = true;
      const newStatus = toggleBtn.dataset.toggle === 'publish' ? 'published' : 'rejected';
      await postJson('/api/admin/toggle-business-status', { businessId: Number(toggleBtn.dataset.businessId), status: newStatus });
      loadHidden();
      (document.getElementById('manage-search-input') as HTMLInputElement).dispatchEvent(new Event('input'));
      return;
    }

    const reassignBtn = (e.target as HTMLElement).closest('button[data-reassign]') as HTMLButtonElement | null;
    if (reassignBtn) {
      const name = reassignBtn.dataset.businessName;
      const email = window.prompt(`Set the owner's email for "${name}" (leave blank to unlink):`);
      if (email === null) return;
      reassignBtn.disabled = true;
      await postJson('/api/admin/set-business-owner', { businessId: Number(reassignBtn.dataset.reassign), userEmail: email.trim() || null });
      loadHidden();
      return;
    }

    const deleteBtn = (e.target as HTMLElement).closest('button[data-delete]') as HTMLButtonElement | null;
    if (deleteBtn) {
      if (!window.confirm(`Permanently delete "${deleteBtn.dataset.businessName}"? This can't be undone.`)) return;
      deleteBtn.disabled = true;
      await postJson('/api/admin/delete-business', { businessId: Number(deleteBtn.dataset.delete) });
      loadHidden();
      (document.getElementById('manage-search-input') as HTMLInputElement).dispatchEvent(new Event('input'));
      return;
    }
  });

  init();
</script>
