---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../site';
---

<BaseLayout title="Users" description={`Registered ${site.siteName} accounts.`}>
  <section class="admin-wrap">
    <div id="loading" class="loading">Loading…</div>

    <div id="content" class="admin" hidden>
      <a href="/admin/" class="back-link">← Admin Dashboard</a>
      <h1>Users</h1>
      <p class="panel-hint">To move a business between accounts, use Reassign on the <a href="/admin/businesses/">Businesses</a> page.</p>
      <ul id="users-list" class="item-list"></ul>
      <p id="users-empty" class="empty-state" hidden>No accounts yet.</p>
    </div>
  </section>
</BaseLayout>

<script>
  function renderUser(u: { email: string; created_at: string; owned_count: number }): string {
    return `
      <li class="admin-row">
        <div class="admin-row-main">
          <strong>${u.email}</strong>
          <span class="row-detail">Joined ${new Date(u.created_at).toLocaleDateString()} · owns ${u.owned_count} business${u.owned_count === 1 ? '' : 'es'}</span>
        </div>
      </li>`;
  }

  async function init() {
    const me = await fetch('/api/me');
    if (me.status === 401) {
      window.location.href = '/login/?next=/admin/users/';
      return;
    }
    const meData = await me.json();
    if (!meData.isAdmin) {
      window.location.href = '/my-businesses/';
      return;
    }

    const res = await fetch('/api/admin/users');
    const data = await res.json();
    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;

    const list = document.getElementById('users-list')!;
    if (data.users.length === 0) {
      document.getElementById('users-empty')!.hidden = false;
    } else {
      list.innerHTML = data.users.map(renderUser).join('');
    }
  }

  init();
</script>

<style>
  .admin-wrap {
    display: flex;
    justify-content: center;
    padding: 3rem 1rem;
  }
  .loading {
    color: var(--text-muted);
  }
  .admin {
    width: 100%;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .back-link {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
  }
  .back-link:hover {
    text-decoration: underline;
  }
  h1 {
    margin: 0;
    font-size: 1.4rem;
    color: var(--navy);
  }
  .panel-hint {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .panel-hint a {
    color: var(--accent);
  }
  .item-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  :global(.admin-row) {
    display: flex;
    align-items: flex-start;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
  }
  :global(.admin-row-main) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.9rem;
  }
  :global(.row-detail) {
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .empty-state {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
