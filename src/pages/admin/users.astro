---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminShell from '../../components/AdminShell.astro';
import site from '../../site';
---

<BaseLayout title="Users" description={`Registered ${site.siteName} accounts.`} noindex={true}>
  <div id="loading" style="padding:3rem;color:var(--muted);text-align:center;">Loading…</div>

  <div id="content" hidden>
    <AdminShell active="users" title="Users" subtitle="Registered accounts.">
      <p style="margin:0;font-size:13px;color:var(--muted);font-weight:600;">To move a business between accounts, use Reassign on the <a href="/admin/businesses/" style="color:var(--accent);">Listings</a> page.</p>
      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div id="users-list"></div>
        <p id="users-empty" hidden style="padding:26px 18px;text-align:center;font-size:13.5px;font-weight:700;color:var(--muted);margin:0;">No accounts yet.</p>
      </div>
    </AdminShell>
  </div>
</BaseLayout>

<script>
  function renderUser(u: { email: string; created_at: string; owned_count: number }): string {
    return `
      <div style="padding:14px 18px;border-bottom:1px solid var(--border);">
        <div style="font-size:14.5px;font-weight:800;color:var(--navy);">${u.email}</div>
        <div style="font-size:12.5px;font-weight:600;color:var(--muted);margin-top:3px;">Joined ${new Date(u.created_at).toLocaleDateString()} · owns ${u.owned_count} business${u.owned_count === 1 ? '' : 'es'}</div>
      </div>`;
  }

  async function init() {
    const me = await fetch('/api/me');
    if (me.status === 401) {
      window.location.href = '/login/?next=/admin/users/';
      return;
    }
    const meData = await me.json();
    if (!meData.isAdmin) {
      window.location.href = '/my-businesses/';
      return;
    }

    const res = await fetch('/api/admin/users');
    const data = await res.json();
    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;

    const list = document.getElementById('users-list')!;
    if (data.users.length === 0) {
      document.getElementById('users-empty')!.hidden = false;
    } else {
      list.innerHTML = data.users.map(renderUser).join('');
    }
  }

  init();
</script>
