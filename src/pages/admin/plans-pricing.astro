---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminShell from '../../components/AdminShell.astro';
---

<BaseLayout title="Plans & Pricing" description="Edit plan and sponsorship pricing." noindex={true}>
  <div id="loading" style="padding:3rem;color:var(--muted);text-align:center;">Loading…</div>

  <div id="content" hidden>
    <AdminShell active="plans" title="Plans & pricing" subtitle="Prices drive the public Pricing page and every checkout.">
      <div id="price-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px"></div>

      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;padding:18px">
        <h2 style="margin:0 0 6px;font-size:15px;letter-spacing:-.015em;color:var(--navy)">Live everywhere</h2>
        <p style="margin:0;font-size:13.5px;line-height:1.55;color:var(--text)">Prices set here drive the public Pricing page, the plan picker inside the signup flow, and every upgrade prompt — on the next rebuild for static pages, immediately for new checkouts.</p>
        <a href="/pricing/" style="display:inline-block;margin-top:13px;padding:11px 15px;border:2px solid var(--navy);border-radius:9px;background:#fff;color:var(--navy);font-size:13px;font-weight:800;text-decoration:none;">View public pricing page</a>
      </div>

      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div style="padding:14px 18px;border-bottom:2px solid var(--navy);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
          <h2 style="margin:0;font-size:15px;letter-spacing:-.015em;color:var(--navy)">Subscribers</h2>
          <span id="mrr" style="font-size:13px;font-weight:800;color:var(--navy);"></span>
        </div>
        <div id="subs-list"></div>
        <p id="subs-empty" hidden style="padding:26px 18px;text-align:center;font-size:13.5px;font-weight:700;color:var(--muted);margin:0;">No active subscribers yet.</p>
      </div>
    </AdminShell>
  </div>
</BaseLayout>

<script>
  const TIER_KEYS = [
    { key: 'price_verified_cents', label: 'Verified plan', accent: false },
    { key: 'price_featured_cents', label: 'Featured plan', accent: true },
  ];
  const SPONSOR_KEYS: Record<string, string> = {
    price_sponsor_category_cents: 'Category sponsor',
    price_sponsor_suburb_cents: 'Suburb sponsor',
    price_sponsor_banner_cents: 'Homepage banner',
    price_sponsor_centre_cents: 'Centre sponsorship',
  };

  async function postJson(url: string, body: unknown) {
    const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    return res.json();
  }

  async function loadSubscribers() {
    const res = await fetch('/api/admin/subscriptions');
    const data = await res.json();
    const list = document.getElementById('subs-list')!;
    const empty = document.getElementById('subs-empty')!;
    if (!data.subscriptions || data.subscriptions.length === 0) {
      empty.hidden = false;
    } else {
      list.innerHTML = data.subscriptions
        .map(
          (s: { name: string; tierName: string; subscription_status: string; priceRand: string }) =>
            `<div style="padding:14px 18px;border-bottom:1px solid var(--border);">
              <div style="font-size:14.5px;font-weight:800;color:var(--navy);">${s.name}</div>
              <div style="font-size:12.5px;font-weight:600;color:var(--muted);margin-top:3px;">${s.tierName} — ${s.subscription_status} — R${s.priceRand}/mo</div>
            </div>`
        )
        .join('');
    }
    document.getElementById('mrr')!.textContent = `Tier MRR: R${data.monthlyRevenueRand}`;
  }

  async function loadPrices() {
    const res = await fetch('/api/admin/site-settings');
    const data = await res.json();
    const settingsByKey = new Map(data.settings.map((s: { key: string; value: string }) => [s.key, s.value]));

    document.getElementById('price-cards')!.innerHTML = TIER_KEYS.map(({ key, label, accent }) => {
      const rand = (Number(settingsByKey.get(key) ?? 0) / 100).toFixed(2);
      return `
        <div style="background:#fff;border:2px solid ${accent ? 'var(--accent)' : 'var(--border)'};border-radius:14px;padding:20px">
          <div style="font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:${accent ? 'var(--accent)' : 'var(--muted)'}">${label}</div>
          <div style="display:flex;align-items:baseline;gap:6px;margin-top:10px">
            <span style="font-size:22px;font-weight:800;color:var(--navy)">R</span>
            <input type="number" min="0" step="0.01" value="${rand}" data-key="${key}" class="price-input" style="width:120px;padding:10px 12px;border:2px solid var(--border);border-radius:10px;font-size:22px;font-weight:800;color:var(--navy);outline:none;background:#fff" />
            <span style="font-size:13px;font-weight:700;color:var(--muted)">/ month</span>
          </div>
          <button type="button" data-save="${key}" style="margin-top:12px;padding:9px 14px;border:2px solid var(--border);border-radius:9px;background:#fff;color:var(--navy);font-size:12.5px;font-weight:800;cursor:pointer;">Save</button>
        </div>`;
    }).join('') + Object.entries(SPONSOR_KEYS).map(([key, label]) => {
      const rand = (Number(settingsByKey.get(key) ?? 0) / 100).toFixed(2);
      return `
        <div style="background:#fff;border:2px solid var(--border);border-radius:14px;padding:20px">
          <div style="font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">${label}</div>
          <div style="display:flex;align-items:baseline;gap:6px;margin-top:10px">
            <span style="font-size:22px;font-weight:800;color:var(--navy)">R</span>
            <input type="number" min="0" step="0.01" value="${rand}" data-key="${key}" class="price-input" style="width:120px;padding:10px 12px;border:2px solid var(--border);border-radius:10px;font-size:22px;font-weight:800;color:var(--navy);outline:none;background:#fff" />
            <span style="font-size:13px;font-weight:700;color:var(--muted)">/ month</span>
          </div>
          <button type="button" data-save="${key}" style="margin-top:12px;padding:9px 14px;border:2px solid var(--border);border-radius:9px;background:#fff;color:var(--navy);font-size:12.5px;font-weight:800;cursor:pointer;">Save</button>
        </div>`;
    }).join('');
  }

  document.getElementById('price-cards')!.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-save]') as HTMLButtonElement | null;
    if (!btn) return;
    const key = btn.dataset.save!;
    const input = document.querySelector(`input[data-key="${key}"]`) as HTMLInputElement;
    const cents = Math.round(Number(input.value) * 100);
    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = 'Saving…';
    const result = await postJson('/api/admin/site-settings', { key, cents });
    btn.textContent = result.ok ? 'Saved' : result.error || 'Error';
    btn.disabled = false;
    setTimeout(() => (btn.textContent = original), 1500);
  });

  async function init() {
    const me = await fetch('/api/me');
    if (me.status === 401) {
      window.location.href = '/login/?next=/admin/plans-pricing/';
      return;
    }
    const meData = await me.json();
    if (!meData.isAdmin) {
      window.location.href = '/my-businesses/';
      return;
    }
    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;
    await Promise.all([loadSubscribers(), loadPrices()]);
  }

  init();
</script>
