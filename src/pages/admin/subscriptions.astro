---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Subscriptions" description="Manage Premium Listing subscriptions.">
  <section class="admin-wrap">
    <div id="loading" class="loading">Loading…</div>

    <div id="content" class="admin" hidden>
      <a href="/admin/" class="back-link">← Admin Dashboard</a>
      <h1>Subscriptions</h1>
      <p id="revenue-line" class="revenue-line"></p>
      <ul id="subs-list" class="item-list"></ul>
      <p id="subs-empty" class="empty-state" hidden>No subscriptions yet.</p>
    </div>
  </section>
</BaseLayout>

<script>
  interface Row {
    id: number;
    name: string;
    subscription_tier: number;
    subscription_status: string;
    subscription_expires_at: string | null;
    tierName: string;
    priceRand: number;
  }

  function renderRow(r: Row): string {
    const expires = r.subscription_expires_at ? new Date(r.subscription_expires_at).toLocaleDateString() : '—';
    return `
      <li class="admin-row">
        <div class="admin-row-main">
          <strong>${r.name}</strong>
          <span class="row-detail">${r.tierName} · R${r.priceRand}/mo · ${r.subscription_status}</span>
          <span class="row-detail">Renews/expires: ${expires}</span>
        </div>
        <div class="row-actions">
          <button class="btn-sm btn-comp" data-comp="${r.id}" data-tier="0">Set Free</button>
        </div>
      </li>`;
  }

  async function init() {
    const me = await fetch('/api/me');
    if (me.status === 401) {
      window.location.href = '/login/?next=/admin/subscriptions/';
      return;
    }
    const meData = await me.json();
    if (!meData.isAdmin) {
      window.location.href = '/my-businesses/';
      return;
    }

    const res = await fetch('/api/admin/subscriptions');
    const data = await res.json();
    document.getElementById('loading')!.hidden = true;
    document.getElementById('content')!.hidden = false;

    document.getElementById('revenue-line')!.textContent = `R${data.monthlyRevenue}/mo across ${data.subscriptions.filter((r: Row) => r.subscription_status === 'active').length} active subscriptions`;

    const list = document.getElementById('subs-list')!;
    if (data.subscriptions.length === 0) {
      document.getElementById('subs-empty')!.hidden = false;
    } else {
      list.innerHTML = data.subscriptions.map(renderRow).join('');
    }
  }

  document.getElementById('content')!.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-comp]') as HTMLButtonElement | null;
    if (!btn) return;
    btn.disabled = true;
    await fetch('/api/admin/subscriptions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ businessId: Number(btn.dataset.comp), tier: Number(btn.dataset.tier) }),
    });
    init();
  });

  init();
</script>

<style>
  .admin-wrap {
    display: flex;
    justify-content: center;
    padding: 3rem 1rem;
  }
  .loading {
    color: var(--text-muted);
  }
  .admin {
    width: 100%;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .back-link {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
  }
  .back-link:hover {
    text-decoration: underline;
  }
  h1 {
    margin: 0;
    font-size: 1.4rem;
    color: var(--navy);
  }
  .revenue-line {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .item-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  :global(.admin-row) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
  }
  :global(.admin-row-main) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.9rem;
    min-width: 0;
  }
  :global(.row-detail) {
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  :global(.row-actions) {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  :global(.btn-sm) {
    border-radius: var(--radius);
    padding: 0.35rem 0.7rem;
    font-weight: 700;
    font-size: 0.78rem;
    cursor: pointer;
    white-space: nowrap;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text);
  }
  .empty-state {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
