---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { categories, businessesInCategory, type Business } from '../../lib/data';
import { CATEGORY_GROUPS } from '../../lib/categoryGroups';
import { collectionPageJsonLd } from '../../lib/seo';
import site from '../../site';

export function getStaticPaths() {
  return CATEGORY_GROUPS.map((group) => ({ params: { slug: group.slug }, props: { group } }));
}

const { group } = Astro.props;
const categoryBySlug = new Map(categories.map((c) => [c.slug, c]));

const byCategory: { name: string; slug: string; businesses: Business[] }[] = [];
for (const slug of group.categorySlugs) {
  const category = categoryBySlug.get(slug);
  if (!category) continue;
  const businesses = businessesInCategory(category.id);
  if (businesses.length === 0) continue;
  byCategory.push({ name: category.name, slug: category.slug, businesses });
}
byCategory.sort((a, b) => a.name.localeCompare(b.name));
const total = byCategory.reduce((sum, c) => sum + c.businesses.length, 0);

const jsonLd = collectionPageJsonLd({
  name: group.name,
  description: `${total} ${group.name} businesses across ${site.cityLabel}.`,
  url: `https://${site.domain}/section/${group.slug}/`,
  items: byCategory.flatMap((c) => c.businesses.map((b) => ({ name: b.name, url: `https://${site.domain}/business/${b.slug}/` }))),
});
---

<BaseLayout
  title={group.name}
  description={`${total} ${group.name} businesses across ${site.cityLabel}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main>
    <section style="position:relative;background:var(--navy);overflow:hidden;min-height:clamp(200px,26vw,320px)">
      <img src={site.sectionBannerImage} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%" />
      <div style="position:absolute;inset:0;background:linear-gradient(100deg,rgba(var(--navy-rgb),.93) 0%,rgba(var(--navy-rgb),.74) 50%,rgba(var(--navy-rgb),.24) 100%)"></div>
      <div style="position:relative;max-width:1200px;margin:0 auto;padding:26px 20px 30px">
        <Breadcrumbs variant="plain" onDark items={[{ label: 'Categories', href: '/category/' }, { label: group.name }]} />
        <h1 style="margin:14px 0 10px;color:#fff;font-size:clamp(28px,4.6vw,46px);letter-spacing:-.03em;line-height:1.04;display:flex;align-items:center;gap:12px;">
          <Icon path={group.iconPath} size={34} />
          {group.name}
        </h1>
        <p style="margin:0;color:rgba(255,255,255,.86);font-size:15.5px;max-width:58ch;line-height:1.55">{total} businesses listed in this section.</p>
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:22px 20px 60px">
      {byCategory.length === 0 ? (
        <p style="color:var(--muted);">None listed yet.</p>
      ) : (
        byCategory.map((cat, i) => (
          <div style={i > 0 ? 'margin-top:30px;' : ''}>
            <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-bottom:2px solid var(--navy);padding-bottom:10px;flex-wrap:wrap">
              <h2 style="margin:0;font-size:18px;letter-spacing:-.02em;color:var(--navy)">{cat.name} <span style="font-weight:600;color:var(--muted);font-size:14px">({cat.businesses.length})</span></h2>
              <a href={`/category/${cat.slug}/`} style="font-size:13px;font-weight:800;color:var(--accent);white-space:nowrap;text-decoration:none">View all {cat.name} →</a>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;margin-top:14px">
              {cat.businesses.map((business) => <BusinessCard business={business} />)}
            </div>
          </div>
        ))
      )}
    </section>
  </main>
</BaseLayout>
