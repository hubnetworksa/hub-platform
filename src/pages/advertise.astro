---
import BaseLayout from '../layouts/BaseLayout.astro';
import site, { SITES } from '../site';
import { businesses, suburbs, categories } from '../lib/data';

const network = Object.values(SITES);
const COLORS: Record<string, string> = { pretoria: '#1d6fe0', polokwane: '#4d9e2f', capetown: '#1f6fd6' };

const TRUST = [
  {
    title: 'Human review',
    body: 'Every submission and claim is checked by a person before it publishes.',
    path: "<path d='M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-4Z'/><path d='m9.5 12 1.8 1.8L15 10'/>",
  },
  {
    title: 'Sourced, not invented',
    body: 'Listings carry their provenance — owner-submitted, confirmed by phone, or public record.',
    path: "<path d='M3 17l6-6 4 4 8-8'/><path d='M15 7h6v6'/>",
  },
  {
    title: 'Ads are labelled',
    body: 'Featured and sponsored placements always say so. Rankings are never quietly sold.',
    path: "<circle cx='12' cy='12' r='9'/><path d='M12 7v5l3.5 2'/>",
  },
];
---

<BaseLayout
  title="Advertise"
  description={`Advertise across ${site.siteName} and its sister directory sites — reach residents actively searching for local businesses.`}
>
  <main>
    <section style="background:var(--navy);color:#fff">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(34px,5vw,60px) 20px">
        <span style="font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--grad-from)">Advertise with us</span>
        <h1 style="margin:12px 0 12px;color:#fff;font-size:clamp(30px,5vw,50px);letter-spacing:-.03em;line-height:1.05;max-width:22ch">Local audience. Local intent. No wasted spend.</h1>
        <p style="margin:0;color:rgba(255,255,255,.84);font-size:16.5px;line-height:1.55;max-width:56ch">{site.siteName} is one of three city hubs — {site.cityLabel}, and its sister sites — built on the same reviewed data and the same ad formats.</p>
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:clamp(26px,4vw,44px) 20px 0">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2px;background:var(--border);border:1px solid var(--border);border-radius:14px;overflow:hidden">
        <div style="background:#fff;padding:20px"><div style="font-size:30px;font-weight:800;color:var(--navy);letter-spacing:-.03em">{businesses.length.toLocaleString()}</div><div style="font-size:11.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:5px">Listings live</div></div>
        <div style="background:#fff;padding:20px"><div style="font-size:30px;font-weight:800;color:var(--navy);letter-spacing:-.03em">{suburbs.length.toLocaleString()}</div><div style="font-size:11.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:5px">Suburb pages</div></div>
        <div style="background:#fff;padding:20px"><div style="font-size:30px;font-weight:800;color:var(--navy);letter-spacing:-.03em">{categories.length.toLocaleString()}</div><div style="font-size:11.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:5px">Categories</div></div>
        <div style="background:#fff;padding:20px"><div style="font-size:30px;font-weight:800;color:var(--accent);letter-spacing:-.03em">{network.length} cities</div><div style="font-size:11.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:5px">One booking</div></div>
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:clamp(30px,4vw,48px) 20px 0">
      <div style="border-bottom:2px solid var(--navy);padding-bottom:12px">
        <h2 style="margin:0;font-size:clamp(20px,2.8vw,28px);letter-spacing:-.025em;color:var(--navy)">Three hubs, one network</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;margin-top:20px">
        {network.map((s) => (
          <a href={`https://${s.domain}/advertise/`} target="_blank" rel="noopener" style="border:2px solid var(--border);border-radius:14px;background:#fff;overflow:hidden;text-decoration:none;color:inherit;display:block">
            <div style={`height:8px;background:${COLORS[s.slug] ?? 'var(--accent)'}`}></div>
            <div style="padding:18px">
              <h3 style="margin:0 0 4px;font-size:19px;letter-spacing:-.02em;color:var(--navy)">{s.siteName}</h3>
              <p style="margin:0 0 10px;font-size:13px;font-weight:700;color:var(--muted)">{s.domain}</p>
              <p style="margin:0;font-size:14px;line-height:1.55;color:var(--text)">{s.tagline}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:clamp(30px,4vw,48px) 20px 0">
      <div style="border-bottom:2px solid var(--navy);padding-bottom:12px">
        <h2 style="margin:0;font-size:clamp(20px,2.8vw,28px);letter-spacing:-.025em;color:var(--navy)">How the sites are kept honest</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;margin-top:20px">
        {TRUST.map((t) => (
          <div>
            <div style="width:38px;height:38px;border-radius:10px;background:var(--bg-subtle);display:flex;align-items:center;justify-content:center;color:var(--accent);margin-bottom:10px">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" set:html={t.path} />
            </div>
            <h3 style="margin:0 0 6px;font-size:16px;letter-spacing:-.015em;color:var(--navy)">{t.title}</h3>
            <p style="margin:0;font-size:14px;line-height:1.55;color:var(--text)">{t.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section style="margin-top:clamp(36px,5vw,60px);background:var(--accent)">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(32px,4.5vw,56px) 20px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px">
        <div>
          <h2 style="margin:0 0 8px;color:var(--contrast);font-size:clamp(24px,3.6vw,36px);letter-spacing:-.03em;line-height:1.08;max-width:26ch">Book one city, or all three.</h2>
          <p style="margin:0;color:var(--contrast);font-size:15.5px;font-weight:600;opacity:.9">{site.contactEmail}</p>
        </div>
        <a href={`mailto:${site.contactEmail}`} style="padding:16px 26px;border-radius:12px;background:#fff;color:var(--accent-hover);font-size:15px;font-weight:800;white-space:nowrap;text-decoration:none">See rates</a>
      </div>
    </section>
  </main>
</BaseLayout>
