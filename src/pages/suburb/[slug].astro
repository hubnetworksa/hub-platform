---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import PageBanner from '../../components/PageBanner.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SponsorSlot from '../../components/SponsorSlot.astro';
import { suburbs, businessesInSuburb, categoriesFor, FEATURED_TIER, type Business } from '../../lib/data';
import { groupForCategory } from '../../lib/categoryGroups';
import { groupForSuburb, regionLabel } from '../../site-content';
import { synonymsFor, suburbSynonymsFor } from '../../lib/categorySynonyms';
import { collectionPageJsonLd } from '../../lib/seo';
import Icon from '../../components/Icon.astro';
import site from '../../site';

export function getStaticPaths() {
  return suburbs.map((suburb) => ({ params: { slug: suburb.slug }, props: { suburb } }));
}

const { suburb } = Astro.props;
const businesses = businessesInSuburb(suburb.id);
const featuredHere = businesses.filter((b) => b.subscription_tier >= FEATURED_TIER).slice(0, 3);

const myGroup = groupForSuburb(suburb.slug);
const nearbySuburbs = myGroup
  ? suburbs.filter((s) => s.slug !== suburb.slug && groupForSuburb(s.slug)?.slug === myGroup.slug).slice(0, 8)
  : [];

const byCategory = new Map<string, { name: string; slug: string; businesses: Business[] }>();
for (const business of businesses) {
  const primary = categoriesFor(business)[0];
  const key = primary?.slug ?? 'uncategorised';
  const name = primary?.name ?? 'Other';
  if (!byCategory.has(key)) byCategory.set(key, { name, slug: key, businesses: [] });
  byCategory.get(key)!.businesses.push(business);
}
const categoryGroups = [...byCategory.entries()].sort((a, b) => a[1].name.localeCompare(b[1].name));

const keywords = [
  ...new Set(
    categoryGroups
      .filter(([slug]) => slug !== 'uncategorised')
      .flatMap(([slug, group]) => [...synonymsFor(slug), ...suburbSynonymsFor(group.name, suburb.name)])
  ),
];

const description = suburb.bio
  ? suburb.bio.replace(/\s+/g, ' ').trim().slice(0, 155)
  : `${businesses.length} businesses in ${suburb.name}, part of the Greater ${site.cityLabel} area — browse by category.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: suburb.name,
  ...(suburb.lat && suburb.lng ? { geo: { '@type': 'GeoCoordinates', latitude: suburb.lat, longitude: suburb.lng } } : {}),
  ...(keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
};

// Place (above) describes the suburb itself; this describes the businesses
// actually listed on this page — same collectionPageJsonLd() every other
// collection-type page (category, section, shopping-center) already uses.
// Both are emitted together, neither replaces the other.
const collectionJsonLd = businesses.length === 0
  ? null
  : collectionPageJsonLd({
      name: suburb.name,
      description,
      url: `https://${site.domain}/suburb/${suburb.slug}/`,
      items: businesses.map((b) => ({ name: b.name, url: `https://${site.domain}/business/${b.slug}/` })),
    });
---

<BaseLayout title={suburb.name} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {collectionJsonLd && <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />}

  <PageBanner title={suburb.name} description={`${businesses.length} businesses listed.`}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Suburbs', href: '/suburb/' },
        ...(groupForSuburb(suburb.slug)
          ? [{ label: groupForSuburb(suburb.slug)!.name, href: `/suburb/#${groupForSuburb(suburb.slug)!.slug}` }]
          : []),
      ]}
    />
  </PageBanner>

  <section class="container" style="padding-top: 1.5rem;">
    <div class:list={['suburb-intro', { 'has-photo': suburb.image_key }]}>
      {suburb.image_key && (
        <img
          class="suburb-photo"
          src={`/media/${suburb.image_key}`}
          alt={`${suburb.name}, ${regionLabel(suburb.region)}`}
          width="480"
          height="320"
          loading="lazy"
        />
      )}
      {suburb.bio ? (
        <div class="suburb-bio" style="max-width: 68ch;">
          {suburb.bio.split(/\n{2,}/).map((para) => <p style="color: var(--text);">{para}</p>)}
        </div>
      ) : (
        <p style="max-width: 68ch; color: var(--text-muted); font-style: italic;">
          A full area guide for {suburb.name} is on the way — in the meantime, here's every business we have listed here.
        </p>
      )}
    </div>
  </section>

  <section class="container" style="padding-bottom: 3rem;">
    <div class="two-col-shell">
      <div>
        {featuredHere.length > 0 && (
          <div style="margin-bottom: 2rem;">
            <SectionHeader eyebrow="Featured" title={`Featured in ${suburb.name}`} />
            <div class="business-grid">
              {featuredHere.map((business) => (
                <BusinessCard business={business} showSuburb={false} listContext={{ kind: 'suburb', slug: suburb.slug, name: suburb.name }} />
              ))}
            </div>
          </div>
        )}

        {businesses.length === 0 ? (
          <p style="color: var(--text-muted);">No businesses listed in {suburb.name} yet.</p>
        ) : (
          categoryGroups.map(([slug, group]) => (
            <div style="margin-top: 1.75rem;">
              <div class="cat-head">
                <h2>
                  {groupForCategory(slug) && <Icon path={groupForCategory(slug)!.iconPath} size={18} />}
                  {group.name} <span class="cat-count">({group.businesses.length})</span>
                </h2>
                <a href={`/category/${slug}/${suburb.slug}/`} class="btn btn-outline btn-sm">View all →</a>
              </div>
              <div class="business-grid">
                {group.businesses.map((business) => (
                  <BusinessCard
                    business={business}
                    showSuburb={false}
                    listContext={{ kind: 'suburb', slug: suburb.slug, name: suburb.name }}
                  />
                ))}
              </div>
            </div>
          ))
        )}
      </div>

      <aside class="suburb-sidebar">
        <div class="ad-slot">
          <span class="ad-slot-eyebrow">Advertisement</span>
          <span class="ad-slot-spec">300×250</span>
        </div>
        <SponsorSlot productType="suburb_sponsor" target={suburb.slug} label="suburb sponsor" />
        {nearbySuburbs.length > 0 && (
          <div class="card">
            <strong>Nearby suburbs</strong>
            <div class="chip-row">
              {nearbySuburbs.map((s) => (
                <a class="chip" href={`/suburb/${s.slug}/`}>{s.name}</a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .suburb-intro.has-photo {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .suburb-photo {
    width: 240px;
    max-width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    flex-shrink: 0;
  }
  .cat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .cat-head h2 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 1.05rem;
    margin: 0;
    color: var(--navy);
  }
  .cat-head h2 :global(svg) {
    color: var(--accent);
  }
  .cat-count {
    color: var(--text-muted);
    font-weight: 400;
    font-size: 0.85rem;
  }
  .business-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
  }
  .suburb-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .suburb-sidebar .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
</style>
