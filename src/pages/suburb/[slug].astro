---
import SponsorBanner from '../../components/SponsorBanner.astro';
import { adsEnabled } from '../../lib/site-overrides';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SponsorSlot from '../../components/SponsorSlot.astro';
import AdUnit from '../../components/AdUnit.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import BusinessLogo from '../../components/BusinessLogo.astro';
import { suburbs, businessesInSuburb, businessesInSuburbAndCategory, categoriesFor, categoryBySlug, FEATURED_TIER, type Business, isPaidListing, sponsorFor, withoutSponsors, averageRating, reviewCount, logoFor, cardBlurbFor, whatsappFor, rankForLinking } from '../../lib/data';
import { MIN_CATEGORY_SUBURB_BUSINESSES } from '../../lib/sitemap';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { groupForSuburb } from '../../site-content';
import { CATEGORY_GROUPS } from '../../lib/categoryGroups';
import { synonymsFor, suburbSynonymsFor } from '../../lib/categorySynonyms';
import { collectionPageJsonLd } from '../../lib/seo';
import site from '../../site';
import { fitDescription, padDescription } from '../../lib/metaText';

export function getStaticPaths() {
  return suburbs.map((suburb) => ({ params: { slug: suburb.slug }, props: { suburb } }));
}

const { suburb } = Astro.props;
const businesses = [...businessesInSuburb(suburb.id)].sort((a, b) => a.name.localeCompare(b.name));
// Sponsor card wins: the suburb sponsor's banner sits right above this
// strip, so that business is left out of "Featured in this suburb".
const suburbSponsor = sponsorFor('suburb_sponsor', suburb.slug);
const featuredHere = withoutSponsors(businesses.filter((b) => b.subscription_tier >= FEATURED_TIER), suburbSponsor);

const myGroup = groupForSuburb(suburb.slug);
const nearbySuburbs = myGroup
  ? suburbs.filter((s) => s.slug !== suburb.slug && groupForSuburb(s.slug)?.slug === myGroup.slug).slice(0, 6)
  : [];

// Category pill row — every distinct category actually present here,
// each linking to that category × suburb intersection page.
const categoriesHere = new Map<string, string>();
for (const b of businesses) {
  const primary = categoriesFor(b)[0];
  if (primary) categoriesHere.set(primary.slug, primary.name);
}

// Businesses grouped by section, same card layout as /category/ — replaces
// a flat A-Z list with the categories-style browse, scoped to this suburb.
const groups = CATEGORY_GROUPS.map((group) => {
  const subs = group.categorySlugs
    .filter((slug) => categoriesHere.has(slug))
    .map((slug) => {
      const category = categoryBySlug(slug)!;
      return { slug, name: category.name, count: businessesInSuburbAndCategory(suburb.id, category.id).length };
    })
    .sort((a, b) => a.name.localeCompare(b.name));
  return { slug: group.slug, name: group.name, iconPath: group.iconPath, subs, total: subs.reduce((sum, s) => sum + s.count, 0) };
}).filter((g) => g.subs.length > 0);

// "Businesses in <suburb>": every listing linked, grouped by primary category
// (biggest first). A heading only links to the category-in-suburb page when
// that page is indexable (same threshold as the sitemap); otherwise the
// overflow link goes to the city-wide category page.
const LISTED_PER_CATEGORY = 12;
const byPrimaryCategory = new Map<string, { slug: string; name: string; list: Business[] }>();
for (const b of businesses) {
  const c = categoriesFor(b)[0];
  if (!c) continue;
  if (!byPrimaryCategory.has(c.slug)) byPrimaryCategory.set(c.slug, { slug: c.slug, name: c.name, list: [] });
  byPrimaryCategory.get(c.slug)!.list.push(b);
}
const businessSections = [...byPrimaryCategory.values()]
  .map((c) => ({ ...c, list: rankForLinking(c.list), linkable: businessesInSuburbAndCategory(suburb.id, categoryBySlug(c.slug)!.id).length >= MIN_CATEGORY_SUBURB_BUSINESSES }))
  .sort((a, b) => b.list.length - a.list.length || a.name.localeCompare(b.name));

const keywords = [
  ...new Set([...categoriesHere.keys()].flatMap((slug) => [...synonymsFor(slug), ...suburbSynonymsFor(categoriesHere.get(slug)!, suburb.name)])),
];

const description = suburb.bio
  ? suburb.bio.replace(/\s+/g, ' ').trim().slice(0, 155)
  : `${businesses.length} reviewed listings in this ${myGroup?.name ?? site.cityLabel} suburb.`;
// Head-only meta description (the visible intro above stays as it is): the
// bio cut at a word boundary, padded under 120 characters with the page's
// own counts.
const sectionCount = groups.length;
const metaDescription = padDescription(fitDescription(suburb.bio ? suburb.bio.replace(/\s+/g, ' ').trim() : `${businesses.length} reviewed ${businesses.length === 1 ? 'listing' : 'listings'} in ${suburb.name}, ${myGroup?.name ?? site.cityLabel}.`), [
  businesses.length > 0 ? `${businesses.length} ${businesses.length === 1 ? 'business' : 'businesses'} listed in ${suburb.name}, ${site.cityLabel}.` : null,
  sectionCount > 1 ? `Browse by ${categoriesHere.size} categories.` : null,
  `Local business directory for ${suburb.name}.`,
  `On ${site.siteName}.`,
]);

const heroSrc = suburb.image_key ? `/media/${suburb.image_key}` : site.sectionBannerImage;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: suburb.name,
  ...(suburb.lat && suburb.lng ? { geo: { '@type': 'GeoCoordinates', latitude: suburb.lat, longitude: suburb.lng } } : {}),
  ...(keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
};

const collectionJsonLd = businesses.length === 0
  ? null
  : collectionPageJsonLd({
      name: suburb.name,
      description,
      url: `https://${site.domain}/suburb/${suburb.slug}/`,
      items: businesses.map((b) => ({ name: b.name, url: `https://${site.domain}/business/${b.slug}/` })),
    });
// No Google ads anywhere a paid listing or sponsor is shown (see
// BaseLayout's noAds): this page shows one if this is true.
const showsPaid = businesses.some(isPaidListing) || !!suburbSponsor;
// SponsorSlot renders nothing once suburbSponsor is sold, so the sidebar can
// end up with none of: the ad unit, the open-slot box, or nearby suburbs.
// Drop the whole aside (and its grid column) rather than leave it empty.
const asideHasContent = (adsEnabled && !showsPaid) || !suburbSponsor || nearbySuburbs.length > 0;
---

<BaseLayout noAds={showsPaid} pageSchema={collectionJsonLd ? undefined : {}} title={`Businesses in ${suburb.name}, ${site.cityLabel}`} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  {collectionJsonLd && <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd).replace(/</g, '\\u003c')} />}

  <main>
    <section style="position:relative;background:var(--navy);overflow:hidden;min-height:clamp(200px,26vw,320px)">
      <img src={heroSrc} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%" />
      <div style="position:absolute;inset:0;background:linear-gradient(100deg,rgba(var(--navy-rgb),.93) 0%,rgba(var(--navy-rgb),.74) 50%,rgba(var(--navy-rgb),.24) 100%)"></div>
      <div style="position:relative;max-width:1200px;margin:0 auto;padding:26px 20px 30px">
        <Breadcrumbs
          variant="plain"
          onDark
          items={[{ label: 'Home', href: '/' }, { label: 'Suburbs', href: '/suburb/' }, { label: suburb.name }]}
        />
        <h1 style="margin:14px 0 10px;color:#fff;font-size:clamp(28px,4.6vw,46px);letter-spacing:-.03em;line-height:1.04">Businesses in {suburb.name}</h1>
        <p style="margin:0;color:rgba(255,255,255,.86);font-size:15.5px;max-width:58ch;line-height:1.55">{description}</p>
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:22px 20px 60px">
      {categoriesHere.size > 0 && (
        <div style="display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;border-bottom:2px solid var(--navy)">
          <span style="padding:9px 14px;border-radius:999px;background:var(--navy);color:#fff;font-size:13px;font-weight:800;white-space:nowrap">All {businesses.length}</span>
          {[...categoriesHere.entries()].map(([slug, name]) => (
            <a href={`/category/${slug}/${suburb.slug}/`} style="padding:9px 14px;border-radius:999px;border:2px solid var(--border);color:var(--navy);font-size:13px;font-weight:700;white-space:nowrap;text-decoration:none">{name}</a>
          ))}
        </div>
      )}

      <div id="suburb-shell" style="display:grid;grid-template-columns:1fr;gap:22px;margin-top:22px" class:list={{ 'has-aside': asideHasContent }}>
        <div>
          <SponsorBanner productType="suburb_sponsor" target={suburb.slug} context={suburb.name} />
          {featuredHere.length > 0 && (
            <>
              <h2 style="margin:0 0 12px;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)">Featured in this suburb</h2>
              <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px">
                {featuredHere.map((b) => {
                  // With a logo, the logo is a left column and the name,
                  // meta and link all sit beside it.
                  const hasLogo = !!logoFor(b);
                  const IdWrap = hasLogo ? 'div' : Fragment;
                  const IdBody = hasLogo ? 'div' : Fragment;
                  return (
                  <article style="border:2px solid var(--accent);border-radius:14px;background:#fff;padding:16px;display:flex;flex-direction:column;gap:8px">
                    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
                      <span style="padding:4px 9px;border-radius:999px;background:var(--accent);color:var(--contrast);font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase">Featured</span>
                      {reviewCount(b) > 0 && (
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:4px 9px;border-radius:999px;background:var(--bg-subtle);color:var(--navy);font-size:10.5px;font-weight:800">
                          ★ {averageRating(b)} <span style="color:var(--muted);font-weight:700">({reviewCount(b)})</span>
                        </span>
                      )}
                    </div>
                    <IdWrap {...(hasLogo ? { class: 'biz-split' } : {})}>
                    <BusinessLogo business={b} size="card" />
                    <IdBody {...(hasLogo ? { class: 'biz-split-body' } : {})}>
                    <h3 style="margin:0;font-size:17px;letter-spacing:-.015em;color:var(--navy)">{b.name}</h3>
                    <p style="margin:0;font-size:13px;font-weight:600;color:var(--muted)">{[categoriesFor(b)[0]?.name, suburb.name].filter(Boolean).join(' · ')}</p>
                    {cardBlurbFor(b) && <p class="desc-clamp" style="margin:0;font-size:13.5px;line-height:1.5;color:var(--text)" set:html={cardBlurbFor(b)} />}
                    {whatsappFor(b) ? (
                      <div class={hasLogo ? 'biz-split-end' : undefined} style="display:flex;align-items:center;flex-wrap:wrap;gap:8px 14px;margin-top:4px">
                        <a href={`/business/${b.slug}/`} style="font-size:13px;font-weight:800;color:var(--accent);text-decoration:none">View profile →</a>
                        <WhatsAppButton business={b} />
                      </div>
                    ) : (
                      <a href={`/business/${b.slug}/`} class={hasLogo ? 'biz-split-end' : undefined} style="align-self:flex-start;margin-top:4px;font-size:13px;font-weight:800;color:var(--accent);text-decoration:none">View profile →</a>
                    )}
                    </IdBody>
                    </IdWrap>
                  </article>
                  );
                })}
              </div>
            </>
          )}

          <h2 style="margin:26px 0 12px;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">Browse by category</h2>
          {businesses.length === 0 ? (
            <p style="color:var(--muted);">No businesses listed in {suburb.name} yet.</p>
          ) : (
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px">
              {groups.map((g) => (
                <section style="border:2px solid var(--border);border-radius:16px;background:#fff;overflow:hidden;display:flex;flex-direction:column">
                  <div style="padding:16px 18px;border-bottom:2px solid var(--navy);display:flex;align-items:flex-start;gap:12px">
                    <span style="flex-shrink:0;width:38px;height:38px;border-radius:10px;background:var(--bg-subtle);display:flex;align-items:center;justify-content:center;color:var(--accent)">
                      <Icon path={g.iconPath} size={20} />
                    </span>
                    <span style="display:flex;flex-direction:column;min-width:0">
                      <span style="font-size:16.5px;font-weight:800;letter-spacing:-.02em;color:var(--navy);line-height:1.2">{g.name}</span>
                      <span style="font-size:12px;font-weight:700;color:var(--muted);margin-top:3px">{g.subs.length} categories · {g.total.toLocaleString('en-US')} businesses</span>
                    </span>
                  </div>
                  <div style="display:flex;flex-direction:column">
                    {g.subs.map((s) => (
                      <a href={`/category/${s.slug}/${suburb.slug}/`} class="suburb-cat-sub" style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 18px;border-bottom:1px solid var(--border);color:var(--navy);text-decoration:none">
                        <span style="font-size:14px;font-weight:700;min-width:0">{s.name}</span>
                        <span style="font-size:12px;font-weight:800;color:var(--muted);white-space:nowrap">{s.count}</span>
                      </a>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          )}

          {businessSections.length > 0 && (
            <div id="businesses-in-suburb" style="margin-top:32px">
              <h2 style="margin:0 0 4px;font-size:20px;letter-spacing:-.02em;color:var(--navy)">Businesses in {suburb.name}</h2>
              {businessSections.map((sec) => (
                <section style="margin-top:20px">
                  <h3 style="margin:0 0 8px;padding-bottom:8px;border-bottom:2px solid var(--navy);font-size:16px;letter-spacing:-.015em;color:var(--navy)">
                    {sec.linkable ? <a href={`/category/${sec.slug}/${suburb.slug}/`} style="color:var(--navy);text-decoration:none">{sec.name}</a> : sec.name}
                    <span style="font-weight:600;color:var(--muted);font-size:13px"> ({sec.list.length})</span>
                  </h3>
                  <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:0 18px">
                    {sec.list.slice(0, LISTED_PER_CATEGORY).map((b) => (
                      <li style="border-bottom:1px solid var(--border)">
                        <a href={`/business/${b.slug}/`} class="suburb-biz-row" style="display:block;padding:11px 2px;min-height:22px;font-size:14.5px;font-weight:700;color:var(--navy);text-decoration:none">{b.name}</a>
                      </li>
                    ))}
                  </ul>
                  {sec.list.length > LISTED_PER_CATEGORY && (
                    <a href={sec.linkable ? `/category/${sec.slug}/${suburb.slug}/` : `/category/${sec.slug}/`} style="display:inline-block;margin-top:10px;font-size:13px;font-weight:800;color:var(--accent);text-decoration:none">See all {sec.list.length} →</a>
                  )}
                </section>
              ))}
            </div>
          )}
        </div>

        {asideHasContent && (
          <aside style="display:flex;flex-direction:column;gap:14px">
            {adsEnabled && !showsPaid && <AdUnit placement="suburbSidebar" gap={14} />}
            <SponsorSlot
              productType="suburb_sponsor"
              target={suburb.slug}
              title={`Own ${suburb.name}`}
              openBody={`One business sponsors ${suburb.name}: shown at the top of this page and above ${suburb.name} listings in every category. The slot is open.`}
              ctaLabel="Sponsor this suburb"
            />
            {nearbySuburbs.length > 0 && (
              <div style="border:2px solid var(--border);border-radius:14px;padding:18px;background:var(--bg-subtle)">
                <h3 style="margin:0 0 8px;font-size:15px;letter-spacing:-.01em;color:var(--navy)">Nearby suburbs</h3>
                <div style="display:flex;flex-wrap:wrap;gap:6px">
                  {nearbySuburbs.map((s) => (
                    <a href={`/suburb/${s.slug}/`} style="padding:7px 11px;border-radius:999px;background:#fff;border:1.5px solid var(--border);font-size:12.5px;font-weight:700;color:var(--navy);text-decoration:none">{s.name}</a>
                  ))}
                </div>
              </div>
            )}
          </aside>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { gaEvent } from '../../lib/ga';
  // WhatsApp clicks from the Featured strip count towards the owner's stats
  // (functions/api/track-view.ts), same as on the homepage cards.
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track][data-track-slug]');
    if (!el) return;
    try {
      navigator.sendBeacon('/api/track-view', new Blob([JSON.stringify({ businessSlug: el.dataset.trackSlug, event: el.dataset.track })], { type: 'application/json' }));
      gaEvent(el.dataset.track!, { business_slug: el.dataset.trackSlug, surface: 'suburb' });
    } catch {
      // A missed click count is never worth surfacing an error over.
    }
  });
</script>

<style>
  @media (min-width: 950px) {
    #suburb-shell.has-aside {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }
  .suburb-biz-row:hover {
    text-decoration: underline;
  }
  .suburb-cat-sub:hover {
    background: var(--bg-subtle);
  }
</style>
