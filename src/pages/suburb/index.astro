---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBox from '../../components/SearchBox.astro';
import { suburbs, suburbBySlug, businessesInSuburb, type Suburb } from '../../lib/data';
import { AREA_GROUPS } from '../../site-content';
import { collectionPageJsonLd } from '../../lib/seo';
import site from '../../site';

const byName = (a: Suburb, b: Suburb) => a.name.localeCompare(b.name);

const jsonLd = collectionPageJsonLd({
  name: 'Suburbs',
  description: `Every area ${site.siteName} covers, with the number of businesses listed so far.`,
  url: `https://${site.domain}/suburb/`,
  items: AREA_GROUPS.flatMap((area) =>
    area.suburbSlugs
      .map((slug) => suburbBySlug(slug))
      .filter((s): s is Suburb => Boolean(s))
      .sort(byName)
      .map((s) => ({ name: s.name, url: `https://${site.domain}/suburb/${s.slug}/` }))
  ),
});
---

<BaseLayout
  title="Suburbs"
  description={`Browse ${site.cityLabel} area by area, suburb by suburb — local businesses across ${suburbs.length} areas.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main>
    <section style="position:relative;background:var(--navy);overflow:hidden">
      <img src={site.bannerImage} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%" />
      <div style="position:absolute;inset:0;background:linear-gradient(105deg,rgba(var(--navy-rgb),.94) 0%,rgba(var(--navy-rgb),.82) 42%,rgba(var(--navy-rgb),.34) 78%,rgba(var(--navy-rgb),.12) 100%)"></div>
      <div style="position:relative;max-width:1200px;margin:0 auto;padding:clamp(30px,5vw,54px) 20px clamp(26px,4vw,38px)">
        <h1 style="margin:0 0 10px;color:#fff;font-size:clamp(28px,4.6vw,44px);letter-spacing:-.03em;line-height:1.05">Suburbs</h1>
        <p style="margin:0 0 22px;color:rgba(255,255,255,.86);font-size:15.5px;max-width:58ch;line-height:1.55">Every area {site.siteName} covers, with the number of businesses listed so far.</p>
        <SearchBox />
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:clamp(28px,4vw,44px) 20px 60px">
      {AREA_GROUPS.map((area, i) => {
        const inArea = area.suburbSlugs
          .map((slug) => suburbBySlug(slug))
          .filter((s): s is Suburb => Boolean(s))
          .sort(byName);
        if (inArea.length === 0) return null;
        return (
          <div id={area.slug} style={`scroll-margin-top:16px;${i > 0 ? 'margin-top:30px;' : ''}`}>
            <h2 style="margin:0 0 14px;font-size:18px;letter-spacing:-.02em;color:var(--navy);border-bottom:2px solid var(--navy);padding-bottom:10px;">{area.name}</h2>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;">
              {inArea.map((suburb) => (
                <a href={`/suburb/${suburb.slug}/`} style="display:flex;flex-direction:column;gap:4px;padding:14px 16px;border:2px solid var(--border);border-radius:12px;background:#fff;text-decoration:none">
                  <strong style="font-size:14.5px;color:var(--navy);font-weight:800;">{suburb.name}</strong>
                  <span style="color:var(--muted);font-size:12.5px;font-weight:700;">{businessesInSuburb(suburb.id).length} businesses</span>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </section>
  </main>
</BaseLayout>
