---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import SearchBox from '../../components/SearchBox.astro';
import { suburbs, suburbBySlug, businessesInSuburb, type Suburb } from '../../lib/data';
import { AREA_GROUPS } from '../../site-content';
import { collectionPageJsonLd } from '../../lib/seo';
import site from '../../site';

const byName = (a: Suburb, b: Suburb) => a.name.localeCompare(b.name);

const jsonLd = collectionPageJsonLd({
  name: 'Suburbs',
  description: `Every area ${site.siteName} covers, with the number of businesses listed so far.`,
  url: `https://${site.domain}/suburb/`,
  items: AREA_GROUPS.flatMap((area) =>
    area.suburbSlugs
      .map((slug) => suburbBySlug(slug))
      .filter((s): s is Suburb => Boolean(s))
      .sort(byName)
      .map((s) => ({ name: s.name, url: `https://${site.domain}/suburb/${s.slug}/` }))
  ),
});
---

<BaseLayout
  title="Suburbs"
  description={`Browse ${site.cityLabel} area by area, suburb by suburb — local businesses across ${suburbs.length} areas.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <PageBanner title="Suburbs" description={`Every area ${site.siteName} covers, with the number of businesses listed so far.`}>
    <SearchBox slot="search" />
  </PageBanner>

  <section class="container" style="padding-top: 2rem; padding-bottom: 3rem;">
    {AREA_GROUPS.map((area) => {
      const inArea = area.suburbSlugs
        .map((slug) => suburbBySlug(slug))
        .filter((s): s is Suburb => Boolean(s))
        .sort(byName);
      if (inArea.length === 0) return null;
      return (
        <div class="area-section" id={area.slug}>
          <h2 style="font-size: 1.1rem;">{area.name}</h2>
          <div class="suburb-grid">
            {inArea.map((suburb) => (
              <a class="suburb-tile" href={`/suburb/${suburb.slug}/`}>
                <strong>{suburb.name}</strong>
                <span>{businessesInSuburb(suburb.id).length} businesses</span>
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </section>
</BaseLayout>

<style>
  .area-section {
    margin-top: 2rem;
    scroll-margin-top: 1rem;
  }
  .suburb-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .suburb-tile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    background: var(--bg-card);
  }
  .suburb-tile:hover {
    border-color: var(--accent);
  }
  .suburb-tile span {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
