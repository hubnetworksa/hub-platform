---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { suburbs, priceRand } from '../../lib/data';
import { buildSuburbRegions, countWord } from '../../lib/suburbRegions';
import { collectionPageJsonLd } from '../../lib/seo';
import site from '../../site';

const regions = buildSuburbRegions();
const fmt = (n: number) => n.toLocaleString('en-US');

const dirTotal = regions.reduce((a, r) => a + r.subs.length, 0);

// "Busiest suburbs" — real business counts, top four.
const busiest = regions
  .flatMap((r) => r.subs.map((s) => ({ ...s, region: r.name })))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
  .slice(0, 4)
  .filter((s) => s.count > 0);

const sponsorPrice = priceRand('price_sponsor_suburb_cents');
const sponsorLabel = sponsorPrice === '—' ? 'Sponsor a suburb' : `Sponsor a suburb — ${sponsorPrice}/mo`;

const regionWord = regions.length === 1 ? 'region' : 'regions';

const jsonLd = collectionPageJsonLd({
  name: 'Suburbs',
  description: `Every area ${site.siteName} covers, with the number of businesses listed so far.`,
  url: `https://${site.domain}/suburb/`,
  items: regions.flatMap((r) => r.subs.map((s) => ({ name: s.name, url: `https://${site.domain}/suburb/${s.slug}/` }))),
});
---

<BaseLayout
  title="Suburbs"
  description={`Browse ${site.cityLabel} area by area, suburb by suburb — local businesses across ${suburbs.length} areas.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main>
    <section style="background:var(--navy);color:#fff">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(28px,4.5vw,54px) 20px">
        <Breadcrumbs variant="plain" onDark items={[{ label: 'Home', href: '/' }, { label: 'Directory' }]} />
        <h1 style="margin:14px 0 12px;color:#fff;font-size:clamp(28px,5vw,48px);letter-spacing:-.03em;line-height:1.04;max-width:20ch">Browse every suburb in {site.cityLabel}</h1>
        <p style="margin:0 0 22px;color:rgba(255,255,255,.86);font-size:16px;line-height:1.55;max-width:54ch">{dirTotal} suburbs across {countWord(regions.length)} {regionWord}, each with its own page of reviewed businesses.</p>
        <div style="background:#fff;border-radius:14px;padding:8px;max-width:560px">
          <div style="display:flex;align-items:center;gap:10px;padding:0 12px;border-radius:9px;background:var(--bg-subtle)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1.9" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m20 20-4.5-4.5"></path></svg>
            <input id="dir-query" type="text" aria-label="Jump to a suburb" autocomplete="off" placeholder="Jump to a suburb — Menlyn, Akasia…" style="flex:1;min-width:0;border:0;background:transparent;padding:13px 0;font-size:15px;color:var(--text);outline:none" />
          </div>
        </div>
      </div>
    </section>

    {busiest.length > 0 && (
      <section style="max-width:1200px;margin:0 auto;padding:clamp(22px,3.5vw,38px) 20px 0">
        <div style="border-bottom:2px solid var(--navy);padding-bottom:12px">
          <h2 style="margin:0;font-size:clamp(19px,2.6vw,25px);letter-spacing:-.025em;color:var(--navy)">Busiest suburbs</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:16px">
          {busiest.map((t) => (
            <a href={`/suburb/${t.slug}/`} class="dir-top" style="border:2px solid var(--border);border-radius:14px;background:#fff;padding:18px;cursor:pointer;display:flex;flex-direction:column;gap:6px;text-decoration:none">
              <span style="font-size:17.5px;font-weight:800;color:var(--navy);letter-spacing:-.02em">{t.name}</span>
              <span style="font-size:24px;font-weight:800;color:var(--accent);letter-spacing:-.025em;line-height:1">{fmt(t.count)}</span>
              <span style="font-size:12.5px;font-weight:700;color:var(--muted);line-height:1.4">{t.count === 1 ? 'listed business' : 'listed businesses'} · {t.region}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section style="max-width:1200px;margin:0 auto;padding:clamp(26px,4vw,42px) 20px 0">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-bottom:2px solid var(--navy);padding-bottom:12px;flex-wrap:wrap">
        <h2 style="margin:0;font-size:clamp(19px,2.6vw,25px);letter-spacing:-.025em;color:var(--navy)">Browse by region</h2>
        <a href="/suburb/map/" style="display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:800;color:var(--accent);white-space:nowrap">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 4-6 2.4v13.2L9 17.2l6 2.4 6-2.4V4l-6 2.4L9 4Z"></path><path d="M9 4v13.2M15 6.4v13.2"></path></svg>
          View on a map
        </a>
      </div>
      <div id="dir-regions" style="display:flex;flex-direction:column;gap:10px;margin-top:18px">
        {regions.map((r, i) => (
          <div class="dr" data-region={r.key} data-open={i === 0 ? 'true' : 'false'} style="border-radius:14px;background:#fff;overflow:hidden">
            <button type="button" class="dr-head" aria-expanded={i === 0 ? 'true' : 'false'} style="display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;padding:16px 18px;border:0;cursor:pointer;font:inherit;text-align:left">
              <span style="display:flex;align-items:center;gap:12px;min-width:0">
                <span style={`width:12px;height:12px;border-radius:99px;flex-shrink:0;background:${r.color}`}></span>
                <span style="display:flex;flex-direction:column;gap:2px;min-width:0;text-align:left">
                  <span style="font-size:17px;font-weight:800;letter-spacing:-.02em">{r.name}</span>
                  <span class="dr-meta" style="font-size:12.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{r.subs.length} {r.subs.length === 1 ? 'suburb' : 'suburbs'} · {r.subs.slice(0, 3).map((s) => s.name).join(', ')}</span>
                </span>
              </span>
              <span style="display:flex;align-items:center;gap:13px;flex-shrink:0">
                <span style="font-size:19px;font-weight:800;letter-spacing:-.025em">{fmt(r.total)}</span>
                <span class="dr-chev" style="display:flex;transition:transform .18s ease">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
                </span>
              </span>
            </button>
            <div class="dr-body">
              <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(186px,1fr));gap:6px;padding:14px 18px 18px">
                {r.subs.map((s) => (
                  <a href={`/suburb/${s.slug}/`} class={`dr-sub${s.sold ? ' sold' : ''}`} data-name={s.name.toLowerCase()} style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 12px;border-width:1.5px;border-style:solid;border-radius:9px;background:#fff;color:var(--navy);cursor:pointer;text-decoration:none">
                    <span style="display:flex;align-items:center;gap:6px;min-width:0">
                      {s.sold && <span style="flex-shrink:0;font-size:11px;color:var(--accent)">★</span>}
                      <span style="font-size:13.5px;font-weight:700;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{s.name}</span>
                    </span>
                    <span style="font-size:11.5px;font-weight:800;color:var(--muted);flex-shrink:0">{s.count}</span>
                  </a>
                ))}
              </div>
              <div style="padding:12px 18px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
                <span style="font-size:12.5px;font-weight:700;color:var(--muted)">{r.soldCount} of {r.subs.length} suburb slots sold in {r.name}</span>
                <a href="/pricing/" style="padding:9px 14px;border:2px solid var(--navy);border-radius:9px;background:#fff;color:var(--navy);font-size:12.5px;font-weight:800;white-space:nowrap;cursor:pointer;text-decoration:none">{sponsorLabel}</a>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p id="dir-empty" hidden style="margin:18px 0 0;font-size:14px;font-weight:700;color:var(--muted)">No suburb matches that search.</p>
    </section>

    <section style="margin-top:clamp(36px,5vw,56px);background:var(--accent)">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(30px,4.5vw,52px) 20px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px">
        <h2 style="margin:0;color:var(--contrast);font-size:clamp(23px,3.4vw,36px);letter-spacing:-.03em;line-height:1.08;max-width:26ch">Own the top slot in your suburb — one business per page.</h2>
        <a href="/pricing/" style="padding:16px 26px;border-radius:12px;background:#fff;color:var(--accent-hover);font-size:15px;font-weight:800;white-space:nowrap;cursor:pointer;text-decoration:none">See suburb rates</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .dir-top:hover { border-color: var(--accent) !important; }
  .dr { border: 2px solid var(--border); }
  .dr[data-open='true'] { border-color: var(--navy); }
  .dr[hidden] { display: none !important; }
  .dr-head { background: #fff; color: var(--navy); }
  .dr[data-open='true'] .dr-head { background: var(--navy); color: #fff; }
  .dr-meta { color: var(--muted); }
  .dr[data-open='true'] .dr-meta { color: rgba(255, 255, 255, 0.66); }
  .dr-chev { color: var(--muted); transform: rotate(0deg); }
  .dr[data-open='true'] .dr-chev { color: rgba(255, 255, 255, 0.7); transform: rotate(180deg); }
  .dr-body { display: none; }
  .dr[data-open='true'] .dr-body { display: block; border-top: 1px solid var(--border); }
  .dr-sub { border-color: var(--border); }
  .dr-sub.sold { border-color: var(--accent); }
  .dr-sub:hover, .dr-sub.sold:hover { border-color: var(--navy); background: var(--bg-subtle) !important; }
  .dr-sub[hidden] { display: none !important; }
</style>

<script>
  const input = document.getElementById('dir-query') as HTMLInputElement | null;
  const list = document.getElementById('dir-regions');
  const empty = document.getElementById('dir-empty');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('#dir-regions .dr'));
  let openKey: string | null = rows[0]?.dataset.region ?? null;

  function setOpen(row: HTMLElement, open: boolean) {
    row.dataset.open = open ? 'true' : 'false';
    row.querySelector('.dr-head')?.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function render() {
    const q = (input?.value ?? '').trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const cards = Array.from(row.querySelectorAll<HTMLElement>('.dr-sub'));
      let matched = 0;
      for (const c of cards) {
        const hit = !q || (c.dataset.name ?? '').includes(q);
        c.hidden = !hit;
        if (hit) matched++;
      }
      row.hidden = q !== '' && matched === 0;
      if (!row.hidden) visible++;
      // While searching, every region with a hit is open; otherwise it's the accordion state.
      setOpen(row, q ? matched > 0 : openKey === row.dataset.region);
    }
    if (empty) empty.hidden = visible > 0;
  }

  input?.addEventListener('input', render);
  list?.addEventListener('click', (e) => {
    const head = (e.target as HTMLElement).closest('.dr-head');
    const row = head?.closest<HTMLElement>('.dr');
    if (!row) return;
    openKey = openKey === row.dataset.region ? null : (row.dataset.region ?? null);
    render();
  });
</script>
