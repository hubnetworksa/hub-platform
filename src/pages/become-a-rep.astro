---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../site';
import { priceRand } from '../lib/data';

const rows: { label: string; key: string }[] = [
  { label: 'Verified plan', key: 'price_verified_cents' },
  { label: 'Featured plan', key: 'price_featured_cents' },
  { label: 'Category sponsorship', key: 'price_sponsor_category_cents' },
  { label: 'Suburb sponsorship', key: 'price_sponsor_suburb_cents' },
  { label: 'Homepage banner', key: 'price_sponsor_banner_cents' },
  { label: 'Shopping centre sponsorship', key: 'price_sponsor_centre_cents' },
  { label: 'Guide sponsorship', key: 'price_sponsor_guide_cents' },
  ...(site.features.tourism ? [{ label: 'Tourism sponsorship', key: 'price_sponsor_tourism_cents' }] : []),
];
const table = rows.map((r) => ({ label: r.label, earn: priceRand(r.key) }));

const steps = [
  { n: 1, title: 'Join and get your code', text: 'Sign in, tap the button below and your personal rep code and share link are ready instantly.' },
  { n: 2, title: 'Share your link or code', text: 'Send your link to local businesses, or give them your code to enter at checkout.' },
  { n: 3, title: 'Get paid monthly', text: 'Commission is paid by EFT at the end of the month once your banking details are on file.' },
];

const faqs = [
  { q: 'Does the buyer get a discount?', a: 'No. The business pays the normal price. Your commission is paid by us on top.' },
  { q: 'Is it only the first payment?', a: 'Yes. You earn on the first payment only. Renewals do not earn commission.' },
  { q: 'What if they pay yearly?', a: 'A yearly purchase still pays you one month’s price, the same as a monthly purchase.' },
  { q: 'Do events earn commission?', a: 'No. Event listings are excluded. Business plans and sponsorships earn commission.' },
  { q: 'When and how do I get paid?', a: 'By EFT at the end of each month, once you have added your banking details on your rep dashboard.' },
  { q: 'Can I have more than one rep account?', a: 'No. There is one rep account per login.' },
  { q: 'Can I use my own code on my own business?', a: 'No. Your own code does not earn commission on a business you own.' },
];
---

<BaseLayout title="Become a sales rep" description={`Earn commission by referring local businesses to ${site.siteName}. Free to join, paid monthly by EFT.`}>
  <main style="max-width:860px;margin:0 auto;padding:clamp(24px,4vw,48px) 16px 64px">
    <section style="text-align:center;padding:clamp(8px,2vw,20px) 0 28px">
      <h1 style="margin:0;font-size:clamp(28px,5vw,44px);letter-spacing:-.03em;color:var(--navy);line-height:1.1">Earn money introducing businesses to {site.siteName}</h1>
      <p style="margin:14px auto 0;max-width:56ch;font-size:clamp(15px,2vw,17px);font-weight:600;color:var(--muted);line-height:1.55">
        Become a sales rep, share your link, and earn a month’s price every time a business buys a plan or sponsorship with your code.
      </p>
      <button type="button" id="rep-cta" class="rep-cta">Become a rep — it’s free</button>
      <p id="rep-cta-error" hidden style="margin:12px 0 0;font-size:13px;font-weight:700;color:var(--danger)"></p>
    </section>

    <h2 id="how-it-works" style="margin:12px 0 14px;scroll-margin-top:80px;font-size:22px;letter-spacing:-.025em;color:var(--navy)">How it works</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:14px">
      {steps.map((s) => (
        <div style="background:#fff;border:2px solid var(--border);border-radius:var(--radius-lg);padding:18px;box-shadow:var(--shadow)">
          <span style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:10px;background:var(--navy);color:#fff;font-weight:800;font-size:15px">{s.n}</span>
          <div style="margin-top:10px;font-size:16px;font-weight:800;color:var(--navy)">{s.title}</div>
          <p style="margin:6px 0 0;font-size:14px;font-weight:600;color:var(--muted);line-height:1.5">{s.text}</p>
        </div>
      ))}
    </div>

    <h2 style="margin:34px 0 6px;font-size:22px;letter-spacing:-.025em;color:var(--navy)">What you earn</h2>
    <p style="margin:0 0 14px;font-size:14px;font-weight:600;color:var(--muted)">One month’s price of whatever the business buys, on their first payment.</p>
    <div style="background:#fff;border:2px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow)">
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:14.5px">
          <thead>
            <tr style="background:var(--bg-subtle)">
              <th style="text-align:left;padding:12px 16px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)">Product</th>
              <th style="text-align:right;padding:12px 16px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)">Your commission</th>
            </tr>
          </thead>
          <tbody>
            {table.map((r) => (
              <tr style="border-top:1px solid var(--border)">
                <td style="padding:12px 16px;font-weight:800;color:var(--navy)">{r.label}</td>
                <td style="padding:12px 16px;text-align:right;font-weight:800;color:var(--navy);white-space:nowrap">You earn {r.earn}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <h2 style="margin:34px 0 14px;font-size:22px;letter-spacing:-.025em;color:var(--navy)">Good to know</h2>
    <div style="display:flex;flex-direction:column;gap:10px">
      {faqs.map((f) => (
        <details style="background:#fff;border:2px solid var(--border);border-radius:12px;padding:14px 16px">
          <summary style="cursor:pointer;font-size:15px;font-weight:800;color:var(--navy)">{f.q}</summary>
          <p style="margin:8px 0 0;font-size:14px;font-weight:600;color:var(--muted);line-height:1.55">{f.a}</p>
        </details>
      ))}
    </div>

    <div style="text-align:center;margin-top:36px">
      <button type="button" id="rep-cta-2" class="rep-cta">Become a rep — it’s free</button>
    </div>
  </main>
</BaseLayout>

<style is:global>
  .rep-cta { margin-top: 22px; padding: 16px 30px; border: 0; border-radius: 12px; background: var(--accent); color: var(--contrast); font-size: 16px; font-weight: 800; font-family: inherit; cursor: pointer; box-shadow: 0 6px 18px rgba(var(--accent-rgb), 0.28); }
  .rep-cta:hover { background: var(--accent-hover); }
  .rep-cta:disabled { opacity: 0.6; cursor: wait; }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.rep-cta'));
  const errorEl = document.getElementById('rep-cta-error')!;

  fetch('/api/me')
    .then((r) => (r.ok ? r.json() : null))
    .then((data) => {
      if (data?.isRep) for (const b of buttons) b.textContent = 'Open your rep dashboard';
    })
    .catch(() => {});

  async function onClick() {
    errorEl.hidden = true;
    for (const b of buttons) b.disabled = true;
    try {
      const meRes = await fetch('/api/me');
      if (meRes.status === 401) {
        window.location.href = '/login/?next=/become-a-rep/';
        return;
      }
      const me = await meRes.json();
      if (me?.isRep) {
        window.location.href = '/rep-dashboard/';
        return;
      }
      const res = await fetch('/api/rep/join', { method: 'POST' });
      if (res.status === 401) {
        window.location.href = '/login/?next=/become-a-rep/';
        return;
      }
      const data = await res.json();
      if (!data.ok) throw new Error('join failed');
      window.location.href = '/rep-dashboard/?welcome=1';
    } catch {
      errorEl.textContent = 'Something went wrong. Please try again.';
      errorEl.hidden = false;
      for (const b of buttons) b.disabled = false;
    }
  }
  for (const b of buttons) b.addEventListener('click', onClick);
</script>
