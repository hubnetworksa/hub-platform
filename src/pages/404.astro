---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../site';

// Astro's special 404.astro convention builds dist/404.html; Cloudflare
// Pages automatically serves that file (with a real 404 status) for any
// request that doesn't match a real route. Before this existed, every
// unmatched URL fell through to index.html with a 200 -- a soft-404 that's
// bad for crawlers (looks like duplicate/thin content at every wrong URL).
---

<BaseLayout
  title="Page not found"
  description={`This page doesn't exist on ${site.siteName}.`}
  noindex={true}
>
  <main style="max-width:1200px;margin:0 auto;padding:clamp(40px,8vw,90px) 20px clamp(50px,8vw,90px);min-height:52vh">
    <div style="max-width:620px">
      <div style="font-size:clamp(64px,13vw,128px);font-weight:800;color:var(--accent);letter-spacing:-.05em;line-height:.9">404</div>
      <h1 style="margin:16px 0 12px;font-size:clamp(24px,3.6vw,36px);letter-spacing:-.03em;line-height:1.08;color:var(--navy)">That page has moved or never existed</h1>
      <p style="margin:0 0 26px;font-size:16.5px;line-height:1.6;color:var(--text);max-width:48ch">If you followed a link to a business, the listing may have been removed at the owner's request.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="/" class="nf-primary" style="padding:14px 22px;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:14.5px;font-weight:800;cursor:pointer;text-decoration:none">Back to home</a>
        <a href="/suburb/" style="padding:14px 22px;border-radius:11px;border:2px solid var(--border);background:#fff;color:var(--navy);font-size:14.5px;font-weight:800;cursor:pointer;text-decoration:none">Browse the directory</a>
        <a href="/contact/" style="padding:14px 22px;border-radius:11px;border:2px solid var(--border);background:#fff;color:var(--navy);font-size:14.5px;font-weight:800;cursor:pointer;text-decoration:none">Report a broken link</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .nf-primary:hover {
    background: var(--accent-hover) !important;
  }
</style>
