---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import SearchBox from '../../components/SearchBox.astro';
import { categories, businessesInCategory } from '../../lib/data';
import { CATEGORY_GROUPS } from '../../lib/categoryGroups';
import { collectionPageJsonLd } from '../../lib/seo';
import site from '../../site';

const categoryBySlug = new Map(categories.map((c) => [c.slug, c]));

// Sorted alphabetically for display here, rather than CATEGORY_GROUPS' own
// curated order (still used as-is on the homepage) — this page's job is
// being a complete, scannable index, so alphabetical is easier to scan/find
// a specific section in than a curated order is.
const sortedGroups = [...CATEGORY_GROUPS].sort((a, b) => a.name.localeCompare(b.name));

const jsonLd = collectionPageJsonLd({
  name: 'Categories',
  description: `Every business category ${site.siteName} covers, organised by section.`,
  url: `https://${site.domain}/category/`,
  items: sortedGroups.flatMap((group) =>
    group.categorySlugs
      .map((slug) => categoryBySlug.get(slug))
      .filter((c): c is NonNullable<typeof c> => Boolean(c))
      .map((c) => ({ name: c.name, url: `https://${site.domain}/category/${c.slug}/` }))
  ),
});
---

<BaseLayout
  title="Categories"
  description={`Every business category ${site.siteName} covers, organised by section — from food and shopping to trade services and professionals.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main>
    <section style="position:relative;background:var(--navy);overflow:hidden">
      <img src={site.bannerImage} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%" />
      <div style="position:absolute;inset:0;background:linear-gradient(105deg,rgba(var(--navy-rgb),.94) 0%,rgba(var(--navy-rgb),.82) 42%,rgba(var(--navy-rgb),.34) 78%,rgba(var(--navy-rgb),.12) 100%)"></div>
      <div style="position:relative;max-width:1200px;margin:0 auto;padding:clamp(30px,5vw,54px) 20px clamp(26px,4vw,38px)">
        <h1 style="margin:0 0 10px;color:#fff;font-size:clamp(28px,4.6vw,44px);letter-spacing:-.03em;line-height:1.05">Categories</h1>
        <p style="margin:0 0 22px;color:rgba(255,255,255,.86);font-size:15.5px;max-width:58ch;line-height:1.55">Browse {site.cityLabel} businesses by section.</p>
        <SearchBox />
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:clamp(28px,4vw,44px) 20px 60px">
      {sortedGroups.map((group, i) => {
        const groupCategories = group.categorySlugs
          .map((slug) => categoryBySlug.get(slug))
          .filter((c): c is NonNullable<typeof c> => Boolean(c))
          .sort((a, b) => a.name.localeCompare(b.name));
        const groupTotal = groupCategories.reduce((sum, c) => sum + businessesInCategory(c.id).length, 0);

        return (
          <div id={group.slug} style={`scroll-margin-top:16px;${i > 0 ? 'margin-top:36px;' : ''}`}>
            <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-bottom:2px solid var(--navy);padding-bottom:12px;flex-wrap:wrap">
              <div style="display:flex;align-items:center;gap:9px;">
                <span style="color:var(--accent)"><Icon path={group.iconPath} size={22} /></span>
                <h2 style="margin:0;font-size:clamp(20px,2.8vw,26px);letter-spacing:-.02em;color:var(--navy)">{group.name} <span style="font-weight:600;color:var(--muted);font-size:15px">({groupTotal})</span></h2>
              </div>
              <a href={`/section/${group.slug}/`} style="font-size:13.5px;font-weight:800;color:var(--accent);white-space:nowrap;text-decoration:none">View all →</a>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin-top:16px">
              {groupCategories.map((category) => (
                <a href={`/category/${category.slug}/`} style="display:flex;align-items:center;gap:10px;padding:14px 16px;border:2px solid var(--border);border-radius:12px;background:#fff;text-decoration:none">
                  <span style="color:var(--accent)"><Icon path={group.iconPath} size={18} /></span>
                  <strong style="flex:1;font-size:14.5px;color:var(--navy);font-weight:700;">{category.name}</strong>
                  <span style="color:var(--muted);font-size:12.5px;font-weight:700;">{businessesInCategory(category.id).length}</span>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </section>
  </main>
</BaseLayout>
