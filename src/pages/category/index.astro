---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { categories, businesses, businessesInCategory, sponsorFor } from '../../lib/data';
import { CATEGORY_GROUPS } from '../../lib/categoryGroups';
import { collectionPageJsonLd } from '../../lib/seo';
import site from '../../site';

const categoryBySlug = new Map(categories.map((c) => [c.slug, c]));

// Alphabetical rather than CATEGORY_GROUPS' curated order (still used on
// the homepage) — this page is the complete index, so easiest-to-scan wins.
const sortedGroups = [...CATEGORY_GROUPS].sort((a, b) => a.name.localeCompare(b.name));

const groups = sortedGroups.map((group) => {
  const subs = group.categorySlugs
    .map((slug) => categoryBySlug.get(slug))
    .filter((c): c is NonNullable<typeof c> => Boolean(c))
    .map((c) => ({ slug: c.slug, name: c.name, count: businessesInCategory(c.id).length }))
    .sort((a, b) => a.name.localeCompare(b.name));
  const soldCount = subs.filter((s) => sponsorFor('category_sponsor', s.slug)).length;
  return {
    slug: group.slug,
    name: group.name,
    iconPath: group.iconPath,
    subs,
    total: subs.reduce((sum, s) => sum + s.count, 0),
    sponsorLabel: soldCount > 0 ? `${soldCount} of ${subs.length} categories sponsored` : 'Sponsor slot open',
  };
});

const NUMBER_WORDS = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const sectionWord = NUMBER_WORDS[groups.length] ?? String(groups.length);
const categoryCount = groups.reduce((sum, g) => sum + g.subs.length, 0);

const jsonLd = collectionPageJsonLd({
  name: 'Categories',
  description: `Every business category ${site.siteName} covers, organised by section.`,
  url: `https://${site.domain}/category/`,
  items: groups.flatMap((g) => g.subs.map((s) => ({ name: s.name, url: `https://${site.domain}/category/${s.slug}/` }))),
});
---

<BaseLayout
  title="Categories"
  description={`Every business category ${site.siteName} covers, organised by section — from food and shopping to trade services and professionals.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <main>
    <section style="background:var(--navy);color:#fff">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(28px,4.5vw,54px) 20px">
        <Breadcrumbs variant="plain" onDark items={[{ label: 'Home', href: '/' }, { label: 'Categories' }]} />
        <h1 style="margin:14px 0 12px;color:#fff;font-size:clamp(28px,5vw,48px);letter-spacing:-.03em;line-height:1.04;max-width:20ch">Every category in {site.cityLabel}</h1>
        <p style="margin:0 0 22px;color:rgba(255,255,255,.86);font-size:16px;line-height:1.55;max-width:54ch">{sectionWord} sections, {categoryCount} categories, {businesses.length.toLocaleString('en-US')} reviewed listings. Pick a section to see what sits under it.</p>
        <div style="background:#fff;border-radius:14px;padding:8px;max-width:560px;display:flex;align-items:center;gap:10px">
          <div style="display:flex;align-items:center;gap:10px;padding:0 12px;border-radius:9px;background:var(--bg-subtle);flex:1;min-width:0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1.9" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m20 20-4.5-4.5"></path></svg>
            <input id="cat-query" type="text" autocomplete="off" placeholder="Search categories — plumber, dentist…" aria-label="Search categories" style="flex:1;min-width:0;border:0;background:transparent;padding:13px 0;font-size:15px;color:var(--text);outline:none" />
          </div>
        </div>
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:clamp(24px,3.5vw,40px) 20px 0">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:16px">
        {groups.map((g) => (
          <section class="cat-group" data-group-name={g.name.toLowerCase()} style="border:2px solid var(--border);border-radius:16px;background:#fff;overflow:hidden;display:flex;flex-direction:column">
            <div style="padding:18px 20px;border-bottom:2px solid var(--navy);display:flex;align-items:flex-start;gap:13px">
              <span style="flex-shrink:0;width:42px;height:42px;border-radius:11px;background:var(--bg-subtle);display:flex;align-items:center;justify-content:center;color:var(--accent)">
                <Icon path={g.iconPath} size={23} />
              </span>
              <span style="display:flex;flex-direction:column;min-width:0">
                <a href={`/section/${g.slug}/`} style="font-size:18px;font-weight:800;letter-spacing:-.02em;color:var(--navy);line-height:1.2;text-decoration:none">{g.name}</a>
                <span style="font-size:12.5px;font-weight:700;color:var(--muted);margin-top:3px">{g.subs.length} categories · {g.total.toLocaleString('en-US')} businesses</span>
              </span>
            </div>
            <div style="display:flex;flex-direction:column">
              {g.subs.map((s) => (
                <a href={`/category/${s.slug}/`} class="cat-sub" data-name={s.name.toLowerCase()} style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 20px;border-bottom:1px solid var(--border);color:var(--navy);text-decoration:none">
                  <span style="font-size:14.5px;font-weight:700;min-width:0">{s.name}</span>
                  <span style="font-size:12px;font-weight:800;color:var(--muted);white-space:nowrap">{s.count}</span>
                </a>
              ))}
            </div>
            <div style="margin-top:auto;padding:14px 20px;background:var(--bg-subtle);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
              <span style="font-size:11.5px;font-weight:800;color:var(--muted)">{g.sponsorLabel}</span>
              <a href="/pricing/" style="font-size:12.5px;font-weight:800;color:var(--accent);white-space:nowrap;text-decoration:none">Sponsor this section →</a>
            </div>
          </section>
        ))}
      </div>
      <div id="cat-empty" hidden style="border:2px dashed var(--border);border-radius:14px;padding:34px;text-align:center;background:var(--bg-subtle)">
        <div style="font-size:16px;font-weight:800;color:var(--navy)">No category matches that</div>
        <div style="font-size:13.5px;font-weight:600;color:var(--muted);margin-top:5px">Try a trade name like "plumber" or "attorney".</div>
      </div>
    </section>

    <section style="margin-top:clamp(36px,5vw,56px);background:var(--accent)">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(30px,4.5vw,52px) 20px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px">
        <h2 style="margin:0;color:var(--contrast);font-size:clamp(23px,3.4vw,36px);letter-spacing:-.03em;line-height:1.08;max-width:26ch">One advertiser owns the top of each category. Claim yours.</h2>
        <a href="/pricing/" style="padding:16px 26px;border-radius:12px;background:#fff;color:var(--accent-hover);font-size:15px;font-weight:800;white-space:nowrap;text-decoration:none">See category rates</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .cat-group:hover {
    border-color: var(--navy) !important;
  }
  .cat-sub:hover {
    background: var(--bg-subtle);
  }
  /* Inline display:flex on these beats the browser's [hidden] rule. */
  .cat-group[hidden],
  .cat-sub[hidden] {
    display: none !important;
  }
</style>

<script>
  // Same filter as the mockup: a section matches if its name matches (show
  // all of its categories) or any of its categories does (show just those).
  const input = document.getElementById('cat-query') as HTMLInputElement;
  const groups = document.querySelectorAll<HTMLElement>('.cat-group');
  const empty = document.getElementById('cat-empty')!;

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visibleGroups = 0;
    groups.forEach((group) => {
      const groupMatches = !q || (group.dataset.groupName ?? '').includes(q);
      let visibleSubs = 0;
      group.querySelectorAll<HTMLElement>('.cat-sub').forEach((sub) => {
        const show = !q || groupMatches || (sub.dataset.name ?? '').includes(q);
        sub.hidden = !show;
        if (show) visibleSubs++;
      });
      group.hidden = visibleSubs === 0;
      if (visibleSubs > 0) visibleGroups++;
    });
    empty.hidden = visibleGroups > 0;
  });
</script>
