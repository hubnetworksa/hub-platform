---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BusinessCard from '../../../components/BusinessCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { categories, suburbs, businessesInSuburbAndCategory, byPlanThenName } from '../../../lib/data';
import SponsorBanner from '../../../components/SponsorBanner.astro';
import { groupForCategory } from '../../../lib/categoryGroups';
import { synonymsFor, locationSynonymsFor, suburbSynonymsFor } from '../../../lib/categorySynonyms';
import { collectionPageJsonLd } from '../../../lib/seo';
import site from '../../../site';

export function getStaticPaths() {
  const paths = [];
  for (const category of categories) {
    for (const suburb of suburbs) {
      const businesses = businessesInSuburbAndCategory(suburb.id, category.id);
      // Only generate a page for combinations that actually have listings —
      // otherwise this would be 57 x 16 mostly-empty pages, which is bad
      // for SEO (thin content) rather than good for it.
      if (businesses.length === 0) continue;
      paths.push({ params: { slug: category.slug, suburb: suburb.slug }, props: { category, suburb, businesses } });
    }
  }
  return paths;
}

const { category, suburb, businesses: unsorted } = Astro.props;
const businesses = [...unsorted].sort(byPlanThenName);
const group = groupForCategory(category.slug);
const synonyms = [
  ...synonymsFor(category.slug),
  ...locationSynonymsFor(category.name, site.cityLabel),
  ...suburbSynonymsFor(category.name, suburb.name),
];
const synonymLine = synonyms.length > 0 ? ` Also searched as: ${synonyms.slice(0, 4).join(', ')}.` : '';

const h1Title = `${category.name} in ${suburb.name}, ${site.cityLabel}`;

const jsonLd = collectionPageJsonLd({
  name: h1Title,
  description: `${businesses.length} ${category.name} in ${suburb.name} — part of the Greater ${site.cityLabel} area.`,
  url: `https://${site.domain}/category/${category.slug}/${suburb.slug}/`,
  items: businesses.map((b) => ({ name: b.name, url: `https://${site.domain}/business/${b.slug}/` })),
  keywords: synonyms,
});
---

<BaseLayout
  title={`${category.name} in ${suburb.name}`}
  description={`${businesses.length} ${category.name} in ${suburb.name} — part of the Greater ${site.cityLabel} area.${synonymLine}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <main>
    <section style="position:relative;background:var(--navy);overflow:hidden;min-height:clamp(200px,26vw,320px)">
      <img src={site.sectionBannerImage} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%" />
      <div style="position:absolute;inset:0;background:linear-gradient(100deg,rgba(var(--navy-rgb),.93) 0%,rgba(var(--navy-rgb),.74) 50%,rgba(var(--navy-rgb),.24) 100%)"></div>
      <div style="position:relative;max-width:1200px;margin:0 auto;padding:26px 20px 30px">
        <Breadcrumbs
          variant="plain"
          onDark
          items={[
            { label: 'Categories', href: '/category/' },
            { label: category.name, href: `/category/${category.slug}/` },
            { label: suburb.name },
          ]}
        />
        <h1 style="margin:14px 0 10px;color:#fff;font-size:clamp(28px,4.6vw,46px);letter-spacing:-.03em;line-height:1.04">{h1Title}</h1>
        <p style="margin:0;color:rgba(255,255,255,.86);font-size:15.5px;max-width:58ch;line-height:1.55">{businesses.length} listed.</p>
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:22px 20px 60px">
      <a href={`/suburb/${suburb.slug}/`} style="display:inline-block;padding:9px 14px;border:2px solid var(--border);border-radius:9px;font-size:13px;font-weight:800;color:var(--navy);text-decoration:none">See all businesses in {suburb.name} →</a>
      <div style="margin-top:18px">
        <SponsorBanner productType="suburb_sponsor" target={suburb.slug} context={suburb.name} />
        <SponsorBanner productType="category_sponsor" target={category.slug} context={`${category.name} in ${site.cityLabel}`} />
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px">
        {businesses.map((business) => <BusinessCard business={business} showSuburb={false} />)}
      </div>
    </section>
  </main>
</BaseLayout>
