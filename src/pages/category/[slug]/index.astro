---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BusinessCard from '../../../components/BusinessCard.astro';
import SponsorBanner from '../../../components/SponsorBanner.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SponsorSlot from '../../../components/SponsorSlot.astro';
import { categories, businessesInCategory, suburbFor, type Business, byPlanThenName, FEATURED_TIER, isPaidListing, sponsorFor } from '../../../lib/data';
import { groupForCategory } from '../../../lib/categoryGroups';
import { synonymsFor, locationSynonymsFor } from '../../../lib/categorySynonyms';
import { collectionPageJsonLd } from '../../../lib/seo';
import site from '../../../site';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const businesses = businessesInCategory(category.id);

const bySuburb = new Map<string, { name: string; slug: string; businesses: Business[] }>();
for (const business of businesses) {
  const suburb = suburbFor(business);
  if (!suburb) continue;
  if (!bySuburb.has(suburb.slug)) bySuburb.set(suburb.slug, { name: suburb.name, slug: suburb.slug, businesses: [] });
  bySuburb.get(suburb.slug)!.businesses.push(business);
}
for (const g of bySuburb.values()) g.businesses.sort(byPlanThenName);
const suburbGroups = [...bySuburb.values()].sort((a, b) => b.businesses.length - a.businesses.length);
// "Top of your category page" for the Featured plan: every Featured
// business in this category, above the suburb-by-suburb list.
const featuredInCategory = businesses.filter((b) => b.subscription_tier >= FEATURED_TIER).sort(byPlanThenName);
const group = groupForCategory(category.slug);
const isEmpty = businesses.length === 0;

// Sibling categories in the same group — only ones with real listings, so
// this never sends someone to a thin/noindexed page (principle 2 of the
// SEO plan: never manufacture links to near-empty pages).
const relatedCategories = (group?.categorySlugs ?? [])
  .filter((slug) => slug !== category.slug)
  .map((slug) => categories.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c) && businessesInCategory(c.id).length > 0)
  .sort((a, b) => a.name.localeCompare(b.name));
const synonyms = [...synonymsFor(category.slug), ...locationSynonymsFor(category.name, site.cityLabel)];
const synonymLine = synonyms.length > 0 ? ` Also searched as: ${synonyms.slice(0, 4).join(', ')}.` : '';

const h1Title = `${category.name} in ${site.cityLabel}`;

const jsonLd = isEmpty
  ? null
  : collectionPageJsonLd({
      name: h1Title,
      description: `${businesses.length} ${category.name} listed across ${site.cityLabel}, by suburb.`,
      url: `https://${site.domain}/category/${category.slug}/`,
      items: businesses.map((b) => ({ name: b.name, url: `https://${site.domain}/business/${b.slug}/` })),
    });
// No Google ads anywhere a paid listing or sponsor is shown (see
// BaseLayout's noAds): this page shows one if this is true.
const showsPaid = businesses.some(isPaidListing) || !!sponsorFor('category_sponsor', category.slug);
---

<BaseLayout noAds={showsPaid}
  title={category.name}
  description={`${businesses.length} ${category.name} listed across ${site.cityLabel}, by suburb.${synonymLine}`}
  noindex={isEmpty}
>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}

  <main>
    <section style="position:relative;background:var(--navy);overflow:hidden;min-height:clamp(200px,26vw,320px)">
      <img src={site.sectionBannerImage} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%" />
      <div style="position:absolute;inset:0;background:linear-gradient(100deg,rgba(var(--navy-rgb),.93) 0%,rgba(var(--navy-rgb),.74) 50%,rgba(var(--navy-rgb),.24) 100%)"></div>
      <div style="position:relative;max-width:1200px;margin:0 auto;padding:26px 20px 30px">
        <Breadcrumbs
          variant="plain"
          onDark
          items={[
            { label: 'Categories', href: '/category/' },
            ...(group ? [{ label: group.name, href: `/section/${group.slug}/` }] : []),
            { label: category.name },
          ]}
        />
        <h1 style="margin:14px 0 10px;color:#fff;font-size:clamp(28px,4.6vw,46px);letter-spacing:-.03em;line-height:1.04">{h1Title}</h1>
        <p style="margin:0;color:rgba(255,255,255,.86);font-size:15.5px;max-width:58ch;line-height:1.55">{businesses.length} listed, by suburb.</p>
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:22px 20px 60px">
      <div style="max-width:420px;margin-bottom:22px">
        <SponsorSlot
          productType="category_sponsor"
          target={category.slug}
          title={`Own ${category.name}`}
          openBody={`One business sponsors ${category.name.toLowerCase()} in ${site.cityLabel}. The slot is open.`}
          ctaLabel="Sponsor this category"
        />
      </div>
      <SponsorBanner productType="category_sponsor" target={category.slug} context={`${category.name} in ${site.cityLabel}`} />
      {featuredInCategory.length > 0 && (
        <div style="margin-bottom:28px">
          <h2 style="margin:0 0 12px;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)">Featured {category.name.toLowerCase()}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px">
            {featuredInCategory.map((business) => <BusinessCard business={business} />)}
          </div>
        </div>
      )}
      {isEmpty ? (
        <div>
          <p style="color:var(--muted);line-height:1.6;">No {category.name.toLowerCase()} listed yet — this page will fill in as new businesses are added.</p>
          <p style="color:var(--muted);line-height:1.6;">
            {group && (
              <>Browse <a href={`/section/${group.slug}/`} style="color:var(--navy);font-weight:700;">{group.name}</a> for related categories, or{' '}</>
            )}
            <a href="/list-your-business/" style="color:var(--navy);font-weight:700;">list your business</a> if you run one in this category.
          </p>
        </div>
      ) : (
        suburbGroups.map((suburbGroup, i) => (
          <div style={i > 0 ? 'margin-top:30px;' : ''}>
            <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-bottom:2px solid var(--navy);padding-bottom:10px;flex-wrap:wrap">
              <h2 style="margin:0;font-size:18px;letter-spacing:-.02em;color:var(--navy)">{suburbGroup.name} <span style="font-weight:600;color:var(--muted);font-size:14px">({suburbGroup.businesses.length})</span></h2>
              <a href={`/category/${category.slug}/${suburbGroup.slug}/`} style="font-size:13px;font-weight:800;color:var(--accent);white-space:nowrap;text-decoration:none">View all →</a>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;margin-top:14px">
              {suburbGroup.businesses.map((business) => <BusinessCard business={business} showSuburb={false} />)}
            </div>
          </div>
        ))
      )}

      {!isEmpty && relatedCategories.length > 0 && group && (
        <div style="margin-top:36px;padding-top:20px;border-top:2px solid var(--border);">
          <h2 style="margin:0 0 12px;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">More in {group.name}</h2>
          <div style="display:flex;flex-wrap:wrap;gap:8px;">
            {relatedCategories.map((c) => (
              <a href={`/category/${c.slug}/`} style="padding:9px 14px;border:2px solid var(--border);border-radius:999px;font-size:13.5px;font-weight:700;color:var(--navy);background:#fff;text-decoration:none">{c.name}</a>
            ))}
          </div>
        </div>
      )}
    </section>
  </main>
</BaseLayout>
