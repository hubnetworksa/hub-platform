---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BusinessCard from '../../../components/BusinessCard.astro';
import PageBanner from '../../../components/PageBanner.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { categories, businessesInCategory, suburbFor, type Business } from '../../../lib/data';
import { groupForCategory } from '../../../lib/categoryGroups';
import { synonymsFor, locationSynonymsFor } from '../../../lib/categorySynonyms';
import { collectionPageJsonLd } from '../../../lib/seo';
import site from '../../../site';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const businesses = businessesInCategory(category.id);

const bySuburb = new Map<string, { name: string; businesses: Business[] }>();
for (const business of businesses) {
  const suburb = suburbFor(business);
  if (!suburb) continue;
  if (!bySuburb.has(suburb.slug)) bySuburb.set(suburb.slug, { name: suburb.name, businesses: [] });
  bySuburb.get(suburb.slug)!.businesses.push(business);
}
const suburbGroups = [...bySuburb.entries()].sort((a, b) => b[1].businesses.length - a[1].businesses.length);
const group = groupForCategory(category.slug);
const isEmpty = businesses.length === 0;

// Sibling categories in the same group — only ones with real listings, so
// this never sends someone to a thin/noindexed page (principle 2 of the
// SEO plan: never manufacture links to near-empty pages).
const relatedCategories = (group?.categorySlugs ?? [])
  .filter((slug) => slug !== category.slug)
  .map((slug) => categories.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c) && businessesInCategory(c.id).length > 0)
  .sort((a, b) => a.name.localeCompare(b.name));
const synonyms = [...synonymsFor(category.slug), ...locationSynonymsFor(category.name, site.cityLabel)];
const synonymLine = synonyms.length > 0 ? ` Also searched as: ${synonyms.slice(0, 4).join(', ')}.` : '';

const h1Title = `${category.name} in ${site.cityLabel}`;

const jsonLd = isEmpty
  ? null
  : collectionPageJsonLd({
      name: h1Title,
      description: `${businesses.length} ${category.name} listed across ${site.cityLabel}, by suburb.`,
      url: `https://${site.domain}/category/${category.slug}/`,
      items: businesses.map((b) => ({ name: b.name, url: `https://${site.domain}/business/${b.slug}/` })),
    });
---

<BaseLayout
  title={category.name}
  description={`${businesses.length} ${category.name} listed across ${site.cityLabel}, by suburb.${synonymLine}`}
  noindex={isEmpty}
>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <PageBanner title={h1Title} description={`${businesses.length} listed, by suburb.`} iconPath={group?.iconPath}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Categories', href: '/category/' },
        ...(group ? [{ label: group.name, href: `/section/${group.slug}/` }] : []),
        { label: category.name },
      ]}
    />
  </PageBanner>

  <section class="container" style="padding-top: 2rem; padding-bottom: 3rem;">
    {isEmpty ? (
      <div class="empty-category">
        <p>No {category.name.toLowerCase()} listed yet — this page will fill in as new businesses are added.</p>
        <p>
          {group && (
            <>Browse <a href={`/section/${group.slug}/`}>{group.name}</a> for related categories, or{' '}</>
          )}
          <a href="/list-your-business/">list your business</a> if you run one in this category.
        </p>
      </div>
    ) : (
      suburbGroups.map(([slug, suburbGroup]) => (
        <div style="margin-top: 1.75rem;">
          <div class="cat-head">
            <h2>{suburbGroup.name} <span class="cat-count">({suburbGroup.businesses.length})</span></h2>
            <a href={`/category/${category.slug}/${slug}/`} class="btn btn-outline btn-sm">View all →</a>
          </div>
          <div class="business-grid">
            {suburbGroup.businesses.map((business) => <BusinessCard business={business} showSuburb={false} />)}
          </div>
        </div>
      ))
    )}

    {!isEmpty && relatedCategories.length > 0 && group && (
      <div class="related-categories">
        <h2>More in {group.name}</h2>
        <div class="related-chip-row">
          {relatedCategories.map((c) => (
            <a class="related-chip" href={`/category/${c.slug}/`}>{c.name}</a>
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .cat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .cat-head h2 {
    font-size: 1.05rem;
    margin: 0;
  }
  .cat-count {
    color: var(--text-muted);
    font-weight: 400;
    font-size: 0.85rem;
  }
  .business-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
  }
  .empty-category p {
    color: var(--text-muted);
    line-height: 1.6;
  }
  .empty-category a {
    color: var(--navy);
    font-weight: 600;
  }
  .related-categories {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .related-categories h2 {
    font-size: 1rem;
    margin: 0 0 0.75rem;
    color: var(--navy);
  }
  .related-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .related-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--text);
    font-size: 0.9rem;
    background: var(--bg-card);
  }
  .related-chip:hover {
    border-color: var(--accent);
  }
</style>
