---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ListReturn from '../../components/ListReturn.astro';
import PlanBadge from '../../components/PlanBadge.astro';
import { businesses, suburbFor, categoriesFor, shoppingCenterFor, parseSourceUrls, photosFor, FEATURED_TIER, businessesInCategory } from '../../lib/data';
import { synonymsFor, locationSynonymsFor } from '../../lib/categorySynonyms';
import { schemaTypeFor } from '../../lib/categorySchemaTypes';
import Icon from '../../components/Icon.astro';
import site from '../../site';

export function getStaticPaths() {
  return businesses.map((business) => ({ params: { slug: business.slug }, props: { business } }));
}

const { business } = Astro.props;
const suburb = suburbFor(business);
const cats = categoriesFor(business);
const sourceUrls = parseSourceUrls(business);
const isOsmSourced = sourceUrls.some((u) => u.includes('openstreetmap.org'));
const SOURCE_LABELS: Record<string, string> = {
  'owner-submitted': 'Submitted by the business owner.',
  'scraped:google-places-no-website': 'Compiled from a publicly available Google Maps listing.',
  'owner-provided-contact-details': 'Contact details confirmed directly with the site owner.',
};
const hasVerifiedUrlSource = sourceUrls.some((u) => /^https?:\/\//.test(u));
const labelSources = sourceUrls.filter((u) => !/^https?:\/\//.test(u)).map((u) => SOURCE_LABELS[u] ?? u);
const center = shoppingCenterFor(business);
const isFeatured = business.subscription_tier >= FEATURED_TIER;
// Featured-tier perk — see functions/api/business-photos.ts. Photos stay
// in R2/business_photos through a downgrade (never deleted), but the
// gallery only renders while the business is CURRENTLY Featured.
const photos = isFeatured ? photosFor(business) : [];

const similar = cats[0]
  ? businessesInCategory(cats[0].id).filter((b) => b.id !== business.id).slice(0, 4)
  : [];

const keywords = [
  ...new Set(cats.flatMap((c) => [...synonymsFor(c.slug), ...locationSynonymsFor(c.name, site.cityLabel)])),
];

const schemaType = cats[0] ? schemaTypeFor(cats[0].slug) : 'LocalBusiness';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = siteUrl + Astro.url.pathname;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: business.name,
  description: business.description,
  url: canonicalUrl,
  ...(business.address ? { address: { '@type': 'PostalAddress', streetAddress: business.address, addressLocality: suburb?.name, addressRegion: site.province, addressCountry: 'ZA' } } : {}),
  ...(business.phone ? { telephone: business.phone } : {}),
  ...(business.lat && business.lng ? { geo: { '@type': 'GeoCoordinates', latitude: business.lat, longitude: business.lng } } : {}),
  ...(keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
};

const mapsUrl = (business.address || (business.lat && business.lng))
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${business.name}${suburb ? `, ${suburb.name}` : ''}`)}`
  : null;
---

<BaseLayout title={business.name} description={business.description.slice(0, 155)} canonical={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main style="max-width:1200px;margin:0 auto;padding:22px 20px 60px">
    <Breadcrumbs
      variant="plain"
      items={[
        { label: 'Home', href: '/' },
        ...(suburb ? [{ label: suburb.name, href: `/suburb/${suburb.slug}/` }] : []),
        ...(cats[0] ? [{ label: cats[0].name, href: `/category/${cats[0].slug}/` }] : []),
        { label: business.name },
      ]}
    />

    <div id="profile-shell" style="display:grid;grid-template-columns:1fr;gap:24px;margin-top:16px">
      <div>
        <div style="border:2px solid var(--navy);border-radius:16px;overflow:hidden;background:#fff">
          {isFeatured && (
            <div style="display:flex;align-items:center;gap:10px;padding:12px 18px;background:var(--navy);flex-wrap:wrap">
              <PlanBadge tier={business.subscription_tier} label="Featured listing" />
              {hasVerifiedUrlSource && (
                <span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:800;color:var(--grad-from)">
                  <Icon path="<path d='M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-4Z'/><path d='m9.5 12 1.8 1.8L15 10'/>" size={14} />
                  Owner verified
                </span>
              )}
            </div>
          )}
          <div style="padding:clamp(18px,3vw,28px)">
            <h1 style="margin:0 0 10px;font-size:clamp(26px,4vw,40px);letter-spacing:-.03em;line-height:1.05;color:var(--navy);overflow-wrap:break-word">{business.name}</h1>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px">
              {!isFeatured && <PlanBadge tier={business.subscription_tier} />}
              {cats.map((c) => (
                <a href={`/category/${c.slug}/`} style="padding:6px 11px;border-radius:999px;background:var(--bg-subtle);color:var(--accent-hover);font-size:12.5px;font-weight:800;text-decoration:none">{c.name}</a>
              ))}
              {suburb && <span style="padding:6px 11px;border-radius:999px;border:1.5px solid var(--border);color:var(--muted);font-size:12.5px;font-weight:700">{suburb.name}</span>}
            </div>
            <p style="margin:0 0 20px;font-size:16px;line-height:1.62;max-width:62ch">{business.description}</p>
            {center && (
              <p style="margin:0 0 16px;">
                <a href={`/shopping-center/${center.slug}/`} style="display:inline-flex;align-items:center;gap:8px;color:var(--accent);font-weight:700;font-size:14px;text-decoration:none">
                  <Icon path="<path d='M4 21h16M6 21V7l6-4 6 4v14M9 21v-6h6v6'/>" size={15} />
                  Located at {center.name}
                </a>
              </p>
            )}

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:20px">
              {business.phone && (
                <a href={`tel:${business.phone}`} style="display:flex;align-items:center;gap:9px;padding:14px 16px;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:14.5px;font-weight:800;text-decoration:none">
                  <Icon path="<path d='M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z'/>" size={17} />
                  {business.phone}
                </a>
              )}
              {business.website && (
                <a href={business.website} target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;gap:9px;padding:14px 16px;border-radius:11px;border:2px solid var(--navy);color:var(--navy);font-size:14.5px;font-weight:800;text-decoration:none">
                  <Icon path="<circle cx='12' cy='12' r='9'/><path d='M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18'/>" size={17} />
                  Website
                </a>
              )}
              {mapsUrl && (
                <a href={mapsUrl} target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;gap:9px;padding:14px 16px;border-radius:11px;border:2px solid var(--border);color:var(--navy);font-size:14.5px;font-weight:800;text-decoration:none">
                  <Icon path="<path d='M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z'/><circle cx='12' cy='10' r='2.5'/>" size={17} />
                  Directions
                </a>
              )}
            </div>

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:2px;background:var(--border);border:1px solid var(--border);border-radius:12px;overflow:hidden">
              {business.address && (
                <div style="background:#fff;padding:14px 16px">
                  <div style="font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Address</div>
                  <div style="font-size:14px;font-weight:600;margin-top:5px;line-height:1.45">{business.address}{suburb && `, ${suburb.name}`}</div>
                </div>
              )}
              <div style="background:#fff;padding:14px 16px">
                <div style="font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Trading hours</div>
                <div style="font-size:14px;font-weight:600;margin-top:5px;line-height:1.45;white-space:pre-line">{business.hours ?? 'Not available'}</div>
              </div>
            </div>
            <ListReturn />
          </div>
        </div>

        {photos.length > 0 && (
          <>
            <div style="margin-top:22px;border-bottom:2px solid var(--navy);padding-bottom:10px">
              <h2 style="margin:0;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)">Photos — a Featured-plan unlock</h2>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:14px">
              {photos.map((p) => (
                <img src={`/media/${p.r2_key}`} alt={p.caption ?? business.name} loading="lazy" style="aspect-ratio:4/3;object-fit:cover;border-radius:12px;border:1px solid var(--border)" />
              ))}
            </div>
          </>
        )}

        {similar.length > 0 && (
          <>
            <div style="margin-top:26px;border-bottom:2px solid var(--navy);padding-bottom:10px">
              <h2 style="margin:0;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">Similar suppliers nearby</h2>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin-top:14px">
              {similar.map((b) => (
                <a href={`/business/${b.slug}/`} class="similar-business-card" style="border:2px solid var(--border);border-radius:14px;padding:16px;background:#fff;display:flex;flex-direction:column;gap:5px;text-decoration:none">
                  <span style="font-size:15.5px;font-weight:800;color:var(--navy);letter-spacing:-.01em">{b.name}</span>
                  <span style="font-size:12.5px;font-weight:600;color:var(--muted)">{cats[0]?.name}{suburbFor(b) ? ` · ${suburbFor(b)!.name}` : ''}</span>
                </a>
              ))}
            </div>
          </>
        )}

        {sourceUrls.length > 0 && (
          <p style="margin-top:1.5rem;font-size:0.78rem;color:var(--muted);overflow-wrap:break-word;">
            {isOsmSourced ? (
              <>Sourced from OpenStreetMap ({sourceUrls.map((u, i) => <>{i > 0 && ', '}<a href={u} target="_blank" rel="noopener noreferrer">record</a></>)}), ODbL-licensed.</>
            ) : (
              <span style="display:inline-flex;align-items:center;flex-wrap:wrap;gap:0.5rem;">
                {hasVerifiedUrlSource && (
                  <span style="display:inline-flex;align-items:center;gap:5px;font-weight:800;font-size:11.5px;color:#1a8f5e;background:rgba(26,143,94,.12);padding:4px 10px;border-radius:999px;">
                    <Icon path="<circle cx='12' cy='12' r='9'/><path d='m8.5 12.5 2.5 2.5 5-5'/>" size={13} /> Verified
                  </span>
                )}
                {labelSources.length > 0 && <span>{labelSources.join(' ')}</span>}
              </span>
            )}
          </p>
        )}

        <div style="display:flex;flex-wrap:wrap;gap:1.25rem;margin-top:2rem;padding-top:1rem;border-top:1px solid var(--border);">
          <a href={`/report-listing/?slug=${business.slug}&name=${encodeURIComponent(business.name)}`} style="display:inline-flex;align-items:center;gap:0.35rem;font-size:0.78rem;color:var(--muted);text-decoration:none;">
            <Icon path="<path d='M5 21V4'/><path d='M5 4h13l-3 4 3 4H5'/>" size={13} /> Report this listing
          </a>
          <a href={`/request-removal/?slug=${business.slug}&name=${encodeURIComponent(business.name)}`} style="display:inline-flex;align-items:center;gap:0.35rem;font-size:0.78rem;color:var(--muted);text-decoration:none;">
            <Icon path="<path d='M3 6h18'/><path d='M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2'/><path d='M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6'/>" size={13} /> Request data removal
          </a>
        </div>
      </div>

      <aside style="display:flex;flex-direction:column;gap:14px">
        <div style="border:2px solid var(--navy);border-radius:16px;overflow:hidden;background:#fff">
          <div style="background:var(--navy);padding:14px 18px;font-size:15px;font-weight:800;color:#fff;letter-spacing:-.01em">Send an enquiry</div>
          <form id="enquiry-form" style="padding:16px;display:flex;flex-direction:column;gap:10px">
            <input type="text" name="name" placeholder="Your name" required style="padding:12px 13px;border:2px solid var(--border);border-radius:10px;font-size:14px;outline:none;background:#fff;color:var(--text)" />
            <input type="text" name="contact" placeholder="Phone or email" required style="padding:12px 13px;border:2px solid var(--border);border-radius:10px;font-size:14px;outline:none;background:#fff;color:var(--text)" />
            <textarea name="message" rows="3" placeholder="What do you need a quote on?" required style="padding:12px 13px;border:2px solid var(--border);border-radius:10px;font-size:14px;outline:none;background:#fff;color:var(--text);resize:vertical"></textarea>
            <button type="submit" style="padding:13px 16px;border:0;border-radius:10px;background:var(--accent);color:var(--contrast);font-size:14px;font-weight:800;cursor:pointer">Send enquiry</button>
            <p id="enquiry-status" style="margin:0;font-size:11.5px;color:var(--muted);font-weight:600">Enquiries go straight to the owner. Featured plans include unlimited enquiries.</p>
          </form>
        </div>
        {!business.owner_user_id && (
          <div style="border:2px solid var(--border);border-radius:14px;padding:18px;background:var(--bg-subtle)">
            <h3 style="margin:0 0 8px;font-size:16px;letter-spacing:-.015em;color:var(--navy)">Is this your business?</h3>
            <p style="margin:0 0 12px;font-size:13.5px;line-height:1.55;color:var(--text)">Claim it free to edit details and trading hours. Upgrade to Featured to add photos and a gallery.</p>
            <a href={`/my-businesses/claim/?businessId=${business.id}&name=${encodeURIComponent(business.name)}`} style="display:block;padding:11px 14px;border-radius:9px;border:2px solid var(--navy);color:var(--navy);font-size:13.5px;font-weight:800;background:#fff;text-decoration:none;text-align:center">Claim this listing</a>
          </div>
        )}
        <div style="border:2px dashed var(--border);border-radius:14px;background:var(--bg-subtle);min-height:250px;display:flex;flex-direction:column;justify-content:center;gap:4px;padding:18px">
          <span style="font-size:10px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)">Advertisement</span>
          <span style="font-size:13.5px;font-weight:700;color:var(--muted)">300×250 sidebar unit</span>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  @media (min-width: 950px) {
    #profile-shell {
      grid-template-columns: 1fr 320px;
    }
  }
  .similar-business-card:hover {
    border-color: var(--navy);
  }
</style>

<script define:vars={{ contactEmail: business.email ?? site.contactEmail, businessName: business.name, siteName: site.siteName }}>
  // No enquiry-storage backend exists yet — same mailto: pattern as
  // list-your-business.astro/submit-business.ts: opens the visitor's own
  // mail client addressed to the business (or the site, if no email is on
  // file), pre-filled with their message. Real email transport, just not
  // server-sent.
  const form = document.getElementById('enquiry-form');
  const status = document.getElementById('enquiry-status');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    const body = `From: ${data.name}\nContact: ${data.contact}\n\n${data.message}`;
    const mailto = `mailto:${contactEmail}?subject=${encodeURIComponent(`Enquiry via ${siteName}: ${businessName}`)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;
    status.textContent = "Opening your email app — please hit send.";
  });
</script>
