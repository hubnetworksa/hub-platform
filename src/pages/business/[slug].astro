---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ListReturn from '../../components/ListReturn.astro';
import PlanBadge from '../../components/PlanBadge.astro';
import AdUnit from '../../components/AdUnit.astro';
import { businesses, suburbFor, categoriesFor, shoppingCenterFor, parseSourceUrls, photosFor, FEATURED_TIER, businessesInCategory, websiteUrl, isPaidListing, sponsorshipsHeldBy, reviewsFor, averageRating, reviewCount, logoFor } from '../../lib/data';
import { synonymsFor, locationSynonymsFor } from '../../lib/categorySynonyms';
import { schemaTypeFor } from '../../lib/categorySchemaTypes';
import Icon from '../../components/Icon.astro';
import BusinessLogo from '../../components/BusinessLogo.astro';
import site from '../../site';
import { formatPhoneZA, phoneHref, phoneInternationalZA } from '../../lib/phone';

export function getStaticPaths() {
  return businesses.map((business) => ({ params: { slug: business.slug }, props: { business } }));
}

const { business } = Astro.props;
const suburb = suburbFor(business);
const cats = categoriesFor(business);

// "Name – Category in Suburb" gives every listing a distinct, descriptive
// title (bare names collide across cities and say nothing to a searcher),
// and a listing with no description still gets a real meta description.
const pageTitle = [business.name, cats[0] && suburb ? `${cats[0].name} in ${suburb.name}` : suburb?.name].filter(Boolean).join(' – ');
const metaDescription = (
  business.description?.trim() ||
  `${business.name}${cats[0] ? `, ${cats[0].name.toLowerCase()}` : ''}${suburb ? ` in ${suburb.name}` : ''}. Address, phone, hours and directions.`
).slice(0, 155);
const sourceUrls = parseSourceUrls(business);
const isOsmSourced = sourceUrls.some((u) => u.includes('openstreetmap.org'));
const SOURCE_LABELS: Record<string, string> = {
  'owner-submitted': 'Submitted by the business owner.',
  'scraped:google-places-no-website': 'Compiled from a publicly available Google Maps listing.',
  'owner-provided-contact-details': 'Contact details confirmed directly with the site owner.',
};
const labelSources = sourceUrls.filter((u) => !/^https?:\/\//.test(u)).map((u) => SOURCE_LABELS[u] ?? u);
const center = shoppingCenterFor(business);
const isFeatured = business.subscription_tier >= FEATURED_TIER;
// Ads run only on free (Basic) listings. Any paid plan makes the page
// ad-free: no units, and ad requests are paused so Auto ads can't appear either.
const isPaying = business.subscription_tier >= 1;
// Featured-plan perk: links to the business's own social pages (https only).
const SOCIAL_ICONS: Record<string, string> = {
  instagram: "<rect x='3' y='3' width='18' height='18' rx='5'/><circle cx='12' cy='12' r='4'/><circle cx='17.3' cy='6.7' r='.6'/>",
  facebook: "<path d='M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5c0-.3.2-.5.5-.5Z'/>",
  linkedin: "<rect x='3' y='3' width='18' height='18' rx='3'/><path d='M8 10v6M8 7.5v.01M12 16v-6M12 12.5c0-1.4 1-2.5 2.3-2.5S16.5 11 16.5 12.5V16'/>",
  youtube: "<rect x='2.5' y='5.5' width='19' height='13' rx='4'/><path d='m10 9.5 5 2.5-5 2.5v-5Z'/>",
};
const socials = isFeatured
  ? ([
      ['instagram', 'Instagram', business.social_instagram],
      ['facebook', 'Facebook', business.social_facebook],
      ['linkedin', 'LinkedIn', business.social_linkedin],
      ['youtube', 'YouTube', business.social_youtube],
    ] as const)
      .filter(([, , url]) => !!url && url.startsWith('https://'))
      .map(([kind, label, url]) => ({ kind, label, url: url as string }))
  : [];
// Featured-tier perk — see functions/api/business-photos.ts. Photos stay
// in R2/business_photos through a downgrade (never deleted), but the
// gallery only renders while the business is CURRENTLY Featured.
// Verified shows up to 4 photos, Featured up to 10 (the pricing page's
// promise). A downgrade hides the extras; nothing is deleted.
const PHOTO_CAP_BY_TIER: Record<number, number> = { 1: 4, 2: 10 };
const photos = photosFor(business).slice(0, PHOTO_CAP_BY_TIER[business.subscription_tier] ?? 0);

const similar = cats[0]
  ? businessesInCategory(cats[0].id).filter((b) => b.id !== business.id).slice(0, 4)
  : [];

const businessReviews = reviewsFor(business);
const avgRating = averageRating(business);
const numReviews = reviewCount(business);
function shortDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-ZA', { day: 'numeric', month: 'short', year: 'numeric' });
}
// No Google ads when this business pays — a plan OR any live sponsorship
// (a Basic listing that sponsors a category/suburb/centre/guide/banner is
// still a paying customer) — or when a paid business is shown in the
// "similar" list on this page. Both AdUnit placements below use this same
// gate, as does BaseLayout's noAds (which also pauses AdSense ad requests).
const showsPaid = isPaying || sponsorshipsHeldBy(business).length > 0 || similar.some(isPaidListing);

const keywords = [
  ...new Set(cats.flatMap((c) => [...synonymsFor(c.slug), ...locationSynonymsFor(c.name, site.cityLabel)])),
];

const schemaType = cats[0] ? schemaTypeFor(cats[0].slug) : 'LocalBusiness';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = siteUrl + Astro.url.pathname;

// Verified/Featured perk (see logoFor): null for everyone else, so free
// listings render exactly as before.
const logo = logoFor(business);
const logoUrl = logo ? siteUrl + logo : null;
// Only wraps the name/badges block when there's a logo to sit beside it.
const HeadWrap = logo ? 'div' : Fragment;
const HeadText = logo ? 'div' : Fragment;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: business.name,
  description: business.description,
  url: canonicalUrl,
  ...(logoUrl ? { logo: logoUrl, image: logoUrl } : {}),
  ...(business.address ? { address: { '@type': 'PostalAddress', streetAddress: business.address, addressLocality: suburb?.name, addressRegion: site.province, addressCountry: 'ZA' } } : {}),
  ...(business.phone ? { telephone: phoneInternationalZA(business.phone) } : {}),
  ...(business.lat && business.lng ? { geo: { '@type': 'GeoCoordinates', latitude: business.lat, longitude: business.lng } } : {}),
  ...(keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
};

const mapsUrl = (business.address || (business.lat && business.lng))
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${business.name}${suburb ? `, ${suburb.name}` : ''}`)}`
  : null;
---

<BaseLayout title={pageTitle} description={metaDescription} canonical={canonicalUrl} noAds={showsPaid} ogImage={logo} ogImageSquare={!!logo}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <main style="max-width:1200px;margin:0 auto;padding:22px 20px 60px">
    <Breadcrumbs
      variant="plain"
      items={[
        { label: 'Home', href: '/' },
        ...(suburb ? [{ label: suburb.name, href: `/suburb/${suburb.slug}/` }] : []),
        ...(cats[0] ? [{ label: cats[0].name, href: `/category/${cats[0].slug}/` }] : []),
        { label: business.name },
      ]}
    />

    <div id="profile-shell" style="display:grid;grid-template-columns:1fr;gap:24px;margin-top:16px">
      <div>
        <div style="border:2px solid var(--navy);border-radius:var(--radius-lg);overflow:hidden;background:#fff;box-shadow:var(--shadow)">
          {isFeatured && (
            <div style="display:flex;align-items:center;gap:10px;padding:12px 18px;background:var(--navy);flex-wrap:wrap">
              <PlanBadge tier={business.subscription_tier} label="Featured listing" />
              {business.owner_user_id != null && (
                <span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:800;color:var(--grad-from)">
                  <Icon path="<path d='M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-4Z'/><path d='m9.5 12 1.8 1.8L15 10'/>" size={14} />
                  Owner verified
                </span>
              )}
            </div>
          )}
          <div style="padding:clamp(18px,3vw,28px)">
            <HeadWrap {...(logo ? { class: 'biz-head' } : {})}>
            <BusinessLogo business={business} size="lg" eager />
            <HeadText {...(logo ? { class: 'biz-head-text' } : {})}>
            <h1 style="margin:0 0 10px;font-size:clamp(26px,4vw,40px);letter-spacing:-.03em;line-height:1.05;color:var(--navy);overflow-wrap:break-word">{business.name}</h1>
            <div id="open-row" hidden data-hours={business.hours ?? ''} style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">
              <span id="open-status" style="display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:800;color:var(--accent-hover)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg>
                <span id="open-status-text"></span>
              </span>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px">
              {!isFeatured && <PlanBadge tier={business.subscription_tier} />}
              {numReviews > 0 && (
                <a href="#reviews" style="display:inline-flex;align-items:center;gap:5px;padding:6px 11px;border-radius:999px;background:var(--bg-subtle);color:var(--navy);font-size:12.5px;font-weight:800;text-decoration:none">
                  <Icon path="<path d='m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7Z' fill='currentColor'/>" size={13} />
                  {avgRating} <span style="color:var(--muted);font-weight:700">({numReviews})</span>
                </a>
              )}
              {cats.map((c) => (
                <a href={`/category/${c.slug}/`} style="padding:6px 11px;border-radius:999px;background:var(--bg-subtle);color:var(--accent-hover);font-size:12.5px;font-weight:800;text-decoration:none">{c.name}</a>
              ))}
              {suburb && <span style="padding:6px 11px;border-radius:999px;border:1.5px solid var(--border);color:var(--muted);font-size:12.5px;font-weight:700">{suburb.name}</span>}
            </div>
            </HeadText>
            </HeadWrap>
            <p style="margin:0 0 20px;font-size:16px;line-height:1.62;max-width:62ch">{business.description}</p>
            {center && (
              <p style="margin:0 0 16px;">
                <a href={`/shopping-center/${center.slug}/`} style="display:inline-flex;align-items:center;gap:8px;color:var(--accent);font-weight:700;font-size:14px;text-decoration:none">
                  <Icon path="<path d='M4 21h16M6 21V7l6-4 6 4v14M9 21v-6h6v6'/>" size={15} />
                  Located at {center.name}
                </a>
              </p>
            )}

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:20px">
              {business.phone && (
                <a href={phoneHref(business.phone)} data-track="phone_click" style="display:flex;align-items:center;gap:9px;padding:14px 16px;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:14.5px;font-weight:800;text-decoration:none">
                  <Icon path="<path d='M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z'/>" size={17} />
                  <span style="white-space:nowrap">{formatPhoneZA(business.phone)}</span>
                </a>
              )}
              {isPaying && websiteUrl(business.website) && (
                <a href={websiteUrl(business.website)!} target="_blank" rel="noopener noreferrer" data-track="website_click" style="display:flex;align-items:center;gap:9px;padding:14px 16px;border-radius:11px;border:2px solid var(--navy);color:var(--navy);font-size:14.5px;font-weight:800;text-decoration:none">
                  <Icon path="<circle cx='12' cy='12' r='9'/><path d='M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18'/>" size={17} />
                  Website
                </a>
              )}
              {mapsUrl && (
                <a href={mapsUrl} target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;gap:9px;padding:14px 16px;border-radius:11px;border:2px solid var(--border);color:var(--navy);font-size:14.5px;font-weight:800;text-decoration:none">
                  <Icon path="<path d='M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z'/><circle cx='12' cy='10' r='2.5'/>" size={17} />
                  Directions
                </a>
              )}
            </div>
            {socials.length > 0 && (
              <div style="display:flex;flex-wrap:wrap;gap:8px;margin:-8px 0 20px">
                {socials.map((so) => (
                  <a href={so.url} target="_blank" rel="noopener noreferrer nofollow" aria-label={`${business.name} on ${so.label}`} style="display:inline-flex;align-items:center;gap:8px;padding:9px 14px;border-radius:999px;border:2px solid var(--border);color:var(--navy);font-size:13px;font-weight:800;text-decoration:none">
                    <Icon path={SOCIAL_ICONS[so.kind]} size={16} />
                    {so.label}
                  </a>
                ))}
              </div>
            )}

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:2px;background:var(--border);border:1px solid var(--border);border-radius:12px;overflow:hidden">
              {business.address && (
                <div style="background:#fff;padding:14px 16px">
                  <div style="font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Address</div>
                  <div style="font-size:14px;font-weight:600;margin-top:5px;line-height:1.45">{business.address}{suburb && `, ${suburb.name}`}</div>
                </div>
              )}
              <div style="background:#fff;padding:14px 16px">
                <div style="font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Trading hours</div>
                <div style="font-size:14px;font-weight:600;margin-top:5px;line-height:1.45;white-space:pre-line">{business.hours ?? 'Not available'}</div>
              </div>
            </div>
            <ListReturn />
          </div>
        </div>

        {!showsPaid && <div style="margin-top:22px"><AdUnit placement="businessInContent" /></div>}

        {photos.length > 0 && (
          <>
            <div style="margin-top:26px;border-bottom:2px solid var(--navy);padding-bottom:10px;display:flex;align-items:center;gap:9px">
              <span style="color:var(--accent)"><Icon path="<rect x='3' y='5' width='18' height='14' rx='2'/><circle cx='8.5' cy='10.5' r='1.5'/><path d='m21 16-5-4-4 3-3-2-4 3'/>" size={17} /></span>
              <h2 style="margin:0;font-size:15px;font-weight:800;letter-spacing:-.015em;color:var(--navy)">Gallery</h2>
            </div>
            <div class="business-photo-grid">
              {photos.map((p, i) => (
                <button type="button" class="business-photo" data-photo-index={i} aria-label={`View photo ${i + 1} of ${photos.length} full screen`}>
                  <img src={`/media/${p.r2_key}`} alt={p.caption ?? business.name} loading="lazy" />
                </button>
              ))}
            </div>

            <div id="lightbox" class="lightbox" hidden>
              <button type="button" id="lightbox-close" class="lightbox-btn lightbox-close" aria-label="Close">
                <Icon path="<path d='M18 6 6 18M6 6l12 12'/>" size={22} />
              </button>
              {photos.length > 1 && (
                <>
                  <button type="button" id="lightbox-prev" class="lightbox-btn lightbox-nav lightbox-prev" aria-label="Previous photo">
                    <Icon path="<path d='m15 18-6-6 6-6'/>" size={24} />
                  </button>
                  <button type="button" id="lightbox-next" class="lightbox-btn lightbox-nav lightbox-next" aria-label="Next photo">
                    <Icon path="<path d='m9 18 6-6-6-6'/>" size={24} />
                  </button>
                </>
              )}
              <img id="lightbox-img" src="" alt="" />
              {photos.length > 1 && <div id="lightbox-count" class="lightbox-count"></div>}
            </div>
          </>
        )}

        <div id="reviews" style="margin-top:26px;border-bottom:2px solid var(--navy);padding-bottom:10px;display:flex;align-items:center;gap:9px;scroll-margin-top:20px">
          <span style="color:var(--accent)"><Icon path="<path d='m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7Z'/>" size={17} /></span>
          <h2 style="margin:0;font-size:15px;font-weight:800;letter-spacing:-.015em;color:var(--navy)">Ratings &amp; reviews</h2>
        </div>

        {numReviews > 0 ? (
          <div style="display:flex;align-items:baseline;gap:10px;margin-top:14px">
            <span style="font-size:34px;font-weight:800;color:var(--navy);letter-spacing:-.03em">{avgRating}</span>
            <span style="font-size:13.5px;font-weight:700;color:var(--muted)">out of 5 · {numReviews} review{numReviews === 1 ? '' : 's'}</span>
          </div>
        ) : (
          <p style="margin:14px 0 0;font-size:13.5px;color:var(--muted);font-weight:600">No reviews yet — be the first to share your experience.</p>
        )}

        {businessReviews.length > 0 && (
          <div style="display:flex;flex-direction:column;gap:12px;margin-top:16px">
            {businessReviews.map((r) => (
              <div style="border:2px solid var(--border);border-radius:var(--radius-lg);padding:16px 18px;background:#fff">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
                  <span style="display:flex;align-items:center;gap:8px">
                    <span style="color:var(--accent);display:flex;gap:1px">
                      {[1, 2, 3, 4, 5].map((n) => (
                        <Icon path={`<path d='m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7Z' ${n <= r.rating ? "fill='currentColor'" : ''}/>`} size={14} />
                      ))}
                    </span>
                    <span style="font-size:13.5px;font-weight:800;color:var(--navy)">{r.author_name}</span>
                  </span>
                  <span style="font-size:12px;font-weight:700;color:var(--muted)">{shortDate(r.created_at)}</span>
                </div>
                <p style="margin:8px 0 0;font-size:14px;line-height:1.55;color:var(--text)">{r.comment}</p>
                {r.owner_reply && (
                  <div style="margin:12px 0 0 16px;padding:10px 14px;border-left:3px solid var(--accent);background:var(--bg-subtle);border-radius:0 8px 8px 0">
                    <div style="font-size:11.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--accent-hover)">Reply from the owner</div>
                    <p style="margin:4px 0 0;font-size:13.5px;line-height:1.5;color:var(--text)">{r.owner_reply}</p>
                  </div>
                )}
              </div>
            ))}
          </div>
        )}

        <div id="review-form-shell" style="margin-top:16px">
          <p id="review-loading" style="font-size:13px;color:var(--muted);font-weight:600">Checking your account…</p>
          <div id="review-logged-out" hidden style="border:2px solid var(--border);border-radius:var(--radius-lg);padding:16px 18px;background:var(--bg-subtle)">
            <p style="margin:0 0 10px;font-size:13.5px;font-weight:700;color:var(--navy)">Log in to write a review.</p>
            <a id="review-login-link" href="/login/" style="display:inline-block;padding:10px 16px;border-radius:9px;background:var(--navy);color:#fff;font-size:13.5px;font-weight:800;text-decoration:none">Log in</a>
          </div>
          <form id="review-form" hidden style="border:2px solid var(--border);border-radius:var(--radius-lg);padding:16px 18px;background:#fff">
            <input type="text" name="company_url" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0" />
            <div style="font-size:13.5px;font-weight:800;color:var(--navy)">Write a review</div>
            <div id="review-star-picker" style="display:flex;gap:4px;color:var(--accent)"></div>
            <input type="text" name="authorName" placeholder="Your name" required maxlength="80" style="padding:12px 13px;border:2px solid var(--border);border-radius:10px;font-size:14px;outline:none;background:#fff;color:var(--text)" />
            <textarea name="comment" rows="3" placeholder="Share your experience with this business" required style="padding:12px 13px;border:2px solid var(--border);border-radius:10px;font-size:14px;outline:none;background:#fff;color:var(--text);resize:vertical"></textarea>
            <button type="submit" style="align-self:flex-start;padding:12px 18px;border:0;border-radius:10px;background:var(--accent);color:var(--contrast);font-size:14px;font-weight:800;cursor:pointer">Submit review</button>
            <p id="review-status" style="margin:0;font-size:11.5px;color:var(--muted);font-weight:600">Reviews are checked before they go live.</p>
          </form>
        </div>

        {!isPaying && similar.length > 0 && (
          <>
            <div style="margin-top:26px;border-bottom:2px solid var(--navy);padding-bottom:10px">
              <h2 style="margin:0;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">Similar suppliers nearby</h2>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin-top:14px">
              {similar.map((b) => {
                // With a logo, the name and meta sit in a column beside it.
                const hasLogo = !!logoFor(b);
                const IdWrap = hasLogo ? 'span' : Fragment;
                const IdText = hasLogo ? 'span' : Fragment;
                return (
                <a href={`/business/${b.slug}/`} class="similar-business-card" style="border:2px solid var(--border);border-radius:var(--radius-lg);padding:16px;background:#fff;display:flex;flex-direction:column;gap:5px;text-decoration:none;box-shadow:var(--shadow)">
                  <IdWrap {...(hasLogo ? { class: 'biz-id' } : {})}>
                  <BusinessLogo business={b} size="md" />
                  <IdText {...(hasLogo ? { class: 'biz-id-text', style: 'gap:5px' } : {})}>
                  <span style="font-size:15.5px;font-weight:800;color:var(--navy);letter-spacing:-.01em">{b.name}</span>
                  <span style="font-size:12.5px;font-weight:600;color:var(--muted)">{cats[0]?.name}{suburbFor(b) ? ` · ${suburbFor(b)!.name}` : ''}</span>
                  </IdText>
                  </IdWrap>
                </a>
                );
              })}
            </div>
          </>
        )}

        {/* No green "Verified" pill for source-checked listings: "Verified" is the name of a
            paid plan, so the pill made free listings look like paying ones. The plan badge
            (PlanBadge) is the only "Verified" label a listing shows. */}
        {(isOsmSourced || labelSources.length > 0) && (
          <p style="margin-top:1.5rem;font-size:0.78rem;color:var(--muted);overflow-wrap:break-word;">
            {isOsmSourced ? (
              <>Sourced from OpenStreetMap ({sourceUrls.map((u, i) => <>{i > 0 && ', '}<a href={u} target="_blank" rel="noopener noreferrer">record</a></>)}), ODbL-licensed.</>
            ) : (
              <span>{labelSources.join(' ')}</span>
            )}
          </p>
        )}

        <div style="display:flex;flex-wrap:wrap;gap:1.25rem;margin-top:2rem;padding-top:1rem;border-top:1px solid var(--border);">
          <a href={`/report-listing/?slug=${business.slug}&name=${encodeURIComponent(business.name)}`} style="display:inline-flex;align-items:center;gap:0.35rem;font-size:0.78rem;color:var(--muted);text-decoration:none;">
            <Icon path="<path d='M5 21V4'/><path d='M5 4h13l-3 4 3 4H5'/>" size={13} /> Report this listing
          </a>
          <a href={`/request-removal/?slug=${business.slug}&name=${encodeURIComponent(business.name)}`} style="display:inline-flex;align-items:center;gap:0.35rem;font-size:0.78rem;color:var(--muted);text-decoration:none;">
            <Icon path="<path d='M3 6h18'/><path d='M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2'/><path d='M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6'/>" size={13} /> Request data removal
          </a>
        </div>
      </div>

      <aside style="display:flex;flex-direction:column;gap:14px">
        {isPaying ? (
          <div style="border:2px solid var(--navy);border-radius:var(--radius-lg);overflow:hidden;background:#fff;box-shadow:var(--shadow)">
            <div style="background:var(--navy);padding:14px 18px;font-size:15px;font-weight:800;color:#fff;letter-spacing:-.01em;display:flex;align-items:center;gap:9px">
              <Icon path="<path d='M4 12h4l2 3h4l2-3h4'/><path d='M5.5 5h13l2.5 7v7a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-7l2.5-7Z'/>" size={16} />
              Send an enquiry
            </div>
            <form id="enquiry-form" style="padding:16px;display:flex;flex-direction:column;gap:10px">
              <input type="text" name="company_url" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0" />
              <input type="text" name="name" placeholder="Your name" required style="padding:12px 13px;border:2px solid var(--border);border-radius:10px;font-size:14px;outline:none;background:#fff;color:var(--text)" />
              <input type="text" name="contact" placeholder="Phone or email" required style="padding:12px 13px;border:2px solid var(--border);border-radius:10px;font-size:14px;outline:none;background:#fff;color:var(--text)" />
              <textarea name="message" rows="3" placeholder="What do you need a quote on?" required style="padding:12px 13px;border:2px solid var(--border);border-radius:10px;font-size:14px;outline:none;background:#fff;color:var(--text);resize:vertical"></textarea>
              <button type="submit" style="padding:13px 16px;border:0;border-radius:10px;background:var(--accent);color:var(--contrast);font-size:14px;font-weight:800;cursor:pointer">Send enquiry</button>
              <p id="enquiry-status" style="margin:0;font-size:11.5px;color:var(--muted);font-weight:600">Enquiries go straight to the owner.</p>
            </form>
          </div>
        ) : (
          <div style="border:2px solid var(--border);border-radius:var(--radius-lg);padding:18px;background:var(--bg-subtle);box-shadow:var(--shadow)">
            <div style="display:flex;align-items:center;gap:9px;margin-bottom:8px">
              <span style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:9px;background:var(--navy);color:#fff;flex-shrink:0"><Icon path="<path d='M4 12h4l2 3h4l2-3h4'/><path d='M5.5 5h13l2.5 7v7a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-7l2.5-7Z'/>" size={15} /></span>
              <h3 style="margin:0;font-size:16px;letter-spacing:-.015em;color:var(--navy)">Get enquiries from this page</h3>
            </div>
            <p style="margin:0 0 12px;font-size:13.5px;line-height:1.55;color:var(--text)">Verified and Featured listings get a direct enquiry form here, sent straight to the owner — this business doesn't have one yet.</p>
            <a href="/pricing/" style="display:block;padding:11px 14px;border-radius:9px;background:var(--accent);color:var(--contrast);font-size:13.5px;font-weight:800;text-decoration:none;text-align:center">See plans</a>
          </div>
        )}
        {!business.owner_user_id && (
          <div style="border:2px solid var(--navy);border-radius:var(--radius-lg);padding:18px;background:#fff;box-shadow:var(--shadow)">
            <div style="display:flex;align-items:center;gap:9px;margin-bottom:8px">
              <span style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:9px;background:var(--bg-subtle);color:var(--accent);flex-shrink:0"><Icon path="<path d='M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-4Z'/><path d='m9.5 12 1.8 1.8L15 10'/>" size={15} /></span>
              <h3 style="margin:0;font-size:16px;letter-spacing:-.015em;color:var(--navy)">Is this your business?</h3>
            </div>
            <p style="margin:0 0 12px;font-size:13.5px;line-height:1.55;color:var(--text)">Claim it free to edit your details and hours, see how many people view your page, and unlock a website link, photos and an enquiry form.</p>
            <a href={`/my-businesses/claim/?businessId=${business.id}&name=${encodeURIComponent(business.name)}`} style="display:block;padding:11px 14px;border-radius:9px;background:var(--navy);color:#fff;font-size:13.5px;font-weight:800;text-decoration:none;text-align:center">Claim this listing — it's free</a>
          </div>
        )}
        {!showsPaid && <AdUnit placement="businessSidebar" />}
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  @media (min-width: 950px) {
    #profile-shell {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }
  .similar-business-card:hover {
    border-color: var(--navy);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }
  .similar-business-card {
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
  }
  /* aspect-ratio + object-fit directly on a grid-item <img> with no
     explicit width doesn't stretch to fill the column — a replaced
     element with an aspect-ratio and no specified size treats
     justify-self:stretch as start instead, so each photo only rendered
     at its intrinsic size in the corner of its cell. Sizing the ratio on
     the wrapping <span> and letting the <img> fill it with object-fit
     avoids that grid quirk entirely. */
  .business-photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
    margin-top: 14px;
  }
  .business-photo {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-subtle);
    box-shadow: var(--shadow);
    transition: transform .15s ease;
    padding: 0;
    border: 0;
    cursor: pointer;
    font: inherit;
  }
  .business-photo:hover {
    transform: translateY(-2px);
  }
  .business-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(10, 15, 26, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 5vw, 60px);
  }
  .lightbox[hidden] {
    display: none !important;
  }
  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 8px;
  }
  .lightbox-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    cursor: pointer;
    transition: background .15s ease;
  }
  .lightbox-btn:hover {
    background: rgba(255, 255, 255, 0.26);
  }
  .lightbox-close {
    top: clamp(10px, 3vw, 22px);
    right: clamp(10px, 3vw, 22px);
    width: 42px;
    height: 42px;
  }
  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
  }
  .lightbox-prev {
    left: clamp(6px, 2vw, 20px);
  }
  .lightbox-next {
    right: clamp(6px, 2vw, 20px);
  }
  .lightbox-count {
    position: absolute;
    bottom: clamp(10px, 3vw, 22px);
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.86);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .02em;
  }
  @media (max-width: 640px) {
    .lightbox-nav {
      width: 40px;
      height: 40px;
    }
  }
  /* Inline display:flex on the row beats the [hidden] attribute. */
  #open-row[hidden] {
    display: none !important;
  }
</style>

<script>
  // "Open now · closes 17:00" — the current time only exists in the
  // browser, so this is filled in client-side from the listing's own hours
  // text. Shown only when that text parses cleanly (src/lib/openNow.ts);
  // otherwise the row stays hidden rather than guessing.
  import { openStatus } from '../../lib/openNow';

  const row = document.getElementById('open-row');
  if (row) {
    const st = openStatus(row.dataset.hours);
    if (st) {
      const text = document.getElementById('open-status-text')!;
      const badge = document.getElementById('open-status')!;
      if (st.open) {
        text.textContent = st.closesAt ? `Open now · closes ${st.closesAt}` : 'Open now';
      } else {
        text.textContent = st.opensAt ? `Closed now · opens ${st.opensAt}` : 'Closed now';
        badge.style.color = 'var(--muted)';
      }
      row.hidden = false;
    }
  }
</script>

<script>
  // Full-screen photo viewer for the Gallery section — click a thumbnail,
  // flip through with the arrow buttons, arrow keys, or Escape to close.
  const photoButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.business-photo'));
  if (photoButtons.length > 0) {
    const lightbox = document.getElementById('lightbox')!;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const closeBtn = document.getElementById('lightbox-close')!;
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const countEl = document.getElementById('lightbox-count');
    const urls = photoButtons.map((b) => b.querySelector('img')!.src);
    let current = 0;

    function show(index: number) {
      current = (index + urls.length) % urls.length;
      lightboxImg.src = urls[current];
      lightboxImg.alt = photoButtons[current].querySelector('img')!.alt;
      if (countEl) countEl.textContent = `${current + 1} / ${urls.length}`;
    }
    function open(index: number) {
      show(index);
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function close() {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }
    photoButtons.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
    closeBtn.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => show(current - 1));
    nextBtn?.addEventListener('click', () => show(current + 1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
    });
  }
</script>

<script define:vars={{ businessSlug: business.slug }}>
  // Sent by the website itself: the server saves the enquiry and emails it to
  // the business (or to us if no address is on file), so the business's email
  // is never placed in this page and the visitor's own email app is never opened.
  // Basic (free-plan) listings don't render this form at all (see
  // isPaying in the frontmatter) — guard against its absence rather than
  // assume every business page has one.

  // Real numbers behind the owner dashboard's "Profile views" / "Phone
  // clicks" / "Website clicks" tiles (see functions/api/track-view.ts).
  // sendBeacon fires and forgets — it never delays or blocks the actual
  // phone call / site visit the visitor is making, and still completes
  // even if the click immediately navigates away.
  function track(event) {
    try {
      navigator.sendBeacon('/api/track-view', new Blob([JSON.stringify({ businessSlug, event })], { type: 'application/json' }));
    } catch {
      // sendBeacon isn't universally supported (very old browsers); a
      // missed view/click count is never worth surfacing an error over.
    }
  }
  track('view');
  document.addEventListener('click', (e) => {
    const el = e.target.closest('[data-track]');
    if (el) track(el.dataset.track);
  });

  const form = document.getElementById('enquiry-form');
  const status = document.getElementById('enquiry-status');
  if (form && status) {
    const loadedAt = Date.now();
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch('/api/enquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            businessSlug,
            name: data.name,
            contact: data.contact,
            message: data.message,
            company_url: data.company_url || '',
            loadedAt,
          }),
        });
        const result = await res.json();
        if (result.ok) {
          form.reset();
          status.textContent = 'Thank you — your enquiry has been sent.';
        } else {
          status.textContent = result.error || 'Something went wrong — please try again.';
        }
      } catch {
        status.textContent = 'Something went wrong — please try again.';
      }
      btn.disabled = false;
    });
  }

  // Write-a-review: login state can't be known at static build time, so this
  // checks the existing /api/me session endpoint client-side and swaps
  // between the "log in" CTA and the actual form.
  (async () => {
    const loading = document.getElementById('review-loading');
    const loggedOut = document.getElementById('review-logged-out');
    const reviewForm = document.getElementById('review-form');
    if (!loading || !loggedOut || !reviewForm) return;

    let me;
    try {
      const res = await fetch('/api/me');
      me = res.ok ? await res.json() : null;
    } catch {
      me = null;
    }
    loading.hidden = true;

    if (!me || !me.ok) {
      document.getElementById('review-login-link').href = `/login/?next=${encodeURIComponent(window.location.pathname)}`;
      loggedOut.hidden = false;
      return;
    }

    reviewForm.hidden = false;
    // The form has no display set inline so [hidden] works correctly by
    // default (same fix as the loading-screen and sponsor-dropdown bugs
    // elsewhere on this site) — the flex layout is only applied once it's
    // actually shown.
    reviewForm.style.cssText += ';display:flex;flex-direction:column;gap:10px';
    const picker = document.getElementById('review-star-picker');
    let rating = 0;
    const stars = [1, 2, 3, 4, 5].map((n) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', `${n} star${n === 1 ? '' : 's'}`);
      b.style.cssText = 'border:0;background:none;padding:2px;cursor:pointer;color:inherit;line-height:0';
      b.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7Z"/></svg>`;
      b.addEventListener('click', () => {
        rating = n;
        stars.forEach((s, i) => (s.querySelector('path').setAttribute('fill', i < rating ? 'currentColor' : 'none')));
      });
      picker.appendChild(b);
      return b;
    });

    const reviewStatus = document.getElementById('review-status');
    const loadedAt = Date.now();
    reviewForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!rating) {
        reviewStatus.textContent = 'Please choose a star rating.';
        return;
      }
      const data = Object.fromEntries(new FormData(reviewForm).entries());
      const btn = reviewForm.querySelector('button[type="submit"]');
      btn.disabled = true;
      reviewStatus.textContent = 'Sending…';
      try {
        const res = await fetch('/api/review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            businessSlug,
            rating,
            authorName: data.authorName,
            comment: data.comment,
            company_url: data.company_url || '',
            loadedAt,
          }),
        });
        const result = await res.json();
        if (result.ok) {
          reviewForm.reset();
          rating = 0;
          stars.forEach((s) => s.querySelector('path').setAttribute('fill', 'none'));
          reviewStatus.textContent = 'Thanks — your review is awaiting approval.';
        } else {
          reviewStatus.textContent = result.error || 'Something went wrong — please try again.';
        }
      } catch {
        reviewStatus.textContent = 'Something went wrong — please try again.';
      }
      btn.disabled = false;
    });
  })();
</script>
