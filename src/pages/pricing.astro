---
import BaseLayout from '../layouts/BaseLayout.astro';
import SponsorSlot from '../components/SponsorSlot.astro';
import { priceRand, categories, suburbs } from '../lib/data';
import site from '../site';

const SPOTS = [
  { productType: 'category_sponsor' as const, name: 'Category sponsor', price: priceRand('price_sponsor_category_cents'), blurb: `Your card above every listing in one of ${categories.length} categories, city-wide.` },
  { productType: 'suburb_sponsor' as const, name: 'Suburb sponsor', price: priceRand('price_sponsor_suburb_cents'), blurb: `Own the top slot on one of ${suburbs.length} suburb pages.` },
  { productType: 'homepage_banner' as const, name: 'Homepage banner', price: priceRand('price_sponsor_banner_cents'), blurb: 'A single full-width placement under the hero. One advertiser at a time.' },
  { productType: 'centre_sponsor' as const, name: 'Centre sponsorship', price: priceRand('price_sponsor_centre_cents'), blurb: 'Brand a whole shopping-centre page and its store list.' },
];
---

<BaseLayout
  title="Plans & pricing"
  description={`See ${site.siteName}'s plans for business listings, plus exclusive sponsorship spots across the site.`}
>
  <main>
    <section style="background:var(--navy);color:#fff">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(34px,5vw,60px) 20px">
        <span style="font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--grad-from)">Plans for owners</span>
        <h1 style="margin:12px 0 12px;color:#fff;font-size:clamp(30px,5vw,52px);letter-spacing:-.03em;line-height:1.04;max-width:24ch">Free to be listed. Paid to be chosen.</h1>
        <p style="margin:0;color:rgba(255,255,255,.84);font-size:16.5px;line-height:1.55;max-width:54ch">Month to month, no contract, and every plan is reviewed by a human before it goes live.</p>
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:clamp(26px,4vw,44px) 20px 0">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:16px">
        <article style="border:2px solid var(--border);border-radius:16px;background:#fff;padding:24px;display:flex;flex-direction:column;gap:14px">
          <div>
            <div style="font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">Basic</div>
            <div style="font-size:40px;font-weight:800;color:var(--navy);letter-spacing:-.03em;line-height:1.05;margin-top:8px">Free</div>
            <div style="font-size:13.5px;font-weight:600;color:var(--muted);margin-top:4px">Claim and keep your details right</div>
          </div>
          <div style="height:2px;background:var(--border)"></div>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14px;line-height:1.45">
            <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>Name, category, suburb, address</li>
            <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>One phone number</li>
            <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>Trading hours</li>
            <li style="display:flex;gap:9px;color:var(--muted)"><span style="font-weight:800">—</span>No website link</li>
            <li style="display:flex;gap:9px;color:var(--muted)"><span style="font-weight:800">—</span>No photos or enquiry form</li>
          </ul>
          <a href="/list-your-business/" style="margin-top:auto;padding:13px 16px;border-radius:10px;border:2px solid var(--navy);color:var(--navy);font-size:14px;font-weight:800;background:#fff;text-decoration:none;text-align:center">Claim free listing</a>
        </article>

        <article style="border:2px solid var(--navy);border-radius:16px;background:#fff;padding:24px;display:flex;flex-direction:column;gap:14px">
          <div>
            <div style="font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">Verified</div>
            <div style="font-size:40px;font-weight:800;color:var(--navy);letter-spacing:-.03em;line-height:1.05;margin-top:8px">{priceRand('price_verified_cents')}<span style="font-size:15px;font-weight:700;color:var(--muted)"> / month</span></div>
            <div style="font-size:13.5px;font-weight:600;color:var(--muted);margin-top:4px">Look legitimate at a glance</div>
          </div>
          <div style="height:2px;background:var(--border)"></div>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14px;line-height:1.45">
            <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>Everything in Basic</li>
            <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>Verified badge on every listing card</li>
            <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>Live website link</li>
            <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>Full description and up to 4 photos</li>
            <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>Enquiry form on your profile</li>
          </ul>
          <a href="/list-your-business/" style="margin-top:auto;padding:13px 16px;border-radius:10px;background:var(--navy);color:#fff;font-size:14px;font-weight:800;text-decoration:none;text-align:center">Get verified</a>
        </article>

        <article style="border:2px solid var(--accent);border-radius:16px;background:#fff;padding:0;display:flex;flex-direction:column;overflow:hidden">
          <div style="background:var(--accent);padding:8px 24px;font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--contrast)">Most enquiries</div>
          <div style="padding:24px;display:flex;flex-direction:column;gap:14px;flex:1">
            <div>
              <div style="font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">Featured</div>
              <div style="font-size:40px;font-weight:800;color:var(--navy);letter-spacing:-.03em;line-height:1.05;margin-top:8px">{priceRand('price_featured_cents')}<span style="font-size:15px;font-weight:700;color:var(--muted)"> / month</span></div>
              <div style="font-size:13.5px;font-weight:600;color:var(--muted);margin-top:4px">Sit above your competitors</div>
            </div>
            <div style="height:2px;background:var(--border)"></div>
            <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14px;line-height:1.45">
              <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>Everything in Verified</li>
              <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>Top of your category and suburb pages</li>
              <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>Featured card on the homepage rotation</li>
              <li style="display:flex;gap:9px"><span style="color:var(--accent);font-weight:800">✓</span>Up to 10 photos and a gallery</li>
            </ul>
            <a href="/list-your-business/" style="margin-top:auto;padding:13px 16px;border-radius:10px;background:var(--accent);color:var(--contrast);font-size:14px;font-weight:800;text-decoration:none;text-align:center">Feature my business</a>
          </div>
        </article>
      </div>
    </section>

    <section style="max-width:1200px;margin:0 auto;padding:clamp(32px,4vw,52px) 20px 0">
      <div style="border-bottom:2px solid var(--navy);padding-bottom:12px">
        <h2 style="margin:0;font-size:clamp(20px,2.8vw,28px);letter-spacing:-.025em;color:var(--navy)">Exclusive spots, sold one at a time</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:2px;background:var(--border);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-top:18px">
        {SPOTS.map((spot) => (
          <div style="background:#fff;padding:20px">
            <div style="font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--accent)">{spot.name}</div>
            <div style="font-size:26px;font-weight:800;color:var(--navy);letter-spacing:-.025em;margin-top:8px">{spot.price} <span style="font-size:14px;font-weight:700;color:var(--muted)">/ mo</span></div>
            <p style="margin:8px 0 0;font-size:13.5px;line-height:1.5;color:var(--text)">{spot.blurb}</p>
          </div>
        ))}
      </div>
      <p style="margin:16px 0 0;font-size:12.5px;color:var(--muted);font-weight:600">Prices shown are placeholders and subject to change.</p>

      <div style="margin-top:18px;max-width:420px;">
        <SponsorSlot
          productType="homepage_banner"
          title="Homepage banner"
          openBody="The single sponsor slot on the homepage — one advertiser at a time."
          ctaLabel="Enquire about the banner"
        />
      </div>
    </section>

    <section id="events" style="max-width:1200px;margin:0 auto;padding:clamp(32px,4vw,52px) 20px 0">
      <div style="border-bottom:2px solid var(--navy);padding-bottom:12px">
        <h2 style="margin:0;font-size:clamp(20px,2.8vw,28px);letter-spacing:-.025em;color:var(--navy)">Feature an event</h2>
      </div>
      <div style="border:2px solid var(--accent);border-radius:14px;background:#fff;padding:22px;margin-top:18px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:18px">
        <div>
          <div style="font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--accent)">Featured event</div>
          <div style="font-size:26px;font-weight:800;color:var(--navy);letter-spacing:-.025em;margin-top:8px">{priceRand('price_event_feature_cents')} <span style="font-size:14px;font-weight:700;color:var(--muted)">/ event</span></div>
          <p style="margin:8px 0 0;font-size:13.5px;line-height:1.5;color:var(--text);max-width:52ch">List your event free — feature it to sit at the top of the Events page and in the homepage rotation. A once-off fee per event, not a subscription.</p>
        </div>
        <a href={`mailto:${site.contactEmail}?subject=${encodeURIComponent('Feature an event on ' + site.siteName)}`} style="padding:14px 22px;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap">Feature my event</a>
      </div>
    </section>

    <section style="margin-top:clamp(36px,5vw,60px);background:var(--accent)">
      <div style="max-width:1200px;margin:0 auto;padding:clamp(32px,4.5vw,56px) 20px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px">
        <h2 style="margin:0;color:var(--contrast);font-size:clamp(24px,3.6vw,38px);letter-spacing:-.03em;line-height:1.08;max-width:24ch">Start free today. Upgrade when the calls start coming.</h2>
        <a href="/list-your-business/" style="padding:16px 26px;border-radius:12px;background:#fff;color:var(--accent-hover);font-size:15px;font-weight:800;white-space:nowrap;text-decoration:none">Add your business</a>
      </div>
    </section>
  </main>
</BaseLayout>
