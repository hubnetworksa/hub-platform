---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import site from '../site';

const ICONS = {
  building: '<path d="M4 21h16M6 21V7l6-4 6 4v14M9 21v-6h6v6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  badge: '<path d="M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-4Z"/><path d="m9.5 12 1.8 1.8L15 10"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
};
---

<BaseLayout title="My Businesses" description={`Manage the businesses linked to your ${site.siteName} account.`} noindex={true}>
  <main style="max-width:720px;margin:0 auto;padding:clamp(24px,4vw,44px) 20px 60px">
    <div id="loading" style="color:var(--muted);padding:2rem 0;">Loading…</div>

    <div id="content" hidden style="display:flex;flex-direction:column;gap:18px;">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;">
        <div>
          <span style="font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)">My businesses</span>
          <h1 style="margin:8px 0 0;font-size:clamp(24px,3.4vw,32px);letter-spacing:-.025em;color:var(--navy)">Your account</h1>
          <p id="account-email" style="margin:4px 0 0;color:var(--muted);font-size:13.5px;font-weight:600;"></p>
        </div>
        <button id="logout-btn" type="button" style="padding:10px 14px;border:2px solid var(--border);border-radius:9px;background:#fff;color:var(--navy);font-size:13px;font-weight:800;cursor:pointer;">Log out</button>
      </div>

      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div style="padding:14px 18px;border-bottom:2px solid var(--navy);display:flex;align-items:center;gap:9px;">
          <span style="color:var(--accent)"><Icon path={ICONS.building} size={17} /></span>
          <h2 style="margin:0;font-size:15px;letter-spacing:-.015em;color:var(--navy)">Businesses you own</h2>
        </div>
        <div id="owned-list"></div>
        <p id="owned-empty" hidden style="padding:26px 18px;text-align:center;font-size:13.5px;font-weight:700;color:var(--muted);margin:0;">You don't own any businesses yet.</p>
      </div>

      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div style="padding:14px 18px;border-bottom:2px solid var(--navy);display:flex;align-items:center;gap:9px;">
          <span style="color:var(--accent)"><Icon path={ICONS.clock} size={17} /></span>
          <h2 style="margin:0;font-size:15px;letter-spacing:-.015em;color:var(--navy)">Pending submissions</h2>
        </div>
        <div id="pending-list"></div>
        <p id="pending-empty" hidden style="padding:26px 18px;text-align:center;font-size:13.5px;font-weight:700;color:var(--muted);margin:0;">No pending submissions.</p>
      </div>

      <div style="background:#fff;border:2px solid var(--border);border-radius:14px;overflow:hidden">
        <div style="padding:14px 18px;border-bottom:2px solid var(--navy);display:flex;align-items:center;gap:9px;">
          <span style="color:var(--accent)"><Icon path={ICONS.badge} size={17} /></span>
          <h2 style="margin:0;font-size:15px;letter-spacing:-.015em;color:var(--navy)">Your claims</h2>
        </div>
        <div id="claims-list"></div>
        <p id="claims-empty" hidden style="padding:26px 18px;text-align:center;font-size:13.5px;font-weight:700;color:var(--muted);margin:0;">You haven't claimed any businesses.</p>
      </div>

      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="/list-your-business/" style="flex:1 1 200px;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px 16px;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:14px;font-weight:800;text-decoration:none;">
          <Icon path={ICONS.plus} size={16} /> Add your business
        </a>
        <a href="/my-businesses/claim/" style="flex:1 1 200px;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px 16px;border-radius:11px;border:2px solid var(--navy);color:var(--navy);font-size:14px;font-weight:800;text-decoration:none;">
          <Icon path={ICONS.badge} size={16} /> Claim a business
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const loading = document.getElementById('loading')!;
  const content = document.getElementById('content')!;

  const TIER_NAMES: Record<number, string> = { 0: 'Basic', 1: 'Verified', 2: 'Featured' };

  function statusBadge(text: string, tone: 'pending' | 'good' | 'bad'): string {
    const colors = { pending: ['#9c5f00', 'rgba(156,95,0,.12)'], good: ['#1a8f5e', 'rgba(26,143,94,.12)'], bad: ['var(--danger)', 'rgba(194,56,56,.1)'] };
    const [color, bg] = colors[tone];
    return `<span style="font-size:11px;font-weight:800;padding:4px 10px;border-radius:999px;white-space:nowrap;color:${color};background:${bg};">${text}</span>`;
  }

  function planBadge(tier: number): string {
    if (tier <= 0) return '';
    const tone = tier >= 2 ? 'good' : 'pending';
    return statusBadge(TIER_NAMES[tier] ?? 'Basic', tone);
  }

  function pendingTone(status: string): 'pending' | 'good' | 'bad' {
    if (status.toLowerCase().includes('declined') || status.toLowerCase().includes('rejected')) return 'bad';
    return 'pending';
  }

  function claimTone(status: string): 'pending' | 'good' | 'bad' {
    if (status === 'approved') return 'good';
    if (status === 'rejected') return 'bad';
    return 'pending';
  }

  function row(name: string, right: string): string {
    return `<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px;border-bottom:1px solid var(--border);">
      <span style="font-size:14.5px;font-weight:800;color:var(--navy);display:flex;align-items:center;gap:8px;">${name}</span>
      ${right}
    </div>`;
  }

  async function init() {
    const res = await fetch('/api/my-businesses');
    if (res.status === 401) {
      window.location.href = '/login/';
      return;
    }
    const data = await res.json();
    loading.hidden = true;
    content.hidden = false;
    document.getElementById('account-email')!.textContent = data.email;

    const ownedList = document.getElementById('owned-list')!;
    if (data.owned.length === 0) {
      document.getElementById('owned-empty')!.hidden = false;
    } else {
      ownedList.innerHTML = data.owned
        .map(
          (b: { id: number; name: string; subscription_tier: number }) =>
            row(`${b.name} ${planBadge(b.subscription_tier)}`, `<a href="/my-businesses/edit/?id=${b.id}" style="padding:8px 12px;border:2px solid var(--border);border-radius:8px;background:#fff;color:var(--navy);font-size:12px;font-weight:800;text-decoration:none;white-space:nowrap;">Manage</a>`)
        )
        .join('');
    }

    const pendingList = document.getElementById('pending-list')!;
    if (data.pending.length === 0) {
      document.getElementById('pending-empty')!.hidden = false;
    } else {
      pendingList.innerHTML = data.pending.map((p: { name: string; status: string }) => row(p.name, statusBadge(p.status, pendingTone(p.status)))).join('');
    }

    const claimsList = document.getElementById('claims-list')!;
    if (data.claims.length === 0) {
      document.getElementById('claims-empty')!.hidden = false;
    } else {
      claimsList.innerHTML = data.claims.map((c: { business_name: string; status: string }) => row(c.business_name, statusBadge(c.status, claimTone(c.status)))).join('');
    }
  }

  document.getElementById('logout-btn')!.addEventListener('click', async () => {
    await fetch('/api/logout', { method: 'POST' });
    window.location.href = '/';
  });

  init();
</script>
