---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../site';
---

<BaseLayout
  title="Report a listing"
  description={`Spotted something wrong with a business listing on ${site.siteName}? Let us know and we'll fix it.`}
  noindex={true}
>
  <section class="container" style="padding-top: 3rem; padding-bottom: 3rem; max-width: 560px;">
    <h1>Report a listing</h1>
    <p id="business-name" style="color: var(--text-muted);">Loading listing…</p>

    <form id="report-form">
      <input type="text" name="company_url" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0" />
      <label>
        What's wrong? *
        <textarea name="issue" required minlength="5" maxlength="1000" rows="4" placeholder="e.g. wrong phone number, business has closed, wrong address..."></textarea>
      </label>
      <label>
        Your email <span>(optional — only if you'd like a reply)</span>
        <input type="email" name="reporterEmail" maxlength="120" />
      </label>

      <button type="submit" class="btn btn-primary">Send report</button>
      <p id="form-status" role="status"></p>
    </form>
  </section>
</BaseLayout>

<script define:vars={{ contactEmail: site.contactEmail, domain: site.domain }}>
  const params = new URLSearchParams(location.search);
  const slug = params.get('slug') || '';
  const name = params.get('name') || '';

  // NOTE: define:vars forces this script to stay inline and unprocessed by
  // Astro/Vite (no TypeScript stripping) — it must be plain browser JS, or
  // it throws a SyntaxError on load and never runs at all.
  const nameEl = document.getElementById('business-name');
  if (slug && name) {
    nameEl.textContent = `Reporting an issue with: ${name}`;
  } else {
    nameEl.textContent = 'No listing specified — go back to the business page and click "Report this listing" there.';
  }

  const form = document.getElementById('report-form');
  const status = document.getElementById('form-status');

  // Sent by the website itself (saved for the admin Reports tab and emailed by
  // the server) — the visitor's own email app is never opened.
  const loadedAt = Date.now();
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!slug || !name) {
      status.textContent = 'No listing specified.';
      return;
    }
    const data = Object.fromEntries(new FormData(form).entries());
    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await fetch('/api/report-listing', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          businessSlug: slug,
          businessName: name,
          issue: data.issue,
          reporterEmail: data.reporterEmail || undefined,
          company_url: data.company_url || '',
          loadedAt,
        }),
      });
      const result = await res.json();
      if (result.ok) {
        form.reset();
        status.textContent = 'Thank you — your report has been sent and our team will look into it.';
      } else {
        status.textContent = result.error || 'Something went wrong — please try again.';
        btn.disabled = false;
      }
    } catch {
      status.textContent = 'Something went wrong — please try again.';
      btn.disabled = false;
    }
  });
</script>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  label span {
    font-weight: 400;
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  input, textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text);
  }
  input:focus, textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  button {
    align-self: flex-start;
    border: none;
    cursor: pointer;
  }
  #form-status {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
