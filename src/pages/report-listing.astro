---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../site';
---

<BaseLayout
  title="Report a listing"
  description={`Spotted something wrong with a business listing on ${site.siteName}? Let us know and we'll fix it.`}
>
  <section class="container" style="padding-top: 3rem; padding-bottom: 3rem; max-width: 560px;">
    <h1>Report a listing</h1>
    <p id="business-name" style="color: var(--text-muted);">Loading listing…</p>

    <form id="report-form">
      <label>
        What's wrong? *
        <textarea name="issue" required minlength="5" maxlength="1000" rows="4" placeholder="e.g. wrong phone number, business has closed, wrong address..."></textarea>
      </label>
      <label>
        Your email <span>(optional — only if you'd like a reply)</span>
        <input type="email" name="reporterEmail" maxlength="120" />
      </label>

      <button type="submit" class="btn btn-primary">Send report</button>
      <p id="form-status" role="status"></p>
    </form>
  </section>
</BaseLayout>

<script define:vars={{ contactEmail: site.contactEmail, domain: site.domain }}>
  const params = new URLSearchParams(location.search);
  const slug = params.get('slug') || '';
  const name = params.get('name') || '';

  const nameEl = document.getElementById('business-name')!;
  if (slug && name) {
    nameEl.textContent = `Reporting an issue with: ${name}`;
  } else {
    nameEl.textContent = 'No listing specified — go back to the business page and click "Report this listing" there.';
  }

  const form = document.getElementById('report-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;

  // No server round-trip — this opens the visitor's own email app with a
  // pre-filled message to our contact address. Their mail client does the
  // actual sending; Cloudflare Email Routing on our side just forwards it
  // into our inbox from there.
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!slug || !name) {
      status.textContent = 'No listing specified.';
      return;
    }
    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    const businessUrl = `https://${domain}/business/${slug}/`;
    const lines = [`Business: ${name}`, `Link: ${businessUrl}`, '', "What's wrong:", data.issue || ''];
    if (data.reporterEmail) lines.push('', `Reply to: ${data.reporterEmail}`);
    const mailto = `mailto:${contactEmail}?subject=${encodeURIComponent(`Listing issue: ${name}`)}&body=${encodeURIComponent(lines.join('\n'))}`;
    status.innerHTML = `Opening your email app to send this — if it didn't open, <a href="${mailto}">click here</a>.`;
    window.location.href = mailto;
  });
</script>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  label span {
    font-weight: 400;
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  input, textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text);
  }
  input:focus, textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  button {
    align-self: flex-start;
    border: none;
    cursor: pointer;
  }
  #form-status {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
