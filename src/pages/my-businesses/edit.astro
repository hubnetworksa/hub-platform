---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Edit business" description="Edit your business listing details." noindex={true}>
  <main style="max-width:560px;margin:0 auto;padding:clamp(24px,4vw,44px) 20px 60px">
    <div id="loading" style="color:var(--muted);">Loading…</div>

    <form id="edit-form" hidden style="display:flex;flex-direction:column;gap:16px;">
      <h1 id="business-name" style="margin:0;font-size:clamp(24px,3.4vw,32px);letter-spacing:-.03em;color:var(--navy)"></h1>
      <label style="display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:800;color:var(--navy);">
        Address
        <input type="text" name="address" maxlength="200" style="padding:14px;border:2px solid var(--border);border-radius:11px;font-size:15px;outline:none;background:#fff;color:var(--text);" />
      </label>
      <label style="display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:800;color:var(--navy);">
        Phone
        <input type="tel" name="phone" maxlength="30" style="padding:14px;border:2px solid var(--border);border-radius:11px;font-size:15px;outline:none;background:#fff;color:var(--text);" />
      </label>
      <label style="display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:800;color:var(--navy);">
        Website
        <input type="url" name="website" maxlength="200" style="padding:14px;border:2px solid var(--border);border-radius:11px;font-size:15px;outline:none;background:#fff;color:var(--text);" />
      </label>
      <label style="display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:800;color:var(--navy);">
        Description
        <textarea name="description" maxlength="600" rows="4" style="padding:14px;border:2px solid var(--border);border-radius:11px;font-size:15px;outline:none;background:#fff;color:var(--text);resize:vertical;"></textarea>
      </label>
      <label style="display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:800;color:var(--navy);">
        Hours
        <textarea name="hours" maxlength="400" rows="3" placeholder="e.g. Mon-Fri 8am-5pm" style="padding:14px;border:2px solid var(--border);border-radius:11px;font-size:15px;outline:none;background:#fff;color:var(--text);resize:vertical;"></textarea>
      </label>
      <button type="submit" style="align-self:flex-start;padding:14px 22px;border:0;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:14.5px;font-weight:800;cursor:pointer;">Save changes</button>
      <p id="form-status" role="status" style="margin:0;font-size:0.9rem;color:var(--muted);"></p>
    </form>

    <div id="plan-panel" hidden style="border:2px solid var(--navy);border-radius:14px;padding:20px;background:#fff;margin-top:20px;display:flex;flex-direction:column;gap:10px;">
      <strong style="font-size:15px;color:var(--navy);">Plan</strong>
      <p id="plan-current" style="margin:0;font-size:13.5px;color:var(--muted);"></p>
      <div id="plan-buttons" style="display:flex;gap:8px;flex-wrap:wrap;"></div>
      <p id="plan-status" role="status" style="margin:0;font-size:13px;color:var(--muted);"></p>
    </div>

    <div id="photos-panel" hidden style="border:2px solid var(--border);border-radius:14px;padding:20px;background:#fff;margin-top:20px;display:flex;flex-direction:column;gap:10px;">
      <strong style="font-size:15px;color:var(--navy);">Photos</strong>
      <p style="margin:0;font-size:13.5px;color:var(--muted);">A Featured-plan perk — up to 12 photos shown on your business page.</p>
      <div id="photos-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:8px;"></div>
      <form id="photo-upload-form" style="display:flex;align-items:center;gap:10px;margin-top:6px;">
        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required style="font-size:13px;" />
        <button type="submit" style="padding:9px 14px;border:2px solid var(--border);border-radius:9px;background:#fff;color:var(--navy);font-size:12.5px;font-weight:800;cursor:pointer;">Upload photo</button>
      </form>
      <p id="photo-status" role="status" style="margin:0;font-size:13px;color:var(--muted);"></p>
    </div>
  </main>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const businessId = params.get('id');
  const loading = document.getElementById('loading')!;
  const form = document.getElementById('edit-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;

  const TIER_NAMES: Record<number, string> = { 0: 'Basic', 1: 'Verified', 2: 'Featured' };
  const FEATURED_TIER = 2;

  function planButton(label: string): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = label;
    btn.style.cssText = 'padding:9px 14px;border:2px solid var(--border);border-radius:9px;background:#fff;color:var(--navy);font-size:12.5px;font-weight:800;cursor:pointer;';
    return btn;
  }

  function renderPlanPanel(business: { subscription_tier: number; subscription_status: string | null; subscription_expires_at: string | null }) {
    const panel = document.getElementById('plan-panel')!;
    const current = document.getElementById('plan-current')!;
    const buttons = document.getElementById('plan-buttons')!;
    const planStatus = document.getElementById('plan-status')!;
    panel.hidden = false;

    const tierName = TIER_NAMES[business.subscription_tier] ?? 'Basic';
    const expiry = business.subscription_expires_at ? new Date(business.subscription_expires_at).toLocaleDateString() : null;
    current.textContent =
      business.subscription_tier > 0
        ? `Current plan: ${tierName}${expiry ? ` — renews/expires ${expiry}` : ''}${business.subscription_status === 'cancelled' ? ' (cancelled, active until then)' : ''}`
        : 'Current plan: Basic (free)';

    buttons.innerHTML = '';
    for (const tier of [1, 2]) {
      if (tier === business.subscription_tier && business.subscription_status === 'active') continue;
      const btn = planButton(`Upgrade to ${TIER_NAMES[tier]}`);
      btn.addEventListener('click', async () => {
        planStatus.textContent = 'Starting checkout…';
        const res = await fetch('/api/subscribe/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ businessId: Number(businessId), tier }),
        });
        const result = await res.json();
        if (result.ok) window.location.href = result.redirectUrl;
        else planStatus.textContent = result.error || 'Could not start checkout.';
      });
      buttons.appendChild(btn);
    }
    if (business.subscription_tier > 0 && business.subscription_status === 'active') {
      const cancelBtn = planButton('Cancel plan');
      cancelBtn.style.color = 'var(--danger)';
      cancelBtn.addEventListener('click', async () => {
        if (!confirm('Cancel your subscription? You keep your current plan until the paid period ends.')) return;
        planStatus.textContent = 'Cancelling…';
        const res = await fetch('/api/subscribe/cancel', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ businessId: Number(businessId) }),
        });
        const result = await res.json();
        planStatus.textContent = result.ok ? 'Cancelled — active until your current period ends.' : result.error || 'Could not cancel.';
      });
      buttons.appendChild(cancelBtn);
    }
  }

  function renderPhotosPanel(business: { subscription_tier: number }, photos: { id: number; r2_key: string; caption: string | null }[]) {
    const panel = document.getElementById('photos-panel')!;
    if (business.subscription_tier < FEATURED_TIER) return; // stays hidden — upgrade to Featured to unlock
    panel.hidden = false;

    const grid = document.getElementById('photos-grid')!;
    const photoStatus = document.getElementById('photo-status')!;
    function renderGrid(list: { id: number; r2_key: string; caption: string | null }[]) {
      grid.innerHTML = list
        .map(
          (p) =>
            `<div style="position:relative;">
              <img src="/media/${p.r2_key}" alt="${p.caption ?? ''}" style="width:100%;height:90px;object-fit:cover;border-radius:10px;border:1px solid var(--border);" />
              <button type="button" data-photo-id="${p.id}" style="position:absolute;top:4px;right:4px;width:22px;height:22px;border-radius:50%;border:0;background:rgba(0,0,0,.6);color:#fff;cursor:pointer;line-height:1;">×</button>
            </div>`
        )
        .join('');
    }
    renderGrid(photos);

    grid.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-photo-id]') as HTMLButtonElement | null;
      if (!btn) return;
      const photoId = Number(btn.dataset.photoId);
      const res = await fetch(`/api/business-photos?photoId=${photoId}`, { method: 'DELETE' });
      const result = await res.json();
      if (result.ok) btn.parentElement?.remove();
      else photoStatus.textContent = result.error || 'Could not delete photo.';
    });

    const uploadForm = document.getElementById('photo-upload-form') as HTMLFormElement;
    uploadForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fileInput = uploadForm.elements.namedItem('photo') as HTMLInputElement;
      if (!fileInput.files?.[0]) return;
      photoStatus.textContent = 'Uploading…';
      const fd = new FormData();
      fd.append('businessId', String(businessId));
      fd.append('photo', fileInput.files[0]);
      const res = await fetch('/api/business-photos', { method: 'POST', body: fd });
      const result = await res.json();
      if (result.ok) {
        photoStatus.textContent = '';
        uploadForm.reset();
        const refreshed = await fetch(`/api/business-photos?businessId=${businessId}`).then((r) => r.json());
        if (refreshed.ok) renderGrid(refreshed.photos);
      } else {
        photoStatus.textContent = result.error || 'Could not upload photo.';
      }
    });
  }

  async function init() {
    if (!businessId) {
      loading.textContent = 'No business specified.';
      return;
    }
    const res = await fetch(`/api/update-business?id=${encodeURIComponent(businessId)}`);
    if (res.status === 401) {
      window.location.href = '/login/';
      return;
    }
    const data = await res.json();
    if (!data.ok) {
      loading.textContent = data.error || 'Could not load this business.';
      return;
    }
    loading.hidden = true;
    form.hidden = false;
    document.getElementById('business-name')!.textContent = data.business.name;
    (form.elements.namedItem('address') as HTMLInputElement).value = data.business.address ?? '';
    (form.elements.namedItem('phone') as HTMLInputElement).value = data.business.phone ?? '';
    (form.elements.namedItem('website') as HTMLInputElement).value = data.business.website ?? '';
    (form.elements.namedItem('description') as HTMLTextAreaElement).value = data.business.description ?? '';
    (form.elements.namedItem('hours') as HTMLTextAreaElement).value = data.business.hours ?? '';

    renderPlanPanel(data.business);
    renderPhotosPanel(data.business, data.photos ?? []);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = 'Saving…';
    const data = Object.fromEntries(new FormData(form).entries());
    const res = await fetch('/api/update-business', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...data, businessId: Number(businessId) }),
    });
    const result = await res.json();
    status.textContent = result.ok ? 'Saved.' : result.error || 'Something went wrong.';
  });

  init();
</script>
