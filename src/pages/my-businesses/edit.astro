          <span style="font-size:14px;font-weight:700;color:var(--navy);flex:1;min-width:0">${esc(what)} · ${esc(shortDate(p.paid_at))}</span>
          <span style="${paid ? pill : 'padding:4px 10px;border-radius:999px;background:var(--bg-subtle);color:var(--muted);font-size:11px;font-weight:800;text-transform:uppercase'}">${paid ? 'Paid' : esc(p.status)}</span>
          <span style="font-size:14px;font-weight:800;color:var(--navy)">${amount}</span>
          ${p.invoice_number ? `<a href="/api/invoice?paymentId=${p.id}" target="_blank" rel="noopener" style="padding:7px 12px;border:2px solid var(--border);border-radius:8px;color:var(--navy);font-size:12px;font-weight:800;text-decoration:none;white-space:nowrap">Invoice</a>` : ''}
        </div>`;
      })
      .join('');
  }

  // ---- Photos ----
  // Every photo is redrawn in the browser before it uploads: EXIF rotation
  // applied, scaled to fit 1600px on its longest side (never upscaled) and
  // re-encoded as WebP (JPEG where the browser can't encode WebP), so a
  // 5–20MB phone shot goes up as a few hundred KB. No trim: unlike a logo,
  // a photo's edges are part of the picture. The server still checks the
  // actual bytes, the plan and the size.
  const PHOTO_MAX_PX = 1600;
  const PHOTO_QUALITY = 0.82;
  const PHOTO_MAX_BYTES = 8 * 1024 * 1024; // functions/api/business-photos.ts MAX_FILE_BYTES
  const PHOTO_ICON = `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10.5" r="1.5"/><path d="m21 16-5-4-4 3-3-2-4 3"/></svg>`;
  const isHeic = (file: File) => /^image\/hei[cf]/i.test(file.type) || /\.hei[cf]$/i.test(file.name);

  class PhotoError extends Error {}

  /** Decoded, upright image. createImageBitmap with imageOrientation applies
   *  the EXIF rotation; the <img> fallback (older Safari) does it by default. */
  async function decodePhoto(file: File): Promise<{ src: CanvasImageSource; w: number; h: number; close: () => void }> {
    if ('createImageBitmap' in window) {
      try {
        const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
        return { src: bmp, w: bmp.width, h: bmp.height, close: () => bmp.close() };
      } catch {
        // fall through to <img>
      }
    }
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.src = url;
    try {
      await img.decode();
    } catch {
      URL.revokeObjectURL(url);
      throw new PhotoError(
        isHeic(file)
          ? "This browser can't open HEIC photos. On your iPhone, choose the photo from Photos (it's converted to JPG), or set Settings › Camera › Formats to Most Compatible, then try again."
          : "Couldn't read that image — try a JPG or PNG."
      );
    }
    return { src: img, w: img.naturalWidth, h: img.naturalHeight, close: () => URL.revokeObjectURL(url) };
  }

  function encode(canvas: HTMLCanvasElement, type: string, quality: number): Promise<Blob | null> {
    return new Promise((resolve) => canvas.toBlob(resolve, type, quality));
  }

  async function preparePhoto(file: File): Promise<Blob> {
    const img = await decodePhoto(file);
    try {
      if (!img.w || !img.h) throw new PhotoError("Couldn't read that image — try a JPG or PNG.");
      const scale = Math.min(1, PHOTO_MAX_PX / Math.max(img.w, img.h));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(img.w * scale));
      canvas.height = Math.max(1, Math.round(img.h * scale));
      const ctx = canvas.getContext('2d')!;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img.src, 0, 0, canvas.width, canvas.height);
      // WebP keeps any transparency. A browser that can't encode WebP hands
      // back a PNG instead; use JPEG then, on white so transparent areas
      // don't turn black.
      let blob = await encode(canvas, 'image/webp', PHOTO_QUALITY);
      if (!blob || blob.type !== 'image/webp') {
        ctx.globalCompositeOperation = 'destination-over';
        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        blob = await encode(canvas, 'image/jpeg', PHOTO_QUALITY);
        if (blob && blob.size > PHOTO_MAX_BYTES) blob = await encode(canvas, 'image/jpeg', 0.6);
      }
      if (!blob) throw new PhotoError("Couldn't process that image — try a JPG or PNG.");
      return blob;
    } finally {
      img.close();
    }
  }

  function renderPhotos(business: Business, initial: Photo[]) {
    const locked = document.getElementById('photos-locked')!;
    const unlocked = document.getElementById('photos-unlocked')!;
    const count = document.getElementById('photos-count')!;
    const PHOTO_CAP = PHOTO_CAPS[business.subscription_tier] ?? 0;
    const planName = business.subscription_tier >= FEATURED_TIER ? 'Featured' : 'Verified';
    if (PHOTO_CAP === 0) {
      count.textContent = '— a Verified and Featured plan perk';
      locked.hidden = false;
      return;
    }
    unlocked.hidden = false;

    const grid = document.getElementById('photos-grid')!;
    const status = document.getElementById('photo-status')!;
    const progress = document.getElementById('photos-progress')!;
    const fileInput = document.getElementById('photos-file') as HTMLInputElement;
    const uploadBtn = document.getElementById('photos-upload') as HTMLButtonElement;
    let photos = initial.slice();
    // Instant previews of the photos uploading right now, shown after the saved ones.
    let pending: { id: number; url: string }[] = [];
    let pendingSeq = 0;
    let busy = false;

    function setStatus(msg: string) {
      status.textContent = msg;
      status.hidden = !msg;
    }
    // Tiles are kept by key and reused, so re-rendering never reloads (or
    // flashes) a photo that is already on screen.
    const tiles = new Map<string, HTMLElement>();
    // A just-uploaded photo keeps showing its local preview, no refetch.
    const localSrc = new Map<string, string>();
    function tile(key: string, html: string): HTMLElement {
      let el = tiles.get(key);
      if (!el) {
        const t = document.createElement('template');
        t.innerHTML = html.trim();
        el = t.content.firstElementChild as HTMLElement;
        tiles.set(key, el);
      }
      return el;
    }
    function render() {
      const n = Math.min(photos.length, PHOTO_CAP);
      count.textContent = `— ${n} / ${PHOTO_CAP} photos on ${planName}`;
      const els: HTMLElement[] = photos.map((p, i) => {
        const el = tile(
          `s:${p.r2_key}`,
          `<div class="photo-tile">
            <span class="photo-frame"><img src="${esc(localSrc.get(p.r2_key) ?? `/media/${p.r2_key}`)}" alt="" /></span>
            <button type="button" class="owner-btn-ghost logo-btn logo-btn-quiet">Remove</button>
          </div>`
        );
        el.querySelector('img')!.alt = p.caption ?? `Photo ${i + 1}`;
        const btn = el.querySelector('button')!;
        btn.dataset.photoId = String(p.id);
        btn.setAttribute('aria-label', `Remove photo ${i + 1}`);
        btn.disabled = busy;
        return el;
      });
      for (const p of pending) {
        els.push(
          tile(
            `p:${p.id}`,
            `<div class="photo-tile is-busy"><span class="photo-frame"><img src="${p.url}" alt="Uploading photo" /><span class="photo-busy"><span class="spinner"></span></span></span></div>`
          )
        );
      }
      if (!els.length) els.push(tile('empty', `<div class="photo-tile photo-empty-tile"><span class="photo-frame"><span class="logo-empty">${PHOTO_ICON}</span></span></div>`));
      grid.replaceChildren(...els);
      const full = photos.length >= PHOTO_CAP;
      uploadBtn.disabled = busy || full;
      uploadBtn.textContent = full ? 'Photo limit reached' : photos.length ? 'Add more photos' : 'Add photos';
    }
    render();
    if (photos.length > PHOTO_CAP) setStatus(`Only your first ${PHOTO_CAP} photos show on ${planName}. Remove some to make room for new ones.`);

    // One line per picked file: name, then where it's up to.
    function progressLine(name: string) {
      const li = document.createElement('li');
      const nameEl = document.createElement('span');
      nameEl.className = 'pf-name';
      nameEl.textContent = name;
      const state = document.createElement('span');
      li.append(nameEl, state);
      progress.append(li);
      progress.hidden = false;
      return (msg: string, kind: '' | 'ok' | 'err' = '') => {
        state.textContent = msg;
        state.className = kind ? `pf-${kind}` : '';
      };
    }

    async function uploadOne(file: File, set: ReturnType<typeof progressLine>): Promise<boolean> {
      if (!file.type.startsWith('image/') && !isHeic(file)) {
        set('Not an image — choose a JPG, PNG, WEBP or HEIC photo.', 'err');
        return false;
      }
      set('Resizing…');
      let blob: Blob;
      try {
        blob = await preparePhoto(file);
      } catch (err) {
        set(err instanceof PhotoError ? err.message : "Couldn't read that image — try a JPG or PNG.", 'err');
        return false;
      }
      if (blob.size > PHOTO_MAX_BYTES) {
        set('Still too big after resizing — try a smaller photo.', 'err');
        return false;
      }
      const preview = { id: ++pendingSeq, url: URL.createObjectURL(blob) };
      pending.push(preview);
      render();
      set(`Uploading ${Math.max(1, Math.round(blob.size / 1024))} KB…`);
      let kept = false;
      try {
        const ext = blob.type === 'image/webp' ? 'webp' : blob.type === 'image/png' ? 'png' : 'jpg';
        const fd = new FormData();
        fd.append('businessId', String(businessId));
        fd.append('photo', blob, `photo.${ext}`);
        let result: { ok?: boolean; error?: string; key?: string; id?: number | null } = { ok: false };
        try {
          const res = await fetch('/api/business-photos', { method: 'POST', body: fd });
          result = await res.json().catch(() => ({ ok: false, error: res.status === 413 ? 'Photo is too big to upload.' : `Upload failed (error ${res.status}) — please try again.` }));
        } catch {
          result = { ok: false, error: 'Upload failed — check your connection and try again.' };
        }
        if (result.ok && result.key) {
          photos.push({ id: result.id ?? -preview.id, r2_key: result.key, caption: null });
          localSrc.set(result.key, preview.url);
          kept = true;
          set('Uploaded', 'ok');
          return true;
        }
        set(result.error || 'Could not upload photo.', 'err');
        return false;
      } finally {
        // Success: the saved tile replaces the preview. Failure: the grid goes
        // back to exactly what was there before.
        pending = pending.filter((p) => p !== preview);
        tiles.delete(`p:${preview.id}`);
        if (!kept) URL.revokeObjectURL(preview.url);
        render();
      }
    }

    uploadBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', async () => {
      const files = Array.from(fileInput.files ?? []);
      fileInput.value = '';
      if (!files.length || busy) return;
      busy = true;
      progress.replaceChildren();
      setStatus(files.length > 1 ? `Uploading ${files.length} photos…` : 'Uploading…');
      render();
      let done = 0;
      let failed = 0;
      try {
        // One at a time, so the plan's limit is checked against each saved photo.
        for (const file of files) {
          const set = progressLine(file.name || 'Photo');
          if (photos.length >= PHOTO_CAP) {
            set(`Skipped — ${planName} allows up to ${PHOTO_CAP} photos.`, 'err');
            failed++;
            continue;
          }
          if (await uploadOne(file, set)) done++;
          else failed++;
        }
      } finally {
        busy = false;
        render();
      }
      if (done) {
        // Sync with the server's list (real ids and order).
        const refreshed = await fetch(`/api/business-photos?businessId=${encodeURIComponent(String(businessId))}`)
          .then((r) => r.json())
          .catch(() => null);
        if (refreshed?.ok) {
          photos = refreshed.photos;
          render();
        }
      }
      // Photos show on the business page itself right away (a live-patch
      // script re-fetches them on load — see functions/api/business-live.ts);
      // only the rest of the site (search, cards) still needs a rebuild.
      const live = `${done === 1 ? 'It shows' : 'They show'} on your public listing right away — search and cards elsewhere on the site catch up within about 15–25 minutes.`;
      if (done && !failed) setStatus(`Saved ${done === 1 ? 'your photo' : `${done} photos`}. ${live}`);
      else if (done) setStatus(`Saved ${done} of ${files.length} photos — see below for the rest. ${live}`);
      else setStatus(files.length === 1 ? 'Your photo was not uploaded — see below.' : 'No photos were uploaded — see below.');
    });

    grid.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-photo-id]') as HTMLButtonElement | null;
      if (!btn || busy) return;
      if (!confirm('Remove this photo?')) return;
      const photoId = Number(btn.dataset.photoId);
      btn.disabled = true;
      btn.textContent = 'Removing…';
      const res = await fetch(`/api/business-photos?photoId=${encodeURIComponent(String(photoId))}`, { method: 'DELETE' }).catch(() => null);
      const result = res ? await res.json().catch(() => ({ ok: false })) : { ok: false, error: 'Could not reach the server — try again.' };
      btn.textContent = 'Remove';
      if (result.ok) {
        for (const p of photos.filter((p) => p.id === photoId)) {
          tiles.delete(`s:${p.r2_key}`);
          const local = localSrc.get(p.r2_key);
          if (local) URL.revokeObjectURL(local);
          localSrc.delete(p.r2_key);
        }
        photos = photos.filter((p) => p.id !== photoId);
        progress.replaceChildren();
        progress.hidden = true;
        setStatus('Photo removed. It no longer shows on your public listing — search and cards elsewhere on the site catch up within about 15–25 minutes.');
      } else {
        setStatus(result.error || 'Could not remove photo.');
      }
      render();
    });
  }

  // ---- Logo ----
  // Trims the picked image's empty border (transparent or near-white rows and
  // columns, keeping a 4% margin) so the mark itself fills the logo tile,
  // scales it to fit 768x768 (never upscaled), keeping transparency, and
  // re-encodes it as WebP, so every stored logo is small whatever the owner
  // picks. The server still checks the actual bytes. Same trim as
  // scripts/trim-existing-logos.mjs.
  const LOGO_MAX_PX = 768;
  const LOGO_SCAN_PX = 2048;
  const LOGO_MAX_BYTES = 2 * 1024 * 1024;
  /** Bounding box of the non-empty pixels plus a 4% margin, or null to keep
   *  the whole image (nothing to trim, effectively blank, or the trim would
   *  throw away more than 98% of it). */
  function logoTrimBox(px: Uint8ClampedArray, w: number, h: number): { x: number; y: number; w: number; h: number } | null {
    let x0 = w, y0 = h, x1 = -1, y1 = -1;
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        const i = (y * w + x) * 4;
        if (px[i + 3] < 16 || (px[i] > 245 && px[i + 1] > 245 && px[i + 2] > 245)) continue;
        if (x < x0) x0 = x;
        if (x > x1) x1 = x;
        if (y < y0) y0 = y;
        if (y > y1) y1 = y;
      }
    }
    if (x1 < 0) return null;
    const bw = x1 - x0 + 1;
    const bh = y1 - y0 + 1;
    if (bw * bh < 0.02 * w * h) return null;
    const m = Math.round(0.04 * Math.max(bw, bh));
    const x = Math.max(0, x0 - m);
    const y = Math.max(0, y0 - m);
    const box = { x, y, w: Math.min(w, x1 + 1 + m) - x, h: Math.min(h, y1 + 1 + m) - y };
    return box.w === w && box.h === h ? null : box;
  }
  async function prepareLogo(file: File): Promise<Blob> {
    const url = URL.createObjectURL(file);
    try {
      const img = new Image();
      img.src = url;
      await img.decode();
      const w = img.naturalWidth;
      const h = img.naturalHeight;
      if (!w || !h) throw new Error('empty');
      // Scan a copy no bigger than 2048px (bounds memory on huge photos).
      const scan = Math.min(1, LOGO_SCAN_PX / w, LOGO_SCAN_PX / h);
      const sc = document.createElement('canvas');
      sc.width = Math.max(1, Math.round(w * scan));
      sc.height = Math.max(1, Math.round(h * scan));
      const sctx = sc.getContext('2d', { willReadFrequently: true })!;
      sctx.drawImage(img, 0, 0, sc.width, sc.height);
      const box = logoTrimBox(sctx.getImageData(0, 0, sc.width, sc.height).data, sc.width, sc.height);
      // Crop rectangle in the original image's pixels.
      const crop = box
        ? { x: box.x / scan, y: box.y / scan, w: Math.min(w, box.w / scan), h: Math.min(h, box.h / scan) }
        : { x: 0, y: 0, w, h };
      const scale = Math.min(1, LOGO_MAX_PX / crop.w, LOGO_MAX_PX / crop.h);
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(crop.w * scale));
      canvas.height = Math.max(1, Math.round(crop.h * scale));
      const ctx = canvas.getContext('2d')!;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, crop.x, crop.y, crop.w, crop.h, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/webp', 0.9));
      if (!blob) throw new Error('encode');
      // Already small, untrimmed and not resized: keep the original if re-encoding didn't help.
      return !box && scale === 1 && file.size <= blob.size ? file : blob;
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  function renderLogo(business: Business) {
    const unlocked = (business.subscription_status === 'active' || business.subscription_status === 'cancelled') && business.subscription_tier >= 1;
    const lg = document.getElementById('logo-preview-lg') as HTMLImageElement;
    const sm = document.getElementById('logo-preview-sm') as HTMLImageElement;
    const emptyLg = document.getElementById('logo-empty-lg')!;
    const emptySm = document.getElementById('logo-empty-sm')!;
    const fileInput = document.getElementById('logo-file') as HTMLInputElement;
    const uploadBtn = document.getElementById('logo-upload') as HTMLButtonElement;
    const removeBtn = document.getElementById('logo-remove') as HTMLButtonElement;
    const status = document.getElementById('logo-status')!;
    document.getElementById('logo-row-name')!.textContent = business.name;
    document.getElementById('logo-row-meta')!.textContent = [business.category_name, business.suburb_name].filter(Boolean).join(' · ');
    document.getElementById('logo-lock')!.hidden = unlocked;
    document.getElementById('logo-locked')!.hidden = unlocked;
    uploadBtn.disabled = !unlocked;
    fileInput.disabled = !unlocked;
    let key = business.logo_key ?? null;

    function setStatus(msg: string) {
      status.textContent = msg;
      status.hidden = !msg;
    }
    function show() {
      const src = key ? `/media/${key}` : '';
      for (const [img, empty] of [[lg, emptyLg], [sm, emptySm]] as const) {
        if (src) img.src = src;
        else img.removeAttribute('src');
        img.hidden = !src;
        empty.hidden = !!src;
      }
      lg.alt = `${business.name} logo`;
      uploadBtn.textContent = key ? 'Replace logo' : 'Upload logo';
      removeBtn.hidden = !key;
    }
    show();
    // A lapsed plan keeps the logo for when they renew; say why it isn't showing.
    if (key && !unlocked) setStatus("Your logo is saved but hidden from your listing until you're back on Verified or Featured.");

    uploadBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      fileInput.value = '';
      if (!file) return;
      if (!/^image\/(png|jpeg|webp)$/.test(file.type)) {
        setStatus('Please choose a PNG, JPG or WEBP image.');
        return;
      }
      uploadBtn.disabled = true;
      removeBtn.disabled = true;
      setStatus('Uploading…');
      try {
        let blob: Blob;
        try {
          blob = await prepareLogo(file);
        } catch {
          setStatus("Couldn't read that image — try a PNG or JPG.");
          return;
        }
        if (blob.size > LOGO_MAX_BYTES) {
          setStatus('Logo must be under 2MB.');
          return;
        }
        // Preview the trimmed logo straight away; show() swaps in the saved
        // copy (or puts the old one back if the upload fails).
        const previewUrl = URL.createObjectURL(blob);
        for (const [img, empty] of [[lg, emptyLg], [sm, emptySm]] as const) {
          img.src = previewUrl;
          img.hidden = false;
          empty.hidden = true;
        }
        const ext = blob.type === 'image/webp' ? 'webp' : blob.type === 'image/png' ? 'png' : 'jpg';
        const fd = new FormData();
        fd.append('businessId', String(businessId));
        fd.append('logo', blob, `logo.${ext}`);
        const res = await fetch('/api/business-logo', { method: 'POST', body: fd });
        const result = await res.json().catch(() => ({ ok: false }));
        if (result.ok) {
          key = result.key;
          show();
          // The logo shows on the business page itself right away (see
          // functions/api/business-live.ts); only the rest of the site
          // (search, cards) still needs a rebuild.
          setStatus('Saved. Your logo shows on your public listing right away — search and cards elsewhere on the site catch up within about 15–25 minutes.');
        } else {
          show();
          setStatus(result.error || 'Could not upload logo.');
        }
      } finally {
        uploadBtn.disabled = !unlocked;
        removeBtn.disabled = false;
      }
    });

    removeBtn.addEventListener('click', async () => {
      if (!confirm('Remove your logo?')) return;
      removeBtn.disabled = true;
      const res = await fetch(`/api/business-logo?businessId=${encodeURIComponent(String(businessId))}`, { method: 'DELETE' });
      const result = await res.json().catch(() => ({ ok: false }));
      removeBtn.disabled = false;
      if (result.ok) {
        key = null;
        show();
        setStatus('Logo removed. It no longer shows on your public listing — search and cards elsewhere on the site catch up within about 15–25 minutes.');
      } else {
        setStatus(result.error || 'Could not remove logo.');
      }
    });
  }

  async function init() {
    if (!businessId) {
      loading.textContent = 'No business specified.';
      return;
    }
    const res = await fetch(`/api/update-business?id=${encodeURIComponent(businessId)}`);
    if (res.status === 401) {
      window.location.href = '/login/';
      return;
    }
    const data = await res.json();
    if (!data.ok) {
      loading.textContent = data.error || 'Could not load this business.';
      return;
    }
    const b: Business = data.business;
    // loading carries its own inline style="display:flex", which beats the
    // UA [hidden]{display:none} rule on specificity — .hidden alone is a
    // silent no-op (same bug fixed in sponsor.astro's sp-target-wrap).
    loading.style.display = 'none';
    dashboard.hidden = false;

    (document.getElementById('field-name') as HTMLInputElement).value = b.name;
    (form.elements.namedItem('address') as HTMLInputElement).value = b.address ?? '';
    (form.elements.namedItem('phone') as HTMLInputElement).value = b.phone ?? '';
    (form.elements.namedItem('website') as HTMLInputElement).value = b.website ?? '';
    (form.elements.namedItem('email') as HTMLInputElement).value = b.email ?? '';
    (form.elements.namedItem('description') as HTMLTextAreaElement).value = b.description ?? '';
    (form.elements.namedItem('short_description') as HTMLTextAreaElement).value = b.short_description ?? '';
    // Basic or lapsed: the toolbar locks and the box shows plain text, as the
    // site does. The stored text (markers and all) is saved back untouched
    // unless the owner edits the description, so a lapsed listing's
    // formatting isn't lost just by saving another field.
    const descLocked = !canFormatDescription(b);
    descEditor.setLocked(descLocked);
    shortEditor.setLocked(descLocked);
    descEditor.refresh();
    shortEditor.refresh();
    const hasMarkers = /\*\S|^\s*(?:[-*•]|\d{1,3}[.)])\s/m.test([b.description ?? '', b.short_description ?? ''].join('\n'));
    document.getElementById('desc-locked-text')!.textContent = descLocked && hasMarkers
      ? "Your formatting is saved, but shows as plain text until your listing is on Verified or Featured again."
      : 'Bold, italic and lists come with the Verified and Featured plans.';
    (form.elements.namedItem('hours') as HTMLTextAreaElement).value = b.hours ?? '';

    const socialOn = (b.subscription_status === 'active' || b.subscription_status === 'cancelled') && b.subscription_tier >= FEATURED_TIER;
    // The four fields stay visible on every plan; below Featured they are locked
    // (disabled inputs are skipped by FormData, so nothing social is submitted and
    // update-business.ts ignores the links for non-Featured listings anyway).
    document.getElementById('social-locked')!.hidden = socialOn;
    document.getElementById('social-note')!.style.display = socialOn ? 'none' : 'inline-flex';
    for (const k of ['instagram', 'facebook', 'linkedin', 'youtube'] as const) {
      const input = form.elements.namedItem('social_' + k) as HTMLInputElement;
      input.value = b[('social_' + k) as 'social_instagram'] ?? '';
      input.disabled = !socialOn;
      input.style.background = socialOn ? '#fff' : 'var(--bg-subtle)';
      input.style.color = socialOn ? 'var(--text)' : 'var(--muted)';
      input.style.cursor = socialOn ? '' : 'not-allowed';
    }

    // WhatsApp number: same Featured rule. Locked, it still shows the stored
    // number (greyed) so a lapsed owner sees it's kept for when they renew.
    const waInput = form.elements.namedItem('whatsapp') as HTMLInputElement;
    const waSame = document.getElementById('whatsapp-same') as HTMLInputElement;
    const phoneInput = form.elements.namedItem('phone') as HTMLInputElement;
    const digitsOf = (v: string) => v.replace(/\D/g, '').replace(/^27/, '0');
    waInput.value = b.whatsapp ?? '';
    waInput.disabled = !socialOn;
    waSame.disabled = !socialOn;
    waSame.checked = socialOn && !!b.whatsapp && digitsOf(b.whatsapp) === digitsOf(b.phone ?? '');
    waInput.readOnly = waSame.checked;
    waInput.style.background = socialOn && !waSame.checked ? '#fff' : 'var(--bg-subtle)';
    waInput.style.color = socialOn ? 'var(--text)' : 'var(--muted)';
    waInput.style.cursor = socialOn ? '' : 'not-allowed';
    document.getElementById('whatsapp-lock')!.hidden = socialOn;
    document.getElementById('whatsapp-locked')!.hidden = socialOn;
    document.getElementById('whatsapp-same-wrap')!.style.display = socialOn ? 'inline-flex' : 'none';
    const syncWhatsapp = () => {
      if (!waSame.checked) return;
      waInput.value = phoneInput.value;
    };
    waSame.onchange = () => {
      waInput.readOnly = waSame.checked;
      waInput.style.background = waSame.checked ? 'var(--bg-subtle)' : '#fff';
      syncWhatsapp();
    };
    phoneInput.oninput = syncWhatsapp;

    renderHeader(b);
    renderVisibility(b);
    renderPlan(b);
    renderSponsorships(data.sponsorships ?? []);
    renderPayments(data.payments ?? []);
    renderPhotos(b, data.photos ?? []);
    renderLogo(b);
    const statsLocked = data.statsLocked === true || data.stats === null;
    renderStats(statsLocked ? null : (data.stats ?? { has_any: false, views: 0, phone_clicks: 0, website_clicks: 0, search_appearances: 0 }), data.enquiriesRecent ?? 0, data.enquiriesTotal ?? 0);
    renderSearchTerms(data.searchTerms ?? [], statsLocked);
    renderEnquiries(data.enquiries ?? [], data.enquiriesTotal ?? 0);
    renderReviews(data.reviews ?? [], data.reviewsTotal ?? 0);

    const fromHash = location.hash.replace('#', '');
    showTab(params.get('upgraded') || params.get('upgrade_cancelled') ? 'billing' : fromHash || 'overview');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formStatus.textContent = 'Saving…';
    const data = Object.fromEntries(new FormData(form).entries());
    const res = await fetch('/api/update-business', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...data, businessId: Number(businessId) }),
    });
    const result = await res.json();
    formStatus.textContent = result.ok
      ? 'Saved. Your description, hours and WhatsApp number update on your public listing right away — the rest updates within about 15–25 minutes.'
      : result.error || 'Something went wrong.';
  });

  init();
</script>
