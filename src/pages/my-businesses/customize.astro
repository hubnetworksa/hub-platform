---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../site';
---

<BaseLayout title="Customise business page" description="Preview and customise your business page.">
  <section class="container" style="padding-top: 3rem; padding-bottom: 1.5rem; max-width: 1180px;">
    <div id="loading">Loading…</div>

    <div id="content" hidden>
      <a id="back-link" href="#" class="back-link">← Back to editing</a>
      <h1>Customise <span id="business-name-hl"></span></h1>

      <div class="preview-panel">
        <div class="preview-head">
          <span>Live preview — this is exactly what visitors will see</span>
          <div class="preview-head-right">
            <div class="preview-width-toggle" role="group" aria-label="Preview width">
              <button type="button" class="width-btn active" data-width="desktop">Desktop</button>
              <button type="button" class="width-btn" data-width="tablet">Tablet</button>
              <button type="button" class="width-btn" data-width="mobile">Mobile</button>
            </div>
            <span class="preview-live-dot">● updates as you edit</span>
          </div>
        </div>
        <div class="preview-frame">
          <div class="preview-body" id="preview-body"></div>
        </div>
        <p class="preview-note">Click any headline or text above to edit it directly. This shows your unsaved draft live — changes autosave as you go, and <strong>Publish changes</strong> below makes them go live on the real page.</p>
      </div>
    </div>
  </section>

  <section class="container" style="padding-top: 1.5rem; padding-bottom: 4rem; max-width: 680px;">
    <div id="content2" hidden>
          <div id="upsell-photos" class="upsell" hidden>
            <p><strong>Photos</strong> unlock at Verified Plus (R99/mo).</p>
            <a href="#" class="upsell-link">Upgrade to add photos →</a>
          </div>
          <section id="photos-section" hidden>
            <h2>Photos</h2>
            <p id="photos-cap-label" class="muted"></p>
            <div id="photo-grid" class="photo-grid"></div>
            <form id="photo-upload-form">
              <input type="file" name="photo" accept="image/*" id="photo-input" />
              <button type="submit" class="btn btn-outline btn-sm">Upload photo</button>
            </form>
            <p id="photo-status" role="status" class="muted"></p>
          </section>

          <div id="upsell-template" class="upsell" hidden>
            <p><strong>Page templates</strong> unlock at Featured (R199/mo).</p>
            <a href="#" class="upsell-link">Upgrade to choose a template →</a>
          </div>
          <section id="template-picker" hidden>
            <h2>Page template</h2>
            <div class="option-grid">
              <button type="button" class="tpl-btn" data-tpl="classic"><b>Classic</b><span>Clean &amp; simple</span></button>
              <button type="button" class="tpl-btn" data-tpl="gallery"><b>Gallery-Forward</b><span>Photo leads the page</span></button>
              <button type="button" class="tpl-btn" data-tpl="services"><b>Services Grid</b><span>Structured service cards</span></button>
            </div>
          </section>

          <div id="upsell-blocks" class="upsell" hidden>
            <p><strong>Custom sections</strong> (Our Story, Specials, Team, Gallery) unlock at Premium (R299/mo).</p>
            <a href="#" class="upsell-link">Upgrade to Premium →</a>
          </div>
          <section id="block-editor" hidden>
            <h2>Extra sections</h2>
            <div id="blocks-list"></div>
            <button type="button" id="add-block-btn" class="btn btn-outline btn-sm">+ Add section</button>
          </section>

      <div id="design-actions" hidden>
        <button type="button" id="publish-btn" class="btn btn-primary" hidden>Publish changes</button>
        <button type="button" id="revert-btn" class="btn btn-outline" hidden>Revert to published</button>
      </div>
      <p id="design-status" role="status" class="muted" hidden></p>
    </div>
  </section>

  <div id="photo-modal" class="photo-modal" hidden>
    <div id="photo-modal-backdrop" class="photo-modal-backdrop"></div>
    <div class="photo-modal-content">
      <button type="button" id="photo-modal-close" class="photo-modal-close" aria-label="Close">×</button>
      <img id="photo-modal-img" src="" alt="Full-size uploaded photo" />
    </div>
  </div>
</BaseLayout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"></script>
<script define:vars={{ SITE_NAME: site.siteName, CITY_LABEL: site.cityLabel, SITE_TAGLINE: site.tagline }}>
  // NOTE: define:vars forces this whole script to stay inline, unprocessed
  // by Astro/Vite — no TypeScript syntax here (no `interface`, no type
  // annotations, no `as X` casts), it must be plain browser JS or it never
  // parses at all in a real browser.
  const params = new URLSearchParams(window.location.search);
  const businessId = params.get('id');
  const loading = document.getElementById('loading');
  const content = document.getElementById('content');

  let selectedTemplate = 'classic';
  let blocks = [];
  let liveTemplateId = 'classic';
  let liveBlocks = [];
  let hasUnpublishedChanges = false;
  let draftUpdatedAt = null;
  let tier = 0;
  let canChooseTemplate = false;
  let canUseBuilder = false;
  let photos = [];
  let business = { name: '', address: '', phone: '', website: '', description: '', hours: '', categories: [], suburb: null };

  // Kept in sync by hand with src/lib/blockRenderer.ts's BLOCK_TITLES/
  // BLOCK_TYPES — this client script can't import that Node/Astro module
  // directly, same reason the icon paths below are hand-copied too.
  const BLOCK_TITLES = {
    story: 'Our Story', specials: 'Specials & Promotions', team: 'Team', gallery: 'Gallery',
    photo: 'Photo', testimonial: 'Testimonial', cta: 'Call to Action', divider: 'Divider',
  };
  const BLOCK_TYPE_OPTIONS = [
    ['story', 'Our Story'], ['specials', 'Specials & Promotions'], ['team', 'Team'], ['gallery', 'Gallery'],
    ['photo', 'Photo'], ['testimonial', 'Testimonial'], ['cta', 'Call to Action'], ['divider', 'Divider'],
  ];
  // Sortable is loaded as a global by the <script src> tag above this one.

  // Same icon paths as src/pages/business/[slug].astro's ICONS + Icon.astro's
  // wrapper — kept in sync by hand since this preview can't import an
  // Astro component at runtime.
  const ICON_PATHS = {
    check: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 5-5"/>',
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
    phone: '<path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"/>',
    pin: '<path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5"/>',
    flag: '<path d="M5 21V4"/><path d="M5 4h13l-3 4 3 4H5"/>',
    trash: '<path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>',
  };
  function icon(name, size = 16) {
    return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;">${ICON_PATHS[name]}</svg>`;
  }

  // Inline SVG placeholder — no network dependency, and clearly marked as a
  // sample so nobody mistakes it for a real uploaded photo.
  function placeholderPhoto(label) {
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="320" height="220" viewBox="0 0 320 220">
      <rect width="320" height="220" fill="#e2e8f0"/>
      <g fill="#94a3b8"><circle cx="160" cy="88" r="26"/><path d="M96 168c0-30 28-46 64-46s64 16 64 46z"/></g>
      <text x="160" y="196" font-family="sans-serif" font-size="12" fill="#64748b" text-anchor="middle">${label}</text>
    </svg>`;
    return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
  }
  const PLACEHOLDER_COUNT = 3;

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  // Phase 4 — click-to-edit directly in the live preview. Each custom-block
  // text field renders as a contenteditable element carrying its block
  // index + field name; a single delegated listener set (below, attached
  // once to #preview-dynamic) handles typing, clearing the placeholder on
  // focus, and restoring it on blur if left empty. The shown fallback text
  // when a field is empty must match src/lib/blockRenderer.ts's own
  // fallback exactly — this preview has to show what a real visitor would
  // actually see, unedited fields included.
  const EMPTY_BODY_PLACEHOLDER_HTML = '<span class="placeholder-text">(empty — add some text)</span>';

  function editableEl(tag, cssClass, index, field, value, fallback, multiline) {
    const isEmpty = !value;
    const shown = escapeHtml(isEmpty ? fallback : value);
    const classes = ['cb-field', cssClass, isEmpty ? 'is-placeholder' : ''].filter(Boolean).join(' ');
    const attrs = [
      `class="${classes}"`,
      'contenteditable="true"',
      `data-block-index="${index}"`,
      `data-field="${field}"`,
      `data-fallback="${escapeHtml(fallback)}"`,
      isEmpty ? 'data-placeholder="true"' : '',
      multiline ? 'data-multiline="true"' : '',
    ].filter(Boolean).join(' ');
    return `<${tag} ${attrs}>${shown}</${tag}>`;
  }

  // Full page chrome (header/nav/footer), rendered once — it never changes
  // while editing a template/section, so there's no reason to rebuild it
  // on every keystroke the way the content below it does. Copied verbatim
  // from src/layouts/BaseLayout.astro.
  function renderChrome() {
    const crumbs = [
      ...(business.suburb ? [`<a href="/suburb/${business.suburb.slug}/">${escapeHtml(business.suburb.name)}</a>`] : []),
      ...(business.categories[0] ? [`<a href="/category/${business.categories[0].slug}/">${escapeHtml(business.categories[0].name)}</a>`] : []),
      `<span class="current">${escapeHtml(business.name)}</span>`,
    ];
    const breadcrumbsHtml = `<nav class="breadcrumbs" aria-label="Breadcrumb">${crumbs
      .map((c, i) => c + (i < crumbs.length - 1 ? '<span class="sep" aria-hidden="true">›</span>' : ''))
      .join('')}</nav>`;

    document.getElementById('preview-body').innerHTML = `
      <header class="brand-row">
        <div class="container">
          <a href="/" class="logo">
            <img src="/logo-icon.png" alt="${escapeHtml(SITE_NAME)}" width="40" height="46" />
            <span class="logo-text">
              <span class="logo-word">${escapeHtml(CITY_LABEL)}<span>Hub</span></span>
              <span class="logo-sub">Business Directory</span>
            </span>
          </a>
          <p class="tagline">
            <strong>Discover. Connect. Grow.</strong>
            <span>${escapeHtml(SITE_TAGLINE)}</span>
          </p>
        </div>
      </header>
      <nav class="site-nav" aria-label="Main">
        <div class="container">
          <div class="nav-links">
            <a href="/">Home</a>
            <a href="/suburb/">Directory</a>
            <a href="/category/">Categories</a>
            <a href="/about/">About Us</a>
          </div>
        </div>
      </nav>
      <main>
        <section class="container" style="padding-top: 2rem; padding-bottom: 2rem; max-width: 720px;">
          ${breadcrumbsHtml}
          <div id="preview-dynamic"></div>
        </section>
      </main>
      <footer class="site-footer">
        <div class="container">
          <span>© ${new Date().getFullYear()} ${escapeHtml(SITE_NAME)}</span>
        </div>
      </footer>
    `;
  }

  // Mirrors src/pages/business/[slug].astro's actual markup and classes
  // exactly (same class names, same conditional structure per template) so
  // this really is a preview of the real page, not an approximation of it.
  // Only touches #preview-dynamic — the chrome around it (rendered once by
  // renderChrome()) never needs to change while editing.
  // Kept in sync by hand with src/lib/blockRenderer.ts's renderOneBlock —
  // same reason as BLOCK_TITLES above.
  function renderOneBlockPreview(b, index) {
    switch (b.type) {
      case 'photo': {
        const altText = escapeHtml(b.title || 'Photo');
        return `<div class="custom-block custom-block-photo">
          ${b.imageKey ? `<img src="/media/${b.imageKey}" alt="${altText}" loading="lazy" />` : '<div class="photo-placeholder">No photo chosen — pick one from the section list below</div>'}
          ${editableEl('p', 'photo-caption', index, 'title', b.title, 'Add a caption (optional)')}
        </div>`;
      }
      case 'divider':
        return `<div class="custom-block custom-block-divider"><hr /></div>`;
      case 'cta':
        return `<div class="custom-block custom-block-cta">
          ${editableEl('p', 'cta-text', index, 'title', b.title, BLOCK_TITLES.cta)}
          ${editableEl('span', 'btn btn-primary cta-btn', index, 'body', b.body, 'Get in touch')}
        </div>`;
      case 'testimonial':
        return `<div class="custom-block custom-block-testimonial">
          <p class="testimonial-quote">&ldquo;${editableEl('span', 'cb-field-inline', index, 'body', b.body, '', true)}&rdquo;</p>
          <p class="testimonial-author">— ${editableEl('span', 'cb-field-inline', index, 'title', b.title, BLOCK_TITLES.testimonial)}</p>
        </div>`;
      default: {
        const titleEl = editableEl('h2', '', index, 'title', b.title, BLOCK_TITLES[b.type] || 'More');
        const bodyHtml = b.body ? escapeHtml(b.body).replace(/\n/g, '<br />') : EMPTY_BODY_PLACEHOLDER_HTML;
        const bodyAttrs = [
          'class="cb-field' + (b.body ? '' : ' is-placeholder') + '"',
          'contenteditable="true"',
          `data-block-index="${index}"`,
          'data-field="body"',
          'data-fallback=""',
          'data-multiline="true"',
          b.body ? '' : 'data-placeholder="true" data-html-fallback="true"',
        ].filter(Boolean).join(' ');
        return `<div class="custom-block">
          ${titleEl}
          <p ${bodyAttrs}>${bodyHtml}</p>
        </div>`;
      }
    }
  }

  function renderPreview() {
    const isPaidTier = tier >= 1;
    const showClickableWebsite = isPaidTier && !!business.website;
    const usingPlaceholders = photos.length === 0;
    const galleryPhotos = usingPlaceholders
      ? Array.from({ length: PLACEHOLDER_COUNT }, (_, i) => placeholderPhoto(`Sample photo ${i + 1}`))
      : photos.map((p) => `/media/${p.r2_key}`);
    const sampleNote = usingPlaceholders ? '<p class="sample-note">📷 Sample photos shown — upload your own above to replace them.</p>' : '';

    const heroGallery = selectedTemplate === 'gallery'
      ? `<div class="hero-gallery">${galleryPhotos.map((src) => `<img src="${src}" alt="" />`).join('')}</div>${sampleNote}`
      : '';
    const inlineGallery = selectedTemplate !== 'gallery'
      ? `<div class="photo-gallery${galleryPhotos.length > 5 ? ' carousel' : ''}">${galleryPhotos.map((src) => `<img src="${src}" alt="" />`).join('')}</div>${sampleNote}`
      : '';

    const customBlocksHtml = canUseBuilder && blocks.length
      ? `<div class="custom-blocks${selectedTemplate === 'services' ? ' grid' : ''}">${blocks.map(renderOneBlockPreview).join('')}</div>`
      : '';

    const tagsHtml = `<div class="tags">
      ${isPaidTier ? `<span class="badge tier-badge">${icon('check', 13)} Verified</span>` : ''}
      ${business.categories.map((c) => `<span class="badge">${escapeHtml(c.name)}</span>`).join('')}
    </div>`;

    const body = document.getElementById('preview-dynamic');
    body.innerHTML = `
      ${heroGallery}
      <h1 style="margin: 1rem 0 0.75rem; overflow-wrap: break-word;">${escapeHtml(business.name)}</h1>
      ${tagsHtml}
      <p style="margin-top: 1.25rem;">${escapeHtml(business.description)}</p>
      ${inlineGallery}
      ${customBlocksHtml}
      ${business.address ? `<p class="address">${escapeHtml(business.address)}</p>` : ''}
      <div class="actions">
        ${showClickableWebsite ? `<span class="btn btn-outline">${icon('pin')} Visit website</span>` : ''}
        ${business.phone ? `<span class="btn btn-outline">${icon('phone')} ${escapeHtml(business.phone)}</span>` : ''}
        <span class="btn btn-outline">${icon('pin')} View on Google Maps</span>
      </div>
      <div class="hours-section">
        <h2 class="hours-heading">${icon('clock', 17)} Trading Hours</h2>
        ${business.hours
          ? `<p class="hours-text">${escapeHtml(business.hours)}</p>`
          : '<p class="hours-text hours-unavailable">Trading hours not available</p>'}
      </div>
      <div class="listing-meta-links">
        <span>${icon('flag', 13)} Report this listing</span>
        <span>${icon('trash', 13)} Request data removal</span>
      </div>
    `;
  }

  // Text fields are edited inline, directly in the live preview (click any
  // headline/body there) — the sidebar only holds what can't be edited that
  // way: which photo a photo block uses.
  function blockFieldsHtml(b) {
    if (b.type === 'divider') {
      return '<p class="muted block-hint">Just a horizontal divider — no text needed.</p>';
    }
    if (b.type === 'photo') {
      const photoOptions = photos
        .map((p) => `<option value="${p.r2_key}" ${b.imageKey === p.r2_key ? 'selected' : ''}>${p.r2_key.split('/').pop()}</option>`)
        .join('');
      return `
        <select class="block-image">
          <option value="">— Choose an uploaded photo —</option>
          ${photoOptions}
        </select>
        <p class="muted block-hint">Caption is editable directly in the preview above.</p>`;
    }
    return '<p class="muted block-hint">Text is editable directly in the preview above.</p>';
  }

  function renderBlocks() {
    const list = document.getElementById('blocks-list');
    list.innerHTML = blocks
      .map(
        (b, i) => `
      <div class="block-row" data-i="${i}">
        <div class="block-row-head">
          <span class="drag-handle" title="Drag to reorder">⠿⠿</span>
          <select class="block-type">
            ${BLOCK_TYPE_OPTIONS.map(([val, label]) => `<option value="${val}" ${b.type === val ? 'selected' : ''}>${label}</option>`).join('')}
          </select>
        </div>
        ${blockFieldsHtml(b)}
        <div class="block-row-actions">
          <button type="button" class="move-up" ${i === 0 ? 'disabled' : ''}>↑</button>
          <button type="button" class="move-down" ${i === blocks.length - 1 ? 'disabled' : ''}>↓</button>
          <button type="button" class="remove-block">Remove</button>
        </div>
      </div>`
      )
      .join('');

    list.querySelectorAll('.block-row').forEach((row) => {
      const i = Number(row.dataset.i);
      row.querySelector('.block-type').addEventListener('change', (e) => {
        blocks[i].type = e.target.value;
        renderBlocks(); renderPreview(); scheduleAutosave();
      });
      row.querySelector('.block-image')?.addEventListener('change', (e) => { blocks[i].imageKey = e.target.value || undefined; renderPreview(); scheduleAutosave(); });
      row.querySelector('.remove-block').addEventListener('click', () => { blocks.splice(i, 1); renderBlocks(); renderPreview(); scheduleAutosave(); });
      row.querySelector('.move-up')?.addEventListener('click', () => { if (i > 0) { [blocks[i - 1], blocks[i]] = [blocks[i], blocks[i - 1]]; renderBlocks(); renderPreview(); scheduleAutosave(); } });
      row.querySelector('.move-down')?.addEventListener('click', () => { if (i < blocks.length - 1) { [blocks[i + 1], blocks[i]] = [blocks[i], blocks[i + 1]]; renderBlocks(); renderPreview(); scheduleAutosave(); } });
    });
  }

  // Delegated once onto the stable #preview-dynamic container (renderPreview()
  // replaces its children on every edit, but the container itself never gets
  // recreated, so a single set of listeners here survives every re-render).
  function initInlineEditing() {
    const container = document.getElementById('preview-dynamic');
    if (!container || container.dataset.editingInited) return;
    container.dataset.editingInited = 'true';

    container.addEventListener('focusin', (e) => {
      const el = e.target.closest('[data-field]');
      if (!el || el.dataset.placeholder !== 'true') return;
      el.textContent = '';
      el.classList.remove('is-placeholder');
      delete el.dataset.placeholder;
    });

    container.addEventListener('input', (e) => {
      const el = e.target.closest('[data-field]');
      if (!el) return;
      const i = Number(el.dataset.blockIndex);
      if (!blocks[i]) return;
      blocks[i][el.dataset.field] = el.textContent;
      scheduleAutosave();
    });

    container.addEventListener('keydown', (e) => {
      const el = e.target.closest('[data-field]');
      if (!el || e.key !== 'Enter') return;
      e.preventDefault();
      if (el.dataset.multiline === 'true') {
        document.execCommand('insertText', false, '\n');
      } else {
        el.blur();
      }
    });

    container.addEventListener('focusout', (e) => {
      const el = e.target.closest('[data-field]');
      if (!el) return;
      const i = Number(el.dataset.blockIndex);
      if (!blocks[i]) return;
      const field = el.dataset.field;
      const value = el.textContent.trim();
      blocks[i][field] = value;
      if (!value) {
        if (el.dataset.htmlFallback === 'true') {
          el.innerHTML = EMPTY_BODY_PLACEHOLDER_HTML;
        } else {
          el.textContent = el.dataset.fallback || '';
        }
        el.classList.add('is-placeholder');
        el.dataset.placeholder = 'true';
      }
      scheduleAutosave();
    });
  }

  // Preview width toggle (Phase 5) — these buttons are static markup, always
  // present regardless of tier, so they're wired up immediately rather than
  // inside init().
  document.querySelectorAll('.width-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.width-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const frame = document.querySelector('.preview-frame');
      frame.classList.remove('width-desktop', 'width-tablet', 'width-mobile');
      frame.classList.add(`width-${btn.dataset.width}`);
    });
  });

  document.getElementById('add-block-btn').addEventListener('click', () => {
    if (blocks.length >= 10) return;
    blocks.push({ type: 'story', title: '', body: '' });
    renderBlocks();
    renderPreview();
    scheduleAutosave();
  });

  // Sortable is attached to the container once — it reads whatever child
  // rows exist at drag time, so it survives renderBlocks() re-rendering
  // those rows on every edit without needing to be re-created.
  let sortableInited = false;
  function initSortable() {
    if (sortableInited || typeof Sortable === 'undefined') return;
    sortableInited = true;
    Sortable.create(document.getElementById('blocks-list'), {
      handle: '.drag-handle',
      animation: 150,
      ghostClass: 'block-row-ghost',
      onEnd: (evt) => {
        if (evt.oldIndex === evt.newIndex) return;
        const [moved] = blocks.splice(evt.oldIndex, 1);
        blocks.splice(evt.newIndex, 0, moved);
        renderBlocks();
        renderPreview();
        scheduleAutosave();
      },
    });
  }

  let autosaveTimer;
  function scheduleAutosave() {
    hasUnpublishedChanges = true;
    updateDesignStatus();
    window.clearTimeout(autosaveTimer);
    autosaveTimer = window.setTimeout(doAutosave, 900);
  }

  async function doAutosave() {
    const designStatus = document.getElementById('design-status');
    designStatus.textContent = 'Saving…';
    const res = await fetch('/api/business-design', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ businessId: Number(businessId), action: 'autosave', templateId: selectedTemplate, blocks }),
    });
    const result = await res.json();
    if (result.ok) {
      draftUpdatedAt = result.draftUpdatedAt;
    } else {
      designStatus.textContent = result.error || 'Could not save your draft.';
      return;
    }
    updateDesignStatus();
  }

  function updateDesignStatus() {
    const designStatus = document.getElementById('design-status');
    const publishBtn = document.getElementById('publish-btn');
    const revertBtn = document.getElementById('revert-btn');
    publishBtn.hidden = !hasUnpublishedChanges;
    revertBtn.hidden = !hasUnpublishedChanges;
    if (hasUnpublishedChanges) {
      designStatus.textContent = draftUpdatedAt
        ? `Draft saved ${new Date(draftUpdatedAt).toLocaleTimeString()} — not published yet.`
        : 'Draft saved — not published yet.';
    } else {
      designStatus.textContent = 'Everything here is published and live.';
    }
  }

  document.getElementById('publish-btn').addEventListener('click', async () => {
    const designStatus = document.getElementById('design-status');
    designStatus.textContent = 'Publishing…';
    const res = await fetch('/api/business-design', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ businessId: Number(businessId), action: 'publish' }),
    });
    const result = await res.json();
    if (result.ok) {
      liveTemplateId = selectedTemplate;
      liveBlocks = JSON.parse(JSON.stringify(blocks));
      hasUnpublishedChanges = false;
      updateDesignStatus();
      designStatus.textContent = 'Published! Your live page will update shortly.';
    } else {
      designStatus.textContent = result.error || 'Could not publish.';
    }
  });

  document.getElementById('revert-btn').addEventListener('click', async () => {
    if (!window.confirm('Discard your unpublished changes and go back to what is currently live?')) return;
    await fetch('/api/business-design', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ businessId: Number(businessId), action: 'revert' }),
    });
    selectedTemplate = liveTemplateId;
    blocks = JSON.parse(JSON.stringify(liveBlocks));
    hasUnpublishedChanges = false;
    draftUpdatedAt = null;
    document.querySelectorAll('.tpl-btn').forEach((btn) => btn.classList.toggle('active', btn.dataset.tpl === selectedTemplate));
    renderBlocks();
    renderPreview();
    updateDesignStatus();
  });

  async function init() {
    if (!businessId) {
      loading.textContent = 'No business specified.';
      return;
    }
    document.getElementById('back-link').href = `/my-businesses/edit/?id=${businessId}`;
    document.querySelectorAll('.upsell-link').forEach((a) => (a.href = `/my-businesses/upgrade/?id=${businessId}`));

    const [updateRes, designRes] = await Promise.all([
      fetch(`/api/update-business?id=${encodeURIComponent(businessId)}`),
      fetch(`/api/business-design?businessId=${encodeURIComponent(businessId)}`),
    ]);
    if (updateRes.status === 401 || designRes.status === 401) {
      window.location.href = '/login/';
      return;
    }
    const data = await updateRes.json();
    const design = await designRes.json();
    if (!data.ok || !design.ok) {
      loading.textContent = data.error || design.error || 'Could not load this business.';
      return;
    }
    loading.hidden = true;
    content.hidden = false;
    document.getElementById('content2').hidden = false;
    document.getElementById('business-name-hl').textContent = data.business.name;

    tier = design.tier;
    canChooseTemplate = design.canChooseTemplate;
    canUseBuilder = design.canUseBuilder;
    selectedTemplate = design.templateId ?? 'classic';
    blocks = Array.isArray(design.blocks) ? design.blocks : [];
    liveTemplateId = design.liveTemplateId ?? 'classic';
    liveBlocks = Array.isArray(design.liveBlocks) ? design.liveBlocks : [];
    hasUnpublishedChanges = !!design.hasUnpublishedChanges;
    draftUpdatedAt = design.draftUpdatedAt ?? null;

    business = {
      name: data.business.name,
      address: data.business.address ?? '',
      phone: data.business.phone ?? '',
      website: data.business.website ?? '',
      description: data.business.description ?? '',
      hours: data.business.hours ?? '',
      categories: Array.isArray(data.business.categories) ? data.business.categories : [],
      suburb: data.business.suburb ?? null,
    };
    renderChrome();
    initInlineEditing();

    if (tier >= 2) {
      document.getElementById('photos-section').hidden = false;
      await loadPhotos();
    } else {
      document.getElementById('upsell-photos').hidden = false;
    }

    if (canChooseTemplate) {
      document.getElementById('template-picker').hidden = false;
      document.getElementById('design-actions').hidden = false;
      document.getElementById('design-status').hidden = false;
      document.querySelectorAll('.tpl-btn').forEach((btn) => {
        if (btn.dataset.tpl === selectedTemplate) btn.classList.add('active');
        btn.addEventListener('click', () => {
          selectedTemplate = btn.dataset.tpl;
          document.querySelectorAll('.tpl-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          renderPreview();
          scheduleAutosave();
        });
      });
    } else {
      document.getElementById('upsell-template').hidden = false;
    }

    if (canUseBuilder) {
      document.getElementById('block-editor').hidden = false;
      renderBlocks();
      initSortable();
    } else {
      document.getElementById('upsell-blocks').hidden = false;
    }

    updateDesignStatus();
    renderPreview();
  }

  async function loadPhotos() {
    const grid = document.getElementById('photo-grid');
    const res = await fetch(`/api/business-photos?businessId=${encodeURIComponent(businessId)}`);
    const data = await res.json();
    if (!data.ok) return;
    photos = data.photos;
    document.getElementById('photos-cap-label').textContent = `${data.photos.length} of ${data.cap} photos used`;
    grid.innerHTML = '';
    for (const photo of data.photos) {
      const div = document.createElement('div');
      div.className = 'photo-thumb';
      div.innerHTML = `<img src="/media/${photo.r2_key}" alt="Uploaded photo — click to view full size" /><button type="button" data-id="${photo.id}">Remove</button>`;
      div.querySelector('img').addEventListener('click', () => openPhotoModal(`/media/${photo.r2_key}`));
      div.querySelector('button').addEventListener('click', async (e) => {
        await fetch(`/api/business-photos?photoId=${e.target.getAttribute('data-id')}`, { method: 'DELETE' });
        await loadPhotos();
        renderPreview();
      });
      grid.appendChild(div);
    }
    renderPreview();
  }

  // Clicking an uploaded photo's thumbnail opens it full-size in a modal,
  // instead of the thumbnail growing/whatever a plain <img> would otherwise
  // do — the customize page itself never displays the full-resolution image.
  const photoModal = document.getElementById('photo-modal');
  const photoModalImg = document.getElementById('photo-modal-img');
  function openPhotoModal(src) {
    photoModalImg.src = src;
    photoModal.hidden = false;
  }
  function closePhotoModal() {
    photoModal.hidden = true;
    photoModalImg.src = '';
  }
  document.getElementById('photo-modal-close').addEventListener('click', closePhotoModal);
  document.getElementById('photo-modal-backdrop').addEventListener('click', closePhotoModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !photoModal.hidden) closePhotoModal();
  });

  document.getElementById('photo-upload-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('photo-input');
    const photoStatus = document.getElementById('photo-status');
    if (!input.files?.[0]) return;
    photoStatus.textContent = 'Uploading…';
    const fd = new FormData();
    fd.append('businessId', businessId);
    fd.append('photo', input.files[0]);
    const res = await fetch('/api/business-photos', { method: 'POST', body: fd });
    const result = await res.json();
    photoStatus.textContent = result.ok ? 'Uploaded.' : result.error || 'Could not upload.';
    if (result.ok) { input.value = ''; await loadPhotos(); }
  });

  init();
</script>

