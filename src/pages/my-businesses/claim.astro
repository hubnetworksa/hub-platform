---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import site from '../../site';

const ICONS = {
  search: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  building: '<path d="M4 21h16M6 21V7l6-4 6 4v14M9 21v-6h6v6"/>',
  x: '<path d="M18 6 6 18M6 6l12 12"/>',
};
---

<BaseLayout title="Claim a business" description={`Claim an existing business listing on ${site.siteName}.`} noindex={true}>
  <main style="max-width:520px;margin:0 auto;padding:clamp(28px,5vw,52px) 20px 60px">
    <span style="font-size:10.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)">Claim a business</span>
    <h1 style="margin:12px 0 10px;font-size:clamp(24px,3.4vw,32px);letter-spacing:-.03em;color:var(--navy)">Find and claim your listing</h1>
    <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:var(--text);">Find your business and tell us who you are. We'll review your request and get back to you — no documents needed.</p>

    <div id="search-section">
      <span style="display:block;font-size:12.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);margin-bottom:8px;">1. Find your business</span>
      <div id="combobox" style="position:relative;display:flex;align-items:center;gap:10px;padding:0 14px;border:2px solid var(--border);border-radius:11px;background:#fff;">
        <Icon path={ICONS.search} size={17} />
        <input type="text" id="search-input" autocomplete="off" placeholder="Start typing a business name…" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="search-results" style="flex:1;border:0;background:none;font-size:15px;padding:14px 0;outline:none;color:var(--text);" />
        <span id="search-spinner" class="spinner" hidden></span>
        <ul id="search-results" role="listbox" hidden style="list-style:none;position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:20;margin:0;padding:6px;border:2px solid var(--border);border-radius:11px;background:#fff;box-shadow:0 12px 28px rgba(16,26,51,.14);max-height:280px;overflow-y:auto;"></ul>
      </div>
    </div>

    <div id="selected-section" hidden style="margin-top:24px;">
      <span style="display:block;font-size:12.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);margin-bottom:8px;">Claiming</span>
      <div style="display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:11px;background:var(--bg-subtle);border:2px solid var(--border);color:var(--navy);font-weight:700;font-size:14.5px;">
        <Icon path={ICONS.building} size={16} />
        <span id="selected-name" style="flex:1;"></span>
        <button type="button" id="change-selection" aria-label="Change business" style="display:flex;align-items:center;justify-content:center;border:0;background:none;color:var(--muted);cursor:pointer;padding:4px;">
          <Icon path={ICONS.x} size={14} />
        </button>
      </div>
    </div>

    <form id="claim-form" hidden style="margin-top:24px;">
      <span style="display:block;font-size:12.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);margin-bottom:12px;">2. Tell us who you are</span>
      <div style="display:flex;flex-direction:column;gap:14px;">
        <label style="display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:800;color:var(--navy);">
          Your full name
          <input type="text" id="contact-name" name="contactName" autocomplete="name" required style="padding:14px;border:2px solid var(--border);border-radius:11px;font-size:15px;outline:none;background:#fff;color:var(--text);" />
        </label>
        <label style="display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:800;color:var(--navy);">
          Phone number
          <input type="tel" id="contact-phone" name="contactPhone" autocomplete="tel" required style="padding:14px;border:2px solid var(--border);border-radius:11px;font-size:15px;outline:none;background:#fff;color:var(--text);" />
        </label>
        <label style="display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:800;color:var(--navy);">
          Email address
          <input type="email" id="contact-email" name="contactEmail" autocomplete="email" required style="padding:14px;border:2px solid var(--border);border-radius:11px;font-size:15px;outline:none;background:#fff;color:var(--text);" />
        </label>
        <label style="display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:800;color:var(--navy);">
          Your role at this business
          <select id="role-note" name="roleNote" style="padding:14px;border:2px solid var(--border);border-radius:11px;font-size:15px;outline:none;background:#fff;color:var(--text);">
            <option value="Owner">Owner</option>
            <option value="Manager">Manager</option>
            <option value="Employee">Employee</option>
            <option value="Other">Other</option>
          </select>
        </label>
      </div>

      <button type="submit" style="width:100%;margin-top:18px;padding:15px 24px;border:0;border-radius:11px;background:var(--accent);color:var(--contrast);font-size:15px;font-weight:800;cursor:pointer;">Submit claim</button>
      <p id="form-status" role="status" style="margin:0.75rem 0 0;font-size:0.88rem;color:var(--muted);min-height:1.2em;"></p>
    </form>
  </main>
</BaseLayout>

<script>
  const searchSection = document.getElementById('search-section')!;
  const selectedSection = document.getElementById('selected-section')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const resultsList = document.getElementById('search-results')!;
  const claimForm = document.getElementById('claim-form') as HTMLFormElement;
  const selectedName = document.getElementById('selected-name')!;
  const changeBtn = document.getElementById('change-selection')!;
  const spinner = document.getElementById('search-spinner')!;
  const status = document.getElementById('form-status')!;
  let selectedId: number | null = null;
  let debounceTimer: number;
  let activeIndex = -1;

  const BUILDING_SVG = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21h16M6 21V7l6-4 6 4v14M9 21v-6h6v6"/></svg>`;

  function closeResults() {
    resultsList.hidden = true;
    resultsList.innerHTML = '';
    searchInput.setAttribute('aria-expanded', 'false');
    activeIndex = -1;
  }

  function highlight(index: number) {
    const items = [...resultsList.querySelectorAll('button[data-id]')];
    items.forEach((el, i) => el.classList.toggle('active', i === index));
    items[index]?.scrollIntoView({ block: 'nearest' });
    activeIndex = index;
  }

  (async () => {
    const res = await fetch('/api/me');
    if (res.status === 401) {
      window.location.href = `/login/?next=${encodeURIComponent(window.location.pathname + window.location.search)}`;
    }
  })();

  function selectBusiness(id: number, name: string) {
    selectedId = id;
    selectedName.textContent = name;
    searchSection.hidden = true;
    selectedSection.hidden = false;
    claimForm.hidden = false;
    closeResults();
    searchInput.value = '';
  }

  // Arriving from a business page's "Claim it" button — skip the search step.
  const params = new URLSearchParams(window.location.search);
  const preselectId = params.get('businessId');
  const preselectName = params.get('name');
  if (preselectId && preselectName) selectBusiness(Number(preselectId), preselectName);

  changeBtn.addEventListener('click', () => {
    selectedId = null;
    searchSection.hidden = false;
    selectedSection.hidden = true;
    claimForm.hidden = true;
  });

  searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const q = searchInput.value.trim();
    if (q.length < 2) {
      spinner.hidden = true;
      closeResults();
      return;
    }
    spinner.hidden = false;
    debounceTimer = window.setTimeout(async () => {
      const res = await fetch(`/api/search-businesses?q=${encodeURIComponent(q)}`);
      const data = await res.json();
      spinner.hidden = true;
      resultsList.hidden = false;
      searchInput.setAttribute('aria-expanded', 'true');
      resultsList.innerHTML = data.results.length
        ? data.results
            .map(
              (b: { id: number; name: string }, i: number) =>
                `<li role="option" style="margin-top:${i > 0 ? '2px' : '0'};"><button type="button" data-id="${b.id}" data-name="${b.name}" data-index="${i}" style="display:flex;align-items:center;gap:10px;width:100%;text-align:left;padding:10px 12px;border-radius:8px;border:0;background:none;color:var(--text);cursor:pointer;font-size:14px;">${BUILDING_SVG}<span>${b.name}</span></button></li>`
            )
            .join('')
        : '<li style="padding:12px;color:var(--muted);font-size:14px;text-align:center;">No matches found.</li>';
      activeIndex = -1;
    }, 250);
  });

  searchInput.addEventListener('keydown', (e) => {
    const items = resultsList.querySelectorAll('button[data-id]');
    if (resultsList.hidden || items.length === 0) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      highlight((activeIndex + 1) % items.length);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlight((activeIndex - 1 + items.length) % items.length);
    } else if (e.key === 'Enter' && activeIndex >= 0) {
      e.preventDefault();
      const btn = items[activeIndex] as HTMLButtonElement;
      selectBusiness(Number(btn.dataset.id), btn.dataset.name ?? '');
    } else if (e.key === 'Escape') {
      closeResults();
    }
  });

  resultsList.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-id]') as HTMLButtonElement | null;
    if (!btn) return;
    selectBusiness(Number(btn.dataset.id), btn.dataset.name ?? '');
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#combobox')) closeResults();
  });

  claimForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!selectedId) return;
    status.textContent = 'Submitting…';
    const contactName = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
    const contactPhone = (document.getElementById('contact-phone') as HTMLInputElement).value.trim();
    const contactEmail = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
    const roleNote = (document.getElementById('role-note') as HTMLSelectElement).value;
    try {
      const res = await fetch('/api/claim-business', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ businessId: selectedId, contactName, contactPhone, contactEmail, roleNote }),
      });
      if (res.status === 401) {
        window.location.href = '/login/';
        return;
      }
      const result = await res.json();
      status.textContent = result.ok ? "Claim submitted — we'll review it and be in touch." : result.error || 'Something went wrong.';
      if (result.ok) claimForm.reset();
    } catch {
      status.textContent = 'Something went wrong — please try again.';
    }
  });
</script>

<style>
  .spinner {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    border: 2px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  #combobox:focus-within {
    border-color: var(--accent);
  }
  #search-results button:hover,
  #search-results button.active {
    background: rgba(var(--accent-rgb), 0.09) !important;
  }
</style>
