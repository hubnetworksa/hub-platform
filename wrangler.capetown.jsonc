{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thecapetownhub",
  "compatibility_date": "2026-08-31",
  "pages_build_output_dir": "dist",

  // Read by functions/_lib/site.ts at request time to pick this site's config
  // out of sites/*.json — set separately for Preview vs Production in the
  // Cloudflare Pages dashboard too (Settings → Environment variables);
  // whatever's there overrides this file for an actual deployed build.
  "vars": {
    "SITE": "capetown"
  },

  // database_id is filled in after `wrangler d1 create thecapetownhub-db` —
  // see SETUP.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thecapetownhub-db",
      "database_id": "REPLACE_AFTER_wrangler_d1_create",
      "migrations_dir": "db/migrations/capetown"
    }
  ],

  // Filled in after `wrangler r2 bucket create thecapetownhub-media` — needs
  // R2 write permission on the wrangler auth token first. See SETUP.md.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "thecapetownhub-media"
    }
  ]
}
