# build output
dist/
# generated types
.astro/
# D1 data snapshot generated by scripts/fetch-d1-data.mjs before each build
src/data/*.json

# manual D1 export/import dumps (contain real business/customer PII —
# emails, phone numbers — never belongs in git history)
db/backups/

# per-site branded assets, copied from assets/sites/<SITE>/ by
# scripts/select-site-assets.mjs before each build/dev — assets/sites/ is
# the real committed source, not this
public/*
!public/.gitkeep

# dependencies
node_modules/

# wrangler local state (local D1 sqlite, etc.)
.wrangler/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.dev.vars

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# personal Claude Code settings (not shared with the team)
.claude/settings.local.json
